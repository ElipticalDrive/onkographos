+def compute_sphere_sdf(points, cfg):
+    """Compute ground-truth SDF for a sphere centered at cfg.center with radius cfg.radius."""
+    diff = torch.abs(points - cfg.center) - cfg.radius
+    signed_distance = torch.linalg.norm(torch.maximum(diff, torch.zeros_like(diff)), dim=-1) + torch.minimum(torch.max(diff, dim=-1)[0], torch.zeros_like(diff[..., 0]))
+    return signed_distance.unsqueeze(-1)
