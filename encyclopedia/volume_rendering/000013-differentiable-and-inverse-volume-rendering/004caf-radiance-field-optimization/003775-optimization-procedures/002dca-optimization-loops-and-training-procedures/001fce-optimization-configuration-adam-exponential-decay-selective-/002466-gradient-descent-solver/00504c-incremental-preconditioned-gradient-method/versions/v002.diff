+        alpha = rs_old / pAp
+        for j in range(N):
+            x[j] += alpha * p[j]
+            r[j] -= alpha * Ap[j]
+        rs_new = sum(r[j]*r[j] for j in range(N))
+        if math.sqrt(rs_new) / math.sqrt(sum(b[j]*b[j] for j in range(N))) < rel_tol:
