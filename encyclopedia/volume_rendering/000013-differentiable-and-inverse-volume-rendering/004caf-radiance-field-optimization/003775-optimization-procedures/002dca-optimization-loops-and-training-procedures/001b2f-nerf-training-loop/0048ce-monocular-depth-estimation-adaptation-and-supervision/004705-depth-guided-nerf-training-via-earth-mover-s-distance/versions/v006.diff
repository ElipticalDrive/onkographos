+
+def train_step(nerf_model, diffdp_model, image, pose, uncertainty_map, depth_prior, 
+               num_coarse, num_fine, num_emd_samples, lambda_bal, gamma):
+    """
+    Single training step.
+    """
+    # 1. Get rays from pose
+    rays = get_rays_from_pose(pose) # Returns origins, directions
+    
+    # 2. Coarse pass
+    y_coarse, weights_coarse, color_coarse = nerf_forward(
+        rays.origins, rays.directions, nerf_model, num_coarse
+    )
+    
+    # 3. Fine pass (optional, for standard NeRF)
+    # ...
+    
+    # 4. EMD Sampling
+    # Use fine weights to sample new distances for EMD
+    y_emd, _, _ = nerf_forward(
+        rays.origins, rays.directions, nerf_model, num_emd_samples
+    )
+    
+    # 5. Compute Losses
+    # Photometric loss
+    # Re-render color for comparison
+    color_rendered = color_coarse # Simplified
+    C_observed = image # Assuming image matches ray batch
+    
+    L_photo = torch.mean((color_rendered - C_observed) ** 2)
+    
+    # EMD Loss
+    # Flatten samples and prior for the ray
+    # y_emd: [batch, num_emd_samples]
+    # depth_prior: [batch, H, W] -> need to map to ray pixels
+    # Assuming depth_prior is aligned with image
+    L_emd = sinkhorn_divergence(y_emd.flatten(), depth_prior.flatten())
+    
+    # 6. Weighted Loss
+    # Uncertainty map u is per pixel, need to gather for rays
+    u = gather_uncertainty(uncertainty_map, rays)
+    
+    L = (1 + u)**gamma * L_photo + lambda_bal * (1 - u)**gamma * L_emd
+    
+    return L
