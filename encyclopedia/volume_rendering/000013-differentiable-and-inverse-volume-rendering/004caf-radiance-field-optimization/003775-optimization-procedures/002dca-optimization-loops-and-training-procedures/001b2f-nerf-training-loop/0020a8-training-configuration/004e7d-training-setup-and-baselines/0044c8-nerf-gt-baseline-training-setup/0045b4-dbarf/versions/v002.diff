+    alpha = 0.85
+    loss_sum = 0.0
+    for j, nearby_img in enumerate(nearby_imgs):
+        # Warp nearby image to target view using P_ij [S1]
+        warped_img = warp_image(nearby_img, P_ij[j], target_img.intrinsics)
+        # SSIM Loss [S1]
