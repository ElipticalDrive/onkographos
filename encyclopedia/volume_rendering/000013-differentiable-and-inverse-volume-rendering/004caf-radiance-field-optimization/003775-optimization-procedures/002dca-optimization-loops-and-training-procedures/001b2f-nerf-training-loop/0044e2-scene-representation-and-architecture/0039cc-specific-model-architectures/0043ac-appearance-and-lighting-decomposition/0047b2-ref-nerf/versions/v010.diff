+    def forward(self, x, d):
+        """
+        Forward pass of Ref-NeRF.
+        :param x: 3D spatial coordinates (B, 3)
+        :param d: Viewing directions (B, 3)
+        :return: Outgoing radiance c (B, 3)
+        """
+        # Step 1: Positional Encoding
