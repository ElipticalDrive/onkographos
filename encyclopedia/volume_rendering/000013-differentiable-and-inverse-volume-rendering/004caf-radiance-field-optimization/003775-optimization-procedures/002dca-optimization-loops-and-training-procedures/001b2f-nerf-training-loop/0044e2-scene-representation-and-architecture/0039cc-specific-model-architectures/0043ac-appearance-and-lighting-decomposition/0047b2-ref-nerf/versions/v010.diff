+        sigma = spatial_out[:, 0:1]
+        cd = spatial_out[:, 1:4]
+        s = spatial_out[:, 4:7]
+        b = spatial_out[:, 7:7+self.bottleneck_dim]
+        rho = spatial_out[:, 7+self.bottleneck_dim:7+self.bottleneck_dim+1]
+        n_prime = spatial_out[:, 7+self.bottleneck_dim+1:7+self.bottleneck_dim+4]
