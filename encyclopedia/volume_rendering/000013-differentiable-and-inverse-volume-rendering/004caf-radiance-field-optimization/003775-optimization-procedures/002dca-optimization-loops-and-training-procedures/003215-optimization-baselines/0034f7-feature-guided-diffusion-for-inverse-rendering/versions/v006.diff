 import numpy as np
 
+class Adam:
+    def __init__(self, params, lr=0.001, beta1=0.9, beta2=0.999, eps=1e-8):
+        self.params = params
+        self.lr = lr
+        self.beta1, self.beta2 = beta1, beta2
+        self.eps = eps
+        self.m = {id(p): np.zeros_like(p) for p in params}
+        self.v = {id(p): np.zeros_like(p) for p in params}
+        self.t = 0
+    def step(self):
+        self.t += 1
+        for p in self.params:
+            self.m[id(p)] = self.beta1 * self.m[id(p)] + (1 - self.beta1) * p.grad
+            self.v[id(p)] = self.beta2 * self.v[id(p)] + (1 - self.beta2) * (p.grad ** 2)
+            m_hat = self.m[id(p)] / (1 - self.beta1 ** self.t)
+            v_hat = self.v[id(p)] / (1 - self.beta2 ** self.t)
+            p -= self.lr * m_hat / (np.sqrt(v_hat) + self.eps)
+            p.grad = None
+
