+def compute_transmittance_and_weights(densities, deltas):
+    """
+    Computes transmittance T and weights w for NeRF samples.
+    densities: Tensor of shape (N_samples,)
+    deltas: Tensor of shape (N_samples,) distance between samples
+    """
+    # Cumulative sum of sigma * delta
+    # T_i = exp(- sum_{j=1}^{i-1} sigma_j * delta_j)
+    # We need to handle the empty sum for i=1 as 0.
+    
+    # Compute sigma * delta
+    sigma_delta = densities * deltas
+    
+    # Cumulative sum, shifted by 1 to represent sum_{j=1}^{i-1}
+    # torch.cumsum includes the current element. We want previous elements.
+    # So we shift the cumsum result.
+    cum_sigma_delta = torch.cumsum(sigma_delta, dim=0)
+    
+    # T_1 = exp(0) = 1. T_i = exp(-cumsum_{i-1})
+    # For i=0 (first sample), cumsum is sigma_0*delta_0. We want 0.
+    # So we pad with 0 at the beginning.
+    cum_sigma_delta_shifted = torch.cat([torch.zeros(1, device=densities.device), cum_sigma_delta[:-1]])
+    
+    T = torch.exp(-cum_sigma_delta_shifted)
+    
+    # w_i = T_i * (1 - exp(-sigma_i * delta_i))
+    w = T * (1 - torch.exp(-sigma_delta))
+    
+    return T, w
