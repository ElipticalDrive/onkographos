+def inverse_transform_sampling(cdf, num_samples):
+    """
+    Samples from a discrete CDF.
+    cdf: Tensor of shape (N_samples,), cumulative probabilities summing to 1.
+    num_samples: int, number of samples to draw.
+    """
+    # Generate uniform random numbers
+    u = torch.rand(num_samples, device=cdf.device)
+    
+    # Find indices where cdf >= u
+    # torch.searchsorted is efficient for this
+    indices = torch.searchsorted(cdf, u)
+    
+    # Return the distances corresponding to these indices
+    # Note: In the actual NeRF context, 'y' are the distances.
+    # The CDF is built from weights associated with distances y_l.
+    # So we return the distances y[indices]
+    return indices
