+import numpy as np
+from typing import List, Tuple, Dict
+
+# Assume standard libraries for diffusion, NeRF/3DGS, and image processing are available.
+# G: Deceptive Diffusion Model (ControlNet fine-tuned Stable Diffusion)
+# F_Theta: NeRF or 3DGS representation
+# K: Camera intrinsic matrix
+# LPIPS: Perceptual similarity metric
+
+def compute_depth_rendering(transmittance: np.ndarray, opacity: np.ndarray, 
+                            density: np.ndarray, delta: np.ndarray) -> np.ndarray:
+    """
+    Computes depth map from volumetric rendering parameters.
+    D = sum(T(t_k) * alpha * sigma(t_k) * delta_k)
+    """
+    # alpha is derived from opacity logit o as 2D Gaussian * opacity logit [S1]
+    # Implementation detail: alpha = 1 - exp(-sigma * delta) for standard NeRF, 
+    # but source specifies alpha is given by evaluating a 2D Gaussian multiplied by opacity logit.
+    # For the purpose of the formula provided in [S1]:
+    depth = np.sum(transmittance * opacity * density * delta, axis=-1)
+    return depth
+
+def warp_image(source_image: np.ndarray, depth_map: np.ndarray, 
+               R_BtoA: np.ndarray, K: np.ndarray) -> np.ndarray:
+    """
+    Warps source image from viewpoint B to viewpoint A using depth map of A.
+    q = K * R_BtoA * D_A(p) * K^-1 * p
+    """
+    H, W = source_image.shape[:2]
+    # Create pixel grid
+    y, x = np.meshgrid(np.arange(H), np.arange(W), indexing='ij')
+    p_homogeneous = np.stack([x, y, np.ones_like(x)], axis=-1) # p in homogeneous coords
+    
+    # Inverse K
+    K_inv = np.linalg.inv(K)
+    
+    # Transform p to camera coordinates (assuming p is in pixel coords, need to handle scaling)
+    # Note: The formula q = K R D_A(p) K^-1 p implies p is in pixel coordinates.
+    # K^-1 p gives normalized camera coordinates.
+    p_cam = (K_inv @ p_homogeneous.T).T # Shape (H, W, 3)
+    
+    # Scale by depth
+    # D_A(p) is a scalar depth value for pixel p
+    # R_BtoA is the rotation matrix from B to A.
+    # We need to transform the point from A's camera frame to B's camera frame?
+    # Actually, the formula warps I_B to A. So we take a point in A's image, 
+    # project it to 3D in A's frame, transform to B's frame, and project to B's image.
+    
+    # 1. Project pixel p in A to 3D ray in A's frame
+    # x_3d_A = depth * K^-1 * p
+    x_3d_A = depth_map * p_cam[:, :, :2] # Assuming depth is z
+    x_3d_A_hom = np.stack([x_3d_A[:, :, 0], x_3d_A[:, :, 1], depth_map], axis=-1)
+    
+    # 2. Transform to B's frame: x_B = R_BtoA * x_A + t_BtoA
+    # The source only provides R_BtoA. Assuming translation is handled or negligible for the warp logic 
+    # or R includes translation in a specific way. Standard epipolar warp uses full pose.
+    # We assume R_BtoA is the full transformation matrix or we approximate.
+    # Let's stick to the formula: q = K * R * D * K^-1 * p
+    # This implies R is applied to the normalized coordinates scaled by depth.
+    
+    # Reshape for matrix multiplication
+    x_3d_A_flat = x_3d_A_hom.reshape(-1, 3)
+    x_3d_B_flat = (R_BtoA @ x_3d_A_flat.T).T
+    
+    # 3. Project to B's image
+    x_3d_B_hom = np.concatenate([x_3d_B_flat, np.ones((x_3d_B_flat.shape[0], 1))], axis=-1)
+    q_cam = (K @ x_3d_B_hom.T).T
+    q = q_cam[:, :, :2] / q_cam[:, :, 2:3] # Normalize
+    
+    # 4. Sample from source_image at q
+    # Handle boundary checks and interpolation
+    warped = np.zeros_like(source_image)
+    # ... (Bilinear interpolation logic would go here) ...
+    return warped
+
+def generate_uncertainty_map(warped_image: np.ndarray, rendered_image: np.ndarray) -> np.ndarray:
+    """
+    U_A = (I_{B->A} - I_A)^2
+    """
+    return (warped_image - rendered_image) ** 2
+
+def derive_text_embedding(image_captioner, textual_inversion_optimizer, 
+                          input_images: List[np.ndarray], coarse_images: List[np.ndarray]) -> np.ndarray:
+    """
+    s = [s_0, s*]
+    """
+    # 1. Generate s_0
+    # Assuming captioner returns a string, which is then tokenized/embedded
+    s_0_str = image_captioner(coarse_images[0]) # Example
+    s_0 = embed_text(s_0_str)
+    
+    # 2. Optimize s*
+    s_star = textual_inversion_optimizer.optimize(input_images, coarse_images)
+    
+    # 3. Concatenate
+    s = np.concatenate([s_0, s_star])
+    return s
+
+def train_deceptive_diffusion_model():
+    """
+    Fine-tune G using ControlNet.
+    Objective: min_theta E || epsilon - epsilon_theta(z_t, t, c(I_coarse, D, U, s)) ||^2
+    """
+    # Dataset construction:
+    # 1. NeRF Duos: Train coarse NeRF (1/5 images) and fine NeRF (all images).
+    #    Render (I_coarse, D, U) from coarse, target I_fine from fine.
+    # 2. Augmentation: Add Gaussian noise (std=0.3) to 60,000 Hypersim images.
+    #    Input: Noisy RGB, Depth. Target: Original RGB. No Uncertainty map in this subset.
+    
+    # Training loop for G
+    for batch in dataset:
+        I_coarse, D, U, s, I_target = batch
+        # If from augmentation, U might be None or zero
+        if U is None:
+            U = np.zeros_like(I_coarse)
+            
+        # Encode to latent space
+        z = encoder(I_coarse)
+        t = random.randint(1, 1000)
+        epsilon = random_noise()
+        
+        # Condition embedding c
+        c = embed_conditions(I_coarse, D, U, s)
+        
+        # Predict noise
+        predicted_epsilon = denoiser(z, t, c)
+        
+        # Loss
+        loss = np.mean((epsilon - predicted_epsilon) ** 2)
+        update_theta(loss)
+
+def deceptive_nerf_pipeline(input_images: List[np.ndarray], poses: List[np.ndarray], 
+                            num_epochs: int, num_pseudo_views: int) -> Dict:
+    """
+    Main pipeline for Deceptive-NeRF/3DGS.
+    """
+    # 1. Initial Training
+    F_Theta = train_nerf_3dgs(input_images, poses, num_epochs)
+    
+    pseudo_observations = []
+    
+    # 2. Iterative Densification
+    for i in range(num_pseudo_views):
+        # Sample novel view A
+        A = sample_novel_view(poses)
+        
+        # Render
+        I_hat_A, D_hat_A = render(F_Theta, A)
+        
+        # Find nearest input view B
+        B = find_nearest_input_view(A, poses)
+        I_B = input_images[B]
+        R_BtoA = compute_pose_diff(poses[B], A)
+        
+        # Warp and Uncertainty
+        I_B_to_A = warp_image(I_B, D_hat_A, R_BtoA, K)
+        U_A = generate_uncertainty_map(I_B_to_A, I_hat_A)
+        
+        # Text Embedding (can be cached or updated periodically)
+        s = derive_text_embedding(captioner, optimizer, input_images, [I_hat_A])
+        
+        # Generate Pseudo-Observation
+        P_A = G(I_hat_A, D_hat_A, U_A, s)
+        
+        # Filter
+        if is_similar_enough(P_A, input_images, threshold=0.2): # Discard bottom 20%
+            pseudo_observations.append(P_A)
+            
+        # Optimize
+        all_images = input_images + pseudo_observations
+        F_Theta = train_nerf_3dgs(all_images, poses + [A], epochs=1) # Incremental update
+        
+    return F_Theta
+
+def is_similar_enough(pseudo: np.ndarray, inputs: List[np.ndarray], threshold: float) -> bool:
+    """
+    Check if pseudo-observation is in top 80% of perceptual similarity.
+    """
+    scores = [LPIPS(pseudo, inp) for inp in inputs]
+    avg_score = np.mean(scores)
+    # Discard if in bottom 20%. 
+    # In practice, maintain a buffer of scores and compare rank.
+    return avg_score > threshold # Placeholder logic for "top 80%"
