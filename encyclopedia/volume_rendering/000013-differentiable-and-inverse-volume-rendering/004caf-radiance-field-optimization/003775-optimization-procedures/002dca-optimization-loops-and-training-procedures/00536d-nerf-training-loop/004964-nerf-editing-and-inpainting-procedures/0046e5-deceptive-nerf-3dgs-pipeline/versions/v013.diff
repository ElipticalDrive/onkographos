+import numpy as np
+
+def train_deceptive_nerf(input_images, camera_poses, diffusion_model, caption_model, 
+                         num_epochs_coarse, num_pseudo_views, discard_rate=0.2):
+    """
+    Main training loop for Deceptive-NeRF/3DGS.
+    
+    Args:
+        input_images: List of W input images I = {I1, ..., IW}.
+        camera_poses: Calibrated camera poses for input_images.
+        diffusion_model: Pre-trained latent diffusion model G with ControlNet.
+        caption_model: Pre-trained image captioning network.
+        num_epochs_coarse: Number of epochs to train initial coarse NeRF.
+        num_pseudo_views: Total number of pseudo-observations to generate.
+        discard_rate: Fraction of pseudo-observations to discard (default 0.2).
+        
+    Returns:
+        optimized_nerf: The final trained NeRF/3DGS representation.
+    """
+    
+    # Step 1: Initial Coarse Training
+    # Train a base NeRF/3DGS using only input_images
+    coarse_nerf = train_nerf(input_images, camera_poses, epochs=num_epochs_coarse)
+    
+    # Step 2: Prepare Text Embedding (Shared across all views)
+    # Generate initial prompt from a representative coarse image
+    representative_coarse_img = coarse_nerf.render(random_view())
+    s0 = caption_model.generate_prompt(representative_coarse_img)
+    
+    # Optimize shared latent text embedding s* via textual inversion
+    # This step optimizes s* to be shared by all input observations and coarse images
+    s_star = textual_inversion(input_images, coarse_nerf, initial_prompt=s0)
+    
+    # Form composite feature s
+    s = concatenate_embeddings(s0, s_star)
+    
+    # Step 3: Initialize Pseudo-Observation Pool
+    pseudo_observations = []
+    
+    # Step 4: Iterative Densification
+    for i in range(num_pseudo_views):
+        
+        # 4a: Sample Novel Viewpoint A
+        view_A = sample_random_view_within_bounds(camera_poses)
+        
+        # 4b: Render Quantities at A
+        # Render RGB, Depth, and Uncertainty
+        I_hat_A = coarse_nerf.render_rgb(view_A)
+        D_A = coarse_nerf.render_depth(view_A)
+        
+        # Compute Uncertainty Map U_A
+        # Find nearest input view B to A
+        view_B = find_nearest_input_view(view_A, camera_poses)
+        I_B = get_image_for_view(view_B, input_images)
+        
+        # Warp I_B to view A using D_A and relative pose
+        # q = K * R_{B->A} * D_A(p) * K^{-1} * p
+        I_B_warped = warp_image(I_B, view_B, view_A, D_A)
+        
+        # U_A = (I_{B->A} - I_hat_A)^2
+        U_A = square_difference(I_B_warped, I_hat_A)
+        
+        # 4c: Generate Pseudo-Observation
+        # P_A = G(I_hat_A, D_A, U_A)
+        # Condition diffusion model on coarse image, depth, uncertainty, and text embedding s
+        P_A = diffusion_model.generate(I_hat_A, D_A, U_A, s)
+        
+        # 4d: Accumulate
+        pseudo_observations.append(P_A)
+        
+        # 4e: Filter (Optional: Perform periodically or at end)
+        # Discard 20% with lowest LPIPS similarity to input images
+        if len(pseudo_observations) > 100: # Example threshold
+            scores = compute_lpips_similarity(pseudo_observations, input_images)
+            num_to_discard = int(len(pseudo_observations) * discard_rate)
+            indices_to_keep = get_top_k_indices(scores, len(scores) - num_to_discard)
+            pseudo_observations = [pseudo_observations[j] for j in indices_to_keep]
+            
+    # Step 5: Final Optimization
+    # Combine real input images and pseudo-observations
+    all_images = input_images + pseudo_observations
+    all_poses = camera_poses + get_poses_for_pseudo_views(pseudo_observations)
+    
+    # Train final NeRF/3DGS using all data
+    optimized_nerf = train_nerf(all_images, all_poses, epochs=final_epochs)
+    
+    return optimized_nerf
+
+def warp_image(I_B, view_B, view_A, D_A):
+    """
+    Warp image I_B from view B to view A using depth map D_A of view A.
+    """
+    H, W = I_B.shape[:2]
+    I_warped = np.zeros_like(I_B)
+    
+    # Get camera intrinsic K and relative rotation R_{B->A}
+    K = get_camera_intrinsic(view_B)
+    R_BA = get_relative_rotation(view_B, view_A)
+    
+    for y in range(H):
+        for x in range(W):
+            # Pixel p in I_B (source)
+            p = np.array([x, y, 1])
+            
+            # We need to find where this pixel maps to in I_hat_A (target)
+            # However, the formula q = K R D_A(p) K^{-1} p maps p in I_hat_A to q in I_B.
+            # To warp I_B to I_hat_A, we need the inverse mapping or iterate over target pixels.
+            # The paper defines U_A based on I_{B->A} compared to I_hat_A.
+            # So we need to generate I_{B->A} which has same dimensions as I_hat_A.
+            pass
+            
+    # Correct approach: Iterate over target pixels in I_hat_A (view A)
+    # and find corresponding source pixel in I_B (view B)
+    H_A, W_A = D_A.shape
+    I_warped = np.zeros((H_A, W_A, 3))
+    
+    for y in range(H_A):
+        for x in range(W_A):
+            p = np.array([x, y, 1]) # Pixel in I_hat_A
+            
+            # Get depth at p
+            depth_p = D_A[y, x]
+            
+            # Transform p to q in I_B
+            # q = K * R_{B->A} * depth_p * K^{-1} * p
+            p_homogeneous = np.array([x, y, 1])
+            p_in_B = K @ R_BA @ (depth_p * (np.linalg.inv(K) @ p_homogeneous))
+            
+            # Normalize
+            if p_in_B[2] != 0:
+                q_x = p_in_B[0] / p_in_B[2]
+                q_y = p_in_B[1] / p_in_B[2]
+                
+                # Check bounds
+                if 0 <= q_x < W and 0 <= q_y < H:
+                    # Interpolate color from I_B
+                    I_warped[y, x] = interpolate_color(I_B, q_x, q_y)
+                    
+    return I_warped
