+            img_feat = clip_encoders[0](roi_color) # Simplified: treating color as image feature for explanation
+            txt_feat = clip_encoders[1](prompt)
+            sim_loss = -np.dot(img_feat, txt_feat)
+            
+        return roi_color, sim_loss
+
+    else:
+        # Inference: Blend O and G
+        # This is handled by the blending logic in the main loop, 
