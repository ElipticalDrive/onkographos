+def positional_encoding(x, L=10):
+    """High frequency sinusoidal positional encoding."""
+    freq_bands = 2.0 ** np.arange(L)
+    return np.concatenate([np.cos(freq_bands * x), np.sin(freq_bands * x)], axis=-1)
+
+def volume_rendering(samples, model, roi_box, is_training=False, prompt=None, clip_encoders=None):
+    """
+    Renders a ray using a NeRF model.
+    samples: list of 3D points along the ray.
+    model: NeRF MLP returning (sigma, color).
+    roi_box: Box defining the ROI.
+    is_training: If True, only render points inside ROI.
+    prompt: Text prompt for CLIP similarity loss.
+    clip_encoders: (E_img, E_txt) for CLIP.
+    """
+    # Filter points inside ROI if training
+    if is_training:
+        points_in_roi = [p for p in samples if roi_box.contains(p)]
+        if not points_in_roi:
+            return 0.0, None # No ROI intersection
+        
+        # Render only ROI points
+        # Note: Standard NeRF rendering sums over all points, but here we restrict to ROI
+        # and normalize by the sum of weights in ROI to get the ROI color
+        total_weight = 0.0
+        weighted_color = np.zeros(3)
+        T = 1.0
+        
+        for i, x in enumerate(points_in_roi):
+            # Get sigma and color from model
+            sigma, c = model(x)
+            # Ensure non-negative sigma if needed by activation phi
+            sigma = max(0, sigma) 
+            
+            delta = distance_to_next_sample(x, points_in_roi, i)
+            weight = T * (1 - np.exp(-sigma * delta))
+            T *= np.exp(-sigma * delta)
+            
+            total_weight += weight
+            weighted_color += weight * c
+            
+        if total_weight > 0:
+            roi_color = weighted_color / total_weight
+        else:
+            roi_color = np.zeros(3)
+            
+        # Compute CLIP similarity loss if prompt provided
+        sim_loss = 0.0
+        if prompt and clip_encoders:
+            # Render ROI image (simplified as single color for loss calculation in paper context)
+            # In practice, this requires rendering a patch/image, not just a ray color
