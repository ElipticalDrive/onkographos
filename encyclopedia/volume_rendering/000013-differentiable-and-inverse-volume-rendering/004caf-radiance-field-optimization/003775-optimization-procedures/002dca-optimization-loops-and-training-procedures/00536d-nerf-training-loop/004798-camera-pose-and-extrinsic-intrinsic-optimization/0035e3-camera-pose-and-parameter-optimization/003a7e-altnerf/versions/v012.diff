+    for i, frame in enumerate(frames):
+        H, W = frame.shape[:2]
+        for u in range(W):
+            for v in range(H):
+                o = poses[i][:3, 3]
+                d = poses[i][:3, :3] @ np.array([(u - W/2)/K[0,0], -(v - H/2)/K[1,1], -1])
