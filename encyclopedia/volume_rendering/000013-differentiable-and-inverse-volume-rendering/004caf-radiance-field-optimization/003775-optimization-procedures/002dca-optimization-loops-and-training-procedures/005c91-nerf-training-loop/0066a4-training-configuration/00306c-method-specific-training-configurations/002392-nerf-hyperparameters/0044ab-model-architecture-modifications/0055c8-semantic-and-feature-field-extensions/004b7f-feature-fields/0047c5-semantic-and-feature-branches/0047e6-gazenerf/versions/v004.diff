 import torch.nn.functional as F
 
+def positional_encoding(x, min_deg=0, max_deg=10, scale=1):
+    """Standard NeRF positional encoding [G]."""
+    scales = torch.tensor([2**i for i in range(min_deg, max_deg)])
+    xb = torch.reshape((x * scale)[:, None, :] * (2 * torch.pi) / scales, list(x.shape)[:-1] + [-1])
+    return torch.cat([torch.sin(xb), torch.cos(xb)], dim=-1)
+
+class MLPStream(nn.Module):
+    """Two-stream MLP predicting density and feature vector [S1]."""
+    def __init__(self, in_dim, out_dim=258):
+        super().__init__()
+        self.net = nn.Sequential(
+            nn.Linear(in_dim, 256), nn.ReLU(),
+            nn.Linear(256, 256), nn.ReLU(),
+            nn.Linear(256, 256), nn.ReLU(),
+            nn.Linear(256, 1 + out_dim) # density + feature
+        )
+    def forward(self, x):
+        out = self.net(x)
+        return torch.sigmoid(out[:, :1]), out[:, 1:]
+
+class NeuralRenderingModule(nn.Module):
+    """Shared upsampling and color prediction module [S1]."""
+    def __init__(self):
+        super().__init__()
+        self.upsample = nn.Upsample(scale_factor=8, mode='bilinear', align_corners=False)
+        self.color_head = nn.Conv2d(258, 3, kernel_size=1)
+    def forward(self, F):
+        # F shape: (B, 64, 64, 258) -> (B, 258, 64, 64)
+        F = F.permute(0, 3, 1, 2)
+        F = self.upsample(F)
+        return self.color_head(F)
+
+def compute_rotation_from_pitch_yaw(pitch, yaw):
+    """Compute 3D rotation matrix R from gaze label g [G]."""
+    # Standard rotation composition: R = R_y(yaw) * R_x(pitch)
+    cos_p, sin_p = torch.cos(pitch), torch.sin(pitch)
+    cos_y, sin_y = torch.cos(yaw), torch.sin(yaw)
+    R_x = torch.tensor([[1, 0, 0], [0, cos_p, -sin_p], [0, sin_p, cos_p]])
+    R_y = torch.tensor([[cos_y, 0, sin_y], [0, 1, 0], [-sin_y, 0, cos_y]])
+    return R_y @ R_x
+
+def volume_render_feature_map(sigma, f, rays_x, rays_d, N=128):
+    """Standard differentiable volume rendering [G]."""
+    # Sample points along rays
+    t_vals = torch.linspace(0, 1, N, device=sigma.device)
+    z_vals = 0.1 * (1 - t_vals) + 0.9 * t_vals
+    pts = rays_x[:, None, :] + rays_d[:, None, :] * z_vals[:, :, None]
+    # Evaluate MLP at sampled points (simplified for pseudocode)
+    # In practice, this calls the MLP and returns sigma_i, f_i
+    # Here we assume sigma and f are already sampled along rays: shape (B, N, 1) and (B, N, 258)
+    delta = z_vals[:, 1:] - z_vals[:, :-1]
+    alpha = 1 - torch.exp(-sigma * delta)
+    T = torch.cat([torch.ones_like(alpha[:, :1]), torch.cumprod(1 - alpha[:, :-1] + 1e-10, dim=1)], dim=1)
+    weights = alpha * T[:, :-1]
+    return torch.sum(weights[:, :, None] * f, dim=1) # (B, 258) -> aggregated to grid in full impl
