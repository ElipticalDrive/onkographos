+    # Binarize indices based on resolution of LUT
+    # Implementation detail: mapping continuous values to discrete indices
+    idx_cos = int(cos_theta * (lut.shape[0] - 1))
+    idx_rough = int(roughness * (lut.shape[1] - 1))
