+    # Clamp indices
+    idx_cos = max(0, min(idx_cos, lut.shape[0] - 1))
+    idx_rough = max(0, min(idx_rough, lut.shape[1] - 1))
+    
+    A = lut[idx_cos, idx_rough, 0] # .r channel
+    B = lut[idx_cos, idx_rough, 1] # .g channel
+    return A, B
