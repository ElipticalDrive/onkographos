+def sample_rays(image_shape, cam_params, near=1.0, far=10.0, num_samples=64):
+    """Generate rays for each pixel using camera parameters [G]."""
+    H, W, _ = image_shape
+    u, v = torch.meshgrid(torch.arange(W), torch.arange(H), indexing='ij')
+    u = u.float().flatten()
+    v = v.float().flatten()
+    # Simple pinhole camera model for demonstration
+    fx, fy = 512.0, 512.0
+    cx, cy = W / 2, H / 2
+    d = torch.stack([
