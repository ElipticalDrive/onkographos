+import math
+import numpy as np
+
+def spherical_harmonics_encoding(d, degree=4):
+    """
+    Encodes direction d using spherical harmonics up to the specified degree.
+    Returns a 1D array of coefficients.
+    """
+    # Standard SH encoding implementation
+    # Degree 0: 1 term
+    # Degree 1: 3 terms
+    # Degree 2: 5 terms
+    # Degree 3: 7 terms
+    # Degree 4: 9 terms
+    # Total terms for degree 4 is (4+1)^2 = 25.
+    # Note: The source says "up to the 4th degree".
+    # We assume a standard SH basis.
+    x, y, z = d
+    norm = math.sqrt(x*x + y*y + z*z)
+    if norm == 0:
+        x, y, z = 0, 0, 1 # Default up
+    else:
+        x, y, z = x/norm, y/norm, z/norm
+        
+    coeffs = []
+    # Degree 0
+    coeffs.append(0.282095)
+    # Degree 1
+    coeffs.append(0.488603 * y)
+    coeffs.append(0.488603 * z)
+    coeffs.append(0.488603 * x)
+    # Degree 2
+    coeffs.append(1.092548 * x * y)
+    coeffs.append(1.092548 * y * z)
+    coeffs.append(0.315392 * (3 * z * z - 1))
+    coeffs.append(1.092548 * x * z)
+    coeffs.append(0.546274 * (x * x - y * y))
+    # Degree 3
+    coeffs.append(0.590044 * y * (3 * x * x - y * y))
+    coeffs.append(2.890611 * x * y * z)
+    coeffs.append(0.457046 * y * (5 * z * z - 1))
+    coeffs.append(0.373176 * z * (5 * z * z - 3))
+    coeffs.append(0.457046 * x * (5 * z * z - 1))
+    coeffs.append(1.445306 * z * (x * x - y * y))
+    coeffs.append(0.590044 * x * (x * x - 3 * y * y))
+    # Degree 4
+    coeffs.append(2.503343 * x * y * (x * x - y * y))
+    coeffs.append(1.770131 * y * z * (3 * x * x - y * y))
+    coeffs.append(0.946175 * x * z * (x * x - 3 * y * y))
+    coeffs.append(0.625836 * y * z * (7 * z * z - 1))
+    coeffs.append(0.109098 * (35 * z * z * z * z - 30 * z * z + 3))
+    coeffs.append(0.946175 * x * z * (7 * z * z - 1))
+    coeffs.append(0.473087 * (x * x - y * y) * (7 * z * z - 1))
+    coeffs.append(1.770131 * x * z * (x * x - 3 * y * y))
+    coeffs.append(0.442533 * (x * x - y * y) * (x * x - 3 * y * y))
+    return np.array(coeffs)
+
+def laplace_cdf(s):
+    """
+    CDF of standard Laplace distribution.
+    Psi(s) = 0.5 * exp(-s) if s > 0
+             1 - 0.5 * exp(s) if s <= 0
+    """
+    if s > 0:
+        return 0.5 * math.exp(-s)
+    else:
+        return 1 - 0.5 * math.exp(s)
+
+def query_3d_grid(grid_128, grid_256, grid_512, x, K=4):
+    """
+    Fetches K features per level from 3D grids using trilinear interpolation.
+    Returns the sum of features across levels.
+    """
+    # Trilinear interpolation helper
+    def trilinear_interp(grid, point):
+        # Implementation of trilinear interpolation for a 3D grid
+        # Returns a vector of size K
+        pass 
+    
+    f_128 = trilinear_interp(grid_128, x)
+    f_256 = trilinear_interp(grid_256, x)
+    f_512 = trilinear_interp(grid_512, x)
+    
+    # Sum features across levels
+    summed_3d = f_128 + f_256 + f_512
+    return summed_3d
+
+def query_triplanes(triplanes, x, K=4):
+    """
+    Fetches K features per level from triplanes using bilinear interpolation.
+    Triplanes are 2D planes (XY, YZ, XZ) at 7 resolution levels.
+    Returns the sum of features across levels.
+    """
+    # Bilinear interpolation helper
+    def bilinear_interp(plane, uv):
+        # Implementation of bilinear interpolation for a 2D plane
+        # Returns a vector of size K
+        pass
+
+    # Project 3D point x to 2D UV coordinates for each plane
+    # XY plane: (x, y)
+    # YZ plane: (y, z)
+    # XZ plane: (x, z)
+    
+    summed_tp = np.zeros(K)
+    
+    # 7 levels from 128^2 to 8192^2
+    # We assume the triplanes list contains the 3 planes for each level
+    for level in triplanes:
+        # level is a list of 3 planes: [XY, YZ, XZ]
+        xy_plane, yz_plane, xz_plane = level
+        
+        # Project x to UV
+        # Normalize coordinates to [0, 1] or [-1, 1] depending on grid definition
+        # Assuming standard [-1, 1] or [0, 1] mapping
+        uv_xy = (x[:2] + 1) / 2 # Example mapping
+        uv_yz = (x[1:] + 1) / 2
+        uv_xz = (x[[0, 2]] + 1) / 2
+        
+        f_xy = bilinear_interp(xy_plane, uv_xy)
+        f_yz = bilinear_interp(yz_plane, uv_yz)
+        f_xz = bilinear_interp(xz_plane, uv_xz)
+        
+        # Sum features across levels (and potentially planes? Source says "sum features across levels")
+        # "Sum the features across levels... concatenate... from the 3 triplanes"
+        # This implies we sum the features from the 3 planes at each level, then sum across levels?
+        # Or sum across levels for each plane?
+        # "Sum the features across levels (instead of concatenation)"
+        # Let's assume we sum the vectors from all 3 planes at each level, then sum across levels.
+        level_sum = f_xy + f_yz + f_xz
+        summed_tp += level_sum
+        
+    return summed_tp
+
+def hybrid_nerf_forward(x, d, grids, triplanes, surfaceness_grid, sdf_mlp, color_mlp):
+    """
+    Forward pass of HybridNeRF.
+    """
+    # 1. Fetch 3D features
+    summed_3d = query_3d_grid(grids['128'], grids['256'], grids['512'], x, K=4)
+    
+    # 2. Fetch Triplane features
+    summed_tp = query_triplanes(triplanes, x, K=4)
+    
+    # 3. Concatenate
+    # Source: "concatenate the summed features from the 3D grid to those from the 3 triplanes to obtain a 4K=16-dimensional MLP input"
+    # 4K = 16. K=4.
+    # If summed_3d is size 12 (3 levels * 4 features?) and summed_tp is size 4?
+    # Or summed_3d is size 4 and summed_tp is size 12?
+    # The source says "4K=16".
+    # Let's assume the concatenation results in a 16-dim vector.
+    input_vec = np.concatenate([summed_3d, summed_tp])
+    
+    # 4. Encode direction
+    sh_coeffs = spherical_harmonics_encoding(d, degree=4)
+    
+    # 5. Predict SDF
+    f = sdf_mlp(input_vec, sh_coeffs)
+    
+    # 6. Predict Color
+    c = color_mlp(input_vec, sh_coeffs)
+    
+    # 7. Get Surfaceness
+    # Nearest neighbor interpolation
+    beta = surfaceness_grid.query_nearest(x)
+    
+    # 8. Compute Density
+    s = f * beta
+    psi = laplace_cdf(s)
+    sigma = beta * psi
+    
+    return c, sigma, f, beta
+
