+def volume_render(t_values, sigmas, colors):
+    """Computes volumetric rendering matching c(r) = sum(T_i alpha_i c_i)."""
+    N = len(t_values)
+    if N == 0:
+        return np.zeros(3)
+    
+    deltas = np.zeros(N)
+    deltas[:-1] = t_values[1:] - t_values[:-1]
+    deltas[-1] = deltas[-2] if N > 1 else 0.0
+    
