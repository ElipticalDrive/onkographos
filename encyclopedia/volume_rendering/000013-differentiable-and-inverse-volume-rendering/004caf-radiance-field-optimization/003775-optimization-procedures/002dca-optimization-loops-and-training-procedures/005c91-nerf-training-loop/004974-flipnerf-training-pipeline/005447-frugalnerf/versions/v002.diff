+def volume_render(V_D, V_A, rays):
+    # Standard alpha-compositing along rays [G]
+    # rays: (batch, H, W, 3) where last dim is [origin, direction]
+    # Returns C_hat, D_hat of shape (batch, H, W, 3) and (batch, H, W, 1)
+    num_samples = 64
+    t_vals = torch.linspace(0.0, 1.0, num_samples, device=rays.device)
+    t_vals = t_vals.unsqueeze(0).unsqueeze(0).unsqueeze(0)
+    z_vals = t_vals * 2.0
+    pts = rays[:, :, :, :3].unsqueeze(1) + z_vals * rays[:, :, :, 3:6].unsqueeze(1)
+    
+    # Query densities and colors (simplified grid lookup)
+    # In practice, trilinear interpolation or hash encoding is used [G]
+    densities = torch.relu(V_D[pts.long()])
+    colors = torch.sigmoid(V_A[pts.long()])
+    
+    weights = densities * torch.exp(-densities[:, :, :, 0].cumsum(dim=1))
+    C_hat = torch.sum(weights.unsqueeze(-1) * colors, dim=1)
+    D_hat = torch.sum(weights * z_vals, dim=1, keepdim=True)
+    return C_hat, D_hat
