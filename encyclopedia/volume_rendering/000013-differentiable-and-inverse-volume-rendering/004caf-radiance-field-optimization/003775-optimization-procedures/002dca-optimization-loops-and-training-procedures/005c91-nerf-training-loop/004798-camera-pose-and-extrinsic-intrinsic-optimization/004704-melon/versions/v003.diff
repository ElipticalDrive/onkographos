+def generate_rays(intrinsics, R, T, H, W):
+    """Generates ray origins and directions for a grid of pixels using the pinhole model [G]."""
+    f = intrinsics['focal_length']
+    u, v = torch.meshgrid(torch.arange(W), torch.arange(H), indexing='xy')
+    u = (u.float() - W / 2) / f
+    v = (v.float() - H / 2) / f
+    d_cam = torch.stack([u, -v, -torch.ones_like(u)], dim=-1)
+    d_world = torch.einsum('ij, ...j -> ...i', R, d_cam)
+    d_world = d_world / torch.norm(d_world, dim=-1, keepdim=True)
+    o_world = T.expand(H, W, 3)
+    return o_world, d_world
+
+def volume_render(nerf, rays_o, rays_d, t_near, t_far, num_samples):
+    """Discrete volume rendering integral [G]."""
+    t_vals = torch.linspace(t_near, t_far, num_samples, device=rays_o.device)
+    deltas = t_vals[1:] - t_vals[:-1]
+    deltas = torch.cat([deltas, torch.tensor([0.001], device=t_vals.device)])
+    pts = rays_o.unsqueeze(1) + rays_d.unsqueeze(1) * t_vals.unsqueeze(2)
+    pts = pts.reshape(-1, 3)
+    raw = nerf(pts, rays_d.reshape(-1, 3))
+    color, density = raw[..., :3], raw[..., 3:]
+    alpha = 1.0 - torch.exp(-torch.relu(density) * deltas)
+    trans = torch.cumprod(torch.exp(-torch.relu(density) * deltas), dim=0)
+    weights = alpha * torch.cat([torch.ones_like(trans[..., :1]), trans[..., :-1]], dim=-1)
+    color = torch.sum(weights * color, dim=0)
     return color
 
