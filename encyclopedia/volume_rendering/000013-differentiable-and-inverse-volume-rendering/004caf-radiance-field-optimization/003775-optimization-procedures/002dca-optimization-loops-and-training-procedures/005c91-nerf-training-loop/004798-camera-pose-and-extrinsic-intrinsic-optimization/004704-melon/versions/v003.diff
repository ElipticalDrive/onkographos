+def pose_to_rotation(theta, phi, alpha):
+    """Converts azimuth (theta), elevation (phi), roll (alpha) to a 3x3 rotation matrix [G]."""
+    ct, st = torch.cos(theta), torch.sin(theta)
+    cp, sp = torch.cos(phi), torch.sin(phi)
+    ca, sa = torch.cos(alpha), torch.sin(alpha)
+    R = torch.zeros(3, 3, device=theta.device)
+    R[0, 0] = ct * ca - st * sp * sa
+    R[1, 0] = cp * st
+    R[2, 0] = st * ca + ct * sp * sa
+    R[0, 1] = -ct * sa - st * sp * ca
+    R[1, 1] = cp * ct
+    R[2, 1] = -st * sa + ct * sp * ca
+    R[0, 2] = st * cp
+    R[1, 2] = -sp
+    R[2, 2] = ct * cp
+    return R
 
