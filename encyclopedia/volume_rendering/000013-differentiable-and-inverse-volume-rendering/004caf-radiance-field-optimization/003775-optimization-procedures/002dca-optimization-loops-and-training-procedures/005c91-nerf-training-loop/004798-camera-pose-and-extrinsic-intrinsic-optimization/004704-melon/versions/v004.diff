+# Standard helper: Volume rendering via discrete ray marching [G]
+def volume_render(nerf, origins, directions, num_samples=128, near=0.1, far=10.0):
+    t_vals = torch.linspace(near, far, num_samples)
+    z_vals = 0.5 * (t_vals[1:] + t_vals[:-1])
+    points = origins[..., None, :] + directions[..., None, :] * z_vals[None, None, :]
+    colors, densities = nerf(points, directions[..., 0, 0, :].expand_as(points))
+    alpha = 1.0 - torch.exp(-torch.relu(densities) * (far - near) / num_samples)
+    weights = alpha * torch.cumprod(torch.ones_like(alpha) - alpha + 1e-10, dim=-2)
+    weights[..., 0] = alpha[..., 0]
+    color = torch.sum(weights * colors, dim=-2)
