+def compute_gradient(phi_g, points, t):
+    """Computes spatial gradient of SDF using finite differences [G]."""
+    eps = 1e-4
+    grad = np.zeros_like(points)
+    for i in range(3):
+        p_plus = points.copy(); p_plus[:, i] += eps
+        p_minus = points.copy(); p_minus[:, i] -= eps
+        grad[:, i] = (phi_g(p_plus, t) - phi_g(p_minus, t)) / (2 * eps)
+    return grad
+
+def compute_time_derivative(phi_g, points, t):
+    """Computes temporal derivative of SDF using finite differences [G]."""
+    eps = 1e-4
+    return (phi_g(points, t + eps) - phi_g(points, t - eps)) / (2 * eps)
+
+def bilinear_sample(image, uv):
+    """Samples image at UV coordinates [G]."""
+    h, w, _ = image.shape
+    u = (uv[:, 0] * (w - 1)).astype(int)
+    v = (uv[:, 1] * (h - 1)).astype(int)
+    u = np.clip(u, 0, w - 2)
+    v = np.clip(v, 0, h - 2)
+    x0, y0 = u, v
+    x1, y1 = x0 + 1, y0 + 1
+    w0 = (x1 - uv[:, 0]) * (y1 - uv[:, 1])
+    w1 = (uv[:, 0] - x0) * (y1 - uv[:, 1])
+    w2 = (x1 - uv[:, 0]) * (uv[:, 1] - y0)
+    w3 = (uv[:, 0] - x0) * (uv[:, 1] - y0)
+    return (w0[:, None] * image[y0, x0] + w1[:, None] * image[y0, x1] + 
+            w2[:, None] * image[y1, x0] + w3[:, None] * image[y1, x1])
