+def volume_render(phi_g, phi_c, origins, directions, t, K_samples=128):
+    """Computes rendered color and surface point via discrete volume rendering [G]."""
+    depths = np.linspace(0.0, 5.0, K_samples)
+    points = origins[:, None, :] + directions[:, None, :] * depths[None, None, :]
+    sdfs = phi_g(points.reshape(-1, 3), t).reshape(origins.shape[0], K_samples)
+    colors = phi_c(points.reshape(-1, 3), directions[:, None, :], t).reshape(origins.shape[0], K_samples, 3)
+    alphas = 1.0 - np.exp(-sdfs)
+    weights = alphas * np.cumprod(np.concatenate([np.ones((origins.shape[0], 1)), 1.0 - alphas[:, :-1]], axis=1), axis=1)
+    rendered_colors = np.sum(weights[:, :, None] * colors, axis=1)
+    surface_points = np.sum(weights[:, :, None] * points, axis=1)
+    normals = np.zeros_like(points)
+    return rendered_colors, surface_points, sdfs, normals
