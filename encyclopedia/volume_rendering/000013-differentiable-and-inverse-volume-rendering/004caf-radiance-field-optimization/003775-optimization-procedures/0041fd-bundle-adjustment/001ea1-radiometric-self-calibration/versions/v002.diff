+class AdamOptimizer:
+    def __init__(self, params, lr):
+        self.params = params
+        self.lr = lr
+        self.t = 0
+        self.m = {id(p): 0.0 for p in params}
+        self.v = {id(p): 0.0 for p in params}
+    def zero_grad(self):
+        for p in self.params:
