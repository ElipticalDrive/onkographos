+def train_DNGaussian(input_images, camera_poses, num_iterations=6000, soft_start_iter=1000):
+    # 1. Initialization
+    # Randomly initialize Gaussians (mu, s, q, alpha)
+    gaussians = RandomInitializeGaussians()
+    
+    # Initialize Neural Color Renderer (Hash Encoder + MLP)
+    color_renderer = NeuralColorRenderer(levels=16, res_range=(16, 512), max_size=2**19, mlp_layers=5, hidden_dim=64)
+    
+    # Predict monocular depth maps using DPT
+    mono_depth_maps = DPT_Predict(input_images)
+    
+    # Parameters
+    tau = 0.95  # Hard depth opacity
+    gamma = 0.1 # Global loss weight
+    
+    for iter in range(1, num_iterations + 1):
+        # 2. Color Supervision (Standard 3DGS optimization)
+        # Render color using Neural Color Renderer
+        rendered_color = RenderColor(gaussians, color_renderer, camera_poses)
+        
+        # Calculate Color Loss
+        L_color = L1_Loss(rendered_color, input_images) + Lambda_LDDSSIM(rendered_color, input_images)
+        
+        # Backpropagate color loss to update Gaussians (mu, s, q, alpha) and Color Renderer
+        # Note: Standard 3DGS duplication/removal happens here
+        Optimizer.step(L_color)
+        
+        # 3. Depth Regularization
+        # Freeze parameters based on phase
+        if iter <= soft_start_iter:
+            # Hard Depth Phase
+            FreezeParameters(gaussians, freeze=['s', 'q'])
+            # Set temporary opacity tau for hard depth rendering
+            hard_depth = RenderHardDepth(gaussians, tau, camera_poses)
+            
+            # Calculate Hard Depth Loss with Global-Local Normalization
+            R_hard = GlobalLocalDepthLoss(hard_depth, mono_depth_maps, gamma=gamma)
+            
+            # Backpropagate hard depth loss to update mu and alpha
+            Optimizer.step(R_hard)
+            
+        else:
+            # Soft Depth Phase
+            # Freeze centers mu
+            FreezeParameters(gaussians, freeze=['mu'])
+            
+            # Render soft depth using current opacities
+            soft_depth = RenderSoftDepth(gaussians, camera_poses)
+            
+            # Calculate Soft Depth Loss with Global-Local Normalization
+            R_soft = GlobalLocalDepthLoss(soft_depth, mono_depth_maps, gamma=gamma)
+            
+            # Backpropagate soft depth loss to update alpha
+            Optimizer.step(R_soft)
+            
+        # Unfreeze parameters for next iteration if needed (though hard phase freezes s,q and soft phase freezes mu)
+        # Note: The paper implies specific freezing during the respective regularization steps.
+        # In practice, gradients are masked or parameters are detached during the specific loss calculation.
+
+def RenderHardDepth(gaussians, tau, camera_poses):
+    # For each ray, set opacity to tau
+    # D_hard(xp) = sum_{i in N} tau * (1 - tau)^(i-1) * G_proj_i(xp) * ||mu_i - o||_2
+    depth = 0.0
+    for ray in rays:
+        hit_gaussians = SortByDistance(ray.origin, gaussians)
+        for i, g in enumerate(hit_gaussians):
+            weight = tau * ((1 - tau) ** i)
+            depth += weight * g.projected_area * distance(g.mu, ray.origin)
+    return depth
+
+def RenderSoftDepth(gaussians, camera_poses):
+    # D_soft(xp) = sum_{i in N} ||mu_i - o||_2 * alpha_i * product_{j=1}^{i-1} (1 - alpha_j)
+    depth = 0.0
+    for ray in rays:
+        hit_gaussians = SortByDistance(ray.origin, gaussians)
+        transmittance = 1.0
+        for i, g in enumerate(hit_gaussians):
+            alpha = g.alpha
+            depth += distance(g.mu, ray.origin) * alpha * transmittance
+            transmittance *= (1 - alpha)
+    return depth
+
+def GlobalLocalDepthLoss(rendered_depth, mono_depth, gamma):
+    # Compute Global Normalized Depth (GN) and Local Normalized Depth (LN)
+    # This involves normalizing the depth maps to handle scale differences and emphasize local changes
+    D_GN, D_LN = NormalizeDepth(rendered_depth)
+    D_tilde_GN, D_tilde_LN = NormalizeDepth(mono_depth)
+    
+    # L2 Loss with error tolerance
+    loss = L2_Loss(D_GN, D_tilde_GN) + gamma * L2_Loss(D_LN, D_tilde_LN)
+    return loss
+```
