+def train_steganerf(images, poses, hidden_info, eta0, eta1, lam0, lam1, lam2, lam3, alpha=3, pretrain_epochs=1000, joint_epochs=5000):
+    theta = initialize_nerf()
+    F_psi = initialize_detector()
+    
+    # Step 2: Pre-training
+    for epoch in range(pretrain_epochs):
+        for i in range(len(images)):
+            render = theta(poses[i])
+            loss = L_rgb(render, images[i])
+            theta.update(loss, eta0)
+            
+    # Step 3: Mask Computation
+    w = abs(theta) ** alpha / sum(abs(theta) ** alpha)
+    m = w
+    
+    # Step 4: Joint Optimization Loop
+    for t in range(joint_epochs):
+        i = random.randint(0, len(images) - 1)
+        P = poses[i]
+        Y = images[i]
+        render = theta(P)
+        
+        # Step 4c: Steganographic Losses (Eq 1, 2)
+        L_cdec = compute_classifier_loss(render, hidden_info)
+        L_plus_dec = compute_positive_detection_loss(render, hidden_info)
+        L_dec = compute_negative_detection_loss(render, hidden_info)
+        
+        # Step 4d: Photometric Loss (Eq 4)
+        L_rgb = norm(render - Y)
+        
+        # Step 4e: Total Loss (Eq 5)
+        L = lam0 * L_cdec + lam1 * L_plus_dec + lam2 * L_dec + lam3 * L_rgb
+        
+        # Step 4f: Update Detector
+        F_psi.update(grad(L, F_psi), eta1)
+        
+        # Step 4g: Update NeRF
+        theta.update(grad(L, theta) * m, eta0)
+        
+    return theta, F_psi
