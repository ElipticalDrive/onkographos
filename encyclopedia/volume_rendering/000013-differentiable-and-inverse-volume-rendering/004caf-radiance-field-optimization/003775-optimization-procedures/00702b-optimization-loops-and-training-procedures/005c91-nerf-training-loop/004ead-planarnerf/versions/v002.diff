+    best_inliers = 0
+    best_params = np.array([0.0, 0.0, 1.0, 0.0])
+    for _ in range(iterations):
+        idx = np.random.choice(len(points), 3, replace=False)
+        p1, p2, p3 = points[idx]
+        normal = np.cross(p2 - p1, p3 - p1)
+        norm = np.linalg.norm(normal)
+        if norm < 1e-6: continue
+        normal /= norm
