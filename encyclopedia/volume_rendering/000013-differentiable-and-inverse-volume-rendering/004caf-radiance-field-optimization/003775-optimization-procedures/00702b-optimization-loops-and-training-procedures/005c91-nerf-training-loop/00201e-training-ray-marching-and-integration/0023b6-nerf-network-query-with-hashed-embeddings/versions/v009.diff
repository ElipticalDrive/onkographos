 import torch.nn as nn
 
+def get_grid_coords(x, level):
+    """Discretize continuous positions to integer grid coordinates for a given resolution level."""
+    # Scale by 2^level and floor to get integer grid indices
+    res = 2 ** level
+    return torch.floor(x * res + 0.5).long()
+
+def hash_function(coords, table_size):
+    """Map 3D integer coordinates to hash table indices using a polynomial hash."""
+    idx = (coords[..., 0] * 73856093 ^ coords[..., 1] * 19349663 ^ coords[..., 2] * 83492791) % table_size
+    return idx
+
+def compute_spherical_harmonics(d, degree=4):
+    """Compute the first 16 coefficients of the spherical harmonics basis for unit vectors."""
+    # Standard SH basis computation for degree 0 to 4 (16 coefficients)
+    # d shape: [N, 3], normalized to unit length
+    d = d / (torch.norm(d, dim=-1, keepdim=True) + 1e-8)
+    x, y, z = d[..., 0], d[..., 1], d[..., 2]
+    # Simplified SH basis evaluation (degree 0-4)
+    sh = torch.zeros(d.shape[0], 16, device=d.device)
+    sh[:, 0] = 0.282095
+    sh[:, 1] = -0.488603 * y
+    sh[:, 2] = 0.488603 * z
+    sh[:, 3] = -0.488603 * x
+    sh[:, 4] = 1.092548 * x * y
+    sh[:, 5] = -1.092548 * y * z
+    sh[:, 6] = 0.315392 * (3 * z**2 - 1)
+    sh[:, 7] = -1.092548 * x * z
+    sh[:, 8] = 0.546274 * (x**2 - y**2)
+    sh[:, 9] = 0.590592 * y * (3 * x**2 - y**2)
+    sh[:, 10] = -2.890611 * x * y * z
+    sh[:, 11] = 0.457045 * y * (5 * z**2 - 1)
+    sh[:, 12] = 3.731763 * z * (5 * z**2 - 3)
+    sh[:, 13] = -0.457045 * x * (5 * z**2 - 1)
+    sh[:, 14] = 1.445306 * x * z * (x**2 - 3 * y**2)
+    sh[:, 15] = -0.590592 * y * (x**2 - 3 * y**2)
+    return sh
+
