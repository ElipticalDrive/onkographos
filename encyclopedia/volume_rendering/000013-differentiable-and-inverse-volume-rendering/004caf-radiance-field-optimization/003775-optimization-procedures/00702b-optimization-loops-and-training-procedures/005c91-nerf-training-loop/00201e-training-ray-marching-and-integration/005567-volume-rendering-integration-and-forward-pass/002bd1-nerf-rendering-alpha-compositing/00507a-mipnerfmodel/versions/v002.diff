+                raw_density += self.density_noise * random.normal(key, raw_density.shape, dtype=raw_density.dtype)
+            
+            rgb = self.rgb_activation(raw_rgb)
+            rgb = rgb * (1 + 2 * self.rgb_padding) - self.rgb_padding
+            density = self.density_activation(raw_density + self.density_bias)
+            
+            comp_rgb, distance, acc, weights = volumetric_rendering(
+                rgb=rgb, density=density, t_vals=t_vals,
+                directions=rays.directions, white_bkgd=white_bkgd,
+            )
+            
+            rgb_out = isp(comp_rgb, rays.temperature, rays.exposure)
+            ret.append((rgb_out, distance, acc))
+            
+            prev_t_vals = t_vals
+            prev_weights = weights
+            
         return ret
