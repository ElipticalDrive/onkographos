+class AdamOptimizer:
+    def __init__(self, params, lr):
+        self.params = params
+        self.lr = lr
+        self.m = {p: torch.zeros_like(p) for p in params}
+        self.v = {p: torch.zeros_like(p) for p in params}
+    def zero_grad(self):
+        for p in self.params:
+            if p.grad is not None:
+                p.grad.detach_()
+                p.grad.zero_()
+    def step(self):
+        for p in self.params:
+            if p.grad is None: continue
+            g = p.grad
+            self.m[p] = 0.9 * self.m[p] + 0.1 * g
+            self.v[p] = 0.999 * self.v[p] + 0.001 * (g ** 2)
+            p -= self.lr * self.m[p] / (torch.sqrt(self.v[p]) + 1e-8)
