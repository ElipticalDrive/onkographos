+class HashEncodedNeRF(nn.Module):
+    """Implicit neural radiance field using hash encoding for spatial hashing [G]."""
+    def __init__(self):
+        super().__init__()
+        # Hash grid and MLPs for density and color [G]
+        self.density_mlp = nn.Sequential(nn.Linear(3, 128), nn.ReLU(), nn.Linear(128, 1))
+        self.color_mlp = nn.Sequential(nn.Linear(3, 128), nn.ReLU(), nn.Linear(128, 3))
+
+    def forward(self, x):
+        # Query hash grid and interpolate features [G]
+        sigma = torch.relu(self.density_mlp(x))
+        c = torch.sigmoid(self.color_mlp(x))
+        return sigma, c
+
+class UNet(nn.Module):
+    """Convolutional neural network for processing equirectangular images [G]."""
+    def __init__(self):
+        super().__init__()
+        self.conv1 = nn.Conv2d(3, 64, 3, padding=1)
+        self.conv2 = nn.Conv2d(64, 3, 3, padding=1)
+        self.relu = nn.ReLU()
+        self.sigmoid = nn.Sigmoid()
+
+    def forward(self, x):
+        # Process equirectangular projection to correct raydrop and alignment [S1]
+        return self.sigmoid(self.conv2(self.relu(self.conv1(x))))
+
+def render_volume(rays_o, rays_d, t_vals, nerf_model):
+    """Render color and depth using volume rendering equations [S1]."""
+    # Sample points along rays: r = o + t*d
+    points = rays_o[:, None, :] + t_vals[None, :, None] * rays_d[:, None, :]
+    points_flat = points.reshape(-1, 3)
+    
+    # Query NeRF for density and color
+    sigma_flat, c_flat = nerf_model(points_flat)
+    sigma = sigma_flat.reshape(rays_o.shape[0], -1)
+    c = c_flat.reshape(rays_o.shape[0], -1, 3)
+    
+    # Compute deltas: delta_j = t_{j+1} - t_j
+    delta = t_vals[1:] - t_vals[:-1]
+    delta = torch.cat([delta, torch.tensor([1e10], device=t_vals.device)], dim=0)
+    
+    # Compute transmittance: T_i = exp(-sum_{j=1}^{i-1} sigma_j * delta_j)
+    alpha = 1.0 - torch.exp(-sigma * delta)
+    T = torch.cumprod(torch.exp(-sigma * delta), dim=1)
+    T = torch.cat([torch.ones_like(T[:, :1]), T[:, :-1]], dim=1)
+    
+    # Render color: C_hat(r) = sum_i T_i (1 - exp(-sigma_i delta_i)) c_i
+    weights = alpha * T
+    C_hat = torch.sum(weights[:, :, None] * c, dim=1)
+    
+    # Render depth: D_hat(r) = sum_i T_i (1 - exp(-sigma_i delta_i)) z_i
+    z = t_vals
+    D_hat = torch.sum(weights * z, dim=1)
+    
+    return C_hat, D_hat, T, alpha, delta
