 import math
 
+def ray_aabb_intersect(origin, direction, b_min, b_max):
+    """Compute intersection of ray with AABB. Returns (t_near, t_far)."""
+    t1 = (b_min - origin) / direction
+    t2 = (b_max - origin) / direction
+    t_near = torch.max(torch.min(t1, t2))
+    t_far = torch.min(torch.max(t1, t2))
+    return t_near, t_far
+
+def positional_encoding(x, num_frequencies=10):
+    """Standard NeRF positional encoding [G]."""
+    x = x.unsqueeze(-1)
+    scales = torch.tensor([2**i for i in range(num_frequencies)], dtype=x.dtype, device=x.device)
+    shaped = x * (math.pi * scales).reshape(1, 1, -1)
+    return torch.cat([torch.sin(shaped), torch.cos(shaped)], dim=-1).reshape(x.shape[0], -1)
