+def inverse_projection(K, R, t, depth):
+    # Computes 3D world coordinates [H, W, 3] from depth and camera parameters
+    H, W = shape(depth)
+    # Create pixel grid coordinates
+    u_coords = [w for h in range(H) for w in range(W)]
+    v_coords = [h for h in range(H) for w in range(W)]
+    # Homogeneous pixel coordinates [H*W, 3]
+    pixel_coords = [[u, v, 1.0] for u, v in zip(u_coords, v_coords)]
+    # Inverse projection: X_cam = K^{-1} * [u, v, 1]^T * depth
+    K_inv = matrix_inverse(K)
+    cam_coords = []
+    for i in range(H * W):
+        p = pixel_coords[i]
+        d = depth[p[1]][p[0]]
+        cam_coords.append(vector_scale(matrix_vector_multiply(K_inv, p), d))
+    # Transform to world coordinates: X_world = R^{-1} * (X_cam - t)
+    R_inv = matrix_inverse(R)
+    world_coords = []
+    for i in range(H * W):
+        cam = cam_coords[i]
+        world_coords.append(vector_add(matrix_vector_multiply(R_inv, cam), vector_scale(t, -1.0)))
+    # Reshape to [H, W, 3]
+    return [[world_coords[h * W + w] for w in range(W)] for h in range(H)]
+
+def register_features(C_t, q_xyz, s):
+    # Aggregates features C_t into grid m based on world coordinates q_xyz
+    H, W, D = shape(C_t)
+    grid_buckets = {}
+    for h in range(H):
+        for w in range(W):
+            c = C_t[h][w]
+            qx, qy = q_xyz[h][w][0], q_xyz[h][w][1]
+            u = int(round(qx / s))
+            v = int(round(qy / s))
+            key = (u, v)
+            if key not in grid_buckets:
+                grid_buckets[key] = []
+            grid_buckets[key].append(c)
+    m = {}
+    for key, features in grid_buckets.items():
+        n = len(features)
+        if n > 0:
+            m[key] = vector_mean(features)
+        else:
+            m[key] = [0.0] * D
+    return m
+
+def compute_loss(rendered, target):
+    return mean(abs(rendered - target))
+
+def apply_gradients(theta_enc, theta_dec, loss, lr):
+    # Standard gradient descent update
+    grad_enc = gradient(loss, theta_enc)
+    grad_dec = gradient(loss, theta_dec)
+    theta_enc = theta_enc - lr * grad_enc
+    theta_dec = theta_dec - lr * grad_dec
+    return theta_enc, theta_dec
