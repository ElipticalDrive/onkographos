+**Pseudocode:**
+```python
+def multi_view_aggregation(x, C, t, images, cameras, smpl_model, direction_d):
+    # 1. Retrieve skeletal features
+    x_smpl = transform_to_smpl_space(x, smpl_model)
+    s0 = trilinear_interpolate_sparseconvnet(x_smpl, smpl_model.sparse_convnet)  # Shape: (C, d)
+
+    # 2. Sample pixel-aligned features
+    px = []
+    for c in range(C):
+        uv = project_to_image_plane(x, cameras[c])
+        px.append(sample_image_feature(images[c], uv))  # Shape: (C, d)
+    px = torch.stack(px)
+
+    # 3. Construct attention weights
+    k_s = linear_keys(s0)  # Shape: (C, d)
+    k_p = linear_keys(px)  # Shape: (C, d)
+    attn_logits = (k_s @ k_p.T) / math.sqrt(d)
+    mv_att = softmax(attn_logits, dim=1)  # Shape: (C, C)
+
+    # 4. Compute view-wise representation
+    v_s = linear_values(s0)  # Shape: (C, d)
+    v_p = linear_values(px)  # Shape: (C, d)
+    z_view = mv_att @ v_p + v_s  # Shape: (C, d)
+
+    # 5. Compute meta representation
+    z_meta = torch.mean(z_view, dim=0)  # Shape: (d)
+
+    # 6. Predict density
+    sigma = mlp_sigma(z_meta)  # Shape: (1,)
+
+    # 7. Predict color
+    v_p_mean = torch.mean(v_p, dim=0)  # Shape: (d)
+    gamma_d = positional_encoding_direction(direction_d)  # Shape: (6*l,)
+    rgb = mlp_rgb(torch.cat([v_p_mean, gamma_d], dim=-1))  # Shape: (3,)
+
+    return sigma, rgb
+```
 
