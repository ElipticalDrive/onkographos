+def hierarchical_pos_enc(p, L=10):
+    """
+    Hierarchical positional encoding as defined in parent article.
+    gamma(p) = (sin(2^0 pi p), cos(2^0 pi p), ..., sin(2^{L-1} pi p), cos(2^{L-1} pi p))
+    """
+    encodings = []
+    for i in range(L):
+        freq = 2**i * np.pi
+        encodings.append(np.sin(freq * p))
+        encodings.append(np.cos(freq * p))
+    return np.concatenate(encodings)
