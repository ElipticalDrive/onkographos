+    # L_offset = mean(delta_x^2)
+    # L_offset = torch.mean(glass_net_outputs_delta_x ** 2) 
+    
+    L = L_render + epsilon * L_offset
+    
+    optimizer.zero_grad()
+    L.backward()
+    optimizer.step()
