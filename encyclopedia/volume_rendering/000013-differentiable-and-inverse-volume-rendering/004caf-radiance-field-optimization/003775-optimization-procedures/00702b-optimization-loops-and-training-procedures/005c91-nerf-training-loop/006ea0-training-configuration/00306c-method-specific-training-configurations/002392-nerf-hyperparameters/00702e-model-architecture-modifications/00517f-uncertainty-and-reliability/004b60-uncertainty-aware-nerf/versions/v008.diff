+        losses['color'] = weight_term * color_nll
+        
+    if gt_depth is not None:
+        # NLL for depth
+        sigma_z = torch.sqrt(rendered_var_depth + eps)
+        depth_nll = (gt_depth - rendered_depth)**2 / (2 * rendered_var_depth + eps) + torch.log(sigma_z)
+        losses['depth'] = depth_nll
