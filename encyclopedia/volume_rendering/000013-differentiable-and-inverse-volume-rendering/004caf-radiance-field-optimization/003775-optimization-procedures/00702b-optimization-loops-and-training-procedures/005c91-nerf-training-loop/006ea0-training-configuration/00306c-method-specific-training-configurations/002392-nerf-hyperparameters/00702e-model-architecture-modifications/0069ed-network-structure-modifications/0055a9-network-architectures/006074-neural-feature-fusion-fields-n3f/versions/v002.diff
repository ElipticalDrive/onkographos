+def volume_render(points, directions, sigma, rgb_features, t_near, t_far, num_samples):
+    """Standard differentiable volume rendering for color and features."""
+    # Sample points along rays
+    t_vals = torch.linspace(0, 1, num_samples)
+    t_samples = t_near + t_vals * (t_far - t_near)
+    
+    # Compute deltas between samples
