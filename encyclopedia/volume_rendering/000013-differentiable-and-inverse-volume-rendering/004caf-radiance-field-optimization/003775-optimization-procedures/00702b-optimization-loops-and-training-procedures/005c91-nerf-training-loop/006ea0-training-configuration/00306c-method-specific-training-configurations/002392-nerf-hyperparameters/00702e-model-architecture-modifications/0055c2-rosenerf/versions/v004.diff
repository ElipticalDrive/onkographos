 import torch.nn.functional as F
 
+class SpatialMLP(nn.Module):
+    def __init__(self, hidden_dim=256):
+        super().__init__()
+        self.net = nn.Sequential(
+            nn.Linear(6 * 2 * 3, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, 1)  # Outputs density sigma
+        )
+    def forward(self, x):
+        return self.net(x)
+
+class DirectionalMLP(nn.Module):
+    def __init__(self, hidden_dim=256):
+        super().__init__()
+        self.net = nn.Sequential(
+            nn.Linear(hidden_dim + 3, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, 3)  # Outputs color c
+        )
+    def forward(self, sigma, d):
+        return self.net(torch.cat([sigma, d], dim=-1))
+
+class StudentRefNet(nn.Module):
+    def __init__(self, layers=2, hidden=64):
+        super().__init__()
+        self.net = nn.Sequential(
+            nn.Linear(4, hidden), nn.ReLU(),
+            nn.Linear(hidden, hidden), nn.ReLU(),
+            nn.Linear(hidden, 4)
+        )
+    def forward(self, lf):
+        return self.net(lf)
+
+class TeacherRefNet(nn.Module):
+    def __init__(self, layers=3, hidden=128):
+        super().__init__()
+        self.net = nn.Sequential(
+            nn.Linear(5, hidden), nn.ReLU(),
+            nn.Linear(hidden, hidden), nn.ReLU(),
+            nn.Linear(hidden, hidden), nn.ReLU(),
+            nn.Linear(hidden, 4)
+        )
+    def forward(self, lf, n):
+        return self.net(torch.cat([lf, n], dim=-1))
+
+class DecoderMLP(nn.Module):
+    def __init__(self, layers=2, hidden=256):
+        super().__init__()
+        self.net = nn.Sequential(
+            nn.Linear(2, hidden), nn.ReLU(),
+            nn.Linear(hidden, hidden), nn.ReLU(),
+            nn.Linear(hidden, 1)
+        )
+    def forward(self, sigma_orig, sigma_refr):
+        return self.net(torch.cat([sigma_orig, sigma_refr], dim=-1))
+
