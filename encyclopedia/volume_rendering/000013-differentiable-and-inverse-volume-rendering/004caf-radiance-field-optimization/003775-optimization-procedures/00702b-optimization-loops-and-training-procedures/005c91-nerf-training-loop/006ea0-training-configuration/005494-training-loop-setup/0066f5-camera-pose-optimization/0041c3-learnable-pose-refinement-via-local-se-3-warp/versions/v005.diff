 import torch
 import torch.nn as nn
+
+def se3_to_SE3(lie_algebra):
+    """Convert SE(3) Lie algebra vector to 4x4 matrix [G]."""
+    omega = lie_algebra[..., :3]
+    trans = lie_algebra[..., 3:]
+    w = torch.stack([
+        torch.zeros_like(omega[..., 0]), -omega[..., 2], omega[..., 1],
+        omega[..., 2], torch.zeros_like(omega[..., 0]), -omega[..., 0],
+        -omega[..., 1], omega[..., 0], torch.zeros_like(omega[..., 0])
+    ], dim=-1).reshape(*lie_algebra.shape[:-1], 3, 3)
+    theta = torch.norm(omega, dim=-1, keepdim=True)
+    I3 = torch.eye(3, device=lie_algebra.device).unsqueeze(0).unsqueeze(0)
+    R = I3 + torch.sin(theta).unsqueeze(-1) * w + (1 - torch.cos(theta)).unsqueeze(-1) * torch.bmm(w, w)
+    S = I3 * theta + (1 - torch.cos(theta)).unsqueeze(-1) * w + (theta - torch.sin(theta)).unsqueeze(-1) * torch.bmm(w, w)
+    T = torch.bmm(S, trans.unsqueeze(-1)).squeeze(-1)
+    M = torch.cat([torch.cat([R, T.unsqueeze(-1)], dim=-1),
+                   torch.tensor([[[0, 0, 0, 1]]], device=lie_algebra.device).expand(*lie_algebra.shape[:-1], 1, 4)], dim=-2)
+    return M
+
+def gather_camera_cords_grid_3D(initial_pose, intr_inv, ray_indices, batch_size):
+    """Gather 3D camera coordinates for sampled rays [G]."""
+    ones = torch.ones(ray_indices.shape[0], ray_indices.shape[1], 1, device=ray_indices.device)
+    uv1 = torch.cat([ray_indices.float(), ones], dim=-1)
+    cam_coords = torch.bmm(uv1, intr_inv.transpose(-1, -2))
+    cam_coords_homo = torch.cat([cam_coords, torch.ones_like(cam_coords[..., :1])], dim=-1)
+    pose_inv = torch.inverse(initial_pose)
+    world_coords = torch.bmm(cam_coords_homo, pose_inv.transpose(-1, -2))
+    return world_coords[..., :3]
 
