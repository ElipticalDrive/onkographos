 import torch.nn as nn
 import torch.nn.functional as F
+
+def positional_encoding(x, num_frequencies=3):
+    """Standard NeRF sinusoidal positional encoding [G]."""
+    scales = torch.tensor([2**i for i in range(num_frequencies)], dtype=x.dtype, device=x.device)
+    scaled_x = x.unsqueeze(-1) * scales
+    return torch.cat([torch.sin(scaled_x), torch.cos(scaled_x)], dim=-1)
+
+def directional_encoding(d, degree=4):
+    """Spherical harmonics directional encoding [G]."""
+    # Simplified to sinusoidal encoding for self-containment; standard SH uses associated Legendre polynomials
+    return positional_encoding(d, num_frequencies=degree)
+
+def trilinear_interp(grid, coords):
+    """Standard trilinear interpolation via grid_sample [G]."""
+    # grid: (C, H, W, D), coords: (N, 3) normalized to [-1, 1]
+    return F.grid_sample(grid.unsqueeze(0).unsqueeze(0), coords.unsqueeze(0).unsqueeze(0), 
+                         mode='trilinear', padding_mode='zeros').squeeze()
+
+def bilinear_interp(grid, coords):
+    """Standard bilinear interpolation via grid_sample [G]."""
+    # grid: (C, H, W), coords: (N, 2) normalized to [-1, 1]
+    return F.grid_sample(grid.unsqueeze(0).unsqueeze(0), coords.unsqueeze(0).unsqueeze(0), 
+                         mode='bilinear', padding_mode='zeros').squeeze()
 
