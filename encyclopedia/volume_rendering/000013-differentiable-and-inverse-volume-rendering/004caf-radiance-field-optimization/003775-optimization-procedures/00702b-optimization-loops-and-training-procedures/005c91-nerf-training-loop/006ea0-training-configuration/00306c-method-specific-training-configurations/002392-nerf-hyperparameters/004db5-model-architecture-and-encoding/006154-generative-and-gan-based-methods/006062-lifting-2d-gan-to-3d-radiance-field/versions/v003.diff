+class FeatureExtractor(nn.Module):
+    """2D CNN mapping constant input to three orthogonal feature planes conditioned on z."""
+    def __init__(self, latent_dim, feature_dim):
+        super().__init__()
+        self.conv = nn.Conv2d(latent_dim, feature_dim * 3, kernel_size=3, padding=1)
+    def forward(self, z):
+        # z: (B, latent_dim, 1, 1) -> feature planes: (B, feature_dim*3, H, W)
+        return self.conv(z).chunk(3, dim=1)
+
+class SIRENMLP(nn.Module):
+    """Single-layer SIREN-based MLP conditioned on z."""
+    def __init__(self, in_dim, hidden_dim):
+        super().__init__()
+        self.linear = nn.Linear(in_dim, hidden_dim)
+        self.sigma = nn.Parameter(torch.tensor(30.0))
+    def forward(self, x, z):
+        # SIREN activation: sin(sigma * x)
+        out = torch.sin(self.sigma * self.linear(x))
+        return out
+
+def sample_pose_latent(pose_latent_pairs):
+    """Returns a random pose latent from the precomputed set."""
+    return pose_latent_pairs[np.random.randint(len(pose_latent_pairs))]
+
+def sample_rays_from_pose(azimuth, elevation, cam_dist=5.0):
+    """Generates ray origin and direction from spherical coordinates."""
+    alpha = np.deg2rad(azimuth)
+    beta = np.deg2rad(elevation)
+    ox = cam_dist * np.cos(beta) * np.cos(alpha)
+    oy = cam_dist * np.sin(beta)
+    oz = cam_dist * np.cos(beta) * np.sin(alpha)
+    o = np.array([ox, oy, oz])
+    d = -o / np.linalg.norm(o)
+    return o, d
+
