+class PCD(nn.Module):
+    def __init__(self, layer_dim):
+        super().__init__()
+        # Three consecutive fully-connected layers
+        self.fc1 = nn.Linear(F_dim, 256)
+        self.fc2 = nn.Linear(256, 128)
+        self.fc3 = nn.Linear(128, layer_dim[0] * layer_dim[1]) # For params
+        self.fc_mask = nn.Linear(128, layer_dim[0] * layer_dim[1]) # For mask
+        
+        # For large layers, use down-sized output with upscaling
+        # This is a simplified representation of the mitigation strategy
+        self.down_fc = nn.Linear(128, 64)
+        self.up_fc = nn.Linear(64, layer_dim[0] * layer_dim[1])
+        
+    def decode_params(self, F):
+        # Flatten F
+        F_flat = F.view(F.size(0), -1)
+        x = F.relu(self.fc1(F_flat))
+        x = F.relu(self.fc2(x))
+        # Down-sized output
+        x_down = self.down_fc(x)
+        # Upscale
+        x_up = self.up_fc(x_down)
+        # Element-wise multiply with optimized full-sized matrices (randomly initialized)
+        # This part is handled by the layer_variant_codes fusion in the main class
+        # Here we just return the base parameters
+        Wd = x_up.view(-1, self.layer_dim[0], self.layer_dim[1])
+        return Wd
+
+    def decode_mask(self, F):
+        F_flat = F.view(F.size(0), -1)
+        x = F.relu(self.fc1(F_flat))
+        x = F.relu(self.fc2(x))
+        M_soft = self.fc_mask(x)
+        return M_soft
