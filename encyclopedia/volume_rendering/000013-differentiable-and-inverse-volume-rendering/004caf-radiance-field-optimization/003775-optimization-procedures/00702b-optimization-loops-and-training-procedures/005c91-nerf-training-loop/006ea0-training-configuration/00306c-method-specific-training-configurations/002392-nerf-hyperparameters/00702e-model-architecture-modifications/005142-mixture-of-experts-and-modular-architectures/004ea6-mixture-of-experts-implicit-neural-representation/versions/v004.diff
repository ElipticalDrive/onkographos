+        mse_per_expert = (all_preds - v_gt_expanded) ** 2 # (B, k, 1)
+        weighted_mse = probs.unsqueeze(-1) * mse_per_expert # (B, k, 1)
+        loss = weighted_mse.sum(dim=1).mean() # Mean over batch
+        
