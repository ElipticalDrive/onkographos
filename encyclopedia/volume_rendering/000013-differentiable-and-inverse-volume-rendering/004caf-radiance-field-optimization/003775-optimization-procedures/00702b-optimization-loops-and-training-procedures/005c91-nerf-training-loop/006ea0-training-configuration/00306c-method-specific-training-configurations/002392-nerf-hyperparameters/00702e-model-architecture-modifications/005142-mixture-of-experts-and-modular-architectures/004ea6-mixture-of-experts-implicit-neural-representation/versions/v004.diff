+        # 4. Loss Calculation
+        # L = sum_j p_j * ||v_j - v||^2
+        # probs: (B, k), all_preds: (B, k, 1), v_gt: (B, 1)
+        # Expand v_gt to (B, k, 1)
+        v_gt_expanded = v_gt.unsqueeze(1).expand_as(all_preds)
