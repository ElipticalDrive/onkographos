+def l_infinity_contraction(x):
+    """
+    Compresses unbounded 3D coordinates into a cube [-1, 1]^3 using L-infinity norm.
+    Inspired by Mip-NeRF 360 but uses L_inf for cube alignment with Hash Encoding.
+    """
+    norm_inf = np.max(np.abs(x), axis=-1, keepdims=True)
+    # Avoid division by zero
+    norm_inf = np.maximum(norm_inf, 1e-8)
+    
+    # If norm <= 1, return x. If norm > 1, apply contraction formula.
+    # Formula: sgn(x) * (2 - 1/||x||_inf)
+    # Note: The source describes this as twisting space into a fixed volume.
+    # Standard L_inf contraction maps ||x||_inf > 1 to the boundary.
+    
+    mask = norm_inf > 1.0
+    x_contracted = np.where(mask, 
+                            np.sign(x) * (2.0 - 1.0 / norm_inf), 
+                            x)
+    return x_contracted
+
