+def expmap_se3(delta):
+    """Exponential map from se(3) to SE(3) [G]."""
+    w = delta[:3]
+    v = delta[3:]
+    theta = np.linalg.norm(w)
+    if theta < 1e-8:
+        R = np.eye(3)
+        t = v
+    else:
+        w_hat = np.array([[0, -w[2], w[1]],
+                          [w[2], 0, -w[0]],
+                          [-w[1], w[0], 0]])
+        R = np.eye(3) + np.sin(theta) * w_hat + (1 - np.cos(theta)) * (w_hat @ w_hat)
+        # V matrix approximation for small theta
+        V = np.eye(3) + (1 - np.cos(theta)) / (theta**2) * w_hat + (theta - np.sin(theta)) / (theta**3) * (w_hat @ w_hat)
+        t = V @ v
+    return np.vstack([np.hstack([R, t[:, np.newaxis]]), np.array([0, 0, 0, 1])])
+
