+# [G] Construct rotation matrix R that points from camera center t to focus point fp
+def compute_rotation(up_axis, focus_point, camera_center):
+    # Standard look-at matrix construction
+    forward = [focus_point[k] - camera_center[k] for k in range(3)]
+    norm = math.sqrt(sum(x**2 for x in forward))
+    forward = [x / norm for x in forward]
+    right = [up_axis[1]*forward[2] - up_axis[2]*forward[1],
+             up_axis[2]*forward[0] - up_axis[0]*forward[2],
+             up_axis[0]*forward[1] - up_axis[1]*forward[0]]
+    norm_r = math.sqrt(sum(x**2 for x in right))
+    right = [x / norm_r for x in right]
+    up = [right[1]*forward[2] - right[2]*forward[1],
+          right[2]*forward[0] - right[0]*forward[2],
+          right[0]*forward[1] - right[1]*forward[0]]
+    return [[right[0], up[0], -forward[0]],
+            [right[1], up[1], -forward[1]],
+            [right[2], up[2], -forward[2]]]
