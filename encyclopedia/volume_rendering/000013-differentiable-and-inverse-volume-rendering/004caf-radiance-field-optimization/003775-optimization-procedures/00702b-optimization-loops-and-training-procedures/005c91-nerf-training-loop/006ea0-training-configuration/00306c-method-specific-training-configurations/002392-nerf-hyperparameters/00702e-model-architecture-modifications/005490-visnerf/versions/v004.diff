+def interpolate_1d(grid, coords):
+    idx = coords.long()
+    frac = coords - idx.float()
+    idx_next = torch.clamp(idx + 1, max=grid.shape[0] - 1)
+    return grid[idx] * (1 - frac) + grid[idx_next] * frac
+
+def interpolate_2d(grid, x, y):
+    x_idx = x.long(); y_idx = y.long()
+    x_frac = x - x_idx.float(); y_frac = y - y_idx.float()
+    x_next = torch.clamp(x_idx + 1, max=grid.shape[0] - 1)
+    y_next = torch.clamp(y_idx + 1, max=grid.shape[1] - 1)
+    v00 = grid[x_idx, y_idx]; v01 = grid[x_idx, y_next]
+    v10 = grid[x_next, y_idx]; v11 = grid[x_next, y_next]
+    return (v00 * (1 - x_frac) + v10 * x_frac) * (1 - y_frac) + (v01 * (1 - x_frac) + v11 * x_frac) * y_frac
+
+def positional_encoding(x, num_frequencies=10):
+    scales = torch.tensor([2**i for i in range(num_frequencies)], dtype=x.dtype, device=x.device)
+    xb = torch.reshape((x[..., None, :] * scales), (*x.shape[:-1], -1))
+    return torch.cat([torch.sin(xb), torch.cos(xb)], dim=-1)
+
+def spherical_harmonic_encoding(d, degree=4):
+    result = []
+    for l in range(degree + 1):
+        for m in range(-l, l + 1):
+            result.append(d[..., 0] ** (l - m) * d[..., 1] ** (l + m) * d[..., 2] ** l)
+    return torch.cat(result, dim=-1)
+
+def compute_tv_loss(tensor):
+    if tensor.dim() == 1:
+        return torch.mean(torch.abs(tensor[1:] - tensor[:-1]))
+    elif tensor.dim() == 2:
+        diff_h = torch.abs(tensor[1:, :] - tensor[:-1, :])
+        diff_w = torch.abs(tensor[:, 1:] - tensor[:, :-1])
+        return torch.mean(diff_h) + torch.mean(diff_w)
+    return 0.0
