+def trilinear_3d(grid, x, y, z):
+    """Trilinear interpolation on a 3D grid [G]."""
+    x0, y0, z0 = int(np.floor(x)), int(np.floor(y)), int(np.floor(z))
+    x1, y1, z1 = min(x0 + 1, grid.shape[0]-1), min(y0 + 1, grid.shape[1]-1), min(z0 + 1, grid.shape[2]-1)
+    dx, dy, dz = x - x0, y - y0, z - z0
+    c00 = grid[x0, y0, z0] * (1-dx) + grid[x1, y0, z0] * dx
+    c01 = grid[x0, y1, z0] * (1-dx) + grid[x1, y1, z0] * dx
+    c10 = grid[x0, y0, z1] * (1-dx) + grid[x1, y0, z1] * dx
+    c11 = grid[x0, y1, z1] * (1-dx) + grid[x1, y1, z1] * dx
+    return (c00 * (1-dy) + c01 * dy) * (1-dz) + (c10 * (1-dy) + c11 * dy) * dz
 
