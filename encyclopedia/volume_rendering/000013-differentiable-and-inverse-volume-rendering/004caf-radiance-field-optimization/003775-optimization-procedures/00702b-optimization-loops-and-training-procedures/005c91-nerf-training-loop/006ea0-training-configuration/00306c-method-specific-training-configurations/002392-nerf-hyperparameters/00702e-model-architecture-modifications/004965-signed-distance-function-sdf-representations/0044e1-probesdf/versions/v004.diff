+def bilinear_2d(plane, u, v):
+    """Bilinear interpolation on a 2D plane [G]."""
+    u0, v0 = int(np.floor(u)), int(np.floor(v))
+    u1, v1 = min(u0 + 1, plane.shape[0]-1), min(v0 + 1, plane.shape[1]-1)
+    du, dv = u - u0, v - v0
+    c0 = plane[u0, v0] * (1-du) + plane[u1, v0] * du
+    c1 = plane[u0, v1] * (1-du) + plane[u1, v1] * du
+    return c0 * (1-dv) + c1 * dv
+
