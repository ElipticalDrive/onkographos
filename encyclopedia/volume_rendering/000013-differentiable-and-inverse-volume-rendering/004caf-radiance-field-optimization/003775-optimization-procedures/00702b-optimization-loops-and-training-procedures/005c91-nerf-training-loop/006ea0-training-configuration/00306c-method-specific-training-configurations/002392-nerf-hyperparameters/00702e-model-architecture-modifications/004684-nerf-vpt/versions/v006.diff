 import torch.nn as nn
 
+# Standard positional encoding [G]
+def positional_encoding(x, num_freq_bands=10):
+    scales = torch.tensor([2**i for i in range(num_freq_bands)], dtype=x.dtype, device=x.device)
+    scaled_x = x[..., None, :] * scales[None, None, :]
+    return torch.cat([torch.sin(scaled_x), torch.cos(scaled_x)], dim=-1)
+
+# Standard directional encoding [G]
+def directional_encoding(d, num_freq_bands=4):
+    scales = torch.tensor([2**i for i in range(num_freq_bands)], dtype=d.dtype, device=d.device)
+    scaled_d = d[..., None, :] * scales[None, None, :]
+    return torch.cat([torch.sin(scaled_d), torch.cos(scaled_d)], dim=-1)
+
+# Mapping function F_i (MLP) [G]
+class NeRFMLP(nn.Module):
+    def __init__(self, pos_dim, dir_dim, hidden_dim=256):
+        super().__init__()
+        self.pos_mlp = nn.Sequential(
+            nn.Linear(pos_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim)
+        )
+        self.shade_mlp = nn.Sequential(
+            nn.Linear(hidden_dim + dir_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, hidden_dim), nn.ReLU(),
+            nn.Linear(hidden_dim, 4)  # 3 for color, 1 for density
+        )
+    def forward(self, pos_enc, dir_enc):
+        h = self.pos_mlp(pos_enc)
+        out = self.shade_mlp(torch.cat([h, dir_enc], dim=-1))
+        sigma = out[..., :1]
+        color = out[..., 1:]
+        return sigma, color
