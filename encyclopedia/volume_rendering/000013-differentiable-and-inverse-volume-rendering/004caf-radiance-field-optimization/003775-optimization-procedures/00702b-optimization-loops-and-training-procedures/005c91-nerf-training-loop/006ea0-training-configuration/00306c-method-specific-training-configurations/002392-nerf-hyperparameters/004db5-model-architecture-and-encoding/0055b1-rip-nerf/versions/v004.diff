+def positional_encoding(x, num_frequencies):
+    """
+    Standard positional encoding for view direction.
+    """
+    # x: (B, 3)
+    # Returns: (B, 2 * num_frequencies * 3)
+    freq_bands = 2.0 ** torch.linspace(0, num_frequencies - 1, num_frequencies)
+    x_expanded = x.unsqueeze(-1) * freq_bands.unsqueeze(0)
