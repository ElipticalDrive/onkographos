+def apply_cem(sr_output, lr_input, blur_kernel):
+    # CEM Output Adjustment Formula:
+    # C_HR = (I - H^T (H H^-1 H)) * C_tilde_HR + H^T (H H^-1) * C_LR
+    # H^-1 denotes the Moore-Penrose pseudo-inverse for numerical stability [G].
+    H = blur_kernel
+    H_pinv = torch.linalg.pinv(H)
+    proj_lr = H.T @ (H @ H_pinv)
+    proj_sr = torch.eye(H.shape[0]) - H.T @ (H @ H_pinv @ H)
+    # Flatten images to vectors for matrix multiplication, then reshape
