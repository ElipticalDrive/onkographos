+    sr_flat = sr_output.view(B, C * H_h * W_w)
+    lr_flat = lr_input.view(B, C * H_h * W_w)
+    out_flat = proj_sr @ sr_flat.T + proj_lr @ lr_flat.T
+    return out_flat.T.view(B, C, H_h, W_w)
 
