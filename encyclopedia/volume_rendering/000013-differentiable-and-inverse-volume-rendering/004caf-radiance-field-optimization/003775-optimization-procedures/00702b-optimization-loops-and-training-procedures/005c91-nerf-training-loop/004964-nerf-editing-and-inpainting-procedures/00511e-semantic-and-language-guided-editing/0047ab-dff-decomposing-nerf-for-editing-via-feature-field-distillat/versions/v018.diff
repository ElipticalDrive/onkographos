 import torch.nn as nn
 import torch.nn.functional as F
+import math
+
+def positional_encoding(x, num_frequencies):
+    """Standard sine/cosine positional encoding."""
+    # x: [B, D], returns [B, D * 2 * num_frequencies]
+    scales = torch.tensor([2 ** (i / num_frequencies) for i in range(num_frequencies)], device=x.device)
+    x = x.unsqueeze(-1) * scales.unsqueeze(0)
+    x = torch.cat([torch.sin(x), torch.cos(x)], dim=-1)
+    return x
+
+class RadianceMLP(nn.Module):
+    """8 hidden layers (256 dims), ReLU. Outputs sigma, color, feature."""
+    def __init__(self, hidden_dim=256):
+        super().__init__()
+        self.layers = nn.ModuleList([nn.Linear(hidden_dim, hidden_dim) for _ in range(8)])
+        self.sigma_layer = nn.Linear(hidden_dim, 1)
+        self.color_layers = nn.ModuleList([nn.Linear(hidden_dim, hidden_dim) for _ in range(3)])
+        self.color_out = nn.Linear(hidden_dim, 3)
+        self.feature_layers = nn.ModuleList([nn.Linear(hidden_dim, hidden_dim) for _ in range(3)])
+        self.feature_out = nn.Linear(hidden_dim, 128) # Matches LSeg/DINO typical dims
+
+    def forward(self, x_pe, d_pe):
+        h = x_pe
+        for i, layer in enumerate(self.layers):
+            h = F.relu(layer(h))
+            if i < 3: # Skip connections at first 3 layers
+                h = torch.cat([h, x_pe], dim=-1)
+        sigma = self.sigma_layer(h)
+        c = h
+        for layer in self.color_layers:
+            c = F.relu(layer(c))
+        color = self.color_out(c)
+        f = h
+        for layer in self.feature_layers:
+            f = F.relu(layer(f))
+        feature = self.feature_out(f)
+        return sigma, color, feature
+
+class IndependentFeatureMLP(nn.Module):
+    """4 layers, skip connection at 3rd if PE used."""
+    def __init__(self, hidden_dim=256):
+        super().__init__()
+        self.layers = nn.ModuleList([nn.Linear(hidden_dim, hidden_dim) for _ in range(4)])
+        
+    def forward(self, x_pe):
+        h = x_pe
+        for i, layer in enumerate(self.layers):
+            h = F.relu(layer(h))
+            if i == 2: # Skip at 3rd layer
+                h = torch.cat([h, x_pe], dim=-1)
+        return h
 
