+import math
+import random
+
+def evenly_sample_indices(total_views, num_views):
+    step = total_views / num_views
+    return [int(i * step) for i in range(num_views)]
+
+def cosine_annealing_lr(initial_lr, final_lr, current_step, total_steps):
+    return final_lr + 0.5 * (initial_lr - final_lr) * (1 + math.cos(math.pi * current_step / total_steps))
+
+class ViT_B_16:
+    def __init__(self, weights='DINO_PRETRAINED', patch_size=16, layers=12, heads=12, embed_dim=768, mlp_ratio=4.0, init='scratch'):
+        self.weights = weights
+        self.patch_size = patch_size
+        self.layers = layers
+        self.heads = heads
+        self.embed_dim = embed_dim
+        self.mlp_ratio = mlp_ratio
+        self.init = init
+    def parameters(self):
+        return []
+    def __call__(self, x):
+        return x
+
+class AdamW:
+    def __init__(self, params, lr, betas):
+        self.params = list(params)
+        self.lr = lr
+        self.betas = betas
+        self.state = {}
+        self.step_count = 0
+    def step(self):
+        self.step_count += 1
+        for p in self.params:
+            if p.grad is None: continue
+            if id(p) not in self.state:
+                self.state[id(p)] = {'m': 0.0, 'v': 0.0}
+            s = self.state[id(p)]
+            beta1, beta2 = self.betas
+            s['m'] = beta1 * s['m'] + (1 - beta1) * p.grad
+            s['v'] = beta2 * s['v'] + (1 - beta2) * p.grad**2
+            m_hat = s['m'] / (1 - beta1**self.step_count)
+            v_hat = s['v'] / (1 - beta2**self.step_count)
+            p.data -= self.lr * m_hat / (math.sqrt(v_hat) + 1e-8)
+    def zero_grad(self):
+        for p in self.params:
+            if p.grad is not None: p.grad.zero_()
 
