+def interpolate(grid, x, y):
+    """Bilinear interpolation for (H, W) grid at (H, W) float coordinates."""
+    x0 = np.floor(x).astype(np.int32)
+    y0 = np.floor(y).astype(np.int32)
+    x1 = x0 + 1
+    y1 = y0 + 1
+    x0 = np.clip(x0, 0, grid.shape[1] - 1)
+    y0 = np.clip(y0, 0, grid.shape[0] - 1)
+    x1 = np.clip(x1, 0, grid.shape[1] - 1)
+    y1 = np.clip(y1, 0, grid.shape[0] - 1)
+    wa = (x - x0)
+    wb = (y - y0)
+    val = (grid[y0, x0] * (1 - wa) * (1 - wb) +
+           grid[y0, x1] * wa * (1 - wb) +
+           grid[y1, x0] * (1 - wa) * wb +
+           grid[y1, x1] * wa * wb)
+    return val
