+def slerp(q0, q1, t):
+    cos_theta = np.dot(q0, q1)
+    if cos_theta < 0:
+        q1 = -q1
+        cos_theta = -cos_theta
+    if cos_theta > 0.9995:
+        return lerp(q0, q1, t)
+    theta = np.arccos(cos_theta)
+    sin_theta = np.sin(theta)
+    s0 = np.sin((1 - t) * theta) / sin_theta
+    s1 = np.sin(t * theta) / sin_theta
+    return s0 * q0 + s1 * q1
