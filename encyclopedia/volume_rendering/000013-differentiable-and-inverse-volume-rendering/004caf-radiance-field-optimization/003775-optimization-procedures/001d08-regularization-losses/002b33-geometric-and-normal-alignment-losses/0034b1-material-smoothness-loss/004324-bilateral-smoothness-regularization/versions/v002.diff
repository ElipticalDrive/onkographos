+def compute_gradient_magnitude(field):
+    """Computes gradient magnitude using central finite differences."""
+    h, w = len(field), len(field[0])
+    grad_mag = [[0.0] * w for _ in range(h)]
+    for r in range(1, h - 1):
+        for c in range(1, w - 1):
+            dx = (field[r][c+1] - field[r][c-1]) / 2.0
+            dy = (field[r+1][c] - field[r-1][c]) / 2.0
+            grad_mag[r][c] = (dx**2 + dy**2)**0.5
+    return grad_mag
+
