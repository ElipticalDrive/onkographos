+def bilinear_sample(grid, x, y):
+    """Performs bilinear interpolation on a 2D grid at coordinates (x, y)."""
+    x0, y0 = int(np.floor(x)), int(np.floor(y))
+    x1, y1 = x0 + 1, y0 + 1
+    dx, dy = x - x0, y - y0
+    x0 = np.clip(x0, 0, grid.shape[1] - 1)
+    x1 = np.clip(x1, 0, grid.shape[1] - 1)
+    y0 = np.clip(y0, 0, grid.shape[0] - 1)
+    y1 = np.clip(y1, 0, grid.shape[0] - 1)
+    top = grid[y0, x0] * (1 - dx) + grid[y0, x1] * dx
+    bottom = grid[y1, x0] * (1 - dx) + grid[y1, x1] * dx
+    return top * (1 - dy) + bottom * dy
