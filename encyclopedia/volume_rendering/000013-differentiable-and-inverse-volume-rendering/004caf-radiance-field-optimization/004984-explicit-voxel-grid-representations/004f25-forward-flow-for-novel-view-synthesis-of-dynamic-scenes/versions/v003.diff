+    alphas = [1.0 - math.exp(-d * step) for d in density]
+    weights = [a * math.prod([1.0 - x + 1e-10 for x in alphas[:i]]) for i, a in enumerate(alphas)]
+    return [sum(w * c for w, c in zip(ws, cs)) for ws, cs in zip(weights, color)]
