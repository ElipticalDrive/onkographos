+def traverse_voxel_grid(ray, bounds_min, bounds_max, voxel_size):
+    # [G] Standard DDA voxel traversal
+    segments = []
+    origin = ray.origin
+    direction = ray.direction
+    inv_dir = [1.0/d if d != 0 else float('inf') for d in direction]
+    
+    # Initial voxel coordinates
+    t_min = [(bounds_min[d] - origin[d]) * inv_dir[d] for d in range(3)]
+    t_max = [(bounds_max[d] - origin[d]) * inv_dir[d] for d in range(3)]
+    
+    # Step sizes
+    step = [1 if d > 0 else -1 for d in direction]
+    t_delta = [voxel_size * abs(inv_dir[d]) for d in range(3)]
+    
+    # Initial tMax
+    t_max_arr = [t_min[d] + t_delta[d] if step[d] > 0 else t_max[d] + t_delta[d] for d in range(3)]
+    
+    # Initial voxel index
+    idx = [int((origin[d] - bounds_min[d]) / voxel_size) for d in range(3)]
+    
+    t = min(t_min)
+    max_steps = 1000
+    for _ in range(max_steps):
+        if t > max(t_max):
+            break
+        # Record segment
+        seg_len = t - (segments[-1].t_end if segments else 0)
+        segments.append(Segment(voxel_index=idx[0] + idx[1]*256 + idx[2]*256*256, length=seg_len, t_end=t))
+        
+        # Advance
+        if t_max_arr[0] < t_max_arr[1] and t_max_arr[0] < t_max_arr[2]:
+            t_max_arr[0] += t_delta[0]
+            idx[0] += step[0]
+        elif t_max_arr[1] < t_max_arr[2]:
+            t_max_arr[1] += t_delta[1]
+            idx[1] += step[1]
+        else:
+            t_max_arr[2] += t_delta[2]
+            idx[2] += step[2]
+        t = min(t_max_arr)
+        
+    return segments
 
