+        
+        # Backpropagate and update
+        optimizer.zero_grad()
+        loss.backward()
+        optimizer.step()
+        
+        # Enable growing and pruning during fine-tuning
+        # This reduces the number of Gaussians by removing redundant ones
+        gaussians = densification_step(gaussians)
+        
+    return gaussians
