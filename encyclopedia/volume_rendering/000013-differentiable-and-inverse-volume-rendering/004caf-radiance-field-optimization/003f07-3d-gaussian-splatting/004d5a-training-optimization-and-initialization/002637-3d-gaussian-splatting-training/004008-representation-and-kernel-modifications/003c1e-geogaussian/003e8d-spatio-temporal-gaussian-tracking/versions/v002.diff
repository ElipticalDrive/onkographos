+**Pseudocode**
+```python
+def query_encoding_voxel(mu, t, E_planes, v_vectors):
+    # mu: (3,), t: float
+    # E_planes: dict mapping plane pair (e.g., 'XY') to 2D feature grid
+    # v_vectors: list of 3 vectors v^1, v^2, v^3
+    coords = (mu[0], mu[1], mu[2], t)
+    latent = 0.0
+    for i, v in enumerate(v_vectors):
+        plane_feats = []
+        for pair in [('X', 'Y'), ('Z', 'T'), ('X', 'Z'), ('Y', 'T'), ('X', 'T'), ('Z', 'Y')]:
+            p_coords = (coords[ord(pair[0]) - ord('X')], coords[ord(pair[1]) - ord('X')])
+            # Standard bilinear interpolation [G]
+            feat = bilinear_interpolate(E_planes[pair], p_coords)
+            plane_feats.append(feat)
+        # Outer product combination as per Eq. 4 [S1, unofficial]
+        latent += outer_product_combine(plane_feats, v)
+    return latent
+
+def compute_deformation(f):
+    # Four tiny MLPs [S1, unofficial]
+    delta_mu = MLP_mu(f)
+    delta_R = MLP_R(f)
+    delta_S = MLP_S(f)
+    delta_o = MLP_o(f)
+    return delta_mu, delta_R, delta_S, delta_o
+
+def get_deformed_gaussian(G0, delta_mu, delta_R, delta_S, delta_o):
+    # Apply deltas to static attributes [S1, unofficial]
+    mu_t = G0.mu + delta_mu
+    R_t = G0.R + delta_R
+    S_t = G0.S + delta_S
+    o_t = G0.o + delta_o
+    return Gaussian(mu_t, R_t, S_t, o_t, G0.SH)
+```
