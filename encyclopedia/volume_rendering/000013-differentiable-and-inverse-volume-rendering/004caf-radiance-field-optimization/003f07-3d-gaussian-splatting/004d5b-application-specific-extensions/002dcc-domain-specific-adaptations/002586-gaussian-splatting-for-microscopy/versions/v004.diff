+def evaluate_gaussians(mu, a, L, grid_coords):
+    """Evaluate Gaussian mixture at given voxel coordinates [G]."""
+    diff = grid_coords[np.newaxis, ...] - mu[:, np.newaxis, :]
+    # Solve L @ y = diff for y
+    y = np.linalg.solve(L[:, np.newaxis, :, :], diff)
+    dist_sq = np.sum(y ** 2, axis=-1)
+    return np.sum(a[:, np.newaxis] * np.exp(-0.5 * dist_sq), axis=0)
