+    # Normalize quaternion
+    norm = np.sqrt(w**2 + x**2 + y**2 + z**2)
+    w, x, y, z = w/norm, x/norm, y/norm, z/norm
+    
+    R = np.zeros((3, 3))
+    R[0, 0] = 1 - 2*(y**2 + z**2)
+    R[0, 1] = 2*(x*y - w*z)
+    R[0, 2] = 2*(x*z + w*y)
+    R[1, 0] = 2*(x*y + w*z)
+    R[1, 1] = 1 - 2*(x**2 + z**2)
+    R[1, 2] = 2*(y*z - w*x)
