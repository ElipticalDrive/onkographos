+                opacity = 1.0 - transmittance[i]
+                output_buffer[i*4] = opacity * 255
+                output_buffer[i*4+1] = opacity * 255
+                output_buffer[i*4+2] = opacity * 255
+                output_buffer[i*4+3] = 255
 ```
 
