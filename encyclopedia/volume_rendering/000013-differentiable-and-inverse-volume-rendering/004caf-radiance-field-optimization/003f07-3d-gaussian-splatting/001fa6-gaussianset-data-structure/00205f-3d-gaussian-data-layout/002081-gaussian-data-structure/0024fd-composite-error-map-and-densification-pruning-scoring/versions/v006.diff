+def density_control(gaussians, views, rendered_images, gt_images, freq_masks, tau, tau_p, tau_d, tau_s, rho, lambda_dssim, schedule_weight):
+    # Step 1: Compute Active Primitives
+    active_primitives = []
+    for i in range(len(gaussians)):
+        valid_count = 0
+        for j in views:
+            r_ij = rasterizer_get_projected_radius(i, j) # [G]
+            if r_ij > 0:
+                valid_count += 1
+        if valid_count > 0:
+            active_primitives.append(i)
+            
+    if not active_primitives:
+        return gaussians
+
+    # Step 2: Compute Composite Error Maps
+    composite_error_masks = {}
+    for j in views:
+        H, W = len(rendered_images[j]), len(rendered_images[j][0])
+        raw_err = [[0.0] * W for _ in range(H)]
+        for r in range(H):
+            for c in range(W):
+                raw_err[r][c] = (1/3) * sum(abs(rendered_images[j][r][c][ch] - gt_images[j][r][c][ch]) for ch in range(3))
+        composite_error_masks[j] = min_max_normalize(raw_err)
+
+    # Step 3: Compute Densification Scores
+    densification_scores = {}
+    for i in active_primitives:
+        valid_views = [j for j in views if rasterizer_get_projected_radius(i, j) > 0] # [G]
+        if not valid_views: continue
+        counts = []
+        for j in valid_views:
+            contributing_pixels = rasterizer_get_contributing_pixels(i, j) # [G]
+            n_ij = sum(composite_error_masks[j][r][c] for r, c in contributing_pixels)
+            counts.append(n_ij)
+        C_i = sum(counts) / len(counts)
+        densification_scores[i] = schedule_weight * C_i
+
+    # Step 4: Compute Pruning Scores
+    photo_losses = {}
+    for j in views:
+        H, W = len(rendered_images[j]), len(rendered_images[j][0])
+        raw_err = [[0.0] * W for _ in range(H)]
+        for r in range(H):
+            for c in range(W):
+                raw_err[r][c] = (1/3) * sum(abs(rendered_images[j][r][c][ch] - gt_images[j][r][c][ch]) for ch in range(3))
+        flat_err = [v for row in raw_err for v in row]
+        mean_l1 = sum(flat_err) / len(flat_err)
+        ssim_val = compute_ssim(rendered_images[j], gt_images[j]) # [G]
+        photo_losses[j] = (1 - lambda_dssim) * mean_l1 + lambda_dssim * (1 - ssim_val)
+
+    pruning_scores = {}
+    for i in active_primitives:
+        valid_views = [j for j in views if rasterizer_get_projected_radius(i, j) > 0] # [G]
+        if not valid_views: continue
+        Q_i = 0
+        for j in valid_views:
+            contributing_pixels = rasterizer_get_contributing_pixels(i, j) # [G]
+            n_ij = sum(composite_error_masks[j][r][c] for r, c in contributing_pixels)
+            Q_i += n_ij * photo_losses[j]
+        pruning_scores[i] = Q_i
+
+    # Normalize pruning scores
+    if pruning_scores:
+        min_s, max_s = min(pruning_scores.values()), max(pruning_scores.values())
+        if max_s == min_s:
+            normalized_scores = {i: 0.0 for i in pruning_scores}
+        else:
+            normalized_scores = {i: (pruning_scores[i] - min_s) / (max_s - min_s) for i in pruning_scores}
+    else:
+        normalized_scores = {}
+
+    # Step 5: Pruning
+    mandatory_removals = set(i for i in active_primitives if gaussians[i].opacity < 0.1 or gaussians[i].gamma < 0.01)
+    candidates = [i for i in active_primitives if i not in mandatory_removals and normalized_scores.get(i, 0) > tau_p]
+    b_t = math.floor(rho * len(candidates))
+    sampled_candidates = weighted_sample_without_replacement(candidates, [normalized_scores[i] for i in candidates], b_t)
+    removal_set = mandatory_removals.union(sampled_candidates)
+
+    # Step 6: Densification
+    new_gaussians = []
+    for i in active_primitives:
+        if i in removal_set:
+            continue
+        if densification_scores.get(i, 0) > tau_d:
+            if gaussians[i].max_base_scale < tau_s:
+                new_g = copy(gaussians[i])
+                new_g.position += gaussians[i].position_gradient # [G]
+                new_g.beta = gaussians[i].beta
+                new_g.gamma = 2 * sigmoid(new_g.beta)
+                new_gaussians.append(new_g)
+            else:
+                g1, g2 = split_into_two(gaussians[i]) # [G]
+                g1.beta = gaussians[i].beta; g1.gamma = 2 * sigmoid(g1.beta)
+                g2.beta = gaussians[i].beta; g2.gamma = 2 * sigmoid(g2.beta)
+                new_gaussians.extend([g1, g2])
+        else:
+            new_gaussians.append(gaussians[i])
+            
+    # Append primitives outside active set unchanged
+    for i in range(len(gaussians)):
+        if i not in active_primitives:
+            new_gaussians.append(gaussians[i])
+            
+    return new_gaussians
 
