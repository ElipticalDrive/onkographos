+def pos_enc(x, min_deg=0, max_deg=10, include_input=True):
+    """Standard NeRF positional encoding [G]."""
+    scales = torch.tensor([2**i for i in range(min_deg, max_deg)])
+    xb = torch.reshape((x * scales)[:, None, :], (x.shape[0], -1, x.shape[2]))
+    freq_bands = 2 * torch.pi * xb
+    enc = torch.cat((torch.sin(freq_bands), torch.cos(freq_bands)), dim=-1)
+    if include_input: enc = torch.cat((x, enc), dim=-1)
+    return enc
 
