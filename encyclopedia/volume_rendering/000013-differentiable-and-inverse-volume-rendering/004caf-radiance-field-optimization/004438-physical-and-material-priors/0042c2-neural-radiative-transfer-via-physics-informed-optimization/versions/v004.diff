+def sample_sphere(n):
+    """Uniform sampling on unit sphere S^2 [G]."""
+    u = torch.rand(n, 1)
+    v = torch.rand(n, 1)
+    theta = 2.0 * np.pi * u
+    phi = torch.acos(1.0 - 2.0 * v)
+    x = torch.sin(phi) * torch.cos(theta)
+    y = torch.sin(phi) * torch.sin(theta)
+    z = torch.cos(phi)
+    return torch.cat([x, y, z], dim=1)
+
+def sample_volume(n, bounds):
+    """Uniform sampling in 3D bounding box [min, max] [G]."""
+    return torch.rand(n, 3) * (bounds[1] - bounds[0]) + bounds[0]
+
+def get_pixel_directions(cam_origin, H, W, fov=60.0):
+    """Compute viewing directions for a pinhole camera [G]."""
+    fx = 1.0 / np.tan(np.radians(fov / 2.0))
+    fy = fx
+    cx, cy = W / 2.0, H / 2.0
+    u, v = torch.meshgrid(torch.arange(W), torch.arange(H), indexing='ij')
+    dirs = torch.stack([
+        (u - cx) / fx,
+        (v - cy) / fy,
+        torch.ones_like(u)
+    ], dim=-1)
+    return dirs / torch.norm(dirs, dim=-1, keepdim=True)
+
+def jittered_stratified_sample(n, t_min, t_max):
+    """Jittered stratified sampling for line integral [G]."""
+    t = torch.linspace(t_min, t_max, n + 1)
+    dt = (t_max - t_min) / n
+    jitter = torch.rand(n) * dt
+    return t[:-1] + jitter
+
