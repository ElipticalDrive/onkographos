+def sample_aabb_boundary(n, bounds):
+    """Sample points and outward normals on an AABB boundary [G]."""
+    min_b, max_b = bounds[0], bounds[1]
+    # Randomly pick one of 6 faces
+    face = torch.randint(0, 6, (n, 1))
+    x = torch.rand(n, 3) * (max_b - min_b) + min_b
+    n_b = torch.zeros(n, 3)
+    for i in range(6):
+        mask = (face == i).squeeze()
+        if mask.any():
+            if i == 0: x[mask, 0] = min_b[0]
+            elif i == 1: x[mask, 0] = max_b[0]
+            elif i == 2: x[mask, 1] = min_b[1]
+            elif i == 3: x[mask, 1] = max_b[1]
+            elif i == 4: x[mask, 2] = min_b[2]
+            elif i == 5: x[mask, 2] = max_b[2]
+            n_b[mask, i % 3] = 1.0 if i % 2 == 0 else -1.0
+    return x, n_b
+
