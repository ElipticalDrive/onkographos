+def adam_update(params, grads, lr, beta1=0.9, beta2=0.999, eps=1e-8):
+    m = {k: beta1 * m.get(k, 0) + (1 - beta1) * grads[k] for k in params}
+    v = {k: beta2 * v.get(k, 0) + (1 - beta2) * (grads[k] ** 2) for k in params}
+    m_hat = {k: m[k] / (1 - beta1) for k in m}
+    v_hat = {k: v[k] / (1 - beta2) for k in v}
+    return {k: params[k] - lr * m_hat[k] / (math.sqrt(v_hat[k]) + eps) for k in params}
