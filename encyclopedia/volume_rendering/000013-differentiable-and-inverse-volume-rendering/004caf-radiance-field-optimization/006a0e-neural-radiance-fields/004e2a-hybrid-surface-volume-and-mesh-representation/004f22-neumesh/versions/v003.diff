+                    c_m_interp = mesh.c_m[v_idx] * w_interp
+                    
+                    # Positional Encoding
+                    # PE applied to h_k, l_g, l_t, direction
+                    h_pe = positional_encoding(h_k, freqs=8)
+                    l_g_pe = positional_encoding(l_g_interp, freqs=2)
+                    l_t_pe = positional_encoding(l_t_interp, freqs=2)
+                    d_pe = positional_encoding(direction, freqs=4)
+                    
+                    # 6. Decode
+                    sigma = geometry_decoder.forward(np.concatenate([l_g_pe, h_pe]))
+                    base_color = radiance_decoder.forward(np.concatenate([l_t_pe, h_pe, d_pe, n]))
+                    
+                    # Add modification color
+                    final_color = base_color + c_m_interp
+                    
+                    densities.append(sigma)
+                    colors.append(final_color)
+                    mod_colors.append(c_m_interp)
+                
+                # Fuse densities and colors from neighbors
+                # Using the weights from interpolation or a specific fusion strategy
+                # NeuMesh++ fuses under condition of latent codes and local indicators
+                # Simplified weighted sum based on neighbor weights
+                sigma_final = sum(d * w for d, w in zip(densities, [1.0/np.linalg.norm(mesh.vertices[k]-x) for k in neighbors]))
+                color_final = sum(c * w for c, w in zip(colors, [1.0/np.linalg.norm(mesh.vertices[k]-x) for k in neighbors]))
+                mod_color_final = sum(m * w for m, w in zip(mod_colors, [1.0/np.linalg.norm(mesh.vertices[k]-x) for k in neighbors]))
+                
+                # 7. Volume Rendering Step
+                delta = sample_distances[i][j+1] - sample_distances[i][j] if j < N_total-1 else 0
+                alpha = 1.0 - np.exp(-sigma_final * delta)
+                
+                T_acc *= (1.0 - alpha)
+                color_acc += T_acc * alpha * color_final
+                mod_color_acc += T_acc * alpha * mod_color_final
+                
+                if T_acc < 1e-4:
+                    break
+            
+            rendered_ray_colors[i] = color_acc
+            # Store mod_color_acc for loss calculation if needed
+        
+        rendered_images.append(rendered_ray_colors)
+        
+        # 8. Loss Calculation
+        # Photometric Loss
+        loss_f = np.mean((rendered_ray_colors - gt_image) ** 2)
+        # Accumulated modification color loss
+        # Note: mod_color_acc needs to be accumulated similarly to color_acc
+        # Simplified: assume mod_color_acc is available
+        loss_mod = 0.01 * np.mean((mod_color_acc - gt_image) ** 2)
+        
+        # Mask Loss
+        # M_hat = sum(T_i * alpha_i)
+        # M_m = BCE(M_hat, M)
+        loss_mask = 0 # Placeholder for BCE calculation
+        
+        # Total Variation Loss (on latent codes)
+        loss_tv = compute_total_variation_loss(mesh, K_tv=10)
+        
+        total_loss += loss_f + loss_mod + loss_mask + loss_tv
+        
+    return rendered_images, total_loss
+
+def compute_total_variation_loss(mesh, K_tv=10):
+    """
+    Computes Total Variation loss on latent codes.
+    """
+    loss = 0
+    for i, v_i in enumerate(mesh.vertices):
+        neighbors = find_k_nearest_vertices(v_i, mesh.vertices, K_tv)
+        for j in neighbors:
+            l_i = mesh.l_g[i] # Or l_t, or combined
+            l_j = mesh.l_g[j]
+            loss += np.sum(np.abs(l_i - l_j))
+    return loss
+
+def find_k_nearest_vertices(query_point, vertices, K):
+    """
+    Finds K nearest vertices to query_point.
+    """
+    dists = np.linalg.norm(vertices - query_point, axis=1)
+    indices = np.argsort(dists)[:K]
+    return indices
 ```
 
-**Parameters:**
-*   $K$: Number of nearest vertices. Default: 8 [S1, S2].
-*   $K_{tv}$: Number of closest vertices for Total Variation loss. Not given in the sources.
-*   Positional Encoding Frequencies: Signed distances (part of $h$) use 8 frequencies; interpolated codes use 2 frequencies; viewing directions use 4 frequencies [S1].
-*   Geometry Decoder: 3 hidden layers, 256 hidden size, SoftPlus activation [S1].
-*   Radiance Decoder: 4 hidden layers, 256 hidden size, ReLU activation [S1].
-*   Loss Weight for Modification Color: 0.01 [S2].
-*   Rendering Resolution: 800 × 800 [S2].
-*   Training Images: 1600 × 1200 (DTU) [S2].
-
-**Edge Cases and Pitfalls:**
-*   **Spatial Distinguishability:** Naive trilinear interpolation of codes on a single-layer mesh fails to distinguish inner/outer queries perpendicular to the surface [S1, S2]. NeuMesh++ solves this with the local indicator $\mathbf{h}_k$ (projection distance $p_k$) [S2].
-*   **Training Stability:** Vertex-bounded representations lack the spatial continuity of global MLPs, risking unstable training [S1]. NeuMesh++ avoids the need for a teacher model (used in NeuMesh) by using the local space parameterization and modification color [S2].
-*   **Texture Overfitting:** Fine-tuning texture codes with a single image can cause view-dependent artifacts [S1]. NeuMesh++ uses a spatial-aware optimization strategy, selecting only affected modification colors via probing rays, to prevent this [S1, S2].
-*   **Non-Watertight Meshes:** The method is agnostic to mesh topology (non-watertight, non-manifold) because it relies on local vertex neighborhoods rather than global surface definitions [S1, S2].
-
 ## Operating characteristics
-*   **Time Complexity:** Rendering speed is approximately 15 fps on an Nvidia GTX 4070 GPU for 800 × 800 images [S2]. This is attributed to compact latent codes and lightweight decoders [S2].
-*   **Memory Complexity:** Memory usage is proportional to the number of mesh vertices ($V$) times the code dimensions ($d_g + d_t + d_s + 3$). The occupancy grid adds a small constant overhead.
-*   **Editing Efficiency:**
-    *   Geometry editing (mesh deformation + occupancy grid update): ~1 second [S2].
-    *   Texture painting (fine-tuning modification colors): ~1 second [S2].
-    *   Semantic-guided editing (3D semantic propagation): ~2 seconds [S2].
-    *   Texture swapping/filling: Immediate, no fine-tuning required [S2].
-*   **Strengths:**
-    *   High-fidelity rendering of high-frequency details (e.g., text, fur) compared to SDF-based methods like NeuS [S2].
-    *   Efficient, fine-grained editing capabilities (geometry, texture, semantics) [S2].
-    *   No need for UV mapping [S1].
-    *   Stable training without a pre-trained teacher model [S2].
-*   **Limitations:**
-    *   Requires an initial mesh scaffold (e.g., from Neuralangelo or NeuS) [S1, S2].
-    *   Performance depends on mesh quality and vertex density [S1].
-    *   Unbounded scenes require an additional background model (hash grid) [S2].
+
+-   **Time Complexity:** Rendering speed is approximately 15 fps on an Nvidia GTX 4070 GPU for 800×800 images [S2]. This is achieved by using compact latent codes, lightweight decoders, and an occupancy grid to skip unoccupied space [S2].
+-   **Memory Complexity:** Memory usage is dominated by the storage of latent codes per vertex. For a mesh with 50K–150K vertices, this is significantly less than storing a dense voxel grid or a large hash grid for the entire scene [S1, S2].
