+# Helper definitions
+def create_student_network():
+    # Standard MLP initialization for NeRDF [G]
+    return type('StudentNeRDF', (), {'render': lambda self, p: (None, None), 'update': lambda self, l: None})
+
+def get_scene_origin(poses):
+    # Average of camera positions [G]
+    return sum(p.position for p in poses) / len(poses)
+
+def convert_to_spherical_ranges(poses, origin):
+    # Compute min/max of spherical coordinates for all poses [G]
+    coords = [to_spherical(p.position, origin) for p in poses]
+    return {
+        'r': (min(c[0] for c in coords), max(c[0] for c in coords)),
+        'theta': (min(c[1] for c in coords), max(c[1] for c in coords)),
+        'phi': (min(c[2] for c in coords), max(c[2] for c in coords))
+    }
+
+def to_spherical(pos, origin):
+    # Standard spherical conversion [G]
+    dx, dy, dz = pos[0]-origin[0], pos[1]-origin[1], pos[2]-origin[2]
+    r = math.sqrt(dx**2 + dy**2 + dz**2)
+    theta = math.acos(dz / r) if r > 0 else 0
+    phi = math.atan2(dy, dx)
+    return (r, theta, phi)
+
+def spherical_to_cartesian(r, theta, phi, origin):
+    # Standard Cartesian conversion [G]
+    x = origin[0] + r * math.sin(theta) * math.cos(phi)
+    y = origin[1] + r * math.sin(theta) * math.sin(phi)
+    z = origin[2] + r * math.cos(theta)
+    return (x, y, z)
+
+def generate_camera_pose(position, origin):
+    # Construct look-at pose [G]
+    return type('Pose', (), {'position': position, 'look_at': origin})()
