+def nearest_neighbor_lookup(grid, point):
+    """Simplified nearest-neighbor lookup returning (sigma, u, v, w)."""
+    idx = [int(round(p)) for p in point]
+    return grid[idx]
+
+def trilinear_lookup(grid, theta, phi):
+    """Simplified trilinear lookup returning beta vector."""
+    idx_t = int(theta / math.pi * (grid.shape[0] - 1))
+    idx_p = int(phi / (2 * math.pi) * (grid.shape[1] - 1))
+    return grid[idx_t, idx_p]
+
