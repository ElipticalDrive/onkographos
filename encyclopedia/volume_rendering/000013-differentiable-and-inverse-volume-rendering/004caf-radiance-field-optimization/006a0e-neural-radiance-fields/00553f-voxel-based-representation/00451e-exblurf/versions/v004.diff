+def bezier_curve(control_points, t):
+    """
+    Compute pose in Lie algebra se(3) using Bézier curve.
+    control_points: list of M+1 vectors in se(3) (6D each).
+    t: normalized time in [0, 1].
+    Returns: vector in se(3).
+    """
+    M = len(control_points) - 1
+    result = np.zeros(6)
+    for j in range(M + 1):
+        coeff = comb(M, j) * ((1 - t) ** (M - j)) * (t ** j)
+        result += coeff * control_points[j]
+    return result
+
+def ray_march_voxel(ray_origin, ray_direction, voxel_grid, num_samples):
+    """
+    Render a single ray using voxel-based radiance field.
+    voxel_grid: function query(x, y, z) -> (sigma, color)
+    """
+    total_transmittance = 1.0
+    accumulated_color = np.zeros(3)
+    
+    # Sample points along the ray
+    # Assuming fixed step size or near/far bounds defined elsewhere
+    # For simplicity, assume we have pre-computed sample depths s_k
+    for k in range(num_samples):
+        # Sample point X_k = origin + s_k * direction
+        # In a real implementation, s_k would be generated based on near/far planes
+        # Here we assume a helper get_sample_point exists or is implicit
+        X_k = ray_origin + ray_direction * get_sample_depth(k) 
+        
+        sigma, color = voxel_grid.query(X_k)
+        
+        # Alpha and transmittance
+        alpha = 1.0 - np.exp(-sigma * get_step_size(k))
+        weight = total_transmittance * alpha
+        
+        accumulated_color += weight * color
+        total_transmittance *= (1.0 - alpha)
+        
+    return accumulated_color
