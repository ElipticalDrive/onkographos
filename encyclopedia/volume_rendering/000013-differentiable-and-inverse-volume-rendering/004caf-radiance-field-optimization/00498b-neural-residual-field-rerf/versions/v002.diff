+    y1 = clamp(y0 + 1, max=grid.shape[1]-1)
+    z1 = clamp(z0 + 1, max=grid.shape[2]-1)
+    dx = points[:, 0] - x0
+    dy = points[:, 1] - y0
+    dz = points[:, 2] - z0
