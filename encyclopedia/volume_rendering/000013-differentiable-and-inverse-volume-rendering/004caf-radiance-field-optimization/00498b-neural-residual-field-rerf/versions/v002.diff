+        v10 = grid[x1, y0, z0]
+        v01 = grid[x0, y1, z0]
+        v11 = grid[x1, y1, z0]
+        v001 = grid[x0, y0, z1]
+        v101 = grid[x1, y0, z1]
+        v011 = grid[x0, y1, z1]
