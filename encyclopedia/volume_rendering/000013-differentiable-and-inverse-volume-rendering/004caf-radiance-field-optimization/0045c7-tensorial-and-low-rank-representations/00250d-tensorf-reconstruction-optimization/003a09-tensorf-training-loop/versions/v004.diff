 import torch.nn as nn
 
+class SimpleSampler:
+    """Random batch sampler for ray indices [G]."""
+    def __init__(self, n_rays, batch_size):
+        self.n_rays = n_rays
+        self.batch_size = batch_size
+        self.perm = torch.randperm(n_rays)
+        self.idx = 0
+
+    def nextids(self):
+        batch = self.perm[self.idx:self.idx + self.batch_size]
+        self.idx = (self.idx + self.batch_size) % self.n_rays
+        return batch
+
+def cal_n_samples(reso_cur, step_ratio):
+    """Linear scaling of samples based on resolution [G]."""
+    return int(reso_cur * step_ratio)
