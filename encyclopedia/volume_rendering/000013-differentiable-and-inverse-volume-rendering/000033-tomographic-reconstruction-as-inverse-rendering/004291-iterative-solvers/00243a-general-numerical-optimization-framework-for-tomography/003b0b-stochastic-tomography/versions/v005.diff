+def gaussian_splat(image, coord, emissivity, sigma_kernel=1.0):
+    """Kernel density estimation splatting for a 2D image."""
+    x, y = coord
+    r = int(math.ceil(2.0 * sigma_kernel))
+    new_image = [row[:] for row in image]
+    for dy in range(-r, r + 1):
+        for dx in range(-r, r + 1):
+            dist_sq = dx*dx + dy*dy
+            if dist_sq <= (2.0 * sigma_kernel)**2:
+                weight = math.exp(-dist_sq / (2 * sigma_kernel**2))
+                ix, iy = int(x) + dx, int(y) + dy
+                if 0 <= iy < len(image) and 0 <= ix < len(image[0]):
+                    new_image[iy][ix] += emissivity * weight
+    return new_image
