+    # Compute row preconditioner R
+    # R = 1 / (A * ones)
+    ones_domain = ones_like(x_rec)
+    forward_ones = A(ones_domain)
+    R = 1.0 / forward_ones
+    # Clamp R to prevent division by zero
+    R = minimum(R, 1.0 / epsilon)
+    
+    # Compute column preconditioner C
+    # C = 1 / (A^T * ones)
+    ones_range = ones_like(y)
