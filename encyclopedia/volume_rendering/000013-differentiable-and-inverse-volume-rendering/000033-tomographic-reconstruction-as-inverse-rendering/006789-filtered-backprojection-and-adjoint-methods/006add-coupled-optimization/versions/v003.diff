+def ComputeGradient(loss, var):
+    return torch.autograd.grad(loss, var, retain_graph=True)[0]
+
+def ComputeTargetLoss(rendered, target):
+    return torch.mean((rendered - target) ** 2)
+
+def ComputeTransportLoss(prev, curr):
+    return torch.mean((prev - curr) ** 2)
+
+def ComputeDivergenceLoss(u):
+    return torch.mean(torch.abs(torch.div(u, u.shape[-1]))) # Simplified divergence proxy [G]
+
+def ComputeDiscriminatorLoss(samples):
+    return torch.mean(torch.log(torch.sigmoid(samples))) # Standard GAN discriminator loss [G]
