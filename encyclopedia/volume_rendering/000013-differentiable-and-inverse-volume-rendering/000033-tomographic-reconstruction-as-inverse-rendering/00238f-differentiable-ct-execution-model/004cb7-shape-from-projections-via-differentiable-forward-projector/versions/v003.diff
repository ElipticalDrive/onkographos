 import torch
 import torch.nn as nn
+
+def ray_triangle_intersect(origin, direction, v0, v1, v2):
+    # Standard differentiable ray-triangle intersection (Möller–Trumbore variant)
+    edge1 = v1 - v0
+    edge2 = v2 - v0
+    h = torch.cross(direction, edge2)
+    a = torch.dot(edge1, h)
+    if a < 1e-8: return -1.0
+    f = 1.0 / a
+    s = origin - v0
+    u = f * torch.dot(s, h)
+    if u < 0.0 or u > 1.0: return -1.0
+    q = torch.cross(s, edge1)
+    v = f * torch.dot(direction, q)
+    if v < 0.0 or u + v > 1.0: return -1.0
+    t = f * torch.dot(edge2, q)
+    if t > 1e-8: return t
+    return -1.0
 
 class DifferentiableForwardProjector(nn.Module):
