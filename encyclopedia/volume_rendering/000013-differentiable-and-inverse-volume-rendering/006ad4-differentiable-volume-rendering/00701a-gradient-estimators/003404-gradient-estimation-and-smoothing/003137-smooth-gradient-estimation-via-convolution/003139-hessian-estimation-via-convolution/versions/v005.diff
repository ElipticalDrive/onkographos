+def sample_hessian_element(f, sigma, i, j, precomputed_inverse_indices):
+    """
+    Estimates a single element H_ij of the Hessian matrix.
+    """
+    n = len(f.dimensions) # Assuming f is defined on n dimensions
+    
+    # 1. Sample dimensions involved in the derivative
+    if i == j:
+        # Diagonal element: Use pre-sorted inverse indices for CDF inversion
+        # u is the sampled value for tau_i
+        u = sample_from_precomputed_cdf(precomputed_inverse_indices[i], sigma)
+        tau_i = u
+        tau_j = u # i == j
+    else:
+        # Off-diagonal element: Product of two independent gradient samples
+        tau_i = sample_gradient_element(sigma, i)
+        tau_j = sample_gradient_element(sigma, j)
+        
+    # 2. Sample remaining dimensions from standard Gaussian
+    tau = [0.0] * n
+    tau[i] = tau_i
+    tau[j] = tau_j
+    
+    for k in range(n):
+        if k != i and k != j:
+            tau[k] = random.gauss(0, sigma)
+            
+    # 3. Compute Kernel Value
+    # Gaussian N(tau, sigma)
+    norm_factor = 1.0 / math.pow(2 * math.pi * sigma * sigma, n / 2.0)
+    exp_arg = -sum(t * t for t in tau) / (2 * sigma * sigma)
+    N_tau_sigma = norm_factor * math.exp(exp_arg)
+    
+    if i == j:
+        kernel_val = (-tau_i * tau_i / (sigma * sigma) + 1.0 / (sigma * sigma)) * N_tau_sigma
+    else:
+        kernel_val = (tau_i * tau_j / math.pow(sigma, 4)) * N_tau_sigma
+        
+    # 4. Evaluate Density and Return Weighted Sample
+    density_val = f.evaluate(tau)
+    return density_val * kernel_val
