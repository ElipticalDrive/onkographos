+def barycentric_weights(p0, p1, p2, px, py):
+    """Computes barycentric coordinates for point (px, py) relative to triangle vertices."""
+    denom = (p1[1] - p2[1]) * (p0[0] - p2[0]) + (p2[0] - p1[0]) * (p0[1] - p2[1])
+    if abs(denom) < 1e-9:
