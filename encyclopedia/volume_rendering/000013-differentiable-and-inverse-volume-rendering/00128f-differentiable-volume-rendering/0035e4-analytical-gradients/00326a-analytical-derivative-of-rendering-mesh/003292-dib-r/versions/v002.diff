+def dib_r_forward_backward(vertices, faces, attributes, camera, alpha_mask=None):
+    # 1. Rasterization & Classification
+    projected_faces = project_to_image(vertices, camera)
+    foreground_mask, background_mask = classify_pixels(projected_faces)
+
+    # 2. Foreground Gradient Computation
+    foreground_grad = 0.0
+    for p in foreground_pixels:
+        f = find_covering_face(p)
+        u, v, w = compute_barycentric(p, f)
+        C_p = u * attributes[f.v1] + v * attributes[f.v2] + w * attributes[f.v3]
+        # Analytical derivative via chain rule on barycentric coordinates
+        grad_V = compute_barycentric_gradient(u, v, w, f.vertices)
+        foreground_grad += grad_V
+
+    # 3. Background Gradient Computation
+    background_grad = 0.0
+    if alpha_mask is not None:
+        for p in background_pixels:
+            # Distance-based aggregation of global face information
+            alpha_p = aggregate_distance_based_alpha(p, projected_faces)
+            # Approximate gradient via alpha channel
+            background_grad += compute_alpha_gradient(alpha_p, alpha_mask[p])
+    else:
+        background_grad = 0.0 # Fallback if no reference mask
+
+    # 4. Composite Gradient
+    total_grad = foreground_grad + background_grad
+    return total_grad
+```
 
