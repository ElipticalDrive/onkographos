+class Adam:
+    def __init__(self, params, lr=0.001, beta1=0.9, beta2=0.999, eps=1e-8):
+        self.params = params
+        self.lr = lr
+        self.beta1, self.beta2 = beta1, beta2
+        self.eps = eps
+        self.m = {id(p): np.zeros_like(p) for p in params}
+        self.v = {id(p): np.zeros_like(p) for p in params}
+        self.t = 0
+    def zero_grad(self):
