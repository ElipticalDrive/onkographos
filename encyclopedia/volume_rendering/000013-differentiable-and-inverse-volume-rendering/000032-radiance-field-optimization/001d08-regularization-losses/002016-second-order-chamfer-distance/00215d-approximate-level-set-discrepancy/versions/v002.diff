+def sample_points_uniformly(mesh, num_samples):
+    # Standard area-weighted uniform sampling on a triangle mesh [G]
+    faces = mesh.faces
+    areas = [triangle_area(f.v0, f.v1, f.v2) for f in faces]
+    total_area = sum(areas)
+    cum_areas = []
+    acc = 0.0
+    for a in areas:
+        acc += a
+        cum_areas.append(acc)
+    points = []
