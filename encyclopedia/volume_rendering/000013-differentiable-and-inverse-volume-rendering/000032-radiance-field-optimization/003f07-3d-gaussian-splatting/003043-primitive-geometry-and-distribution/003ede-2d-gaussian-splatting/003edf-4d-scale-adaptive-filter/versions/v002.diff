+def det(M):
+    """Computes the determinant of a square matrix M recursively."""
+    n = len(M)
+    if n == 1:
+        return M[0][0]
+    if n == 2:
+        return M[0][0] * M[1][1] - M[0][1] * M[1][0]
+    return sum((-1) ** i * M[0][i] * det([row[:i] + row[i+1:] for row in M[1:]]) for i in range(n))
