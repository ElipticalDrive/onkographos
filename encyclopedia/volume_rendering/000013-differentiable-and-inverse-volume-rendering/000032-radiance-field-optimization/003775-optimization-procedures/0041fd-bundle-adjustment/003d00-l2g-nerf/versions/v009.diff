+def exponential_map_so3(r):
+    """
+    Maps Lie algebra vector r (3,) to rotation matrix R (3,3).
+    Uses Rodrigues' formula.
+    """
+    theta = np.linalg.norm(r)
+    if theta < 1e-8:
+        return np.eye(3)
+    k = r / theta
+    K = np.array([[0, -k[2], k[1]],
+                  [k[2], 0, -k[0]],
+                  [-k[1], k[0], 0]])
+    return np.eye(3) + np.sin(theta) * K + (1 - np.cos(theta)) * K @ K
