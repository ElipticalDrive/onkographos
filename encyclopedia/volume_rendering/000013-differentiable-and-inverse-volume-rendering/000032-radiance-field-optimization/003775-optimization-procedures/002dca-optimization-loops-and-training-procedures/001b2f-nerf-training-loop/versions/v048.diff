+def compute_volume_rendering(raw, z_vals, rays_d):
+    """
+    Computes RGB from raw network output using standard volume rendering.
+    raw: [B, S, 4] (sigma, r, g, b)
+    z_vals: [B, S]
+    rays_d: [B, 3]
+    """
+    sigma = raw[..., 0]
+    rgb = raw[..., 1:]
+    
+    # Step sizes
+    dists = z_vals[..., 1:] - z_vals[..., :-1]
+    dists = torch.cat([dists, torch.tensor([1e10]).to(z_vals.device).expand_as(dists[..., :1])], -1)
+    
+    # Alpha
+    alpha = 1.0 - torch.exp(-sigma * dists)
+    
+    # Transmittance
+    T = torch.cumprod(torch.exp(-sigma * dists), dim=-1)
+    T = torch.cat([torch.ones_like(T[..., :1]), T[..., :-1]], dim=-1)
+    
+    # Weights
+    weights = alpha * T
+    
+    # Composite
+    rgb_map = torch.sum(weights[..., None] * rgb, dim=-2)
+    
+    return rgb_map
