+                m_ar = alpha_margin * abs(d_r_k1 - d_r_k2)
+                loss_val = max(d_r_k1 - d_r_k2 + m_ar, 0)
+                l_dof += loss_val
+            
+            # Depth Structural Consistency
+            # KNN on depth values in local region
+            for k1 in range(num_pixels):
+                neighbors = get_knn_depth_neighbors(depth_priors[view['id']], k1, k=3)
+                for k2 in neighbors:
+                    d_r_k1 = h_rendered[k1]
+                    d_r_k2 = h_rendered[k2]
