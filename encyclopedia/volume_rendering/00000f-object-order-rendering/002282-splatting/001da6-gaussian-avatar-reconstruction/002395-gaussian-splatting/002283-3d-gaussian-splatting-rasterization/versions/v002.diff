+                    isect_ids.append((c, n, ty, tx))
+                    flatten_ids.append(n)
+    return np.array(isect_ids), np.array(flatten_ids)
+
+def compute_alphas(opacities_cn, means2d, conics, width, height):
+    C, N, _ = means2d.shape
+    alphas = np.zeros((C, N, height, width))
