+        # A_v = sum(pj * pj^T)
+        # b_v = sum(fj * pj)
+        # where pj = vj - v, fj = fj - f
+        
+        A = np.zeros((2, 2))
+        b = np.zeros(2)
+        
+        fv = features[v_id]
+        
+        for n_id in neighbors:
+            vn = vertices[n_id]
+            fn = features[n_id]
+            
