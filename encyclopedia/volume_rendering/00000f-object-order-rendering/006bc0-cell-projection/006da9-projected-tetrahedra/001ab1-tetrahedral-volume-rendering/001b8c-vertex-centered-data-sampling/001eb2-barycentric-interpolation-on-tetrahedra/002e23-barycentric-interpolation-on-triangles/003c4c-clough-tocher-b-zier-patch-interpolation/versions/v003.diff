+            
+            # Outer product dp * dp^T
+            A += np.outer(dp, dp)
+            
+            # df * dp^T (result is vector)
+            b += df * dp
+            
+        # Solve A * grad = b
+        # Analytical solution for 2x2:
+        # det = A00*A11 - A01*A10
+        det = A[0,0]*A[1,1] - A[0,1]*A[1,0]
+        
