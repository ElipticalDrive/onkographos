+def hsv_to_rgb(h, s, v):
+    hue_norm = h / 60.0
+    sector = int(hue_norm)
+    ff = hue_norm - float(sector)
+    p = v * (1.0 - s)
+    q = v * (1.0 - (s * ff))
+    t = v * (1.0 - (s * (1.0 - ff)))
+    if sector == 0: return (v, t, p)
+    elif sector == 1: return (q, v, p)
+    elif sector == 2: return (p, v, t)
+    elif sector == 3: return (p, q, v)
+    elif sector == 4: return (t, p, v)
+    elif sector == 5: return (v, p, q)
+    else: return (0.0, 0.0, 0.0)
