+    // Vertex 0: (-dx, dy), UV (0,0)
+    GS_OUT v0;
+    v0.pos = corLoc + float4(-dx, dy, 0, 0);
+    v0.uv = float2(0, 0);
+    v0.col = input[0].col;
+    outStream.Append(v0);
