+    v1.pos = corLoc + float4(dx, dy, 0, 0);
+    v1.uv = float2(1, 0);
+    v1.col = input[0].col;
+    outStream.Append(v1);
+    
+    // Vertex 2: (-dx, -dy), UV (0,1)
+    GS_OUT v2;
+    v2.pos = corLoc + float4(-dx, -dy, 0, 0);
+    v2.uv = float2(0, 1);
+    v2.col = input[0].col;
+    outStream.Append(v2);
+    
+    // Vertex 3: (dx, -dy), UV (1,1)
+    GS_OUT v3;
+    v3.pos = corLoc + float4(dx, -dy, 0, 0);
+    v3.uv = float2(1, 1);
+    v3.col = input[0].col;
+    outStream.Append(v3);
+    
+    outStream.RestartStrip();
+}
