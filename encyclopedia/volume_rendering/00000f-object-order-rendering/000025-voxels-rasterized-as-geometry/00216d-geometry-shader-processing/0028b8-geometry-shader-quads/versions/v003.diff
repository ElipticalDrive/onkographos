-| 2 | -Z | (0, 0, 1) | (0, 1, 0) |
-| 3 | +X | (1, 0, 0) | (0, 0, 1) |
-| 4 | -X | (1, 0, 0) | (0, 1, 0) |
-| 5 | -Y | (0, 1, 0) | (1, 0, 0) |
