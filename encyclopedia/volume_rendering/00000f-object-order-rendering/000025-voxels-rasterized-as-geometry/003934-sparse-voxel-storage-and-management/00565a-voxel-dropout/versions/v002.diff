+def compute_geometry_consistency_loss(active_voxels, full_scale_depth, full_scale_normal):
+    """Computes depth and normal consistency loss for the active voxel subset."""
+    loss = 0.0
+    for voxel in active_voxels:
+        local_depth = voxel.compute_depth()
+        local_normal = voxel.compute_normal()
+        depth_error = (local_depth - full_scale_depth[voxel.id]) ** 2
+        normal_error = 1.0 - local_normal.dot(full_scale_normal[voxel.id])
+        loss += depth_error + normal_error
+    return loss / len(active_voxels)
