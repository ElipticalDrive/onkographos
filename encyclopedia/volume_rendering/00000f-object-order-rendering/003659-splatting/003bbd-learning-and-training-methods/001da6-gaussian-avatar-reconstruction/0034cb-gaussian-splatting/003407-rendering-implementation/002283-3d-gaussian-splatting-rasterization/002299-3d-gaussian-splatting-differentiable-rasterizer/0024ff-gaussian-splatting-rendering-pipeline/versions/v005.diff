+def split_features(feature_tensor, channel_widths):
+    """
+    Split a feature tensor into components based on channel widths.
+    """
+    start = 0
+    components = []
+    for width in channel_widths:
+        end = start + width
+        components.append(feature_tensor[..., start:end])
+        start = end
