+    b = cov_2d[:, :, 0, 1]
+    c = cov_2d[:, :, 1, 0]
+    d = cov_2d[:, :, 1, 1]
+    
+    det = a * d - b * c
+    # Add epsilon for stability
+    det = mx.maximum(det, 1e-6)
+    
+    inv_a = d / det
+    inv_b = -b / det
+    inv_c = -c / det
+    inv_d = a / det
