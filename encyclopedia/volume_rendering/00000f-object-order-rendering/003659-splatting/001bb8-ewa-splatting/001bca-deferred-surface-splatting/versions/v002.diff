+
+**Pseudocode (Finalization Pass):**
+```python
+def finalization_pass(color_texture, normal_texture, depth_texture, projection_matrix_inv, viewport, smooth, multisampling):
+    res = vec4(0.0)
+    if multisampling:
+        itexture_uv = textureSize(color_texture, 0) * In.texture_uv
+        for i in range(4):
+            pixel = texelFetch(color_texture, itexture_uv + vec2(i), 0)
+            if smooth:
+                normal = normalize(texelFetch(normal_texture, itexture_uv + vec2(i), 0))
+                depth = texelFetch(depth_texture, itexture_uv + vec2(i), 0)
+            if pixel.a > 0.0:
+                p_ndc = vec4(viewport.xy + pixel.xy * viewport.zw, depth.r, 1.0)
+                v_eye = (projection_matrix_inv * p_ndc).xyz / p_ndc.w
+                if smooth:
+                    res += vec4(lighting(normal, v_eye, pixel.rgb / pixel.a, material_shininess), 1.0)
+                else:
+                    res += vec4(pixel.rgb / pixel.a, 1.0)
+            else:
+                res += vec4(1.0)
+        frag_color = sqrt(res / 4.0)
+    else:
+        pixel = texture(color_texture, In.texture_uv)
+        if smooth:
+            normal = normalize(texture(normal_texture, In.texture_uv))
+            depth = texture(depth_texture, In.texture_uv)
+        if pixel.a > 0.0:
+            p_ndc = vec4(viewport.xy + pixel.xy * viewport.zw, depth.r, 1.0)
+            v_eye = (projection_matrix_inv * p_ndc).xyz / p_ndc.w
+            if smooth:
+                res += vec4(lighting(normal, v_eye, pixel.rgb / pixel.a, material_shininess), 1.0)
+            else:
+                res += vec4(pixel.rgb / pixel.a, 1.0)
+        else:
+            res += vec4(1.0)
+        frag_color = sqrt(res)
+```
 
