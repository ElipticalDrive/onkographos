+def sample_rays(rays, num_samples, stratified=False):
+    # rays: (num_rays, 2, 3) -> (origin, direction)
+    # Generate points between z_near and z_far
+    z_near, z_far = 0.1, 10.0
+    if stratified:
+        t = torch.linspace(z_near, z_far, num_samples, device=rays.device)
+        t = t + torch.rand_like(t) * (z_far - z_near) / num_samples
+    else:
+        t = torch.linspace(z_near, z_far, num_samples, device=rays.device)
+    t = t.unsqueeze(0).expand(rays.shape[0], -1) # (num_rays, num_samples)
+    points = rays[:, 0:1, :] + t.unsqueeze(-1) * rays[:, 1:2, :] # (num_rays, num_samples, 3)
+    dt = torch.diff(torch.cat([torch.zeros_like(t[:, :1]), t], dim=1), dim=1) # (num_rays, num_samples)
+    return points, dt
+
+def importance_sample(points, densities, num_samples):
+    # densities: (num_rays, num_orig_samples, 1)
+    # Compute weights for sampling
+    weights = densities.squeeze(-1) + 1e-6
+    weights = weights / weights.sum(dim=1, keepdim=True)
+    indices = torch.multinomial(weights, num_samples, replacement=True)
+    new_points = torch.gather(points, 1, indices.unsqueeze(-1).expand(-1, -1, 3))
+    # Approximate dt for new samples
+    dt = torch.ones_like(new_points[:, :, 0]) * 0.1
+    return new_points, dt.unsqueeze(-1)
+
+def volumetric_render(points, densities, colors, dt):
+    # points: (num_rays, num_samples, 3)
+    # densities: (num_rays, num_samples, 1)
+    # colors: (num_rays, num_samples, 3)
+    # dt: (num_rays, num_samples, 1)
+    alpha = 1.0 - torch.exp(-densities * dt)
+    T = torch.cumprod(torch.cat([torch.ones_like(alpha[:, :1, :]), 1.0 - alpha[:, :-1, :]], dim=1), dim=1)
+    contributions = T * alpha * colors
+    rendered_colors = contributions.sum(dim=1)
+    return rendered_colors
 
