+def compute_primitive_space_intersection(surfel, o, d):
+    # Transform ray origin and direction to surfel's local frame
+    R_inv = surfel['R'].T
+    local_o = R_inv @ (o - surfel['mu'])
+    local_d = R_inv @ d
+    # Intersection parameter t in local frame
+    t_local = -local_o[2] / local_d[2]
+    u = local_o[0] + t_local * local_d[0]
+    v = local_o[1] + t_local * local_d[1]
+    return u, v
