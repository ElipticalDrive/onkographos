+
+```python
+import torch
+import numpy as np
+
+def train_spacetime_gaussians(dataset, opt, iteration, multiview, duration, loader, option="train_ours_full"):
+    """
+    Main training loop for SpacetimeGaussians.
+    """
+    # 1. Initialize Model
+    gaussians = getmodel(dataset.model, sh_degree=3, rgb_function="trbfunction") # [S1, unofficial]
+    
+    # 2. Initialize Scene Data
+    scene = Scene(
+        dataset=dataset, 
+        gaussians=gaussians, 
+        load_iteration=iteration, 
+        shuffle=False, 
+        multiview=multiview, 
+        duration=duration, 
+        loader=loader
+    ) # [S1, unofficial]
+    
+    # 3. Initialize Background Color
+    numchannels = 9 # [S1, unofficial]
+    background = torch.zeros(numchannels, dtype=torch.float32, device="cuda") # [S1, unofficial]
+    
+    # 4. Initialize Time Tensor
+    if gaussians.ts is None:
+        H, W = scene.cameras[0].image_size # Assuming camera has image_size attribute
+        gaussians.ts = torch.ones((1, 1, H, W), dtype=torch.float32, device="cuda") # [S1, unofficial]
+    
+    # 5. Get Rendering Pipeline
+    train_func, RasterizationSettings, Rasterizer = getrenderpip(option) # [S1, unofficial]
+    
+    # 6. Training Loop (simplified structure)
+    for iteration in range(total_iterations):
+        
+        # 6.1. Densification and Pruning Logic
+        if opt.densify == 1: # n3d mode
+            if iteration == 8001:
+                # Determine which Gaussians keep motion parameters
+                omegamask = gaussians.zero_omegabymotion() # [S1, unofficial]
+                gaussians.omegamask = omegamask
+            
+            if iteration > 8001:
+                # Freeze weights based on mask
+                # Freeze _omega for Gaussians where omegamask is True
+                # Freeze _rotation for Gaussians where omegamask is False
+                freezweightsbymasknounsqueeze(gaussians._omega, omegamask) # [S1, unofficial]
+                freezweightsbymasknounsqueeze(gaussians._rotation, ~omegamask) # [S1, unofficial]
+            
+            # Densification
+            if iteration > opt.densify_from_iter and iteration % opt.densification_interval == 0:
+                if flag < opt.desicnt: # [S1, unofficial]
+                    size_threshold = 20 if iteration > opt.opacity_reset_interval else None # [S1, unofficial]
+                    gaussians.densify_pruneclone(
+                        grad_threshold=opt.densify_grad_threshold,
+                        opthr=opt.opthr,
+                        cameras_extent=scene.cameras_extent,
+                        size_threshold=size_threshold
+                    ) # [S1, unofficial]
+            
+            # Pruning
+            if flag >= opt.desicnt and iteration < 7000: # [S1, unofficial]
+                gaussians.prune_opaque(opthr=opt.opthr) # [S1, unofficial]
+            
+            # Opacity Reset
+            if iteration % 3000 == 0: # [S1, unofficial]
+                gaussians.reset_opacity() # [S1, unofficial]
+            
+            # Final Freezing and Pruning
+            if iteration >= opt.densify_until_iter: # [S1, unofficial]
+                freezweightsbymasknounsqueeze(gaussians._omega, omegamask) # [S1, unofficial]
+                freezweightsbymasknounsqueeze(gaussians._rotation, ~omegamask) # [S1, unofficial]
+                if iteration % 1000 == 500: # [S1, unofficial]
+                    # Prune points with Z-coordinate < 4.5
+                    mask = gaussians._xyz[:, 2] >= 4.5 # [S1, unofficial]
+                    gaussians.prune_by_mask(mask) # [S1, unofficial]
+        
+        elif opt.densify == 3: # [S1, unofficial]
