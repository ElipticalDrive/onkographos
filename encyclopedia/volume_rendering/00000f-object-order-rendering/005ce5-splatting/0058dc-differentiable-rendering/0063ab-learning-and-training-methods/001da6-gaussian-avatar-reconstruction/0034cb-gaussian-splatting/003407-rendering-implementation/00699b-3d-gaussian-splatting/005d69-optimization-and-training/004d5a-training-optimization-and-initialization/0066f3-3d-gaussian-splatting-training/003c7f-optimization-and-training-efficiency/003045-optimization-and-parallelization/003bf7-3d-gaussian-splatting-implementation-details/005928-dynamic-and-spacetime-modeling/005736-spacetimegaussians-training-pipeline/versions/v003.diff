+        rendering = train_func(
+            gaussians=gaussians,
+            camera=camera,
+            background=background,
+            scaling_modifier=1.0, # [S1, unofficial]
+            basicfunction="trbfunction", # [S1, unofficial]
+            GRsetting=RasterizationSettings, # [S1, unofficial]
+            GR=Rasterizer, # [S1, unofficial]
+            time=time
+        ) # [S1, unofficial]
+        
+        # 6.4. Compute Loss
+        gt_image = image
+        loss = compute_loss(rendering, gt_image, opt) # [S1, unofficial]
+        
+        # 6.5. Backpropagate and Update
+        loss.backward()
+        optimizer.step()
+        optimizer.zero_grad()
+        
