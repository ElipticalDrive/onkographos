+def mlp_forward(theta, x, r, s, v, L=10):
+    """Standard 4-layer MLP forward pass. First 3 layers shared (64 units, ReLU, Xavier init), last 3 are single-layer heads."""
+    x_enc = positional_encoding(x, L)
+    v_enc = positional_encoding(v, L)
