+**Pseudocode:**
+```python
+def mini_splatting_optimization(images, poses, initial_gaussians, N_max):
+    gaussians = initial_gaussians
+    T_total = 30000
+    T_dense = 15000
+    T_simp1 = 15000
+    T_simp2 = 20000
+    sh_enabled = False
+    sh_degree = 0
+
+    for t in range(1, T_total + 1):
+        # 1. Render and compute loss
+        rendered_images = rasterize(gaussians, poses)
+        loss = compute_loss(rendered_images, images)
+        gradients = backpropagate(loss, gaussians)
+
+        # 2. Update parameters
+        update_gaussian_parameters(gaussians, gradients)
+
+        # 3. Densification phase
+        if t < T_dense:
+            if not sh_enabled:
+                disable_sh(gaussians)
+            blur_mask = detect_blur(rendered_images)
+            split_gaussians_in_blur(gaussians, blur_mask)
+            reinitialize_with_depth(gaussians)
+            gaussians = enforce_count(gaussians, N_max, mode='prune_least_important')
+
+        # 4. Simplification phases
+        if t == T_simp1 or t == T_simp2:
+            if t == T_simp1:
+                enable_sh(gaussians)
+                increase_sh_degree(gaussians)
+            gaussians = intersection_preserving_simplify(gaussians)
+            gaussians = gaussian_sampling_simplify(gaussians)
+            gaussians = enforce_count(gaussians, N_max, mode='prune_low_contribution')
+
+    return gaussians
+```
