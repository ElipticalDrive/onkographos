-    ```python
-    def EncodeMorton2D_16x16(x: int, y: int) -> int:
-        # x, y are 4-bit integers (0 <= x, y < 16)
-        t = ((y & 0xF) << 8) | (x & 0xF)
-        t = (t ^ (t << 2)) & 0x3333
-        t = (t ^ (t << 1)) & 0x5555
-        return (t | (t >> 7)) & 0xFF
