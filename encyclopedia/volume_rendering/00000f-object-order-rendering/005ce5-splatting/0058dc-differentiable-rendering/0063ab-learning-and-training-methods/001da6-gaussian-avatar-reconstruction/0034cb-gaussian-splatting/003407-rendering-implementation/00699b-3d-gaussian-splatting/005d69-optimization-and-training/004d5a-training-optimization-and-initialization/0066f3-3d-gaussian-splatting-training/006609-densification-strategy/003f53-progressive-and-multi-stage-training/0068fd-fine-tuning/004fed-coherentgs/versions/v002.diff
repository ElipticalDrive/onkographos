+    N = len(input_images)
+    
+    # 1. Initialization: Assign one Gaussian per pixel per image
+    # Structure: Gaussians[n][p] = {x, sigma, alpha, c}
+    # x is initialized using monocular depth
+    gaussians = {}
+    for n in range(N):
+        gaussians[n] = {}
+        H, W = input_images[n].shape[:2]
+        for y in range(H):
+            for x in range(W):
