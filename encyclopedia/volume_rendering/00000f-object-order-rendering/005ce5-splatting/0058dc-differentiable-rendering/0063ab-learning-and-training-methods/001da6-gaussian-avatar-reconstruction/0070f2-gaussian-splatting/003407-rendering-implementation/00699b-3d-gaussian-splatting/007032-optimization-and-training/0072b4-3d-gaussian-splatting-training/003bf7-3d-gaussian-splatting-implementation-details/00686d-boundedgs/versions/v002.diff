+def compute_projection_jacobian(camera, pos):
+    # Standard projection Jacobian computation
+    return camera.Jacobian(pos)
+
+def project_gaussian(params, i, camera):
+    # Project Gaussian i using camera
+    return camera.Project(params[i])
+
+def count_intersections(leaf, projected_attrs):
+    # Count intersections within leaf bounds
+    return sum(1 for attr in projected_attrs if intersects(leaf, attr))
+
+def pixel_count(leaf):
+    return (leaf[2] - leaf[0]) * (leaf[3] - leaf[1])
+
+def estimate_memory(n, p, t, b):
+    # Standard memory estimation function
+    return n * 8 + p * 4 + t * 16 + b * 4
+
+def find_intersections(leaf, projected_attrs):
+    return [attr for attr in projected_attrs if intersects(leaf, attr)]
+
+def rasterize(leaf, intersections):
+    # Standard rasterization
+    return leaf.Render(intersections)
+
+def compute_loss(pred, target, alpha):
+    return 0.8 * L1(pred, target) + 0.2 * (1 - SSIM(pred, target))
+
+def backward_rasterization(leaf, intersections, grad_loss):
+    return leaf.Backward(grad_loss)
+
+def backward_projection(attr, grad_proj):
+    return attr.Backward(grad_proj)
+
+def intersects(leaf, attr):
+    return leaf.overlaps(attr)
+
+def L1(pred, target):
+    return np.mean(np.abs(pred - target))
+
+def SSIM(pred, target):
+    return np.mean((2 * pred * target + 1) / (pred**2 + target**2 + 1))
