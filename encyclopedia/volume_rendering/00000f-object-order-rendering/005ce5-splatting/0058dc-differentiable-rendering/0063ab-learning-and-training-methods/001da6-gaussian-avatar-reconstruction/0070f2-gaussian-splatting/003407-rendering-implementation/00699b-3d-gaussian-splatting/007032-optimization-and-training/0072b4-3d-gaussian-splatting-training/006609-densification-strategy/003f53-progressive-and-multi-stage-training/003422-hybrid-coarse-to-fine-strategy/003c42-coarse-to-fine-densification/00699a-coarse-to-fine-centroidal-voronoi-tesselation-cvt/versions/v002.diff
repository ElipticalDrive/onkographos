 import numpy as np
 
+def generate_uniform_grid(bbox_min, bbox_max, res):
+    """Generates a coarse uniform grid of sites within the bounding box."""
+    x = torch.linspace(bbox_min[0], bbox_max[0], res)
+    y = torch.linspace(bbox_min[1], bbox_max[1], res)
+    z = torch.linspace(bbox_min[2], bbox_max[2], res)
+    grid = torch.stack(torch.meshgrid(x, y, z, indexing='ij'), dim=-1)
+    return grid.reshape(-1, 3)
+
+def initialize_sdf(sites):
+    """Initializes SDF values for sites. Values are typically learned parameters [G]."""
+    return torch.zeros(sites.shape[0], requires_grad=True)
+
+def initialize_features(sites):
+    """Initializes feature values for sites. Values are typically learned parameters [G]."""
+    return torch.zeros(sites.shape[0], 16, requires_grad=True) # 16 is a standard feature dim [G]
+
+def build_kd_tree(sites):
+    """Builds a KD-tree structure for fast KNN queries. Implemented via scipy.spatial or similar standard library [G]."""
+    from scipy.spatial import KDTree
+    return KDTree(sites.detach().cpu().numpy())
+
+def find_knn(kd_tree, sites, k):
+    """Finds K-nearest neighbors for all sites using the KD-tree."""
+    dists, indices = kd_tree.query(sites.detach().cpu().numpy(), k=k+1)
+    # Exclude self (index 0)
+    return indices[:, 1:], dists[:, 1:]
+
