+    # This requires argmax over the Gaussian list per pixel
+    max_weight_indices = torch.argmax(weights, dim=-1)
+    hard_depth = depths.gather(-1, max_weight_indices.unsqueeze(-1)).squeeze(-1)
+    return hard_depth
+
+def render_soft_depth(mu, s, q, alpha, c, camera):
+    """
+    Render a 'soft' (alpha-blended) depth map.
+    """
+    depths, weights = splat_gaussians(mu, s, q, alpha, c, camera)
+    # Soft depth is the weighted average of depths
+    soft_depth = torch.sum(depths * weights, dim=-1)
+    return soft_depth
