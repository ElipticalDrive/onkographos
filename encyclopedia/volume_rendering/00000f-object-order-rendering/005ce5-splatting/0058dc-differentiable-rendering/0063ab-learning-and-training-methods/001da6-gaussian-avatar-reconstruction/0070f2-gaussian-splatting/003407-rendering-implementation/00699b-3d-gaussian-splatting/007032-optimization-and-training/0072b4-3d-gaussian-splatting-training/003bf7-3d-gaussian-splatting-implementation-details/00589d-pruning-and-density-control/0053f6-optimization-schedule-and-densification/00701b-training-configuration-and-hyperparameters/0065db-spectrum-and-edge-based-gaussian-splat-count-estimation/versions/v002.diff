+def compute_gradients(image):
+    """Compute horizontal and vertical gradients using finite differences."""
+    height, width = len(image), len(image[0])
+    gx = [[0.0]*width for _ in range(height)]
+    gy = [[0.0]*width for _ in range(height)]
+    for r in range(height):
+        for c in range(width):
+            gx[r][c] = image[r][min(c+1, width-1)] - image[r][max(c-1, 0)]
+            gy[r][c] = image[min(r+1, height-1)][c] - image[max(r-1, 0)][c]
+    return gx, gy
 
