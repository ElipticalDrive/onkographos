+def unproject_3d(image, depth_map, pose):
+    """
+    Unprojects 2D image pixels to 3D world coordinates.
+    """
+    points_3d = []
+    for u, v in image.pixels:
+        depth = depth_map[u, v]
+        # Convert pixel to camera space
+        x_cam = (u - K[0,2]) * depth / K[0,0]
+        y_cam = (v - K[1,2]) * depth / K[1,1]
+        z_cam = depth
+        point_cam = np.array([x_cam, y_cam, z_cam, 1.0])
+        # Transform to world space
