+def render_darbf_splat(primitives, camera_view_matrix, image_dims):
+    # primitives: list of dicts with keys 'p' (3,), 'cov' (3,3), 'alpha' (float), 'color' (3,), 'sh' (list)
+    # camera_view_matrix: 4x4 transformation to camera space
+    # image_dims: (height, width)
+    out_color = np.zeros(image_dims + (3,))
+    out_alpha = np.zeros(image_dims)
+
+    # Step 1: Project 3D primitives to 2D and compute 2D covariance
+    projected_prims = []
+    for prim in primitives:
+        p_3d = prim['p']
+        cov_3d = prim['cov']
+        # Transform position and covariance to camera frame [G]
+        p_cam = camera_view_matrix[:3, :3] @ p_3d + camera_view_matrix[:3, 3]
+        cov_cam = camera_view_matrix[:3, :3] @ cov_3d @ camera_view_matrix[:3, :3].T
+        # Skip third row and column for 2D projection [S1]
+        cov_2d = cov_cam[:2, :2]
+        mu_2d = p_cam[:2]
+        projected_prims.append({'mu': mu_2d, 'cov': cov_2d, 'alpha': prim['alpha'], 'color': prim['color'], 'sh': prim['sh']})
+
+    # Step 5 (partial): Sort primitives by depth for correct blending [Parent]
+    projected_prims.sort(key=lambda p: p['mu'][2]) # Assuming z-depth in camera frame
+
+    # Step 2-4: Evaluate kernel and blend per pixel
+    for prim in projected_prims:
+        mu = prim['mu']
+        cov = prim['cov']
+        alpha = prim['alpha']
+        color = prim['color']
+        # Compute bounding box for efficient rasterization [G]
+        bbox = compute_bounding_box(mu, cov)
+        for y in range(bbox.y_min, bbox.y_max):
+            for x in range(bbox.x_min, bbox.x_max):
+                x_prime = np.array([x, y])
+                diff = x_prime - mu[:2]
+                # Mahalanobis distance squared [S1]
+                d_M_sq = diff @ np.linalg.inv(cov) @ diff
+                # Evaluate DARBF kernel (e.g., half-cosine) [S1]
+                xi = 2.0 # shape parameter
+                if d_M_sq < xi * np.pi / 2:
+                    K = np.cos(d_M_sq / xi)
+                else:
+                    K = 0.0
+                # Apply scalar correction factor [S1]
+                psi = 1.5 # precomputed from regression
+                sigma = alpha * psi * K
+                # Alpha blending [Parent]
+                out_color[y, x] += color * sigma * (1.0 - out_alpha[y, x])
+                out_alpha[y, x] += sigma
+    return out_color
