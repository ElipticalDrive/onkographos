+            'Sigma_3D_inv': Sigma_3D_inv,
+            'alpha': alpha,
+            'color': color,
+            'b_min_2d': b_min[:2],
+            'b_max_2d': b_max[:2]
+        })
+        
+    # 4. Rasterization
+    for g in accepted_gaussians:
+        mu_3D = g['mu_3D']
+        Sigma_3D_inv = g['Sigma_3D_inv']
+        alpha = g['alpha']
+        color = g['color']
+        b_min_2d = g['b_min_2d']
+        b_max_2d = g['b_max_2d']
