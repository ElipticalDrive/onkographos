+    cx, cy = K[0, 2], K[1, 2]
+    
+    # Projection: u = fx * x / z + cx, v = fy * y / z + cy
+    # Derivatives:
+    # du/dx = fx/z, du/dy = 0, du/dz = -fx*x/z^2
+    # dv/dx = 0, dv/dy = fy/z, dv/dz = -fy*y/z^2
+    
+    J = np.zeros((2, 3))
+    J[0, 0] = fx / z
+    J[0, 2] = -fx * x / (z**2)
+    J[1, 1] = fy / z
+    J[1, 2] = -fy * y / (z**2)
+    
+    return J
+
+def project_point(mu_cam, K):
+    """
+    Project 3D point in camera space to 2D image coordinates.
+    """
+    x, y, z = mu_cam
+    fx, fy = K[0, 0], K[1, 1]
+    cx, cy = K[0, 2], K[1, 2]
+    
+    u = fx * x / z + cx
+    v = fy * y / z + cy
+    
+    return np.array([u, v])
+
+def evaluate_sh(sh_coeffs, view_dir):
+    """
+    Evaluate spherical harmonics for a given viewing direction.
+    sh_coeffs: (3, 16) array, 3 channels, 16 coefficients per channel.
+    view_dir: (3,) normalized viewing direction vector.
+    """
+    # Convert view_dir to spherical coordinates (theta, phi)
+    theta = np.arccos(view_dir[2])
+    phi = np.arctan2(view_dir[1], view_dir[0])
+    
+    # Evaluate SH basis functions for band 3 (degree 0 to 3)
+    # There are 16 coefficients per channel
+    # Basis functions Y_l^m(theta, phi)
+    # This is a simplified placeholder; actual implementation requires explicit SH basis evaluation
+    sh_basis = evaluate_sh_basis(theta, phi, degree=3)
+    
+    # Color = sum(sh_coeffs[c, l] * sh_basis[l]) for c in 0..2
+    color = np.zeros(3)
+    for c in range(3):
+        color[c] = np.dot(sh_coeffs[c], sh_basis)
+        
+    return np.clip(color, 0, 1)
+
+def evaluate_sh_basis(theta, phi, degree):
+    """
+    Evaluate SH basis functions up to given degree.
+    Returns array of size (degree+1)^2
+    """
