+    
+    # Step 3: Compute Flattening Loss Gradient
+    # L_flatten = min(s_i)
+    # d(L_flatten)/d(s_i) is a one-hot vector at the index of the minimum scale
+    grad_s_flatten = np.zeros_like(gaussians.s)
+    for i in range(len(gaussians)):
+        idx = min_scale_indices[i]
+        grad_s_flatten[i, idx] = 1.0
+        
+    gradients['s'] += lambda_flatten * grad_s_flatten
+    
+    # Step 4: Compute Normal Consistency Loss Gradient
+    # L_normal = 1 - n_rendered . n_gauss
+    # We need to map world_normals to the pixels where they contribute.
