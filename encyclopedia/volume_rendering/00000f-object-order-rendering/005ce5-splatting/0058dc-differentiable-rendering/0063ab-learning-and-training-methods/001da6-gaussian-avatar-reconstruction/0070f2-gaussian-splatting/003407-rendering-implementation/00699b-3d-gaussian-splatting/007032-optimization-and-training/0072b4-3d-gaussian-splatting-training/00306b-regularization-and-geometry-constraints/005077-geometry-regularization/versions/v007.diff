+        'c': np.zeros_like(gaussians.c)
+    }
+    
+    # Step 1: Identify smallest scale component for each Gaussian
+    # s is shape (N, 3)
+    min_scale_indices = np.argmin(gaussians.s, axis=1) # Shape (N,)
