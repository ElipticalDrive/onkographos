+    # rotated by the Gaussian's rotation quaternion.
+    # Assuming standard basis vectors e_x, e_y, e_z
+    basis_vectors = np.array([[1, 0, 0], [0, 1, 0], [0, 0, 1]])
+    
+    # Get the basis vector for the smallest scale for each Gaussian
+    # This results in shape (N, 3)
+    local_normals = basis_vectors[min_scale_indices] 
+    
+    # Rotate local normals to world space using quaternions
+    # Assuming a function rotate_vector_by_quaternion exists or is implemented
+    world_normals = np.array([
+        rotate_vector_by_quaternion(local_normals[i], gaussians.q[i]) 
+        for i in range(len(gaussians))
