 import torch.nn.functional as F
 
+class STEAssign(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, features, codes):
+        dists = torch.cdist(features, codes)  # (N, k)
+        probs = torch.softmax(-dists, dim=1) # Softmax relaxation for backward
+        indices = torch.argmax(probs, dim=1) # Argmax for forward
+        selected = codes[indices]            # Straight-through: forward uses hard assignment
+        ctx.save_for_backward(probs)
+        return selected, indices
+
+    @staticmethod
+    def backward(ctx, grad_selected, grad_indices):
+        probs, = ctx.saved_tensors
+        # Gradients flow through the softmax relaxation
+        return probs @ grad_selected, None
+
+def project_to_camera(world_pts, cam_pose):
+    """Projects world coordinates (N,3) to camera 2D coordinates (N,2) using relative pose."""
+    ones = torch.ones(world_pts.size(0), 1, device=world_pts.device)
+    homo_pts = torch.cat([world_pts, ones], dim=1)  # (N, 4)
+    cam_pts = (cam_pose @ homo_pts.T).T              # (N, 4)
+    return cam_pts[:, :2] / cam_pts[:, 3:4]          # (N, 2) normalized coordinates
+
+def sample_features(feature_map, cam_coords):
+    """Samples features from spatial map at normalized camera coordinates (N,2)."""
+    # Normalize to [-1, 1] for grid_sample
+    norm_coords = 2.0 * cam_coords - 1.0
+    norm_coords = norm_coords.unsqueeze(1).unsqueeze(1)  # (N, 1, 1, 2)
+    # feature_map: (B, d, H/k, W/k)
+    sampled = F.grid_sample(feature_map, norm_coords, align_corners=True)
+    return sampled.squeeze(-1).squeeze(-1).permute(0, 2, 1)  # (B, N, d)
