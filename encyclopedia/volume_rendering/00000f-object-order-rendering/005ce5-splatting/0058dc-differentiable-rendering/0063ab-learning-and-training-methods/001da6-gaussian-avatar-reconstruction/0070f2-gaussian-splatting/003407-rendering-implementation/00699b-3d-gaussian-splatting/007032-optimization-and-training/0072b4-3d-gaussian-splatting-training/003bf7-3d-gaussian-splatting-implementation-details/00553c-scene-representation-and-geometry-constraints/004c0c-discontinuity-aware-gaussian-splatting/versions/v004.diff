+    """Computes implicit polynomial coefficients for a cubic Bezier curve from control points."""
+    # Standard algebraic implicitization for cubic Bezier curves (O(1) arithmetic)
+    # Returns dict of gamma coefficients matching B_imp(x,y) = 0
+    x0, y0 = w0
+    x1, y1 = w1
+    x2, y2 = w2
+    x3, y3 = w3
+    
+    # Coefficients derived via standard implicitization formulas
+    a = x0 - 3*x1 + 3*x2 - x3
+    b = y0 - 3*y1 + 3*y2 - y3
+    c = x0 - 2*x1 + x2
+    d = y0 - 2*y1 + y2
+    e = x0 - x1
+    f = y0 - y1
+    
+    gamma_xxx = b**3
+    gamma_xxy = -3*b**2 * a
+    gamma_xyy = 3*b * a**2
+    gamma_yyy = -a**3
+    
+    gamma_xx = 3*b**2 * (3*c - e) - 6*b*a * (3*d - f)
+    gamma_xy = -6*b*a * (3*c - e) + 6*a**2 * (3*d - f)
+    gamma_yy = 3*a**2 * (3*d - f) - 3*b**2 * (3*e)
