+    gamma_x = 3*b**2 * (3*e) - 6*b*a * (3*f)
+    gamma_y = -6*b*a * (3*e) + 6*a**2 * (3*f)
+    
+    gamma_0 = 3*b**2 * (3*f) - 3*a**2 * (3*e)
+    
+    return {
