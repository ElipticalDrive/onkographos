+def compute_binoms_table(max_n=50):
+    """Precompute binomial coefficients."""
+    binoms = torch.zeros(max_n + 1, max_n + 1, dtype=torch.float32)
+    for n in range(max_n + 1):
+        for k in range(n + 1):
+            binoms[n, k] = math.comb(n, k)
+    return binoms
