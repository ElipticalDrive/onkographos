+    min_scale_idx = torch.argmin(scales, dim=1, keepdim=True)
+    axes = torch.eye(3).to(scales.device).unsqueeze(0).expand(scales.shape[0], -1, -1)
+    normals_cam = axes[torch.arange(scales.shape[0]), min_scale_idx.squeeze()]
