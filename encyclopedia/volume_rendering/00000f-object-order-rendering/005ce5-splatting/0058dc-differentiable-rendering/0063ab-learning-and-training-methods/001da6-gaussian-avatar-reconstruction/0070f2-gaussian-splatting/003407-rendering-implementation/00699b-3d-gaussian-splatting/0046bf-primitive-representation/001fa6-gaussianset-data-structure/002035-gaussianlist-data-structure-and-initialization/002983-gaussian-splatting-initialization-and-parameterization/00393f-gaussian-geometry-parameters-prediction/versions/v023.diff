+def predict_gaussian_geometry(input_images, camera_poses, depth_estimator, sparse_3d_cnn, d_pos, d_opa, d_cov, v_size):
+    """
+    Predicts Gaussian geometry parameters from input images.
+    
+    Args:
+        input_images: List of N RGB images {I_n}
+        camera_poses: List of camera poses with intrinsics {K_n} and extrinsics {T_n}
+        depth_estimator: Function to predict depth maps
+        sparse_3d_cnn: Sparse 3D CNN to extract feature volume
+        d_pos, d_opa, d_cov: MLP heads for position, opacity, covariance
+        v_size: Voxel size for scaling position offset
+        
+    Returns:
+        Gaussians: List of Gaussian parameters (mu, alpha, Sigma, color)
+    """
+    N = len(input_images)
+    
+    # Step 1 & 2: Depth Estimation and Global Point Cloud Construction
+    depth_maps = [depth_estimator(I) for I in input_images]
+    # Apply depth consistency check and 3D filters (implementation specific)
+    filtered_depth_maps = apply_filters(depth_maps)
+    
+    P = []
+    for n in range(N):
+        I_n = input_images[n]
+        D_n = filtered_depth_maps[n]
+        K_n = camera_poses[n].intrinsic
+        T_n = camera_poses[n].extrinsic
+        # Unproject pixels to 3D
+        points = unproject_pixels(I_n, D_n, T_n, K_n)
+        P.extend(points)
+    
+    # Step 3: Pruning
+    P = uniform_filter(P)
+    P = statistical_filter(P)
+    
+    # Step 4: Feature Volume Extraction
+    F = sparse_3d_cnn(P)
+    
+    # Step 5 & 6: Geometry Parameters Prediction
+    gaussians = []
+    for p in P:
+        mu_init = p
+        delta_mu_prev = 0.0
+        
+        # Inference: Recursive update for convergence
+        # Execute twice for convergence
+        for _ in range(2):
+            # Query feature at updated position
+            query_pos = mu_init + delta_mu_prev
+            f_i = trilinear_interpolate(F, query_pos)
+            
+            # Predict offset
+            delta_mu = tanh(d_pos(f_i)) * v_size
+            
+            # Update position
+            mu = mu_init + delta_mu
+            
+            # Query feature at converged position for alpha and Sigma
+            f_i_converged = trilinear_interpolate(F, mu)
+            alpha = d_opa(f_i_converged)
+            Sigma = d_cov(f_i_converged)
+            
+            delta_mu_prev = delta_mu # For next iteration if needed, but here we just need final mu
+        
+        # Step 7: Color Prediction (Simplified)
+        # Retrieve 2D context from K nearest views
+        color = predict_color_from_2d_context(mu, alpha, Sigma, input_images, K=3)
