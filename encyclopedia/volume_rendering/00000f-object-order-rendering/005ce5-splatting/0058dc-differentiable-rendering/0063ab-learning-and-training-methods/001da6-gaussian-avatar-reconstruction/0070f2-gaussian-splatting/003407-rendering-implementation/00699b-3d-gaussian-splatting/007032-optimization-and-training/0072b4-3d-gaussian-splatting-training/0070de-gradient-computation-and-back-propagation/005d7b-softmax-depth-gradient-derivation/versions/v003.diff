+```python
+def softmax_depth_forward(N, alphas, depths, beta):
+    T = [0.0] * (N + 1)
+    T[1] = 1.0
+    for k in range(2, N + 1):
+        T[k] = T[k-1] * (1.0 - alphas[k-1])**0.5
+    w = [T[k] * alphas[k] for k in range(1, N + 1)]
+    S = sum(w[i] * math.exp(beta * w[i]) for i in range(N))
+    numerator = sum(w[i] * math.exp(beta * w[i]) * depths[i] for i in range(N))
+    d_softmax = math.log(numerator / S)
+    return T, w, S, d_softmax
+
+def softmax_depth_backward(N, alphas, depths, beta, grad_d_softmax, T, w, S, d_softmax):
+    U = [(1.0 + beta * w[i]) * math.exp(beta * w[i]) for i in range(N)]
+    A_l = [0.0] * (N + 1)
+    A_r = [0.0] * (N + 1)
+    for k in range(1, N + 1):
+        A_l[k] = alphas[k-1] * U[k-1] * depths[k-1] + (1.0 - alphas[k-1]) * A_l[k-1]
+        A_r[k] = alphas[k-1] * U[k-1] + (1.0 - alphas[k-1]) * A_r[k-1]
+    grad_alpha = [0.0] * (N + 1)
+    grad_depth = [0.0] * (N + 1)
+    for k in range(1, N + 1):
+        grad_depth[k] = (w[k-1] * math.exp(beta * w[k-1])) / S * grad_d_softmax
+        denom = 1.0 - alphas[k-1]
+        grad_alpha[k] = (T[k] * U[k-1] * depths[k-1] - A_l[k] / denom - 
+                         d_softmax * (T[k] * U[k-1] - A_r[k] / denom)) * grad_d_softmax
+    return grad_alpha, grad_depth
