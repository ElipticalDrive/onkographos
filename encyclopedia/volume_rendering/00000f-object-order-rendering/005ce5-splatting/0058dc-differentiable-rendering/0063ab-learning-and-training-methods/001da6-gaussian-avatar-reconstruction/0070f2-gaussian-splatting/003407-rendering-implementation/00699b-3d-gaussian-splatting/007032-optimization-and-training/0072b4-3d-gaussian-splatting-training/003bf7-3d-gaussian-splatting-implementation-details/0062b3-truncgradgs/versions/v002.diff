+def compute_gaussian_and_grad(mean_2d, cov_inv_2d, point_2d):
+    """Computes G and dG/dDelta_x at a given point using the conic form."""
+    dx = mean_2d[0] - point_2d[0]
+    dy = mean_2d[1] - point_2d[1]
+    a, b = cov_inv_2d[0, 0], cov_inv_2d[0, 1]
+    c = cov_inv_2d[1, 1]
+    exponent = -0.5 * (a * dx**2 + c * dy**2) - b * dx * dy
+    G = math.exp(exponent)
+    dG_dx = G * (a * dx + b * dy)
+    dG_dDelta_x = -dG_dx
+    return G, dG_dDelta_x
