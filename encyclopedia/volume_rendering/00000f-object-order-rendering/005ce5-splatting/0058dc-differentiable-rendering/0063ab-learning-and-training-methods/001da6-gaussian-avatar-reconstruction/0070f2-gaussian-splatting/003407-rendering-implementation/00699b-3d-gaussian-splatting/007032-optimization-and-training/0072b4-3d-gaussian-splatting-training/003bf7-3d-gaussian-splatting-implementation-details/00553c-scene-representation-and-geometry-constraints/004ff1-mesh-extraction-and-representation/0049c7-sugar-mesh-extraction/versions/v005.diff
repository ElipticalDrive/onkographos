+def standard_gaussian_rasterize(gaussians, images, cameras):
+    # Standard differentiable Gaussian rasterization [G]
+    rendered = []
+    for img, cam in zip(images, cameras):
+        projected = project_gaussians_2d(gaussians, cam)
+        sorted_gaussians = sort_by_depth(projected, cam)
+        pixel_colors = alpha_composite(sorted_gaussians, img.shape)
+        rendered.append(pixel_colors)
+    return rendered
