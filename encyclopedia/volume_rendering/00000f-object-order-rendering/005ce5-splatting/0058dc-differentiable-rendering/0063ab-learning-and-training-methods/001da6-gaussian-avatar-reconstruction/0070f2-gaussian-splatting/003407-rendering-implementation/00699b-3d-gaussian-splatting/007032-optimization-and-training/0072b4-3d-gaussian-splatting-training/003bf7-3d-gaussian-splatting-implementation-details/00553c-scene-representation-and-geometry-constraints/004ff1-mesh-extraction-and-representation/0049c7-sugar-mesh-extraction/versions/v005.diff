+def alpha_composite(sorted_gaussians, shape):
+    # Standard front-to-back alpha compositing [G]
+    image = np.zeros(shape[:2] + (3,))
+    for g in sorted_gaussians:
+        mu = g['mu']
+        if 0 <= mu[0] < shape[1] and 0 <= mu[1] < shape[0]:
+            alpha = g['alpha']
+            color = g['color']
+            image[mu[1], mu[0]] = image[mu[1], mu[0]] * (1 - alpha) + color * alpha
+    return image
