+def project_gaussians_2d(gaussians, cam):
+    # Standard 3D to 2D projection with covariance transformation [G]
+    projected = []
+    for g in gaussians:
+        p = cam.extrinsic @ g.mu
+        if p[2] > 0:
+            p2d = cam.intrinsic @ (p / p[2])
+            cov2d = cam.intrinsic @ (cam.rotation @ g.cov @ cam.rotation.T) @ cam.intrinsic.T
+            projected.append({'mu': p2d[:2], 'cov': cov2d[:2, :2], 'alpha': g.alpha, 'color': g.color})
+    return projected
+
+def sort_by_depth(projected, cam):
+    # Sort by depth for correct alpha blending [G]
+    return sorted(projected, key=lambda g: cam.extrinsic[2, 3] @ g['mu'])
