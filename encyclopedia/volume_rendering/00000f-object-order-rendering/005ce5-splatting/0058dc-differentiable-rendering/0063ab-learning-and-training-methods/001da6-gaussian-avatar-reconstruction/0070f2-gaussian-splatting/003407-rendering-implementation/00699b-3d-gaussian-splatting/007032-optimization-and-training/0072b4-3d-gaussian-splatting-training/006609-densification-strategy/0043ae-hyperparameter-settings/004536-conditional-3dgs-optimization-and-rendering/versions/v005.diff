+def project_to_image_plane(mu, Sigma, K, R_w2c, t_w2c):
+    """Projects 3D mean and covariance to 2D image plane."""
+    mu_cam = [R_w2c[i][j]*mu[j] + t_w2c[i] for i in range(3) for j in range(3)]
+    Sigma_cam = [[sum(R_w2c[i][k]*Sigma[k][l]*R_w2c[j][l] for l in range(3)) for l in range(3)] for i in range(3) for j in range(3)]
+    x, y, z = mu_cam
+    if z <= 0.01:
+        return None, None
+    f_x, f_y = K[0][0], K[1][1]
+    c_x, c_y = K[0][2], K[1][2]
+    T = [[f_x/z, 0, -f_x*x/(z*z)],
+         [0, f_y/z, -f_y*y/(z*z)],
+         [0, 0, 0]]
+    Sigma_2d = [[sum(T[i][k]*Sigma_cam[k][l]*T[j][l] for l in range(2)) for l in range(2)] for i in range(2) for j in range(2)]
+    mu_2d = [f_x * (x/z) + c_x, f_y * (y/z) + c_y]
+    return mu_2d, Sigma_2d
+
+def splat_2d_gaussians(gaussians, width, height):
+    """Renders 2D Gaussians with depth-aware alpha blending."""
+    gaussians_sorted = sorted(gaussians, key=lambda g: g['z'])
+    image = [[0.0, 0.0, 0.0] for _ in range(height * width)]
+    alpha_accum = [[0.0] for _ in range(height * width)]
+    for g in gaussians_sorted:
+        mu, Sigma, color, alpha, z = g['mu'], g['Sigma'], g['color'], g['alpha'], g['z']
+        std_x, std_y = math.sqrt(Sigma[0][0]), math.sqrt(Sigma[1][1])
+        bbox = [max(0, int(mu[0] - 3*std_x)), max(0, int(mu[1] - 3*std_y)),
+                min(width, int(mu[0] + 3*std_x)), min(height, int(mu[1] + 3*std_y))]
+        for y in range(bbox[1], bbox[3]):
+            for x in range(bbox[0], bbox[2]):
+                dx, dy = x - mu[0], y - mu[1]
+                exp = -0.5 * (dx*dx/Sigma[0][0] + dy*dy/Sigma[1][1])
+                if exp > -4.0:
+                    idx = y * width + x
+                    contrib = alpha * math.exp(exp)
+                    new_alpha = alpha_accum[idx][0] + contrib
+                    if new_alpha > 0.999:
+                        image[idx] = color
+                        alpha_accum[idx][0] = 1.0
+                    else:
+                        image[idx] = [c1*alpha_accum[idx][0] + c2*contrib for c1, c2 in zip(image[idx], color)]
+                        alpha_accum[idx][0] = new_alpha
+    return image
