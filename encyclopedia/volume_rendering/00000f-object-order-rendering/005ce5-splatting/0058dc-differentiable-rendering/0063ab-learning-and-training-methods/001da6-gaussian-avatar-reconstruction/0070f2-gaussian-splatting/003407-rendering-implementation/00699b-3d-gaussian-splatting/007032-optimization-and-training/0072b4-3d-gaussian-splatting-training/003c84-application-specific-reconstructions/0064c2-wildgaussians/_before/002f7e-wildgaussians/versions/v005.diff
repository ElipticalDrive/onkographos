+class HashGrid:
+    """Minimal self-contained hash grid implementation for pseudocode."""
+    def __init__(self, n_levels, n_features_per_level, log2_hashmap_size, resolution_min, resolution_max):
+        self.n_levels = n_levels
+        self.n_features = n_features_per_level
+        self.hashmap_size = 2 ** log2_hashmap_size
+        self.resolutions = [int(resolution_min * (resolution_max / resolution_min) ** (i / (n_levels - 1))) for i in range(n_levels)]
+        self.grids = [torch.randn(self.hashmap_size, self.n_features) for _ in range(n_levels)]
+
+    def __call__(self, x):
+        # x shape: (N, 3)
+        embeddings = []
+        for i, res in enumerate(self.grids):
+            indices = torch.abs(torch.round(x * res.shape[0] / 2 + res.shape[0] / 2).long()) % self.hashmap_size
+            idx = indices[:, 0] % self.hashmap_size
+            embeddings.append(self.grids[i][idx])
+        return torch.cat(embeddings, dim=-1)
 
