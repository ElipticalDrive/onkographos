+            for g in gs_in_tile:
+                # Calculate splatting opacity alpha_i
+                x = p - g.center
+                alpha_i = g.opacity * math.exp(-0.5 * x.T @ np.linalg.inv(g.projected_covariance) @ x)
+                
+                # Composite
+                color += g.color * alpha_i * (1 - alpha)
+                alpha += alpha_i * (1 - alpha)
+                
+                if alpha > 0.99: # Early exit optimization
+                    break
+            return color
 ```
 
