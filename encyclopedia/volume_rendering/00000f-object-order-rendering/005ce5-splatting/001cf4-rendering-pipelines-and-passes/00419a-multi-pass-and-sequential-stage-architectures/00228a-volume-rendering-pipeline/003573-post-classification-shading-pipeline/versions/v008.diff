+def intersect_ray_aabb(origin, direction, bounds):
+    """Standard slab method for ray-AABB intersection."""
+    t_min = -float('inf')
+    t_max = float('inf')
+    for i in range(3):
+        if direction[i] == 0:
+            if origin[i] < bounds.min[i] or origin[i] > bounds.max[i]:
+                return (float('inf'), -float('inf'))
+        else:
+            t1 = (bounds.min[i] - origin[i]) / direction[i]
+            t2 = (bounds.max[i] - origin[i]) / direction[i]
+            t_min = max(t_min, min(t1, t2))
+            t_max = min(t_max, max(t1, t2))
+    return (t_min, t_max)
