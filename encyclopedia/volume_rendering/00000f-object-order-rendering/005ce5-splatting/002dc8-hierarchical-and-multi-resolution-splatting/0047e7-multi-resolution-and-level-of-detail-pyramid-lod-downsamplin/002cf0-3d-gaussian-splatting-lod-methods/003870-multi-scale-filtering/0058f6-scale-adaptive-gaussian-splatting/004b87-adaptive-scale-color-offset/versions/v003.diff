+def evaluate_sh_bases(d, degree):
+    # Standard spherical harmonic basis evaluation [G]
+    x, y, z = d[:, 0], d[:, 1], d[:, 2]
+    inv_sqrt_4pi = 1.0 / (4 * 3.141592653589793) ** 0.5
+    bases = [torch.full_like(x, inv_sqrt_4pi)]
+    if degree >= 1: bases.append(torch.full_like(x, y * inv_sqrt_4pi))
+    if degree >= 2: bases.append(torch.full_like(x, z * inv_sqrt_4pi))
+    if degree >= 3: bases.append(torch.full_like(x, x * inv_sqrt_4pi))
+    # Higher degrees follow standard formulas [G]
+    return torch.stack(bases, dim=1)[:, :degree]
 
