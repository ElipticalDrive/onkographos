 import torch.nn.functional as F
 
+def farthest_point_sample(points, n_centers):
+    """Standard FPS on (B, P, 3) points. Returns (B, n_centers) indices."""
+    B, P, _ = points.shape
+    centroids = torch.zeros(B, n_centers, device=points.device, dtype=torch.long)
+    dist = torch.ones(B, P, device=points.device) * 1e10
+    rand_idx = torch.randint(P, (B,), device=points.device)
+    centroids[:, 0] = rand_idx
+    for i in range(1, n_centers):
+        p = points[torch.arange(B), centroids[:, i-1]]
+        dist_i = torch.norm(points - p.unsqueeze(1), dim=2)
+        dist = torch.minimum(dist, dist_i)
+        centroids[:, i] = torch.argmax(dist, dim=1)
+    return centroids
+
+def knn(points, centers, k):
+    """Hard KNN. points: (P, 3), centers: (N, 3). Returns (N, k) indices."""
+    dist = torch.cdist(centers, points)
+    _, idx = torch.topk(dist, k, dim=1, largest=False)
+    return idx
+
+class Encoder(nn.Module):
+    def __init__(self, depth, width, heads):
+        super().__init__()
+        self.layers = nn.ModuleList([
+            nn.TransformerEncoderLayer(d_model=width, nhead=heads, batch_first=True)
+            for _ in range(depth)
+        ])
+    def forward(self, x, pos):
+        x = x + pos
+        for layer in self.layers:
+            x = layer(x)
+        return x
+
+class TransformerPredictor(nn.Module):
+    def __init__(self, depth, width, heads):
+        super().__init__()
+        self.layers = nn.ModuleList([
+            nn.TransformerEncoderLayer(d_model=width, nhead=heads, batch_first=True)
+            for _ in range(depth)
+        ])
+    def forward(self, x, pos):
+        x = x + pos
+        for layer in self.layers:
+            x = layer(x)
+        return x
