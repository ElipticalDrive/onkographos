+# Standard operations [G]
+def compute_screen_size(params, camera_view):
+    # Project 3D Gaussian covariance to 2D screen space and compute max extent in pixels
+    return camera_view.project(params)
+
+def fast_knn_search(query, candidates, k):
+    # Approximate KNN using spatial hashing or ball tree [S1]
+    return sorted(candidates, key=lambda c: distance(query.params, c.params))[:k]
+
