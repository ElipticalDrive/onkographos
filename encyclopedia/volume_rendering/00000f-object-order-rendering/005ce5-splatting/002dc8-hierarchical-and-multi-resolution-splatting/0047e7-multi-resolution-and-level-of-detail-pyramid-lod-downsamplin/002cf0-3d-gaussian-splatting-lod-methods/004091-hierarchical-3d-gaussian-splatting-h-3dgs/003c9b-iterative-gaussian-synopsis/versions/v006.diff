+**Pseudocode:**
+```python
+def iterative_gaussian_synopsis(SfM_points, images, L_max, L_g, N_c):
+    # 1. Initialization
+    anchors = initialize_from_SfM(SfM_points) # voxelization
+    for anchor in anchors:
+        anchor.offsets = learnable_offsets(K, 3)
+        anchor.scales = learnable_scales(3)
+        anchor.v_j = learnable_soft_index(N_c)
+        anchor.m_j = learnable_mask_params(K)
+    grids = initialize_hierarchical_grids(L_g, dim=4)
+    codebook = initialize_codebook(N_c, D_c=32) # N(0,1)
+    MLP_fuse, MLP_attr = initialize_MLPs()
+    
+    # 2. Full-fidelity training
+    for t in range(T_full):
+        view = sample_view(images)
+        render(view, anchors, grids, codebook, MLP_fuse, MLP_attr)
+        L_full = compute_loss(view, anchors) # L1 + D-SSIM + vol
+        update_all_parameters(L_full)
+        
+    # 3. Unfolding loop
+    for anchor in anchors:
+        anchor.idx_j = argmax(anchor.v_j) # discrete index for LOD L_max-1
+        
+    for l in range(L_max - 1, 0, -1):
+        # Grid restriction
+        restrict_grids_to_LOD(l - 1)
+        
+        # Copy state
+        M = ones_like(anchor.m_j)
+        C^(l-1) = copy(codebook)
+        MLP^(l-1) = copy(MLP_attr)
+        
+        # Adaptation modules (LAD/CBM) are integrated here
+        
+        # Pruning optimization
+        for t in range(T_unfold):
+            for anchor in anchors:
+                for i in range(K):
+                    sigma_val = sigmoid(anchor.m_j[i])
+                    indicator = 1 if sigma_val > epsilon else 0
+                    anchor.M_j[i] = stop_gradient(indicator - sigma_val) + sigma_val
+                    
+                anchor.alpha_hat = anchor.M_j * anchor.alpha
+                anchor.s_hat = anchor.M_j * anchor.s
+                
+            render_at_resolution(LOD=l-1)
+            L_LOD = compute_LOD_loss(anchors, L_mask, L_group)
+            update_masks_and_adaptations(L_LOD, C^(l-1), MLP^(l-1))
+            freeze_anchor_properties() # positions, offsets, scales, grids
+            
+    return {L_0, ..., L_{L_max-1}}
+```
 
