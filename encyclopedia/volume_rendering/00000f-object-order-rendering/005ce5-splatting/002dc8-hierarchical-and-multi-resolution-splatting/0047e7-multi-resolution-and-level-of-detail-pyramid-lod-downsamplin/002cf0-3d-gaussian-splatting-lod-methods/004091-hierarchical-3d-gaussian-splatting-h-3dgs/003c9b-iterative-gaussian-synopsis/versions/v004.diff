+        next_MLP_scale = current_MLP_scale.clone()
+        next_MLP_rot = current_MLP_rot.clone()
+        
+        # Unfold Training
+        for t in range(T_unfold):
+            camera_pos = sample_camera_position()
+            
+            # Get Hierarchical Feature from active grids
+            f_hier = get_hierarchical_feature(anchors.position, active_grids)
+            
+            # Get Local Feature from modulated codebook
+            # During unfolding, we use the straight-through estimator with the current soft indices
+            # But the codebook is now next_C
+            f_loc = soft_index_retrieval(v, next_C)
+            
+            # Fuse Features
+            f_fused = MLP_fuse(torch.cat([f_hier, f_loc], dim=-1))
+            
+            # Compute Masks
+            masks = torch.zeros(N, K)
+            for j in range(N):
+                for i in range(K):
+                    masks[j, i] = straight_through_mask(current_m[j, i], epsilon)
+            
+            # Apply masks to attributes
+            # Predict attributes
+            dist = torch.norm(anchors.position - camera_pos, dim=-1, keepdim=True)
+            dir_vec = (anchors.position - camera_pos) / (dist + 1e-8)
+            
+            alphas, colors, scales, rots = predict_gaussian_attributes(
+                f_fused, dist, dir_vec, next_MLP_alpha, next_MLP_color, next_MLP_scale, next_MLP_rot
+            )
+            
+            masked_alphas = masks * alphas
+            masked_scales = masks * scales
+            
+            # Render
+            rendered = rasterize(masked_alphas, colors, masked_scales, rots, anchors.position)
+            
+            # Compute Loss
+            target = get_target_image(camera_pos)
+            L_LOD = torch.mean(torch.abs(rendered - target))
+            
+            # Sparsity Regularization
+            L_mask = torch.mean(sigmoid(current_m))
+            # Group sparsity loss (simplified)
+            L_group = torch.mean(torch.sum(sigmoid(current_m), dim=1)) # Encourages entire anchor to be pruned
+            
+            L_total = L_LOD + lambda_group * L_group
+            
+            # Update masks and level-specific MLPs/Codebook
+            # Freeze positions, offsets, scales, grids
+            L_total.backward()
+            
+            # Update only masks, C, and MLPs
+            optimizer_mask.step()
+            optimizer_C.step()
+            optimizer_MLP.step()
+            
+            # Update current_m for next iteration
+            current_m = current_m - optimizer_mask.param_groups[0]['lr'] * current_m.grad
+            
+            optimizer_mask.zero_grad()
+            optimizer_C.zero_grad()
+            optimizer_MLP.zero_grad()
+            
+        # Store LOD
+        LODs[l] = {
+            'anchors': anchors,
+            'C': next_C,
+            'MLPs': [next_MLP_alpha, next_MLP_color, next_MLP_scale, next_MLP_rot],
+            'grids': active_grids,
+            'masks': current_m
+        }
+        
+        # Prepare for next iteration (coarser LOD)
+        current_C = next_C
+        current_MLP_alpha = next_MLP_alpha
+        current_MLP_color = next_MLP_color
+        current_MLP_scale = next_MLP_scale
+        current_MLP_rot = next_MLP_rot
+        current_m = current_m # Keep masks for next step? Source says "masks <- 1" at start of loop
