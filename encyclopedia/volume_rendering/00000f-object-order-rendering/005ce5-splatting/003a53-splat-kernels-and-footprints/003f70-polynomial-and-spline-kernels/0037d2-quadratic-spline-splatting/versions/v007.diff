+def compute_ellipse_bbox(center, C):
+    a, b, c = C[0][0], C[0][1], C[1][1]
+    trace = a + c
+    det = a * c - b * b
+    disc = math.sqrt(max(0, trace * trace - 4 * det))
+    l1 = (trace + disc) / 2
+    l2 = (trace - disc) / 2
+    s1 = 1.0 / math.sqrt(l1)
