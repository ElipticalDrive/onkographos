+def standard_kernel(x, y):
+    # [G] Standard Gaussian or box kernel for conventional splatting
+    return max(0.0, 1.0 - (x*x + y*y))
+
+def apply_splat(image, pos, footprint, value, shade=False):
+    # [G] Standard rasterization accumulation step
+    px, py, pz = pos
+    for dy in range(-2, 3):
+        for dx in range(-2, 3):
+            fx, fy = dx, dy
+            weight = footprint(fx, fy)
+            if weight > 0:
+                ix, iy = int(px + fx), int(py + fy)
+                if 0 <= ix < len(image[0]) and 0 <= iy < len(image):
+                    image[iy][ix] += weight * value * (1.0 if shade else 0.5)
+
+def dot_product(v1, v2):
+    return v1[0]*v2[0] + v1[1]*v2[1] + v1[2]*v2[2]
+
+def norm(v):
+    return (v[0]**2 + v[1]**2 + v[2]**2)**0.5
+
+def normalize(v):
+    n = norm(v)
+    return (v[0]/n, v[1]/n, v[2]/n) if n > 0 else (0.0, 0.0, 0.0)
+
+def is_parallel(v1, v2):
+    # [G] Check if vectors are parallel using cross product magnitude
+    cross_x = v1[1]*v2[2] - v1[2]*v2[1]
+    cross_y = v1[2]*v2[0] - v1[0]*v2[2]
+    cross_z = v1[0]*v2[1] - v1[1]*v2[0]
+    return norm((cross_x, cross_y, cross_z)) < 1e-6
