+def sample_texture_atlas(atlas, u, v):
+    """Bilinear sampling of the texture atlas at normalized coordinates (u, v)."""
+    u = max(0.0, min(1.0, u))
+    v = max(0.0, min(1.0, v))
+    # Standard bilinear interpolation replaces GPU hardware filtering for CPU reference [G]
+    h, w, c = atlas.shape
+    u_idx = u * (w - 1)
+    v_idx = v * (h - 1)
+    u0, u1 = int(math.floor(u_idx)), int(math.ceil(u_idx))
+    v0, v1 = int(math.floor(v_idx)), int(math.ceil(v_idx))
+    u0, u1 = max(0, min(w-1, u0)), max(0, min(w-1, u1))
+    v0, v1 = max(0, min(h-1, v0)), max(0, min(h-1, v1))
+    du, dv = u_idx - u0, v_idx - v0
+    top = atlas[v0, u0] * (1 - du) + atlas[v0, u1] * du
+    bottom = atlas[v1, u0] * (1 - du) + atlas[v1, u1] * du
+    return top * (1 - dv) + bottom * dv
