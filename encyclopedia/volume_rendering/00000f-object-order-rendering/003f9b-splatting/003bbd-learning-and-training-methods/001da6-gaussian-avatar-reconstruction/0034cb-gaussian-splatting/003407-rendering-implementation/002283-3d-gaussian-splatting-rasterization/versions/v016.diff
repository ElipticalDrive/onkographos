+    # means_cam = R @ means_3d + t
+    R = viewmats[:, :3, :3] # [C, 3, 3]
+    t = viewmats[:, :3, 3] # [C, 3]
+    means_cam = mx.einsum("cij,nj->cni", R, means_3d) + t[:, None, :] # [C, N, 3]
