+def compute_radii(cov_2D, width, height):
+    C, N, _, _ = cov_2D.shape
+    radii = np.zeros((C, N, 2))
+    for c in range(C):
+        for n in range(N):
+            M = cov_2D[c, n]
+            trace = M[0, 0] + M[1, 1]
+            det = M[0, 0]*M[1, 1] - M[0, 1]*M[1, 0]
+            disc = np.sqrt(max(trace**2 - 4*det, 0))
+            lambda1 = (trace + disc) / 2
+            lambda2 = (trace - disc) / 2
+            r_x = 3.0 * np.sqrt(max(lambda1, 0))
+            r_y = 3.0 * np.sqrt(max(lambda2, 0))
+            radii[c, n, 0] = min(r_x, width)
+            radii[c, n, 1] = min(r_y, height)
+    return radii
 
