+    
+    for c in range(C):
+        # 1. Project 3D Gaussians to 2D
+        # Transform to camera space
+        R = viewmats[c, :3, :3]
+        t = viewmats[c, :3, 3]
+        means_cam = (R @ means3D.T).T + t # [N, 3]
+        
+        # Compute Jacobian J for projection
+        # J = d(u,v)/d(X,Y,Z)
+        # u = fx * X/Z + cx, v = fy * Y/Z + cy
+        # J = [[fx/Z, 0, -fx*X/Z^2],
+        #      [0, fy/Z, -fy*Y/Z^2]]
+        Z = means_cam[:, 2:3] # [N, 1]
+        X = means_cam[:, 0:1]
+        Y = means_cam[:, 1:2]
