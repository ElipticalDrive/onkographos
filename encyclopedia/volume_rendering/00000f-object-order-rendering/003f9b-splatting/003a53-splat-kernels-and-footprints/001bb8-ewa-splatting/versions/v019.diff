+def eigenvalues2x2(M):
+    tr = M[0][0] + M[1][1]
+    det = M[0][0]*M[1][1] - M[0][1]*M[1][0]
+    disc = tr*tr - 4*det
+    if disc < 0: disc = 0
+    sqrt_disc = math.sqrt(disc)
+    return [(tr + sqrt_disc)/2.0, (tr - sqrt_disc)/2.0]
