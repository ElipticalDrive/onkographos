+def bilinear_interpolate(table, idx_x, idx_y, resolution):
+    """Bilinear interpolation for the footprint table."""
+    table_size = 2 * resolution + 1
+    fx = idx_x - int(idx_x)
+    fy = idx_y - int(idx_y)
+    ix = int(idx_x)
+    iy = int(idx_y)
+    x0, x1 = max(0, ix), min(table_size - 1, ix + 1)
+    y0, y1 = max(0, iy), min(table_size - 1, iy + 1)
+    val = (table[y0][x0] * (1 - fx) * (1 - fy) +
+           table[y0][x1] * fx * (1 - fy) +
+           table[y1][x0] * (1 - fx) * fy +
+           table[y1][x1] * fx * fy)
+    return val
 
