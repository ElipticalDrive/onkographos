+    x0 = clamp(x0, 0, D-2)
+    x1 = clamp(x1, 0, D-1)
+    y0 = clamp(y0, 0, H-2)
+    y1 = clamp(y1, 0, H-1)
+    z0 = clamp(z0, 0, W-2)
