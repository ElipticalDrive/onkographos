+def compute_3d_dct(volume):
+    """
+    Computes the 3D Discrete Cosine Transform of a volume.
+    """
+    # Apply 1D DCT along each dimension sequentially.
+    # Type II DCT is standard for compression.
+    temp1 = apply_1d_dct(volume, axis=0)
+    temp2 = apply_1d_dct(temp1, axis=1)
+    spectrum = apply_1d_dct(temp2, axis=2)
+    return spectrum
