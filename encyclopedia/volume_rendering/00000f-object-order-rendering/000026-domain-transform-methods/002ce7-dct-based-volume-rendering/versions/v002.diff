+    idx2 = int(round(w2))
+    idx3 = int(round(w3))
+    
+    # Handle boundary conditions
+    idx1 = max(0, min(idx1, spectrum.shape[0] - 1))
+    idx2 = max(0, min(idx2, spectrum.shape[1] - 1))
+    idx3 = max(0, min(idx3, spectrum.shape[2] - 1))
+    
+    return spectrum[idx1, idx2, idx3]
