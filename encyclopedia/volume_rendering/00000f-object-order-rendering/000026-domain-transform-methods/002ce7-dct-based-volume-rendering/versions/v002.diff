+def apply_1d_dct(data, axis):
+    """
+    Applies 1D DCT along a specific axis.
+    """
+    # Using standard DCT-II definition.
+    # For implementation, use numpy.fft.dct with type=2.
+    return np.fft.dct(data, type=2, axis=axis)
