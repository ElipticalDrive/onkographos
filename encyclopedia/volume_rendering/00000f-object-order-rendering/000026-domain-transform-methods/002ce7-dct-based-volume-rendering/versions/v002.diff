+def compute_2d_idct(slice_data):
+    """
+    Computes the 2D Inverse Discrete Cosine Transform.
+    """
+    # Apply 1D IDCT along each dimension sequentially.
+    # Type III DCT is the inverse of Type II.
+    temp1 = apply_1d_idct(slice_data, axis=0)
+    image = apply_1d_idct(temp1, axis=1)
+    return image
