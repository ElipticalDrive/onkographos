+    Computes two orthogonal unit vectors perpendicular to the view direction.
+    """
+    # Normalize view direction
+    v = view_direction / np.linalg.norm(view_direction)
+    
+    # Choose an arbitrary vector not parallel to v
+    if abs(v[0]) < 0.9:
+        arbitrary = np.array([1, 0, 0])
+    else:
+        arbitrary = np.array([0, 1, 0])
+        
+    # First basis vector is perpendicular to v and arbitrary
+    basis_u = np.cross(v, arbitrary)
+    basis_u = basis_u / np.linalg.norm(basis_u)
+    
+    # Second basis vector is perpendicular to both v and basis_u
+    basis_v = np.cross(v, basis_u)
+    basis_v = basis_v / np.linalg.norm(basis_v)
+    
+    return basis_u, basis_v
