+            segs = pixel_buffers[y][x]
+            if not segs: continue
+            segs.sort(key=lambda s: s.depth_end, reverse=True)
+            c, a = 0.0, 0.0
+            for s in segs:
+                c, a = porter_duff_over(c, a, s.sample_val, s.depth_end - s.depth_start)
+            local_image[y][x] = (c, a)
+
+def porter_duff_over(c1, a1, c2, a2):
+    a_out = a1 + a2 * (1 - a1)
+    c_out = c1 + c2 * (1 - a1)
+    return c_out, a_out
