+def merge_incoming_segments(proc_id, width, height):
+    # Poll and merge
+    for dest in range(num_processors):
+        if buffers[dest][0].not_empty():
+            segments = buffers[dest][0].pop_all()
+            for seg in segments:
+                pixel_buffers[seg.y][seg.x].append(seg)
