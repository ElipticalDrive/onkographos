+def send_buffer(dest_proc, segment):
+    # Double buffering logic for asynchronous communication
+    if buffers[dest_proc][0].full():
+        if buffers[dest_proc][1].full():
+            merge_incoming_segments(processor_id, image_width, image_height) # Deadlock prevention
+        buffers[dest_proc][1].push(segment)
+    else:
+        buffers[dest_proc][0].push(segment)
