+def tetrahedron_volume(v0, v1, v2, v3):
+    """
+    Calculate the volume of a tetrahedron defined by 4 vertices.
+    """
+    # Volume = |det(v1-v0, v2-v0, v3-v0)| / 6
+    d1 = v1 - v0
+    d2 = v2 - v0
+    d3 = v3 - v0
+    det = d1.x * (d2.y * d3.z - d2.z * d3.y) - \
+          d1.y * (d2.x * d3.z - d2.z * d3.x) + \
+          d1.z * (d2.x * d3.y - d2.y * d3.x)
+    return abs(det) / 6.0
