+def compute_grid_resolution(N_min, N_max, L):
+    """Compute geometric progression ratio and level resolutions."""
+    gamma = np.exp((np.log(N_max) - np.log(N_min)) / (L - 1))
+    N_l = np.floor(N_min * gamma ** np.arange(L)).astype(int)
+    return N_l
 
