-    P_1 &= (x-B, y-B, z+B) \\
-    P_2 &= (x+B, y-B, z+B) \\
-    P_3 &= (x+B, y+B, z+B) \\
-    P_4 &= (x-B, y+B, z+B) \\
-    P_5 &= (x-B, y-B, z-B) \\
-    P_6 &= (x+B, y-B, z-B) \\
-    P_7 &= (x+B, y+B, z-B) \\
-    P_8 &= (x-B, y+B, z-B)
-    \end{aligned}
-    $$
