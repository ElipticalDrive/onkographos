+def compute_aspect_ratio(poly):
+    # Standard aspect ratio: longest edge / shortest edge [G]
+    edges = []
+    n = len(poly)
+    for i in range(n):
+        dx = poly[(i+1)%n].x - poly[i].x
+        dy = poly[(i+1)%n].y - poly[i].y
+        edges.append((dx*dx + dy*dy)**0.5)
+    if not edges:
+        return 1.0
+    return max(edges) / min(edges)
 
