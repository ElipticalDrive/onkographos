 *   **Precision:** The min-max texture lookup must be precise enough to avoid false positives (blocks marked occupied when they are not) or false negatives (occupied blocks culled) [S4, unofficial].
 
+### Pseudocode
+```python
+def raster_occlusion_culling(minmax_texture, isovalue, volume_dims, block_dims):
+    # 1. Task Shader: Block-wise Stream Compaction
+    occupied_blocks = []
+    for block_idx in range(volume_dims[0] // block_dims[0], volume_dims[1] // block_dims[1], volume_dims[2] // block_dims[2]):
+        min_val, max_val = sample_minmax(minmax_texture, block_idx)
+        if min_val <= isovalue <= max_val:
+            occupied_blocks.append(block_idx)
+            
+    # 2. Mesh Shader: Proxy Geometry Creation
+    proxy_quads = []
+    for block_idx in occupied_blocks:
+        # Project block bounding box to screen space, use minimal z-coordinate
+        quad = create_screen_space_quad(block_idx)
+        proxy_quads.append(quad)
+        
+    # 3. Rasterization & Fragment Shader
+    visibility_buffer = [0] * (screen_width * screen_height)
+    for quad in proxy_quads:
+        fragments = rasterize(quad, depth_func=GL_LEQUAL)
+        for frag in fragments:
+            if frag.passes_early_depth_test and frag.passes_representative_fragment_test:
+                visibility_buffer[frag.screen_id] = frag.block_id
+                
+    # 4. Compute Shader: PVS Generation and Compactification
+    pvs_curr = compactify_visibility_buffer(visibility_buffer)
+    pvs_curr_prev = compute_visible_since_last_frame(pvs_curr)
+    return pvs_curr, pvs_curr_prev
+```
