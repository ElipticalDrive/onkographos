+def generate_mesh(chunk_data, chunk_size, min_altitude, max_altitude, neighbor_chunks, chunk_pos):
+    CHUNK_VOL = chunk_size ** 3
+    ACCESS_STEP_X = chunk_size
+    ACCESS_STEP_Y = 1
+    ACCESS_STEP_Z = chunk_size ** 2
+
+    visitXN = [False] * CHUNK_VOL
+    visitXP = [False] * CHUNK_VOL
+    visitYN = [False] * CHUNK_VOL
+    visitYP = [False] * CHUNK_VOL
+    visitZN = [False] * CHUNK_VOL
+    visitZP = [False] * CHUNK_VOL
+
+    vertex_buffer = []
+
+    def different_block(access_a, access_b):
+        return chunk_data[access_a].index != chunk_data[access_b].index or \
+               chunk_data[access_a].health != chunk_data[access_b].health
+
+    def is_visible_xn(i, j, k, access):
+        if i == 0:
+            if chunk_pos.x == 0: return False
+            if neighbor_chunks.xn is None: return True
+            return neighbor_chunks.xn.data[31 * chunk_size + j + k * ACCESS_STEP_Z].index == 0
+        return chunk_data[access - ACCESS_STEP_X].index == 0
+
+    def append_quad_xn(buf, i, j, k, length_a, length_b, voxel):
+        # Generates 6 vertex integers for 2 triangles
+        # Corners: (i,j,k), (i,j,k+length_b), (i,j+length_a,k), (i,j+length_a,k+length_b)
+        # Normal: (-1, 0, 0)
+        # UVs: (0,0), (0,1), (1,0), (1,1)
+        # Packed with face_id and texture health
+        for corner in [(0,0), (0,1), (1,0), (1,1)]:
+            u, v = corner
+            # Calculate packed vertex attributes
+            packed = pack_data(i, j, k, voxel.index, 3, 0, 0) # face_id=3 for xn
+            buf.append(packed)
+
