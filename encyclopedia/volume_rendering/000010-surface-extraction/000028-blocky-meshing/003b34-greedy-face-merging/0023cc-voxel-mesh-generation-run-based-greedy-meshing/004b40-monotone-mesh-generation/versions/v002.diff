-**Sub-algorithm: WritePolygon**
-This function triangulates a monotone polygon and writes triangles to the mesh.
-
-1. Initialize `LeftIndex` and `RightIndex` arrays.
-2. Call `WriteVertex` for `Polygon.Left` to populate `LeftIndex` and `OutRawMesh.VertexPositions`.
-3. Call `WriteVertex` for `Polygon.Right` to populate `RightIndex` and `OutRawMesh.VertexPositions`.
-4. Calculate `ColorIndex`: `0 < Polygon.Color ? Polygon.Color - 1 : -Polygon.Color - 1`.
-5. Calculate `Flipped`: `Polygon.Color < 0`.
-6. Initialize `Left = 1`, `Right = 1`, `LastSide = true`.
-7. Define `CrossProduct(a, b) = a.X * b.Y - b.X * a.Y`.
-8. Initialize `List` with `TPair(LeftIndex[0], Polygon.Left[0])` and `TPair(RightIndex[0], Polygon.Right[0])`.
-9. **Triangulation Loop**: While `Left < Polygon.Left.Num()` OR `Right < Polygon.Right.Num()`:
-   - Determine `Side`:
-     - If `Left == Polygon.Left.Num()`: `Side = true` (Right).
-     - Else if `Right != Polygon.Right.Num()`: `Side = (Polygon.Left[Left].Y > Polygon.Right[Right].Y)`.
-     - Else: `Side = false` (Left).
-   - Get `Index` and `Vertex` based on `Side` (`RightIndex[Right]/Polygon.Right[Right]` if Side, else `LeftIndex[Left]/Polygon.Left[Left]`).
-   - **Wedge Generation**:
-     - If `Side != LastSide`:
-       - While `List.Num() > 1`:
-         - Write wedge using `List[0]`, `List[1]`, `Index`, `Color`, and `Flipped == Side`.
-         - Remove `List[0]`.
-     - Else (`Side == LastSide`):
-       - While `List.Num() > 1`:
-         - Calculate `Normal = CrossProduct(List.Last().Value - Vertex, List[List.Num()-2].Value - Vertex)`.
-         - If `Side == (Normal > 0)`: Break.
-         - If `Normal != 0`: Write wedge using `List.Last()`, `List[List.Num()-2]`, `Index`, `Color`, `Flipped == Side`.
-         - Remove `List.Last()`.
-   - Add `TPair(Index, Vertex)` to `List`.
-   - Increment `Right` if `Side`, else `Left`.
-   - Set `LastSide = Side`.
-
-**Sub-algorithm: WriteVertex**
-1. Iterate `i` from 0 to `Polygon.Left.Num()`.
-   - Create `Vertex` from `Polygon.Left[i]` mapped to `Axis` coordinates.
-   - Add `Vertex` to `OutRawMesh.VertexPositions` using `AddUnique`.
-   - Store index in `OutLeftIndex[i]`.
-2. Iterate `i` from 0 to `Polygon.Right.Num()`.
-   - Create `Vertex` from `Polygon.Right[i]` mapped to `Axis` coordinates.
-   - Add `Vertex` to `OutRawMesh.VertexPositions` using `AddUnique`.
-   - Store index in `OutRightIndex[i]`.
-
-**Sub-algorithm: WriteWedge**
-1. Add three indices to `OutRawMesh.WedgeIndices`: `Index1` if `Face` else `Index2`, `Index2` if `Face` else `Index1`, `Index3`.
-2. Add three identical texture coordinates to `OutRawMesh.WedgeTexCoords[0]`: `((double)ColorIndex + 0.5) / 256.0`, `0.5`.
-3. Add `0` to `OutRawMesh.FaceMaterialIndices` and `OutRawMesh.FaceSmoothingMasks`.
+```python
+def CreateRawMesh(Voxel, Size, Palette, ImportOption):
+    OutRawMesh = FRawMesh()
+    for Dimension in range(3):
+        Axis = [Dimension, (Dimension + 1) % 3, (Dimension + 2) % 3]
+        Plane = [0, 0, 0]
+        for Plane[Axis[2]] in range(Size[Axis[2]]):
+            Polygons = CreatePolygons(Voxel, Size, Axis, Plane)
+            for Polygon in Polygons:
+                WritePolygon(OutRawMesh, Axis, Polygon)
+    if ImportOption.bImportXYCenter:
+        Offset = (Size.X * 0.5, Size.Y * 0.5, 0.0)
+        for i in range(len(OutRawMesh.VertexPositions)):
+            OutRawMesh.VertexPositions[i] -= Offset
+    OutRawMesh.CompactMaterialIndices()
+    return OutRawMesh
+
+def CreatePolygons(Voxel, Size, Axis, Plane):
+    OutPolygons = []
+    for P_y in range(Size[Axis[1]]):
+        Faces = CreateFaces(Voxel, Size, Axis, Plane, P_y)
+        Frontier = []
+        NextFrontier = []
+        f_idx = 0
+        while f_idx < len(Faces):
+            if not Frontier:
+                idx = len(OutPolygons)
+                OutPolygons.append(FPolygon(Faces[f_idx].Color, Faces[f_idx].Left, Faces[f_idx].Right, P_y, Plane[Axis[2]]))
+                NextFrontier.append(idx)
+                f_idx += 1
+                continue
+
+            poly_idx = Frontier[0]
+            poly = OutPolygons[poly_idx]
+            face = Faces[f_idx]
+
+            left_x = poly.Left[-1].X if poly.Left else 0
+            right_x = poly.Right[-1].X if poly.Right else 0
+
+            if left_x < face.Right and face.Left < right_x and face.Color == poly.Color:
+                poly.Left.append((face.Left, P_y))
+                poly.Right.append((face.Right, P_y))
+                NextFrontier.append(poly_idx)
+                f_idx += 1
+            else:
+                if right_x <= face.Right:
+                    poly.CloseOff(P_y, Plane[Axis[2]])
+                    Frontier.pop(0)
+                if face.Right <= right_x:
+                    idx = len(OutPolygons)
+                    OutPolygons.append(FPolygon(face.Color, face.Left, face.Right, P_y, Plane[Axis[2]]))
+                    NextFrontier.append(idx)
+                    f_idx += 1
+        Frontier = NextFrontier
+        for idx in Frontier:
+            OutPolygons[idx].CloseOff(P_y, Plane[Axis[2]])
+    return OutPolygons
+
+def CreateFaces(Voxel, Size, Axis, Plane, P_y):
+    OutFaces = []
+    D = [0, 0, 0]
+    D[Axis[0]] = 0
+    D[Axis[1]] = 0
+    D[Axis[2]] = -1
+    prev_color = 0
+    for P_x in range(Size[Axis[0]]):
+        P = [0, 0, 0]
+        P[Axis[0]] = P_x
+        P[Axis[1]] = P_y
+        P[Axis[2]] = Plane[Axis[2]]
+        Back = Voxel.Get(P + D)
+        Front = Voxel.Get(P)
+        if not Back and not Front:
+            color = 0
+        elif Back:
+            color = -Back
+        else:
+            color = Front
+
+        if prev_color != color:
+            if prev_color != 0:
+                OutFaces[-1].Right = P_x
+            if color != 0:
+                OutFaces.append(FFace(color, P_x, P_x))
+        prev_color = color
+    if prev_color != 0:
+        OutFaces[-1].Right = P_x
+    return OutFaces
+
+def WritePolygon(OutRawMesh, Axis, Polygon):
+    LeftIndex = []
+    RightIndex = []
+    WriteVertex(OutRawMesh, Axis, Polygon.Left, LeftIndex)
+    WriteVertex(OutRawMesh, Axis, Polygon.Right, RightIndex)
+
+    ColorIndex = Polygon.Color - 1 if Polygon.Color > 0 else -Polygon.Color - 1
+    Flipped = Polygon.Color < 0
+
+    Left = 1
+    Right = 1
+    LastSide = True
+    CrossProduct = lambda a, b: a.X * b.Y - b.X * a.Y
+    List = [(LeftIndex[0], Polygon.Left[0]), (RightIndex[0], Polygon.Right[0])]
+
+    while Left < len(Polygon.Left) or Right < len(Polygon.Right):
+        if Left == len(Polygon.Left):
+            Side = True
+        elif Right < len(Polygon.Right):
+            Side = Polygon.Left[Left].Y > Polygon.Right[Right].Y
+        else:
+            Side = False
+
+        if Side:
+            Index = RightIndex[Right]
+            Vertex = Polygon.Right[Right]
+        else:
+            Index = LeftIndex[Left]
+            Vertex = Polygon.Left[Left]
+
+        if Side != LastSide:
+            while len(List) > 1:
+                WriteWedge(OutRawMesh, List[0][0], List[1][0], Index, ColorIndex, Flipped == Side)
+                List.pop(0)
+        else:
+            while len(List) > 1:
+                Normal = CrossProduct(List[-1][1] - Vertex, List[-2][1] - Vertex)
+                if Side == (Normal > 0):
+                    break
+                if Normal != 0:
+                    WriteWedge(OutRawMesh, List[-1][0], List[-2][0], Index, ColorIndex, Flipped == Side)
+                    List.pop()
+        List.append((Index, Vertex))
+        if Side:
+            Right += 1
+        else:
+            Left += 1
+        LastSide = Side
+
+def WriteVertex(OutRawMesh, Axis, Chain, IndexArray):
+    for pt in Chain:
+        Vertex = Plane + pt.X * Axis[1] + pt.Y * Axis[2]
+        idx = OutRawMesh.VertexPositions.AddUnique(Vertex)
+        IndexArray.append(idx)
+
+def WriteWedge(OutRawMesh, Index1, Index2, Index3, ColorIndex, Flipped):
+    OutRawMesh.WedgeIndices.Add(Index1 if not Flipped else Index2)
+    OutRawMesh.WedgeIndices.Add(Index2 if not Flipped else Index1)
+    OutRawMesh.WedgeIndices.Add(Index3)
+    TexCoord = (((double)ColorIndex + 0.5) / 256.0, 0.5)
+    OutRawMesh.WedgeTexCoords[0].Add(TexCoord)
+    OutRawMesh.WedgeTexCoords[0].Add(TexCoord)
+    OutRawMesh.WedgeTexCoords[0].Add(TexCoord)
+    OutRawMesh.FaceMaterialIndices.Add(0)
+    OutRawMesh.FaceSmoothingMasks.Add(0)
+```
 
