+def compute_face_vertices(x, y, z, dx, dy, dz):
+    """
+    Computes 4 vertices for a quad on the face defined by normal (dx, dy, dz).
+    Assumes voxel at (x,y,z) and face at (x+dx, y+dy, z+dz).
+    Returns vertices in CCW order when viewed from outside.
+    """
+    # Base coordinates on the face plane
+    fx, fy, fz = x + dx, y + dy, z + dz
+    
+    if dx == 1:  # EAST
+        return [(fx, y, z), (fx, y+1, z), (fx, y+1, z+1), (fx, y, z+1)]
+    elif dx == -1: # WEST
+        return [(fx, y, z+1), (fx, y+1, z+1), (fx, y+1, z), (fx, y, z)]
+    elif dy == 1:  # TOP
+        return [(x, fy, z), (x+1, fy, z), (x+1, fy, z+1), (x, fy, z+1)]
+    elif dy == -1: # BOTTOM
+        return [(x+1, fy, z+1), (x, fy, z+1), (x, fy, z), (x+1, fy, z)]
+    elif dz == 1:  # SOUTH
+        return [(x, y, fz), (x+1, y, fz), (x+1, y+1, fz), (x, y+1, fz)]
+    elif dz == -1: # NORTH
+        return [(x+1, y+1, fz), (x, y+1, fz), (x, y, fz), (x+1, y, fz)]
+    return []
