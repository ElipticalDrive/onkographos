+def greedy_mesh_binary_plane(data, lod_size):
+    greedy_quads = []
+    for row in range(len(data)):
+        y = 0
+        while y < lod_size:
+            shifted = data[row] >> y
+            if shifted == 0:
+                y += 32
+                continue
+            # trailing zeros
+            tz = (shifted & -shifted).bit_length() - 1
+            y += tz
+            if y >= lod_size:
+                continue
+            # trailing ones
+            ones_shifted = shifted >> y
+            h = 0
+            while h < 32 - y and (ones_shifted & 1):
+                h += 1
+                ones_shifted >>= 1
+            greedy_quads.append((row, y, h))
+            y += h
+    return greedy_quads
