+                if not intervals or intervals[-1][1] < x:
+                    intervals.append([x, x])
+                else:
+                    intervals[-1][1] = x
+        for start, end in intervals:
+            aabbs.append((start, y, end - start + 1, 1))
+    return aabbs
+
