+def rasterize_edges(poly, grid_size):
+    # Deterministic Bresenham-like integer edge rasterization
+    # Returns list of (x, y) pixels on the 1000x1000 grid
+    pixels = []
+    for i in range(len(poly.vertices)):
+        x0, y0 = poly.vertices[i]
+        x1, y1 = poly.vertices[(i + 1) % len(poly.vertices)]
+        dx, dy = abs(x1 - x0), abs(y1 - y0)
+        sx = 1 if x0 < x1 else -1
+        sy = 1 if y0 < y1 else -1
+        err = dx - dy
+        while True:
+            pixels.append((x0, y0))
+            if x0 == x1 and y0 == y1: break
+            e2 = 2 * err
+            if e2 > -dy: err -= dy; x0 += sx
+            if e2 < dx: err += dx; y0 += sy
+    return pixels
