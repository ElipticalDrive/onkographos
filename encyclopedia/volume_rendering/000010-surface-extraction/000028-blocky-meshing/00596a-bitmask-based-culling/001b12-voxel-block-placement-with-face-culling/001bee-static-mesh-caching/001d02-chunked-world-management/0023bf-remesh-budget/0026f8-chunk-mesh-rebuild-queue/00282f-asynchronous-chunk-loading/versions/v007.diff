+class Queue:
+    def __init__(self):
+        self._items = collections.deque()
+    def enqueue(self, item):
+        self._items.append(item)
+    def dequeue(self):
+        return self._items.popleft() if self._items else None
+    def is_empty(self):
+        return len(self._items) == 0
+
+def get_hash(x, y):
+    return (x << 16) | (y & 0xFFFF)
