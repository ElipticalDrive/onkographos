+    return Actor()
+
+class ThreadPool:
+    def __init__(self):
+        self._queue = Queue()
+        self._threads = []
+        for _ in range(4):
+            t = threading.Thread(target=self._worker, daemon=True)
+            t.start()
+            self._threads.append(t)
+    def _worker(self):
+        while True:
+            task = self._queue.dequeue()
+            if task is None: break
+            task()
+    def submit_async(self, func, *args):
+        def wrapper():
+            return func(*args)
+        self._queue.enqueue(wrapper)
+        return None
