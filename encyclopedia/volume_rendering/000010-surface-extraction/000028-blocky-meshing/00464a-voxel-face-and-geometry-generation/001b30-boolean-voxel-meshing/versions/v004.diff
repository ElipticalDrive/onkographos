+    vertices_x = x_coords / N_x - 0.5
+    vertices_y = y_coords / N_y - 0.5
+    vertices_z = z_coords / N_z - 0.5
+    vertices = np.stack([vertices_x, vertices_y, vertices_z], axis=1)
+    ```
 
