-    $$ \text{corner\_sample}[10] = \text{corner\_sample}[2] $$
-    $$ \text{corner\_sample}[11] = \text{corner\_sample}[4] $$
-    $$ \text{corner\_sample}[12] = \text{corner\_sample}[6] $$
