+        (vol.sample((p[0], p[1]+h, p[2])) - vol.sample((p[0], p[1]-h, p[2]))),
+        (vol.sample((p[0], p[1], p[2]+h)) - vol.sample((p[0], p[1], p[2]-h)))
+    )
+
+def project_to_plane(p, n):
