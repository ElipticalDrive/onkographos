+def interpolate(v1, v2, iso):
+    if abs(v2 - v1) < 1e-6: return v1
+    return v1 + (iso - v1) / (v2 - v1)
+
+def interpolate_vec(v1, v2, iso):
+    if abs(v2 - v1) < 1e-6: return v1
+    t = (iso - v1) / (v2 - v1)
+    return (v1[0] + t*(v2[0]-v1[0]), v1[1] + t*(v2[1]-v1[1]), v1[2] + t*(v2[2]-v1[2]))
+
+def compute_gradient(vol, p):
