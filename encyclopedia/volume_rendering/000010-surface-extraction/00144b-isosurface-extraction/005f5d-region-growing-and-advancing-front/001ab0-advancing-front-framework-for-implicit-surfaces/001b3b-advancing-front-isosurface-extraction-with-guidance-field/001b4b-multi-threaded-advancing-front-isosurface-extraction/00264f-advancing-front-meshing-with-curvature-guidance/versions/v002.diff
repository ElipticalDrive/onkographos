+**Pseudocode:**
+```python
+def advancing_front_curvature_guidance(ct_data, threshold, k, n, L):
+    # 1. Construct voxel pyramid: coarse (L) to fine (0)
+    pyramid = [ct_data]
+    for _ in range(L):
+        pyramid.append(downsample_3d(pyramid[-1]))
+        
+    # 2. Initialize at coarsest scale (l = L)
+    l = L
+    response_region = []
+    for i, j, idx in grid_indices(pyramid[l]):
+        if sign_change(pyramid[l][i, j, idx], threshold):
+            response_region.append((i, j, idx))
+            
+    while l > 0:
+        # 3. Compute fields
+        grad_field = compute_gradient(pyramid[l])
+        curv_field = compute_curvature(pyramid[l], grad_field)
+        
+        # 4a. Statistics
+        curv_values = [curv_field[u] for u in response_region]
+        mu = sum(curv_values) / len(curv_values)
+        sigma = (sum((c - mu)**2 for c in curv_values) / len(curv_values))**0.5
+        theta = mu + k * sigma
+        
+        # 4b. High-curvature region
+        high_curv_region = [u for u in response_region if curv_field[u] > theta]
+        
+        # 4c. Dilation (width n)
+        candidate_region = set()
+        for u in high_curv_region:
+            for dx in range(-n, n + 1):
+                for dy in range(-n, n + 1):
+                    for dz in range(-n, n + 1):
+                        candidate_region.add((u[0] + dx, u[1] + dy, u[2] + dz))
+                        
+        # 4d. Map to finer scale & screen new response units
+        l -= 1
+        response_region = []
+        for u in candidate_region:
+            if sign_change(pyramid[l][u], threshold):
+                response_region.append(u)
+                
+    return response_region
+```
 
