+def compute_area(p1, p2, p3):
+    """Compute area of triangle defined by 3D points p1, p2, p3."""
+    v1 = [p2[i] - p1[i] for i in range(3)]
+    v2 = [p3[i] - p1[i] for i in range(3)]
+    cross = [
+        v1[1]*v2[2] - v1[2]*v2[1],
+        v1[2]*v2[0] - v1[0]*v2[2],
+        v1[0]*v2[1] - v1[1]*v2[0]
+    ]
+    magnitude = (cross[0]**2 + cross[1]**2 + cross[2]**2)**0.5
+    return 0.5 * magnitude
 
