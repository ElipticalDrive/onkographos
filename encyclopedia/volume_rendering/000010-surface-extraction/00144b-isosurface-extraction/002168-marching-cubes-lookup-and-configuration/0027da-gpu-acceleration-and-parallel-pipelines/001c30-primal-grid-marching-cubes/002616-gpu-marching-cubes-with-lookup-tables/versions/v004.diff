+int3 GetVertexPosition(int x, int y, int z, int k) {
+    // Mapping based on standard MC vertex ordering:
+    // 0:(0,0,0), 1:(1,0,0), 2:(1,1,0), 3:(0,1,0)
+    // 4:(0,0,1), 5:(1,0,1), 6:(1,1,1), 7:(0,1,1)
+    int dx = (k & 1);
