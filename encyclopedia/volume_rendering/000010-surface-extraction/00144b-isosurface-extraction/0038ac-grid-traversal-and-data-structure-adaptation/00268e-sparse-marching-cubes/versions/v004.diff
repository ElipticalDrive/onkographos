+        binary_mask[:, 0] * 1 |
+        binary_mask[:, 1] * 2 |
+        binary_mask[:, 2] * 4 |
+        binary_mask[:, 3] * 8 |
+        binary_mask[:, 4] * 16 |
+        binary_mask[:, 5] * 32 |
+        binary_mask[:, 6] * 64 |
+        binary_mask[:, 7] * 128
+    ).int()
+    
+    return cube_indices
