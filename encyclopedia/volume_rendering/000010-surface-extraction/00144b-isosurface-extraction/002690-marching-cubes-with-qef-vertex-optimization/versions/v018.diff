+               HORIZNTL_RANGE, HORIZNTL_LINEAR_SEARCH, HORIZNTL_BINARY_SEARCH, axd_tab, ax0_tab, ax1_tab, cas_tab, amb_chks, qvntab, pfvtab, vitogi, cstrtab):
