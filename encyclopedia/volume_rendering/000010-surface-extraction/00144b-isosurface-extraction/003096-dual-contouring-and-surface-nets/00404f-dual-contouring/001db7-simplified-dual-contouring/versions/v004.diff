-       $$
-       \begin{aligned}
-       \text{top\_left} &= \mathbf{p} - \mathbf{b}_1 \\
-       \text{top\_right} &= \mathbf{p} \\
-       \text{bottom\_left} &= \mathbf{p} - \mathbf{b}_1 - \mathbf{b}_2 \\
-       \text{bottom\_right} &= \mathbf{p} - \mathbf{b}_2
-       \end{aligned}
