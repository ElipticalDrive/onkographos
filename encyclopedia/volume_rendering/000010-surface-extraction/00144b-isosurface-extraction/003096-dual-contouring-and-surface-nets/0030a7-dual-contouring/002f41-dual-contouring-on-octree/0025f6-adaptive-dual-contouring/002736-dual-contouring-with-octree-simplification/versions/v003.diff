+def approximate_zero_crossing(p0, p1):
+    min_val = float('inf')
+    best_t = 0.0
+    steps = 8
+    for k in range(steps + 1):
+        t = k / steps
+        p = tuple(p0[j] + (p1[j] - p0[j]) * t for j in range(3))
+        val = abs(f(p))
+        if val < min_val:
+            min_val = val
+            best_t = t
+    return tuple(p0[j] + (p1[j] - p0[j]) * best_t for j in range(3))
+
+def calculate_surface_normal(p):
+    H = 0.001
+    dx = f((p[0]+H, p[1], p[2])) - f((p[0]-H, p[1], p[2]))
+    dy = f((p[0], p[1]+H, p[2])) - f((p[0], p[1]-H, p[2]))
+    dz = f((p[0], p[1], p[2]+H)) - f((p[0], p[1], p[2]-H))
+    return normalize(Vector3(dx, dy, dz))
