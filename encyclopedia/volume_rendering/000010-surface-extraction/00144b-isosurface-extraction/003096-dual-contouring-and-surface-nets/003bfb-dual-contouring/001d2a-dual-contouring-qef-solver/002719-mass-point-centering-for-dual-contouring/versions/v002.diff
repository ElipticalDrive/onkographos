+def vmul_symmetric(mat: SMat3, vec: Vec3) -> Vec3:
+    return [
+        mat.m00 * vec[0] + mat.m01 * vec[1] + mat.m02 * vec[2],
+        mat.m01 * vec[0] + mat.m11 * vec[1] + mat.m12 * vec[2],
+        mat.m02 * vec[0] + mat.m12 * vec[1] + mat.m22 * vec[2]
