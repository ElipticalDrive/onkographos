+# Helper definitions to make pseudocode self-contained
+def look_at(eye, center, up):
+    # Standard lookAt matrix construction
+    f = normalize(center - eye)
+    s = normalize(cross(f, up))
+    u = cross(s, f)
+    return mat4(
+        vec4(s.x, u.x, -f.x, 0),
+        vec4(s.y, u.y, -f.y, 0),
+        vec4(s.z, u.z, -f.z, 0),
+        vec4(-dot(s, eye), -dot(u, eye), dot(f, eye), 1)
+    )
