+                        ∂Oα. Each point must support a method to get its neighbors 
+                        within the surface set.
+                        
+    Returns:
+        g: The integer genus of the surface.
+    """
+    # Initialize counters for neighbor counts
+    count_3 = 0
+    count_5 = 0
+    count_6 = 0
+    
+    # Iterate over each surface point
+    for s in surface_points:
+        # Get neighbors of s that are also in the surface
+        # This relies on the adjacency definition in the Khalimsky space
+        # as defined in the parent article [3937-digital-surface-extraction-via-khalimsky-space.md]
+        neighbors = get_surface_neighbors(s, surface_points)
+        neighbor_count = len(neighbors)
+        
+        if neighbor_count == 3:
+            count_3 += 1
+        elif neighbor_count == 5:
+            count_5 += 1
+        elif neighbor_count == 6:
+            count_6 += 1
+        else:
+            # Points with other neighbor counts are not part of the standard 
+            # manifold configuration for this formula. 
+            # In a strict 2-manifold MI reconstruction, these should not occur.
+            pass
+            
+    # Apply the genus formula
+    # g = 1 + (|N5| + 2|N6| - |N3|) / 8
+    numerator = count_5 + 2 * count_6 - count_3
+    genus = 1 + numerator / 8
+    
+    return genus
