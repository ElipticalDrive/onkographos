+def _propagate_uncertainty(bounds_min, bounds_max):
+    """
+    Estimates mean and standard deviation of INR output over a bounding box.
+    Uses first-order Taylor approximation [G].
+    """
+    center = (bounds_min + bounds_max) / 2.0
+    mu = inr_func(center)
+    # Approximate variance via finite differences or Jacobian trace [G]
+    eps = 1e-4
+    grad_x = (inr_func(center + jnp.array([eps, 0, 0])) - mu) / eps
+    grad_y = (inr_func(center + jnp.array([0, eps, 0])) - mu) / eps
+    grad_z = (inr_func(center + jnp.array([0, 0, eps])) - mu) / eps
+    sigma = jnp.sqrt((grad_x**2 + grad_y**2 + grad_z**2) * (eps**2) / 3.0)
+    return mu, sigma
