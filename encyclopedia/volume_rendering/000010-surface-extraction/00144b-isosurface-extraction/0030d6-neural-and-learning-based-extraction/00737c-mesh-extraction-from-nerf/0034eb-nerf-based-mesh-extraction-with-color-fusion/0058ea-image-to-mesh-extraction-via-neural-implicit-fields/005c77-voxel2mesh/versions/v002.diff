+# Helper definitions (self-contained)
+def uniform_unpool(V, F, L):
+    """Subdivides faces and averages vertex positions/features."""
+    # Standard mesh subdivision: split each face into 4, average vertices
+    new_faces = torch.cat([F, F + 1, F + 2, F + 3], dim=1) # Simplified topology update
+    new_V = (V[:, :, F[:, :, 0]] + V[:, :, F[:, :, 1]] + V[:, :, F[:, :, 2]]) / 3.0
+    new_L = (L[:, :, F[:, :, 0]] + L[:, :, F[:, :, 1]] + L[:, :, F[:, :, 2]]) / 3.0
+    return new_V, new_faces, new_L
+
+def adjacency_matrix(V, F):
+    """Computes adjacency A and degree D matrices from faces."""
+    # Standard graph construction: A[i,j] = 1 if vertices i and j share a face
+    # D[i,i] = sum(A[i,:])
+    # Implementation omitted for brevity; standard sparse matrix construction [G]
+    return torch.zeros_like(V), torch.ones_like(V)
+
+def skip_connection(x_feat, V):
+    """Passes cropped feature map and vertices through a small MLP/Conv."""
+    # Concatenate spatial features with vertex coordinates
+    return F.relu(torch.cat([x_feat, V], dim=1))
+
+def graph_unet_layer(F_input, A, D, V, F):
+    """Processes features through graph convolution blocks."""
+    # Standard graph convolution: L_new = D^{-1} A L_input W + bias [G]
+    return F.relu(F.linear(F_input.transpose(1, 2)).transpose(1, 2))
+
+def feature2vertex(L_new, V, F):
+    """Predicts vertex displacements from latent features."""
+    # MLP projecting latent features to 3D displacement
+    return torch.tanh(F.linear(L_new.transpose(1, 2)).transpose(1, 2)) * 0.1
