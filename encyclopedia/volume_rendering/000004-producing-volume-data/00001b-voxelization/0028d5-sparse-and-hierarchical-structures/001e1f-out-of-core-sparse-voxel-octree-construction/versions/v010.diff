+def point_in_triangle(point, tri):
+    # Barycentric coordinate test [G]
+    v0 = tri.v1 - tri.v0
+    v1 = tri.v2 - tri.v0
+    v2 = point - tri.v0
+    dot00 = dot(v0, v0)
+    dot01 = dot(v0, v1)
+    dot02 = dot(v0, v2)
+    dot11 = dot(v1, v1)
+    dot12 = dot(v1, v2)
+    inv_denom = 1 / (dot00 * dot11 - dot01 * dot01)
+    u = (dot11 * dot02 - dot01 * dot12) * inv_denom
+    v = (dot00 * dot12 - dot01 * dot02) * inv_denom
+    return (u >= 0) and (v >= 0) and (u + v <= 1)
 
