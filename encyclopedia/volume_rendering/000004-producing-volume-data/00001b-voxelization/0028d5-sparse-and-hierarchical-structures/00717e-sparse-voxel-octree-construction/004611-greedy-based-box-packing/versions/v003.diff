+def greedy_box_packing(volume, X, Y, Z, T_density, T_sparsity):
+    # 1. Seed Map Creation
+    seed_map = [[[False]*Z for _ in range(Y)] for _ in range(X)]
+    for x in range(X):
+        for y in range(Y):
+            for z in range(Z):
+                if volume[x][y][z] > T_density:
+                    seed_map[x][y][z] = True
+                else:
+                    seed_map[x][y][z] = False
 
