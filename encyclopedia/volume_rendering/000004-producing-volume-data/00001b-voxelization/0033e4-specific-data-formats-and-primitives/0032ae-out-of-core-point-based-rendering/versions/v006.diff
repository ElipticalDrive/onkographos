+    """Standard 3D Morton Z-order encoding for 8-bit channels [G]."""
+    m = 0
+    for i in range(8):
+        m |= ((r >> i) & 1) << (3 * i)
+        m |= ((g >> i) & 1) << (3 * i + 1)
+        m |= ((b >> i) & 1) << (3 * i + 2)
+    return m
