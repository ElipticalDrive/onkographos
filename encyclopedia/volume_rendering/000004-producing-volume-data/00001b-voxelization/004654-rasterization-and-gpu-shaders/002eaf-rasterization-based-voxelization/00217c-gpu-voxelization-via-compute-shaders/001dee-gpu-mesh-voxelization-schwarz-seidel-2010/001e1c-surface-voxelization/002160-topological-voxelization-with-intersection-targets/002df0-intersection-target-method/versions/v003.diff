+def _bisect(func, a, b, tol=1e-6, max_iter=100):
+    """[G] Standard bisection root finder for a continuous function."""
+    roots = []
+    fa, fb = func(a), func(b)
+    if fa * fb > 0:
+        return roots
+    for _ in range(max_iter):
+        mid = (a + b) / 2
+        fm = func(mid)
+        if abs(fm) < tol or (b - a) / 2 < tol:
+            roots.append(mid)
+            break
+        if fa * fm < 0:
+            b, fb = mid, fm
+        else:
