+def barycentric_integral(V, a, b, c, d):
+    """Integral of barycentric monomial over tetrahedron."""
+    return 6.0 * V * math.factorial(a) * math.factorial(b) * math.factorial(c) * math.factorial(d) / math.factorial(a + b + c + d + 3)
+
