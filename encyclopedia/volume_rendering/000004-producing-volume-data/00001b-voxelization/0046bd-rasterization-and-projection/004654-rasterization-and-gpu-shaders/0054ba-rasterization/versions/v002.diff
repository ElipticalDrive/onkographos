+**Pseudocode:**
+```python
+def rasterize(vertices, faces, E, K, image_width, image_height):
+    # Initialize output buffers
+    color_buffer = np.zeros((image_height, image_width, 3))
+    z_buffer = np.full((image_height, image_width), np.inf)
+
+    for face in faces:
+        # 1. Transform vertices to camera space
+        v_cam = E @ vertices[face]
+
+        # 2. Cull: skip if outside view frustum or back-facing
+        if is_outside_frustum(v_cam) or is_backfacing(v_cam):
+            continue
+
+        # 3. Project to 2D image coordinates
+        v_img = K @ v_cam
+        # Perspective division (standard graphics operation [G])
+        v_img = v_img[:, :2] / v_img[:, 2]
+
+        # 4. Interpolate attributes and rasterize
+        # Determine bounding box of projected triangle
+        min_x, max_x = int(min(v_img[:, 0])), int(max(v_img[:, 0]))
+        min_y, max_y = int(min(v_img[:, 1])), int(max(v_img[:, 1]))
+        min_x, max_x = clamp(min_x, 0, image_width - 1), clamp(max_x, 0, image_width - 1)
+        min_y, max_y = clamp(min_y, 0, image_height - 1), clamp(max_y, 0, image_height - 1)
+
+        for y in range(min_y, max_y + 1):
+            for x in range(min_x, max_x + 1):
+                # Barycentric interpolation for depth (standard [G])
+                depth = interpolate_depth(v_img, x, y)
+                if depth < z_buffer[y, x]:
+                    z_buffer[y, x] = depth
+                    color_buffer[y, x] = interpolate_color(v_img, x, y)
+    return color_buffer, z_buffer
+```
