+def compute_morton(z, y, x):
+    # Standard 3D Morton code interleaving
+    m = 0
+    for i in range(10): # Assumes coordinates fit in 10 bits each
+        m |= ((x & (1 << i)) << (2 * i))
+        m |= ((y & (1 << i)) << (2 * i + 1))
+        m |= ((z & (1 << i)) << (2 * i + 2))
+    return m
