+def swizzle(v0, v1, v2, n, axis):
+    # Permute coordinates to align dominant axis with Z (XY plane projection)
+    if axis == 0: # X dominant
+        return [v0[1], v1[1], v2[1]], [v0[2], v1[2], v2[2]], [v0[0], v1[0], v2[0]], [n[1], n[2], n[0]]
+    elif axis == 1: # Y dominant
+        return [v0[0], v1[0], v2[0]], [v0[2], v1[2], v2[2]], [v0[1], v1[1], v2[1]], [n[0], n[2], n[1]]
+    else: # Z dominant
+        return v0, v1, v2, n
+
+def get_unswizzle_matrix(axis):
+    # Returns permutation matrix to reverse swizzle
+    if axis == 0: return [[0,0,1],[1,0,0],[0,1,0]]
+    elif axis == 1: return [[1,0,0],[0,0,1],[0,1,0]]
+    else: return [[1,0,0],[0,1,0],[0,0,1]]
+
+def compute_2d_edge_normals(e0, e1, e2, n, plane):
+    # Compute inward-facing 2D edge normals based on plane and normal sign
+    if plane == 'XY':
+        sign = 1 if n[2] >= 0 else -1
+        return [sign * vec2(-e0[1], e0[0]), sign * vec2(-e1[1], e1[0]), sign * vec2(-e2[1], e2[0])]
+    elif plane == 'YZ':
+        sign = 1 if n[0] >= 0 else -1
+        return [sign * vec2(-e0[2], e0[1]), sign * vec2(-e1[2], e1[1]), sign * vec2(-e2[2], e2[1])]
+    else: # ZX
+        sign = 1 if n[1] >= 0 else -1
+        return [sign * vec2(-e0[0], e0[2]), sign * vec2(-e1[0], e1[2]), sign * vec2(-e2[0], e2[2])]
+
+def image_store(buffer, pos, value):
+    idx = pos[0] + pos[1] * voxel_resolution + pos[2] * voxel_resolution * voxel_resolution
+    buffer[idx] = value
+
+def barrier_all():
