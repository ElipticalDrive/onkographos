+    if sin_theta_t_sq > 1.0: return 0.0
+    cos_theta_t = math.sqrt(1.0 - sin_theta_t_sq)
+    rs = ((n1 * cos_theta_i) - (n2 * cos_theta_t)) / ((n1 * cos_theta_i) + (n2 * cos_theta_t))
+    rp = ((n1 * cos_theta_t) - (n2 * cos_theta_i)) / ((n1 * cos_theta_t) + (n2 * cos_theta_i))
+    return 0.5 * (rs**2 + rp**2)
