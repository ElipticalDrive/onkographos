+def split_polygon_bary(polygon_bary, tri_coords, value):
+    below = []
+    above = []
+    n = len(polygon_bary)
+    for i in range(n):
+        curr_bary = polygon_bary[i]
+        next_bary = polygon_bary[(i + 1) % n]
+        curr_val = torch.dot(curr_bary, tri_coords)
+        next_val = torch.dot(next_bary, tri_coords)
+        curr_below = curr_val <= value
+        next_below = next_val <= value
+        if curr_below:
+            below.append(curr_bary)
+        else:
+            above.append(curr_bary)
+        if curr_below != next_below:
+            d = next_val - curr_val
+            if torch.abs(d) > 1e-12:
+                t = (value - curr_val) / d
+                intersection_bary = curr_bary + t * (next_bary - curr_bary)
+                below.append(intersection_bary)
+                above.append(intersection_bary)
+    return below
