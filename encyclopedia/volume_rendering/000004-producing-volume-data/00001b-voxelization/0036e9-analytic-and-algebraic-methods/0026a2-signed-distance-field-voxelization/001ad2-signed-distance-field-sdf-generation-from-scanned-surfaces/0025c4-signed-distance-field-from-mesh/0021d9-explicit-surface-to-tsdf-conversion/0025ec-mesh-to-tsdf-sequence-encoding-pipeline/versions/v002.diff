+def parse_pattern(text):
+    pattern = {"head": "", "tail": "", "width": -1}
+    out = pattern["head"]
+    i = 0
+    while i < len(text):
+        if text[i] != '%':
+            out += text[i]
+            i += 1
+            continue
+        rest = len(text) - i - 1
+        if rest >= 1 and text[i + 1] == '%':
+            out += '%'
+            i += 2
+            continue
+        width = 0
+        if rest >= 1 and text[i + 1] == 'd':
+            i += 2
+        elif rest >= 3 and text[i + 1] == '0' and text[i + 2].isdigit() and text[i + 3] == 'd':
+            width = int(text[i + 2])
+            i += 4
+        else:
+            raise ValueError("Invalid pattern")
+        pattern["width"] = width
+        pattern["tail"] = text[i:]
+        break
+    return pattern
