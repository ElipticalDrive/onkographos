+def sat_triangle_aabb(triangle, min_x, max_x, min_y, max_y, min_z, max_z):
+    """
+    Separating Axis Theorem for triangle vs AABB [G].
+    Returns True if they intersect, False otherwise.
+    """
+    v0, v1, v2 = triangle
+    bc = ((min_x + max_x)/2, (min_y + max_y)/2, (min_z + max_z)/2)
+    be = ((max_x - min_x)/2, (max_y - min_y)/2, (max_z - min_z)/2)
+    
+    e1 = (v1[0]-v0[0], v1[1]-v0[1], v1[2]-v0[2])
+    e2 = (v2[0]-v0[0], v2[1]-v0[1], v2[2]-v0[2])
+    t_n = cross(e1, e2)
+    
+    # Test box axes (x, y, z)
+    for axis in [(1,0,0), (0,1,0), (0,0,1)]:
+        p0 = dot(v0, axis); p1 = dot(v1, axis); p2 = dot(v2, axis)
+        min_p, max_p = min(p0, p1, p2), max(p0, p1, p2)
+        c = dot(bc, axis)
+        r = be[0]*abs(axis[0]) + be[1]*abs(axis[1]) + be[2]*abs(axis[2])
+        if max_p < c - r or min_p > c + r: return False
+        
+    # Test triangle normal
