+    t_n_len = math.sqrt(dot(t_n, t_n))
+    t_n = (t_n[0]/t_n_len, t_n[1]/t_n_len, t_n[2]/t_n_len)
+    p0 = dot(v0, t_n); p1 = dot(v1, t_n); p2 = dot(v2, t_n)
+    min_p, max_p = min(p0, p1, p2), max(p0, p1, p2)
+    c = dot(bc, t_n)
+    r = be[0]*abs(t_n[0]) + be[1]*abs(t_n[1]) + be[2]*abs(t_n[2])
+    if max_p < c - r or min_p > c + r: return False
+    
+    # Test cross products of triangle edges with box axes
+    axes = [cross(e1, (1,0,0)), cross(e1, (0,1,0)), cross(e1, (0,0,1)),
+            cross(e2, (1,0,0)), cross(e2, (0,1,0)), cross(e2, (0,0,1))]
