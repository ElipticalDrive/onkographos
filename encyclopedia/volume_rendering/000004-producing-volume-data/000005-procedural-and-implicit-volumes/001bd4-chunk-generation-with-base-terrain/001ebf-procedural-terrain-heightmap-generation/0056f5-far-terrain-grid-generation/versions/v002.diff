+def value_noise(x, z, seed):
+    # Simple integer grid hash noise [G]
+    ix = int(x) & 0xFF
+    iz = int(z) & 0xFF
+    h = (ix * 374761393 + iz * 668265263 + seed) & 0x7FFFFFFF
+    return (h % 10000) / 10000.0
