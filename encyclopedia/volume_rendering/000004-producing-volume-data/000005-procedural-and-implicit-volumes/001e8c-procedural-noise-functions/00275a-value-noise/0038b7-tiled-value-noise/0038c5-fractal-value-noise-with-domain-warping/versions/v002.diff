 import numpy as np
 
+def _value_noise_slice(lattice, x, y, z):
+    """Standard 3D value noise lookup using linear interpolation on a tiled grid."""
+    # [G] Standard value noise implementation: hash grid coordinates,
+    # compute interpolation weights, and blend lattice values.
+    ix, iy, iz = int(np.floor(x)), int(np.floor(y)), int(np.floor(z))
+    fx, fy, fz = x - ix, y - iy, z - iz
+    def lerp(a, b, t): return a + t * (b - a)
+    def hash(i, j, k): return lattice[(i % lattice.shape[0], j % lattice.shape[1], k % lattice.shape[2])]
+    v000 = hash(ix, iy, iz)
+    v100 = hash(ix+1, iy, iz)
+    v010 = hash(ix, iy+1, iz)
+    v110 = hash(ix+1, iy+1, iz)
+    v001 = hash(ix, iy, iz+1)
+    v101 = hash(ix+1, iy, iz+1)
+    v011 = hash(ix, iy+1, iz+1)
+    v111 = hash(ix+1, iy+1, iz+1)
+    x1 = lerp(v000, v100, fx)
+    x2 = lerp(v010, v110, fx)
+    y1 = lerp(v001, v101, fx)
+    y2 = lerp(v011, v111, fx)
+    z1 = lerp(x1, x2, fy)
+    z2 = lerp(y1, y2, fy)
+    return lerp(z1, z2, fz)
+
