+**Pseudocode:**
+```python
+def setup_distance_attenuation(projection_matrix, viewport_height):
+    # projection_matrix is a 4x4 array, viewport_height is an integer
+    h = 2.0 / projection_matrix[0][0]
+    D0 = (2.0 ** 0.5) * viewport_height / h
+    k = 1.0 / (1.0 + 2.0 * (1.0 / projection_matrix[0][0]) ** 0.5)
+    atten = [0.0, 0.0, (1.0 / D0) ** 0.5 * k]
+    gl_point_parameterfv_ext(GL_DISTANCE_ATTENUATION_EXT, atten)
+    gl_point_size(1.0)
+    gl_enable(GL_POINT_SMOOTH)
+```
 
