+**Pseudocode:**
+```python
+def FSEraser(polygon_coord, proj_plane, P, sculpt_map):
+    # polygon_coord: 2D texture mapping fragment UV to 3D voxel coordinates
+    # proj_plane: 4x4 projection matrix
+    # P: 3D vector (P.xy = 2D tool center, P.z = tool radius r)
+    # sculpt_map: 3D texture storing the mask
+    tex_coord = texture_sample_2d(polygon_coord)  # Returns float3
+    Col = texture_sample_3d(sculpt_map, tex_coord)  # Col is the current mask RGBA value
+    # Project 3D voxel coordinate to 2D projection plane
+    plane_coords = matrix_mul(float4(tex_coord - 0.5, 1.0), proj_plane)
+    plane_coords.xyz /= plane_coords.w
+    # Normalized 2D Euclidean distance to tool center
+    D = length(plane_coords.xy - P.xy) / P.z
+    if D < Col.a:
+        Col.a = D
+    return Col
+
+def FSClipper(clip_plane, sculpt_map, polygon_coord):
+    # clip_plane: 4D vector (ax, ay, az, d) defining the clipping plane
+    tex_coord = texture_sample_2d(polygon_coord)
+    Col = texture_sample_3d(sculpt_map, tex_coord)
+    # Signed distance to clipping plane, clamped to [0, 1]
+    D = clamp(dot(clip_plane, float4(tex_coord - 0.5, 1.0)) + 1.0, 0.0, 1.0)
+    if D < Col.a:
+        Col.a = D
+    return Col
+```
+
 **Parameters:**
-*   $r$: Tool radius.
-*   $P$: 2D point defining the eraser center.
-*   `clipPlane`: Plane equation for the clipper.
