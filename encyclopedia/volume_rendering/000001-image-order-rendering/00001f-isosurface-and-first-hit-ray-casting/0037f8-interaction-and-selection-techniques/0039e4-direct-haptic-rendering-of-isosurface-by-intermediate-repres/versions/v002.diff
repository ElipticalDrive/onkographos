+def tri_linear_interpolate(V, p):
+    # Standard tri-linear interpolation [G]
+    ix, iy, iz = int(p[0]), int(p[1]), int(p[2])
+    fx, fy, fz = p[0]-ix, p[1]-iy, p[2]-iz
+    ix = max(0, min(ix, V.shape[0]-2))
+    iy = max(0, min(iy, V.shape[1]-2))
+    iz = max(0, min(iz, V.shape[2]-2))
+    c00 = V[ix, iy, iz]*(1-fx) + V[ix+1, iy, iz]*fx
+    c10 = V[ix, iy+1, iz]*(1-fx) + V[ix+1, iy+1, iz]*fx
+    c01 = V[ix, iy, iz+1]*(1-fx) + V[ix+1, iy, iz+1]*fx
+    c11 = V[ix, iy+1, iz+1]*(1-fx) + V[ix+1, iy+1, iz+1]*fx
+    c0 = c00*(1-fy) + c10*fy
+    c1 = c01*(1-fy) + c11*fy
+    return c0*(1-fz) + c1*fz
 
