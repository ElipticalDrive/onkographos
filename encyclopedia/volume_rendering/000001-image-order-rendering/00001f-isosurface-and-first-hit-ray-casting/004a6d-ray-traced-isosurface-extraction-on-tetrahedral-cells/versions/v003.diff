+def solve_4x4(M, S):
+    # Solves M * x = S using Gaussian elimination with partial pivoting [G].
+    n = 4
+    aug = [M[i] + [S[i]] for i in range(n)]
+    for i in range(n):
+        max_row = i
+        for k in range(i + 1, n):
+            if abs(aug[k][i]) > abs(aug[max_row][i]):
+                max_row = k
+        aug[i], aug[max_row] = aug[max_row], aug[i]
+        pivot = aug[i][i]
+        if abs(pivot) < 1e-12:
+            return [0.0] * n
+        for k in range(i + 1, n):
+            factor = aug[k][i] / pivot
+            for j in range(i, n + 1):
+                aug[k][j] -= factor * aug[i][j]
+    x = [0.0] * n
+    for i in range(n - 1, -1, -1):
+        x[i] = aug[i][n]
+        for j in range(i + 1, n):
+            x[i] -= aug[i][j] * x[j]
+        x[i] /= aug[i][i]
+    return x
 
