+def ray_box_intersection(ray_o, ray_d, box_min, box_max):
+    """Standard slab method. Returns (t_min, t_max) or None if no hit."""
+    t_min = -float('inf')
+    t_max = float('inf')
+    for i in range(3):
+        if ray_d[i] == 0.0:
+            if ray_o[i] < box_min[i] or ray_o[i] > box_max[i]:
+                return None
+        else:
+            t1 = (box_min[i] - ray_o[i]) / ray_d[i]
+            t2 = (box_max[i] - ray_o[i]) / ray_d[i]
+            t_min = max(t_min, min(t1, t2))
+            t_max = min(t_max, max(t1, t2))
+    if t_max < 0.0 or t_min > t_max:
+        return None
+    return t_min, t_max
+
+def trilinear_intersection(ray_o, ray_d, voxel_data, isovalue):
+    """Solves V(u,v,w) = isovalue along ray segment within voxel bounds [G]."""
+    # voxel_data: [x, y, z, w, h, d, v0...v7]
+    # v0..v7 are scalar values at the 8 vertices of the voxel
+    box_min = [voxel_data[0], voxel_data[1], voxel_data[2]]
+    box_max = [voxel_data[0] + voxel_data[3], 
+               voxel_data[1] + voxel_data[3], 
+               voxel_data[2] + voxel_data[3]]
+    
+    t_hit = None
+    t_seg = ray_box_intersection(ray_o, ray_d, box_min, box_max)
+    if t_seg is None:
+        return None
+        
+    t_start, t_end = t_seg
+    # Bisection search for trilinear root within voxel slab [G]
+    for _ in range(32):
+        t_mid = (t_start + t_end) / 2.0
+        p = ray_o + t_mid * ray_d
+        u = (p[0] - box_min[0]) / (box_max[0] - box_min[0])
+        v = (p[1] - box_min[1]) / (box_max[1] - box_min[1])
+        w = (p[2] - box_min[2]) / (box_max[2] - box_min[2])
+        u = max(0.0, min(1.0, u))
+        v = max(0.0, min(1.0, v))
+        w = max(0.0, min(1.0, w))
+        
+        # Trilinear interpolation formula [G]
+        v000, v100, v010, v110, v001, v101, v011, v111 = voxel_data[6:14]
+        val = ((1-u)*(1-v)*(1-w)*v000 + u*(1-v)*(1-w)*v100 + 
+               (1-u)*v*(1-w)*v010 + u*v*(1-w)*v110 + 
+               (1-u)*(1-v)*w*v001 + u*(1-v)*w*v101 + 
+               (1-u)*v*w*v011 + u*v*w*v111)
+        
+        if abs(val - isovalue) < 1e-6:
+            t_hit = t_mid
+            break
+        if (val - isovalue) * ((1-u)*(1-v)*(1-w)*v000 - isovalue) < 0:
+            t_end = t_mid
+        else:
