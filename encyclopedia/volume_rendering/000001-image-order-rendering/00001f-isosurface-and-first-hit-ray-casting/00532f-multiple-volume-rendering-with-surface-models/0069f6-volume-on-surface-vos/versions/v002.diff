+        t_delta_y = float('inf')
+
+    if direction[2] != 0:
+        boundary_z = (z + (1 if step_z > 0 else 0)) * dz
+        t_max_z = abs(boundary_z - origin[2]) / abs(direction[2])
+        t_delta_z = dz / abs(direction[2])
+    else:
+        t_max_z = float('inf')
+        t_delta_z = float('inf')
+
+    visited = []
+    max_steps = grid_dims[0] * grid_dims[1] * grid_dims[2]
+    steps = 0
+    while 0 <= x < grid_dims[0] and 0 <= y < grid_dims[1] and 0 <= z < grid_dims[2] and steps < max_steps:
+        visited.append((x, y, z))
+        steps += 1
+        if t_max_x < t_max_y:
+            if t_max_x < t_max_z:
+                x += step_x
+                t_max_x += t_delta_x
+            else:
+                z += step_z
+                t_max_z += t_delta_z
+        else:
+            if t_max_y < t_max_z:
+                y += step_y
+                t_max_y += t_delta_y
+            else:
+                z += step_z
+                t_max_z += t_delta_z
+    return visited
