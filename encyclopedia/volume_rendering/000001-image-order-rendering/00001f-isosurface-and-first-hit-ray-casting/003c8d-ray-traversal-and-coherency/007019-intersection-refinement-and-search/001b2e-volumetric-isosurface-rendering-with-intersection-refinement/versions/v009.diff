+def intersect_box(o, d, min_b, max_b):
+    t_min = 0.0
+    t_max = float('inf')
+    for i in range(3):
+        if d[i] == 0:
+            if o[i] < min_b[i] or o[i] > max_b[i]:
+                return None, None
+        else:
+            t1 = (min_b[i] - o[i]) / d[i]
+            t2 = (max_b[i] - o[i]) / d[i]
+            if t1 > t2: t1, t2 = t2, t1
+            t_min = max(t_min, t1)
+            t_max = min(t_max, t2)
+        if t_min > t_max:
+            return None, None
+    return t_min, t_max
+
+def sample_volume(p, tex):
+    # Standard 3D texture lookup with linear filtering
+    return tex[p]
