+def calculate_xz_falloff(pos, params):
+    xmin = -0.5 * params.volume_scaling.x + params.volume_translate.x
+    xmax = xmin + params.volume_scaling.x
+    zmin = -0.5 * params.volume_scaling.z + params.volume_translate.z
