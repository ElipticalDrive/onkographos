+def intersect_sphere(origin, direction, sphere):
+    # Ray-sphere intersection [G]
+    oc = origin - sphere.center
+    a = dot(direction, direction)
+    b = 2.0 * dot(oc, direction)
+    c = dot(oc, oc) - sphere.radius * sphere.radius
+    disc = b*b - 4*a*c
+    if disc < 0:
+        return None, None
+    sqrt_disc = sqrt(disc)
+    t0 = (-b - sqrt_disc) / (2*a)
+    t1 = (-b + sqrt_disc) / (2*a)
+    if t0 < 0:
+        t0 = t1
+    return t0, t1
