+    ndc_y = 1.0 - (2.0 * (j + 0.5) / height)
+    ray_dir = Vector3(ndc_x * aspect * tan(fov/2), ndc_y * tan(fov/2), -1.0)
+    ray_dir = normalize(ray_dir)
+    return camera.position, ray_dir
