+def intersect_bounding_box(origin, direction, bbox_min, bbox_max):
+    """[G] Simple axis-aligned bounding box intersection."""
+    t_min = (bbox_min[0] - origin[0]) / direction[0]
+    t_max = (bbox_max[0] - origin[0]) / direction[0]
