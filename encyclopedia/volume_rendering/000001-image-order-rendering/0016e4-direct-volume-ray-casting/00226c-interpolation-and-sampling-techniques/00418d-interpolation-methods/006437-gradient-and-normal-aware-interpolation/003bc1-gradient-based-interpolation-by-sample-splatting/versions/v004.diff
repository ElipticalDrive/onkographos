+# Helper definitions
+def vec(x, y, z): return type('vec', (), {'x': x, 'y': y, 'z': z})()
+def add_vectors(a, b): return vec(a.x + b.x, a.y + b.y, a.z + b.z)
+def sub_vectors(a, b): return vec(a.x - b.x, a.y - b.y, a.z - b.z)
+def scale_vector(v, s): return vec(v.x * s, v.y * s, v.z * s)
+def dot(a, b): return a.x * b.x + a.y * b.y + a.z * b.z
+def length(v): return math.sqrt(v.x**2 + v.y**2 + v.z**2)
+def length_sq(v): return v.x**2 + v.y**2 + v.z**2
+def normalize(v): l = length(v); return vec(v.x/l, v.y/l, v.z/l)
+def is_inside_volume(p, bounds): return bounds.min.x <= p.x <= bounds.max.x and bounds.min.y <= p.y <= bounds.max.y and bounds.min.z <= p.z <= bounds.max.z
