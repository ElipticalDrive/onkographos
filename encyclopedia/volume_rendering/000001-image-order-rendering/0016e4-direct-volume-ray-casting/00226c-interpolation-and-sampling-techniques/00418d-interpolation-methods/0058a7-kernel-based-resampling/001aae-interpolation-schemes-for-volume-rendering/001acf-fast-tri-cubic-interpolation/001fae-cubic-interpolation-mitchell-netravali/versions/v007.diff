-**Pitfalls:**
-- General cubic interpolation can produce values outside the range of the inputs; clamping is required [S1, unofficial].
-- The filter support is fixed at 4N samples in N dimensions (64 in 3D), which is computationally expensive compared to linear interpolation [S1, unofficial].
+```python
+def mitchell_netravali_kernel(x, B, C):
+    ax = abs(x)
+    ax2 = ax * ax
+    ax3 = ax2 * ax
+    
+    if ax < 1.0:
+        # Case |x| < 1
+        # Coefficients from source: (12 - 9B - 6C), (-18 + 12B + 6C), (6 - 2B)
+        c3 = 12.0 - 9.0 * B - 6.0 * C
+        c2 = -18.0 + 12.0 * B + 6.0 * C
+        c0 = 6.0 - 2.0 * B
+        return (c3 * ax3 + c2 * ax2 + c0) / 6.0
+    elif ax < 2.0:
+        # Case 1 <= |x| < 2
+        # Coefficients from source: (-B - 6C), (6B + 30C), (-12B - 48C), (8B + 24C)
+        c3 = -B - 6.0 * C
+        c2 = 6.0 * B + 30.0 * C
+        c1 = -12.0 * B - 48.0 * C
+        c0 = 8.0 * B + 24.0 * C
+        return (c3 * ax3 + c2 * ax2 + c1 * ax + c0) / 6.0
+    else:
+        return 0.0
+
+def sample_volume_mitchell(volume, p, B, C, min_val, max_val):
+    # p is (x, y, z)
+    result = 0.0
+    
+    # Iterate over the 4x4x4 grid
+    for dx in range(-1, 3):
+        for dy in range(-1, 3):
+            for dz in range(-1, 3):
+                # Get voxel coordinates
+                vx = floor(p.x) + dx
+                vy = floor(p.y) + dy
+                vz = floor(p.z) + dz
+                
+                # Check bounds (edge case)
+                if not volume.is_valid(vx, vy, vz):
+                    continue
+                
+                # Compute relative distances
+                ux = p.x - (floor(p.x) + dx)
+                uy = p.y - (floor(p.y) + dy)
+                uz = p.z - (floor(p.z) + dz)
+                
+                # Compute weights
+                wx = mitchell_netravali_kernel(ux, B, C)
+                wy = mitchell_netravali_kernel(uy, B, C)
+                wz = mitchell_netravali_kernel(uz, B, C)
+                
+                # Combine weights (separable kernel)
+                w = wx * wy * wz
+                
+                # Accumulate
+                result += w * volume.get(vx, vy, vz)
+                
+    # Clamp to prevent out-of-range values [S1, unofficial]
+    return clamp(result, min_val, max_val)
+```
 
