+def interpolate_1d(tf_positions, tf_values, scalar_val):
+    """Linear interpolation of 1D transfer function."""
+    # Find index where tf_positions[i] <= scalar_val < tf_positions[i+1]
+    idx = np.searchsorted(tf_positions, scalar_val, side='right') - 1
+    if idx < 0:
+        idx = 0
