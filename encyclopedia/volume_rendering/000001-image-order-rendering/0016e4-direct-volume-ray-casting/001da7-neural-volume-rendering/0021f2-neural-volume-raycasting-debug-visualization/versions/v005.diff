+**Pseudocode**
+```python
+import math
+
+def sigmoid(x):
+    return 1.0 / (1.0 + math.exp(-x))
+
+def softplus(x):
+    return math.log(1.0 + math.exp(x))
+
+def visualize_neural_volume(dataset, model, empty_threshold=0.1, num_samples=64, sphere_scale=0.02):
+    # 1. Subsample rays using a precomputed index set
+    ray_indices = dataset.subsample_index
+
+    # 2. Iterate over each camera and fetch ray samples
+    for camera_idx in range(dataset.num_cameras):
+        positions, views = dataset.rays_for_camera(camera_idx)
+
+        # 3. Move to compute device and reshape to (-1, 3)
+        positions = positions.to(device=model.device).reshape(-1, 3)
+        if views is not None:
+            views = views.to(device=model.device).reshape(-1, 3)
+
+        # 4. Query neural network
+        if views is not None:
+            raw_output = model(positions, views)
+        else:
+            raw_output = model(positions)
+
+        # 5. Reshape output to (-1, num_samples, 4) and split
+        raw_output = raw_output.reshape(-1, num_samples, 4)
+        color_raw = raw_output[:, :, :3]
+        opacity_raw = raw_output[:, :, 3:4]
+
+        # 6. Apply activation functions
+        color = sigmoid(color_raw)
+        opacity = softplus(opacity_raw)
+
+        # 7. Convert to CPU numpy arrays and reshape
+        positions_np = positions.cpu().numpy().reshape(-1, 3)
+        color_np = color.cpu().numpy().reshape(-1, 3)
+        opacity_np = opacity.cpu().numpy().reshape(-1, 1)
+
+        # 8. Classify samples as empty or non-empty
+        empty_mask = opacity_np < empty_threshold
+
+        # 9. Create instanced sphere meshes
+        instances = []
+        for i in range(len(positions_np)):
+            if empty_mask[i]:
+                base_color = [0.0, 0.0, 0.0]
+                instance_color = [0.0, 0.0, 0.0]
+            else:
+                base_color = [1.0, 1.0, 1.0]
+                instance_color = color_np[i]
+            instances.append({
+                "position": positions_np[i],
+                "base_color": base_color,
+                "instance_color": instance_color,
+                "scale": sphere_scale
+            })
+
+        # 10. Export scene
