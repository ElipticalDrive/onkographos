+def trilinear_interpolate(grid, points):
+    """Standard trilinear interpolation [G]."""
+    grid_shape = torch.tensor(grid.shape, device=points.device, dtype=torch.float32)
+    coords = points * (grid_shape - 1)
+    x0 = torch.clamp(torch.floor(coords[:, 0]).long(), 0, grid_shape[0]-1)
+    y0 = torch.clamp(torch.floor(coords[:, 1]).long(), 0, grid_shape[1]-1)
+    z0 = torch.clamp(torch.floor(coords[:, 2]).long(), 0, grid_shape[2]-1)
+    x1 = torch.clamp(x0 + 1, 0, grid_shape[0]-1)
+    y1 = torch.clamp(y0 + 1, 0, grid_shape[1]-1)
+    z1 = torch.clamp(z0 + 1, 0, grid_shape[2]-1)
+    dx = coords[:, 0] - x0.float()
+    dy = coords[:, 1] - y0.float()
+    dz = coords[:, 2] - z0.float()
+    # Interpolate values at corners
+    v000 = grid[x0, y0, z0]
+    v100 = grid[x1, y0, z0]
+    v010 = grid[x0, y1, z0]
+    v110 = grid[x1, y1, z0]
+    v001 = grid[x0, y0, z1]
+    v101 = grid[x1, y0, z1]
+    v011 = grid[x0, y1, z1]
+    v111 = grid[x1, y1, z1]
+    # Trilinear combination
+    v00 = v000 * (1 - dx) + v100 * dx
+    v01 = v001 * (1 - dx) + v101 * dx
+    v10 = v010 * (1 - dx) + v110 * dx
+    v11 = v011 * (1 - dx) + v111 * dx
+    v0 = v00 * (1 - dy) + v10 * dy
+    v1 = v01 * (1 - dy) + v11 * dy
+    return v0 * (1 - dz) + v1 * dz
+
