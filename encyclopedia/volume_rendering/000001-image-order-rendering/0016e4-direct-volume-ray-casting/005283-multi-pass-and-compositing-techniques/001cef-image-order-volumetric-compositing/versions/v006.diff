+def trilinear_interpolate(arr, pos, dims):
+    D, H, W = dims
+    x, y, z = pos
+    x0, x1 = int(x), min(int(x)+1, W-1)
+    y0, y1 = int(y), min(int(y)+1, H-1)
+    z0, z1 = int(z), min(int(z)+1, D-1)
+    fx, fy, fz = x-x0, y-y0, z-z0
+    def lerp(a, b, t): return a + t * (b - a)
+    c00 = lerp(arr[z0][y0][x0], arr[z0][y0][x1], fx)
+    c01 = lerp(arr[z0][y1][x0], arr[z0][y1][x1], fx)
+    c10 = lerp(arr[z1][y0][x0], arr[z1][y0][x1], fx)
+    c11 = lerp(arr[z1][y1][x0], arr[z1][y1][x1], fx)
+    c0 = lerp(c00, c01, fy)
+    c1 = lerp(c10, c11, fy)
+    return lerp(c0, c1, fz)
