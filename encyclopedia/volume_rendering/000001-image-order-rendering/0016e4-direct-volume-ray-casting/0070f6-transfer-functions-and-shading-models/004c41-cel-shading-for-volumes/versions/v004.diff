+def xtoon_tone_detail(density_c, temp_density):
+    density_min = 0.01
+    density_max = density_min * params.r
+    density = temp_density
+    density_min_m = density_c - density_min
+    density_min_p = density_c + density_min
+    density_max_m = density_c - density_max
+    density_max_p = density_c + density_max
+    D = 1.0 - log(density / density_min) / log(density_max - density_min)
+    if density < density_min_m:
+        density_min = density_c - density_min
+        density_max = density_c - params.r * density_min
+        D = 1.0 - log(density / density_min_m) / log(density_max_m / density_min_m)
+    elif density > density_min_p:
+        density_min = density_c + density_min
+        density_max = density_c + params.r * density_min
+        D = log(density / density_max_p) / log(density_min_p / density_max_p)
+    return D
+
+def xtoon_specular(VR):
+    return pow(VR, params.s)
+
+def xtoon_backlight(NV):
