+        blurred = apply_gaussian_filter(current, blur_sigma)
+        downsampled = [[blurred[j][k] for k in range(0, len(blurred[0]), 2)] for j in range(0, len(blurred), 2)]
+        levels.append(downsampled)
+        current = downsampled
+    return levels
