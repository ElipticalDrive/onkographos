+        scalar = volume.sample_scalar(x, y, z)
+        color_feat = volume.sample_color(x, y, z)
+        grad_feat = volume.sample_gradient(x, y, z)
+        
+        # Evaluate opacity for current step
+        alpha = opacity_func(scalar, color_feat, grad_feat)
+        
+        # Front-to-back accumulation
+        if alpha_accum >= 1.0:
+            accumulated_alphas.append(1.0)
+            break
+            
+        weight = alpha * (1.0 - alpha_accum)
+        alpha_accum += weight
