+def raycast_opacity_trace(origin, direction, step, volume, opacity_func, num_steps):
+    """
+    Marches a ray through a volume and returns accumulated opacity at each step.
+    Uses front-to-back compositing for accumulation.
+    """
+    accumulated_alphas = []
+    alpha_accum = 0.0
+    
+    for i in range(num_steps):
