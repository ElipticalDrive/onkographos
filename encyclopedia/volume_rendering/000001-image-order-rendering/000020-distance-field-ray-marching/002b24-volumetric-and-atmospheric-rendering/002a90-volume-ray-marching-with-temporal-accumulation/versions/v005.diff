+        $$ \mathbf{second} = (1.0 - \text{cameraPosition}) \times \mathbf{invD} $$
+        $$ t_{min} = \max(\min(\mathbf{first}), \min(\mathbf{second})) $$
+        $$ t_{max} = \min(\max(\mathbf{first}), \max(\mathbf{second})) $$
