+
+def clip(tensor, min_val, max_val):
+    # Standard array operation to clamp values
+    return max(min_val, min(max_val, tensor))
+
+def mean(tensor):
+    # Standard array operation to compute mean
+    return sum(tensor) / len(tensor)
