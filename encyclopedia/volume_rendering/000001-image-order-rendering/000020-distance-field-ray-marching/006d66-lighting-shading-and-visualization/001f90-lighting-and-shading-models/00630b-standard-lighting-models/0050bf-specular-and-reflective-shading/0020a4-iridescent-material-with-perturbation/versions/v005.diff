 from typing import Tuple
 
-# Standard vector operations assumed available or implemented as helpers
-# vec3_add, vec3_sub, vec3_mul_scalar, vec3_dot, vec3_normalize, vec3_sin, vec3_pow, vec3_clamp, vec3_reflect
+# Standard vector operations defined for self-containment
+def vec3_add(a: Tuple[float, float, float], b: Tuple[float, float, float]) -> Tuple[float, float, float]:
+    return (a[0] + b[0], a[1] + b[1], a[2] + b[2])
+
+def vec3_sub(a: Tuple[float, float, float], b: Tuple[float, float, float]) -> Tuple[float, float, float]:
+    return (a[0] - b[0], a[1] - b[1], a[2] - b[2])
+
+def vec3_mul_scalar(v: Tuple[float, float, float], s: float) -> Tuple[float, float, float]:
+    return (v[0] * s, v[1] * s, v[2] * s)
+
+def vec3_dot(a: Tuple[float, float, float], b: Tuple[float, float, float]) -> float:
+    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+
+def vec3_normalize(v: Tuple[float, float, float]) -> Tuple[float, float, float]:
+    s = math.sqrt(v[0]**2 + v[1]**2 + v[2]**2)
+    return (v[0] / s, v[1] / s, v[2] / s)
+
+def vec3_sin(v: Tuple[float, float, float]) -> Tuple[float, float, float]:
+    return (math.sin(v[0]), math.sin(v[1]), math.sin(v[2]))
+
+def vec3_clamp(v: Tuple[float, float, float], lo: float, hi: float) -> Tuple[float, float, float]:
+    return (max(lo, min(hi, v[0])), max(lo, min(hi, v[1])), max(lo, min(hi, v[2])))
+
+def vec3_reflect(I: Tuple[float, float, float], N: Tuple[float, float, float]) -> Tuple[float, float, float]:
+    dot_val = vec3_dot(I, N)
+    return (I[0] - 2 * dot_val * N[0], I[1] - 2 * dot_val * N[1], I[2] - 2 * dot_val * N[2])
 
