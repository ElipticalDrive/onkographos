+def intersect_box(origin, direction, box_min, box_max):
+    """Standard slab method for ray-AABB intersection."""
+    t_min = (box_min - origin) / direction
+    t_max = (box_max - origin) / direction
+    t0 = min(t_min.x, t_min.y, t_min.z)
+    t1 = max(t_max.x, t_max.y, t_max.z)
+    if t0 > t1:
+        return None, None
+    return t0, t1
+
+def wang_hash(n):
+    """Standard integer hash function returning a float in [0, 1)."""
+    n = (n >> 16) ^ n
+    n = n * 0x45d9f3b
+    n = (n >> 16) ^ n
+    return (n & 0x7fffffff) / 2147483647.0
+
