+def integrate_1d_gaussian(t_start, t_end, center, sigma):
+    """Analytical integral of a 1D Gaussian over [t_start, t_end]."""
+    if sigma <= 0:
+        return 0.0
+    sqrt2_sigma = math.sqrt(2.0) * sigma
+    val1 = math.erf((t_start - center) / sqrt2_sigma)
+    val2 = math.erf((t_end - center) / sqrt2_sigma)
+    return math.sqrt(math.pi / 2.0) * sigma * (val2 - val1)
 
