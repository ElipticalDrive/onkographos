-    # p: input position (vec3)
-    # s: elongation vector (vec3)
-    # base_sdf: function returning distance for a point
-    q = (abs(p.x), abs(p.y), abs(p.z)) - s
-    q_pos = (max(q.x, 0.0), max(q.y, 0.0), max(q.z, 0.0))
-    d_raw = base_sdf(q_pos)
-    correction = (max(-q.x, 0.0), max(-q.y, 0.0), max(-q.z, 0.0))
-    return d_raw + sum(correction)
+import math
+
+def elongation_sdf(p, h):
+    """
+    Computes the SDF of an elongated primitive based on the reference implementation.
+    
+    Args:
+        p: tuple or list of 3 floats (px, py, pz)
+        h: float, elongation parameter
+        
+    Returns:
+        float, the signed distance
+    """
+    px, py, pz = p
+    
+    # Step 1: Absolute values and sorting for symmetry
+    px = abs(px)
+    pz = abs(pz)
+    
+    # Sort to handle the specific symmetry of the primitive
+    if px < pz:
+        px, pz = pz, px
+        
+    # Normalize
+    px = px - 0.5
+    pz = pz - 0.5
+    
+    # Construct q
+    qx = pz
+    qy = h * py - 0.5 * px
+    qz = h * px + 0.5 * py
+    
+    # Elongation correction
+    s = max(0.0, -qx)
+    
+    # Precompute m
+    m = h * h + 0.25
+    
+    # Distance squared terms
+    a = m * (qx + s) ** 2 + qy ** 2
+    
+    # Interpolation factor t
+    denom = m + 0.25
+    t = (qy - 0.5 * pz) / denom
+    t = max(0.0, min(1.0, t))
+    
+    b = m * (qx + 0.5 * t) ** 2 + (qy - m * t) ** 2
+    
+    # Select minimum
+    cond = min(qy, -qx * m - qy * 0.5) > 0.0
+    d_sq = a if cond else min(a, b)
+    
+    # Final distance
+    dist = math.sqrt((d_sq + qz ** 2) / m)
+    sign = 1.0 if max(qz, -py) >= 0 else -1.0
+    
+    return dist * sign
