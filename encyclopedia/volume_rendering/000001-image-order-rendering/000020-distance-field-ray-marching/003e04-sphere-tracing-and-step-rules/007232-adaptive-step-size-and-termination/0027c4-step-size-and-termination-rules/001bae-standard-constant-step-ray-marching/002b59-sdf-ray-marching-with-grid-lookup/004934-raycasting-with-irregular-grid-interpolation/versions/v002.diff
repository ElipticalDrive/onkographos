+def tri_linear_interpolate(points_8, values_8, query):
+    # Standard tri-linear interpolation for regular grids
+    # Assumes points_8 are ordered consistently with the weights below
+    rx = query[0] - points_8[0][0]
+    ry = query[1] - points_8[0][1]
+    rz = query[2] - points_8[0][2]
+    w000 = (1-rx)*(1-ry)*(1-rz)
+    w100 = rx*(1-ry)*(1-rz)
+    w010 = (1-rx)*ry*(1-rz)
+    w110 = rx*ry*(1-rz)
+    w001 = (1-rx)*(1-ry)*rz
+    w101 = rx*(1-ry)*rz
+    w011 = (1-rx)*ry*rz
+    w111 = rx*ry*rz
+    return (w000*values_8[0] + w100*values_8[1] + w010*values_8[2] + w110*values_8[3] +
+            w001*values_8[4] + w101*values_8[5] + w011*values_8[6] + w111*values_8[7])
+
+def gaussian_elimination(A, b):
+    # Solves Ax = b for square A using Gaussian elimination with partial pivoting
+    n = len(A)
+    M = [A[i][:] + [b[i]] for i in range(n)]
+    for i in range(n):
+        max_row = i
+        for k in range(i+1, n):
+            if abs(M[k][i]) > abs(M[max_row][i]):
+                max_row = k
+        M[i], M[max_row] = M[max_row], M[i]
+        pivot = M[i][i]
+        if abs(pivot) < 1e-12:
+            continue
+        for k in range(i+1, n):
+            factor = M[k][i] / pivot
+            for j in range(i, n+1):
+                M[k][j] -= factor * M[i][j]
+    x = [0.0] * n
+    for i in range(n-1, -1, -1):
+        x[i] = M[i][n]
+        for j in range(i+1, n):
+            x[i] -= M[i][j] * x[j]
+        x[i] /= M[i][i]
+    return x
