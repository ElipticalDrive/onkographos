 def project_to_screen(vertex, camera):
-    # Standard perspective projection to screen coordinates [G]
-    # Returns (x, y) tuple
-    pass
+    # Standard perspective projection to normalized device coordinates [G]
+    # Assumes camera has position, forward, up, right vectors and focal length
+    to_cam = vertex - camera.position
+    z = -to_cam @ camera.forward
+    x = to_cam @ camera.right
+    y = to_cam @ camera.up
+    if z <= 0.0:
+        return None
+    scale = camera.focal_length / z
+    return (x * scale, y * scale)
 
