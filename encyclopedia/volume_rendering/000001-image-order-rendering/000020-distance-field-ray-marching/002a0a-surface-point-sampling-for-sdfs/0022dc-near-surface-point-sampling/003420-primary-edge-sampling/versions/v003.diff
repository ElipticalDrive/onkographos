+def intersect_ray_surface(origin, direction, phi_func, max_iter=50, tol=1e-6):
+    """
+    Standard Newton-Raphson root finding for implicit surface intersection.
+    Solves phi(origin + t * direction) = 0 for t >= 0.
+    """
+    t = 0.0
+    for _ in range(max_iter):
+        p = origin + t * direction
+        val = phi_func(p)
+        if abs(val) < tol:
+            return p
+        # Finite difference gradient along ray direction
+        eps = 1e-5
+        grad = (phi_func(p + eps * direction) - val) / eps
+        if abs(grad) < 1e-12:
+            return None
+        t -= val / grad
+    return None
