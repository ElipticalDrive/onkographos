+    c000 = v(0,0,0); c100 = v(1,0,0); c010 = v(0,1,0); c110 = v(1,1,0)
+    c001 = v(0,0,1); c101 = v(1,0,1); c011 = v(0,1,1); c111 = v(1,1,1)
