+
+def upsample_grid(tensor):
+    return upsample_to(tensor, tensor.shape[0] * 2)
+
+def redistance(grid, method):
+    return dr.abs(grid) * dr.sign(grid)
+
+def atleast_4d(tensor):
+    return dr.reshape(tensor, (1, *tensor.shape))
