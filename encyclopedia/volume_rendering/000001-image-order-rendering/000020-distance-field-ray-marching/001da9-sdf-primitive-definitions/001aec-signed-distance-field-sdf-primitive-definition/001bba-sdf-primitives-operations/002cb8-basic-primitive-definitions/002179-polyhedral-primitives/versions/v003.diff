+```python
+def sdTriPrism(p, h):
+    q_x = abs(p[0])
+    q_y = abs(p[1])
+    q_z = abs(p[2])
+    d_z = q_z - h[1]
+    d_xy = max(q_x * 0.866025 + q_y * 0.5, -q_y) - h[0] * 0.5
