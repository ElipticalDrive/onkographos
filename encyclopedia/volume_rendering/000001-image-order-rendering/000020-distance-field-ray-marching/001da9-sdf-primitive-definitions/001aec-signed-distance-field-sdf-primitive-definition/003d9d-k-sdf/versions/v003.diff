 import numpy as np
 
+def phi_beta(d, beta):
+    return beta * np.exp(-beta * d) / (1 + np.exp(-beta * d))**2
+
+def sigmoid(x):
+    return 1.0 / (1.0 + np.exp(-x))
+
+def schedule_beta(iteration, start_v, end_v, total_iters):
+    v = start_v + (end_v - start_v) * (iteration / total_iters)
+    return np.exp(10 * v)
+
+def compute_occupancy_grid(sdf_func, offsets, beta, grid_res=256, threshold=1e-4):
+    grid = np.zeros((grid_res, grid_res, grid_res), dtype=bool)
+    diag = np.sqrt(3) / grid_res
+    for i in range(grid_res):
+        for j in range(grid_res):
+            for l in range(grid_res):
+                center = np.array([i, j, l]) / grid_res
+                d_main = sdf_func(center)
+                for o in offsets:
+                    d_val = d_main + o
+                    if phi_beta(np.abs(d_val), beta) * diag > threshold:
+                        grid[i, j, l] = True
+    return grid
+
