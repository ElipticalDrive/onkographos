+        sdf_vals.append([main_sdf(p) + o for p in points])
+        
+    cdfs = []
+    for d_vals in sdf_vals:
+        dens = phi_beta(np.abs(d_vals), beta)
+        cdf = np.cumsum(dens)
+        cdf /= cdf[-1]
+        cdfs.append(cdf)
+        
