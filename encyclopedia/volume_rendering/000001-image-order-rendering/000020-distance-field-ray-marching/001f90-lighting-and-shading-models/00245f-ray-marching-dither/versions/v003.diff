-   $$ uv.x = vUv.x + rand(vUv + \vec{2}(0.12, 0.32)) \cdot dither - \frac{dither}{2.0} $$
-   $$ uv.y = vUv.y + rand(vUv + \vec{2}(0.42, 0.52)) \cdot dither - \frac{dither}{2.0} $$
