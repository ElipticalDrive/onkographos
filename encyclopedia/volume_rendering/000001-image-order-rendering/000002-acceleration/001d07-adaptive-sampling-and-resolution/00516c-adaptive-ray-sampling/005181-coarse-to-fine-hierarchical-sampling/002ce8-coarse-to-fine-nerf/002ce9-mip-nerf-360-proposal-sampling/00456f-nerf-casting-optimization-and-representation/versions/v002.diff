+def volume_render(samples, density, color_view, color_refl, mixing):
+    deltas = np.diff(np.concatenate([samples['near'], samples['positions'], samples['far']], axis=-1), axis=-1)
+    deltas = np.maximum(deltas, 1e-8)
+    alphas = 1 - np.exp(-density * deltas)
+    
+    transmittance = np.ones_like(alphas[..., 0])
+    accumulated_color = np.zeros_like(color_view[..., 0])
+    
+    for i in range(alphas.shape[0]):
+        alpha = alphas[i]
+        c = mixing[i] * color_view[i] + (1 - mixing[i]) * color_refl[i]
+        accumulated_color = accumulated_color + transmittance * alpha * c
+        transmittance = transmittance * (1 - alpha)
+        
+    return accumulated_color
+
+def mse(pred, target):
+    return np.mean((pred - target) ** 2)
+
+def distortion_loss(density, samples):
+    return np.mean(density)
