+def interpolate_weight(z, w, target_z):
+    """
+    Linear interpolation of weight at target_z given z and w arrays.
+    """
+    # Find indices
+    idx = torch.searchsorted(z, target_z)
+    if idx == 0:
+        return w[0]
+    if idx >= len(z):
+        return w[-1]
+    
+    z0, z1 = z[idx-1], z[idx]
+    w0, w1 = w[idx-1], w[idx]
+    
+    if z1 == z0:
+        return w0
+    
+    t = (target_z - z0) / (z1 - z0)
+    return w0 + t * (w1 - w0)
