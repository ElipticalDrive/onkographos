+def compute_ray_segment(origin, direction):
+    """Compute A and B such that |B-A| = SEGMENT_LENGTH and midpoint is closest to origin [S1]."""
+    d = direction / torch.norm(direction)
+    t = -torch.dot(origin, d)
+    mid = origin + t * d
+    A = mid - (d * SEGMENT_LENGTH) / 2.0
+    B = mid + (d * SEGMENT_LENGTH) / 2.0
+    return A, B
