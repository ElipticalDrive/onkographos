+        self.dir_x_sign = 1 if dir.x > 0 else -1
+        self.dir_y_sign = 1 if dir.y > 0 else -1
+        self.dir_z_sign = 1 if dir.z > 0 else -1
+        self.step_x = 1.0 / abs(dir.x) if dir.x != 0 else float_large
+        self.step_y = 1.0 / abs(dir.y) if dir.y != 0 else float_large
+        self.step_z = 1.0 / abs(dir.z) if dir.z != 0 else float_large
+        
+        self.cell.x = max(0, min(int(org.x), dims.x - 1))
+        self.cell.y = max(0, min(int(org.y), dims.y - 1))
+        self.cell.z = max(0, min(int(org.z), dims.z - 1))
+        
+        self.t_next_x = (self.cell.x + self.dir_x_sign - org.x) / dir.x if dir.x != 0 else float_large
+        self.t_next_y = (self.cell.y + self.dir_y_sign - org.y) / dir.y if dir.y != 0 else float_large
+        self.t_next_z = (self.cell.z + self.dir_z_sign - org.z) / dir.z if dir.z != 0 else float_large
+        
