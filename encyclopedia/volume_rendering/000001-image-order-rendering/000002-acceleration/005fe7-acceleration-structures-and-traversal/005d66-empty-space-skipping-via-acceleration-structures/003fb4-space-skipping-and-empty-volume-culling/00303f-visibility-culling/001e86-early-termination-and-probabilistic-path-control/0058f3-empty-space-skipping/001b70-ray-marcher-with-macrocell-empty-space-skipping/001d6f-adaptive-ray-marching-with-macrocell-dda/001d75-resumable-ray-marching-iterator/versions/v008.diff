+        if self.done: return False
+        if self.t_next_x < self.t_next_y and self.t_next_x < self.t_next_z:
+            self.cell.x += self.dir_x_sign
+            self.t0 = self.t1
+            self.t1 = self.t_next_x
+            self.t_next_x += self.step_x
