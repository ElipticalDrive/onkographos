+    # 2D binary space subdivision [S1]
+    # Base case: if number of rectangles is within budget or below threshold, return as one tile
+    if len(rects) <= budget:
+        return [Rect(0, 0, viewport_width, viewport_height)], rects
+    
+    # Split plane along one of the axes at the position that separates the set into two equally sized subsets [S1]
