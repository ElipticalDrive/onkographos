+def sample_rays(images, poses):
+    # Returns a batch of rays sampled uniformly from the image plane for each pose
+    return [(pose, random_pixel_coords()) for _ in range(batch_size)]
+
+def volume_render(rays, params):
+    # Computes color using alpha compositing along each ray
+    colors = []
+    for ray in rays:
+        T = 1.0
+        color = np.zeros(3)
+        for step in ray.steps:
+            sigma, c = params.query(step.position)
+            alpha = 1.0 - np.exp(-sigma * step.delta)
+            color += T * alpha * c
+            T *= (1.0 - alpha)
+        colors.append(color)
+    return np.array(colors)
+
+def get_ground_truth_colors(rays, images):
+    return np.array([images[ray.camera_id][ray.pixel_coords] for ray in rays])
+
+def mean_squared_error(rendered, ground_truth):
+    return np.mean((rendered - ground_truth) ** 2)
+
