+```python
+def photometric_loss_optimization(scene_params, rays, targets, renderer, optimizer, max_iters):
+    """
+    Generic photometric loss optimization loop matching shared principles.
+    
+    Args:
+        scene_params: Differentiable tensor of scene/camera parameters $\theta$.
+        rays: Tensor of ray origins and directions.
+        targets: Tensor of ground-truth pixel colors $\hat{C}(r)$.
+        renderer: Differentiable function $I(r; \theta)$ returning rendered colors.
+        optimizer: Gradient descent optimizer for $\theta$.
+        max_iters: Number of optimization steps.
+        
+    Returns:
+        Optimized scene parameters.
+    """
+    for _ in range(max_iters):
+        # Render current scene parameters for the sampled rays
+        rendered = renderer(scene_params, rays)
+        
+        # Compute photometric loss (MSE or L1)
+        loss = torch.mean((rendered - targets) ** 2)
+        
+        # Backpropagate gradients through the renderer
+        loss.backward()
+        
+        # Update parameters using the optimizer
+        optimizer.step()
+        optimizer.zero_grad()
+        
+    return scene_params
+```
 
