+    o_vals = origins[:, axes]
+    d_vals = directions[:, axes]
+    valid = torch.abs(d_vals) > 1e-6
+    t = torch.where(valid, (boundaries - o_vals) / d_vals, torch.full_like(o_vals, float('inf')))
+    return t, valid
