+### Pseudocode
+```python
+def _calc_dt(t, cone_angle, dt_min, dt_max):
+    return max(dt_min, min(dt_max, t * cone_angle))
+
+def traverse_grids_kernel(rays_o, rays_d, rays_mask, binaries, aabbs, hits, t_sorted, t_indices, 
+                          near_planes, far_planes, traverse_steps_limit, step_size, cone_angle, 
+                          resolution, delta, eps, n_rays, n_grids, intervals, samples, terminate_planes):
+    # Grid-stride loop over rays
+    for tid in range(blockIdx.x * blockDim.x + threadIdx.x, n_rays, blockDim.x * gridDim.x):
+        if rays_mask is not None and not rays_mask[tid]:
+            continue
+        if not is_first_pass and (intervals.chunk_cnts[tid] == 0 or samples.chunk_cnts[tid] == 0):
+            continue
+
+        base_hits = tid * n_grids
+        base_t_sorted = tid * n_grids * 2
+        t_last = 0.0
+        continuous = True
+
+        for i in range(base_t_sorted, base_t_sorted + n_grids * 2 - 1):
+            is_entering = t_indices[i] < n_grids
+            level = t_indices[i] % n_grids
+
+            if not hits[base_hits + level]:
+                continue
+
+            this_tmin = max(t_sorted[i], near_planes[tid])
+            this_tmax = min(t_sorted[i + 1], far_planes[tid])
+            if this_tmin >= this_tmax:
+                continue
+
+            if not continuous:
+                if step_size <= 0.0:
+                    t_last = this_tmin
+                else:
+                    t = t_last
+                    while t + _calc_dt(t, cone_angle, dt_min, dt_max) * 0.5 < this_tmin:
+                        t += _calc_dt(t, cone_angle, dt_min, dt_max)
+                    t_last = t
+                continuous = True
+
+            # The sources do not give the internals of setup_traversal.
+            # setup_traversal(ray, this_tmin, this_tmax, eps, aabbs[level], resolution, delta, tdist, step_index, current_index, final_index)
+
+            n_samples = 0
+            while traverse_steps_limit <= 0 or n_samples < traverse_steps_limit:
+                t_traverse = min(tdist.x, min(tdist.y, tdist.z))
+                t_traverse = min(t_traverse, this_tmax)
+
+                cell_id = (current_index.x * resolution.y * resolution.z + 
+                           current_index.y * resolution.z + 
+                           current_index.z + 
+                           level * resolution.x * resolution.y * resolution.z)
+
+                if not binaries[cell_id]:
+                    if step_size <= 0.0:
+                        t_last = t_traverse
+                    else:
+                        t = t_last
+                        while t + _calc_dt(t, cone_angle, dt_min, dt_max) * 0.5 < t_traverse:
+                            t += _calc_dt(t, cone_angle, dt_min, dt_max)
+                        t_last = t
+                    continuous = False
+                else:
