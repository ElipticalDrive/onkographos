+                    while t_next < t_traverse:
+                        if step_size <= 0.0:
+                            t_next = t_traverse
+                        else:
+                            t_next = t_last + _calc_dt(t_last, cone_angle, dt_min, dt_max)
+                        
+                        if not continuous:
+                            intervals.vals.append(t_last)
+                            intervals.vals.append(t_next)
+                            intervals.is_left.append(True)
+                            intervals.is_right.append(False)
+                            intervals.ray_indices.append(tid)
+                            n_intervals += 1
+                        else:
+                            intervals.vals[-1] = t_next
+                            intervals.is_right[-1] = True
+                        
+                        samples.vals.append((t_next + t_last) * 0.5)
+                        samples.is_valid.append(True)
+                        n_samples += 1
