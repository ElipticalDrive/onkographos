+def inverse_transform_point(p, M):
+    # Applies inverse of 4x4 matrix M to point p [G]
+    inv_M = [[1, 0, 0, -p[0]], [0, 1, 0, -p[1]], [0, 0, 1, -p[2]], [0, 0, 0, 1]]
+    return [inv_M[i][0]*p[0] + inv_M[i][1]*p[1] + inv_M[i][2]*p[2] + inv_M[i][3] for i in range(3)]
