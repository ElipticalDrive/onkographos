+def matrix_multiply(A, B):
+    # Standard 4x4 matrix multiplication [G]
+    C = [[0]*4 for _ in range(4)]
+    for i in range(4):
+        for j in range(4):
+            for k in range(4):
+                C[i][j] += A[i][k] * B[k][j]
+    return C
