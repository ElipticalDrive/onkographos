+def apply_depth_test(depth_buffer, slab, depth_func, alpha_test, alpha_ref):
+    """Simulates GPU depth/alpha test per pixel [G]."""
+    new_buffer = list(depth_buffer)
+    for i in range(len(depth_buffer)):
+        frag_depth = slab[i] if i < len(slab) else depth_buffer[i]
+        frag_alpha = 1.0
+        if alpha_test and frag_alpha <= alpha_ref:
+            continue
+        if depth_func == 'LESS' and frag_depth < new_buffer[i]:
+            new_buffer[i] = frag_depth
+        elif depth_func == 'GREATER' and frag_depth > new_buffer[i]:
+            new_buffer[i] = frag_depth
+    return new_buffer
 
