+def compute_central_difference_gradients(volume):
+    """Compute voxel gradients using central differences [S3, unofficial]."""
+    D, H, W = volume.shape
+    grad = [[[0.0, 0.0, 0.0] for _ in range(W)] for _ in range(H)]
+    for d in range(D):
+        for h in range(H):
+            for w in range(W):
+                dx = volume[d][h][min(w+1, W-1)] - volume[d][h][max(w-1, 0)]
+                dy = volume[d][min(h+1, H-1)][w] - volume[d][max(h-1, 0)][w]
+                dz = volume[min(d+1, D-1)][h][w] - volume[max(d-1, 0)][h][w]
+                grad[d][h][w] = [dx, dy, dz]
+    return grad
