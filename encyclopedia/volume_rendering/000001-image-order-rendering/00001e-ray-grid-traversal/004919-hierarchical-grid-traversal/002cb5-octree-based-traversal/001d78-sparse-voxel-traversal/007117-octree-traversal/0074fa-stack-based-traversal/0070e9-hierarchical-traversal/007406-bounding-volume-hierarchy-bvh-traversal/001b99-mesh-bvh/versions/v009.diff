 import math
 
+def distance_point_aabb(p, aabb_min, aabb_max):
+    """Computes squared distance from point p to AABB."""
+    dx = max(aabb_min[0] - p[0], 0.0, p[0] - aabb_max[0])
+    dy = max(aabb_min[1] - p[1], 0.0, p[1] - aabb_max[1])
+    dz = max(aabb_min[2] - p[2], 0.0, p[2] - aabb_max[2])
+    return dx*dx + dy*dy + dz*dz
+
+def ray_triangle_intersect(origin, direction, v0, v1, v2, tmax):
+    """Möller-Trumbore ray-triangle intersection [G]."""
+    epsilon = 1e-8
+    edge1 = (v1[0]-v0[0], v1[1]-v0[1], v1[2]-v0[2])
+    edge2 = (v2[0]-v0[0], v2[1]-v0[1], v2[2]-v0[2])
+    h = (direction[1]*edge2[2]-direction[2]*edge2[1],
+         direction[2]*edge2[0]-direction[0]*edge2[2],
+         direction[0]*edge2[1]-direction[1]*edge2[0])
+    a = edge1[0]*h[0] + edge1[1]*h[1] + edge1[2]*h[2]
+    if a < epsilon and a > -epsilon:
+        return False
+    f = 1.0 / a
+    s = (origin[0]-v0[0], origin[1]-v0[1], origin[2]-v0[2])
+    u = f * (s[0]*h[0] + s[1]*h[1] + s[2]*h[2])
+    if u < 0.0 or u > 1.0:
+        return False
+    q = (s[1]*edge2[2]-s[2]*edge2[1],
+         s[2]*edge2[0]-s[0]*edge2[2],
+         s[0]*edge2[1]-s[1]*edge2[0])
+    v = f * (direction[0]*q[0] + direction[1]*q[1] + direction[2]*q[2])
+    if v < 0.0 or u + v > 1.0:
+        return False
+    t = f * (edge1[0]*q[0] + edge1[1]*q[1] + edge1[2]*q[2])
+    return 0.0 <= t <= tmax
+
+def ray_intersects_mesh(origin, direction, bvh_root, tmax=float('inf')):
+    """Traverses BVH to check if ray intersects any triangle."""
+    stack = [bvh_root]
+    while stack:
+        node = stack.pop()
+        if node.is_leaf():
+            v0, v1, v2 = node.triangle_vertices()
+            if ray_triangle_intersect(origin, direction, v0, v1, v2, tmax):
+                return True
+        else:
+            if distance_point_aabb(origin, node.aabb_min, node.aabb_max) <= tmax*tmax:
+                stack.append(node.right)
+                stack.append(node.left)
+    return False
