+def point_locate(dest: Vec3i, start_depth: int, start_node: Node) -> int:
+    """
+    Standard downward traversal from start_node to find the leaf at dest.
+    """
+    node = start_node
+    for d in range(start_depth, -1, -1):
+        child_idx = ((dest.x >> d) & 1) << 2 | ((dest.y >> d) & 1) << 1 | ((dest.z >> d) & 1)
+        if node.children[child_idx] is None:
+            return 0
+        node = node.children[child_idx]
+    return node.index
