+def closest_point_triangle(p, a, b, c):
+    """
+    Computes the closest point on triangle abc to point p.
+    Based on Ericson, Real-Time Collision Detection, 5.1.5.
+    """
+    ab = b - a
+    ac = c - a
+    ap = p - a
+    
+    d1 = dot(ab, ap)
+    d2 = dot(ac, ap)
+    
+    if d1 <= 0.0 and d2 <= 0.0:
+        return a
+    
+    bp = p - b
+    d3 = dot(ab, bp)
+    d4 = dot(ac, bp)
+    
+    if d3 >= 0.0 and d4 <= d3:
+        return b
+    
+    vc = d1 * d4 - d3 * d2
+    if vc <= 0.0 and d1 >= 0.0 and d3 <= 0.0:
+        v = d1 / (d1 - d3)
+        return a + ab * v
+    
+    cp = p - c
+    d5 = dot(ab, cp)
+    d6 = dot(ac, cp)
+    
+    if d6 >= 0.0 and d5 <= d6:
+        return c
+    
+    vb = d5 * d2 - d1 * d6
+    if vb <= 0.0 and d2 >= 0.0 and d6 <= 0.0:
+        w = d2 / (d2 - d6)
+        return a + ac * w
+    
+    de = dot(ab, ac)
+    dv = de * de - dot(ab, ab) * dot(ac, ac)
+    
+    if dv == 0.0:
+        return (a + b) * 0.5
+    
+    u = (de * d4 - d3 * de) / dv
+    w = (de * d1 - d5 * de) / dv
+    
+    if u + w <= 1.0:
+        if u < 0.0:
+            u = 0.0
+            if w < 0.0:
