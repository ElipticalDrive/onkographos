+def build_regular_grid(primitives, p1, p2, Nx, Ny, Nz):
+    # 1. Initialize grid
+    grid_size = Nx * Ny * Nz
+    grid = [None] * grid_size
+    
+    # 2. Calculate dimensions
+    dx = (p2.x - p1.x) / Nx
+    dy = (p2.y - p1.y) / Ny
+    dz = (p2.z - p1.z) / Nz
+    dx_rec = 1.0 / dx
+    dy_rec = 1.0 / dy
+    dz_rec = 1.0 / dz
