+def First(u, bounds):
+    o, d = u
+    t_min = 0.0
+    for k in range(3):
+        if d[k] == 0.0:
+            if o[k] < bounds[2*k] or o[k] > bounds[2*k+1]: return None
+        else:
+            t1 = (bounds[2*k] - o[k]) / d[k]
+            t2 = (bounds[2*k+1] - o[k]) / d[k]
+            t_min = max(t_min, min(t1, t2))
+    return o + t_min * d
+
+def InBounds(x, bounds):
+    return all(bounds[2*k] <= x[k] <= bounds[2*k+1] for k in range(3))
+
+def Index(m, x, bounds):
+    cell_size = (bounds[1] - bounds[0]) / (2**m)
+    return tuple(int((x[k] - bounds[2*k]) / cell_size) for k in range(3))
+
+def Next(m, x, u, bounds):
+    o, d = u
+    cell_size = (bounds[1] - bounds[0]) / (2**m)
+    t_max = float('inf')
+    for k in range(3):
+        if d[k] != 0.0:
+            t = (bounds[2*k] + cell_size - x[k]) / d[k]
+            if t > 0.0: t_max = min(t_max, t)
+    return x + t_max * d
+
+def Parent(m, i):
+    return tuple(i[k] // 2 for k in range(3))
+
+def Image(x):
