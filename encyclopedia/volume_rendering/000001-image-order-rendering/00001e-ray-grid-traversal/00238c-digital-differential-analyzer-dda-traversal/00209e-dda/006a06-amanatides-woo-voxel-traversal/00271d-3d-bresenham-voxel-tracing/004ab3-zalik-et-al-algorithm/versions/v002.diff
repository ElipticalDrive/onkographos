+    # Phase 2: Relationship examination and recovery [S1]
+    final_cells = []
+    for i in range(len(bresenham_cells) - 1):
+        c_curr = bresenham_cells[i]
+        c_next = bresenham_cells[i+1]
+        final_cells.append(c_curr)
+        # Detect skipped cells when multiple axes change simultaneously
+        ax = abs(c_curr[0] - c_next[0])
+        ay = abs(c_curr[1] - c_next[1])
+        az = abs(c_curr[2] - c_next[2])
+        if (ax > 1 or ay > 1 or az > 1) and (ay > 1 or az > 1):
+            # Insert missing voxel(s) based on direction signs [G]
+            step_x = 1 if c_next[0] > c_curr[0] else -1
+            step_y = 1 if c_next[1] > c_curr[1] else -1
+            step_z = 1 if c_next[2] > c_curr[2] else -1
+            missing = (c_curr[0] + step_x, c_curr[1] + step_y, c_curr[2] + step_z)
+            final_cells.append(missing)
