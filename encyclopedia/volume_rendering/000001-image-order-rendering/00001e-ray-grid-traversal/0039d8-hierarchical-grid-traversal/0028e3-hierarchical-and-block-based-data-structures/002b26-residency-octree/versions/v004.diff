+def residency_octree_ray_march(ray_origin, ray_direction, step_size, octree_nodes, brick_cache, page_table, max_steps):
+    # Initialize ray traversal variables
+    t = 0.0
+    color = [0.0, 0.0, 0.0, 0.0]
+    alpha = 0.0
+    
+    # Handle zero direction components safely
+    inv_dir = [1.0 / d if d != 0.0 else float('inf') for d in ray_direction]
+    step_sign = [1 if d >= 0 else -1 for d in ray_direction]
+    
+    # Compute initial cell entry/exit distances
+    cell_min = [int(ray_origin[i] * inv_dir[i]) if inv_dir[i] != float('inf') else 0 for i in range(3)]
+    t_max = [
+        (cell_min[i] - ray_origin[i]) * inv_dir[i] if inv_dir[i] != float('inf') else float('inf')
+        for i in range(3)
+    ]
+    
+    for step in range(max_steps):
+        if alpha >= 1.0:
+            break
+            
+        # Determine current cell coordinates
+        cx, cy, cz = cell_min[0], cell_min[1], cell_min[2]
+        
+        # Find corresponding octree node index (simplified pointerless layout)
+        node_idx = (cx >> 10) | ((cy >> 10) << 10) | ((cz >> 10) << 20)
+        node = octree_nodes[node_idx]
+        
+        # Check residency for the current channel/resolution (assume channel 0, res 0 for simplicity)
+        res_bitmap = (node.channel_data[0] >> 0) & 0xFFFF
+        is_mapped = (res_bitmap & (1 << 0)) != 0
+        
+        # If not mapped, request brick or use fallback
+        if not is_mapped:
+            brick_id = page_table.get_brick_id(cx, cy, cz, channel=0, resolution=0)
+            if brick_id not in brick_cache:
+                brick_data = server.request(brick_id)
+                brick_cache.store(brick_id, brick_data)
+                # Update residency bitmap for this node
+                node.channel_data[0] |= (1 << 0)
+                # Propagate up to parent (simplified)
+                parent_idx = node_idx >> 1
+                if parent_idx < len(octree_nodes):
+                    octree_nodes[parent_idx].channel_data[0] |= (1 << 0)
+            else:
+                brick_data = brick_cache.get(brick_id)
+        else:
+            brick_data = brick_cache.get_brick_at_cell(cx, cy, cz, channel=0, resolution=0)
+            
+        # Sample volume data and apply transfer function
+        voxel_value = brick_data.sample(cx, cy, cz)
+        opacity = transfer_function(voxel_value)
+        color_rgb = color_from_value(voxel_value)
+        
+        # Front-to-back alpha blending
+        alpha_factor = opacity * (1.0 - alpha)
+        color[0] += color_rgb[0] * alpha_factor
+        color[1] += color_rgb[1] * alpha_factor
+        color[2] += color_rgb[2] * alpha_factor
+        alpha += alpha_factor
+        
+        # Advance ray to next cell
+        t += step_size
+        if t_max[0] < t_max[1]:
+            t_max[0] += step_size
+            cell_min[0] += step_sign[0]
+        elif t_max[1] < t_max[2]:
+            t_max[1] += step_size
+            cell_min[1] += step_sign[1]
+        else:
+            t_max[2] += step_size
+            cell_min[2] += step_sign[2]
+            
+    return color
 
