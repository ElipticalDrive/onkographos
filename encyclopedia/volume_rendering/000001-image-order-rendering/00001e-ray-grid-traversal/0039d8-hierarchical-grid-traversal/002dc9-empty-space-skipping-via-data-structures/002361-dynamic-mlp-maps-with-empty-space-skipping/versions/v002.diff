+    wy = y - y0.float()
+    val00 = map_2d[y0, x0, :]
+    val01 = map_2d[y0, x1, :]
+    val10 = map_2d[y1, x0, :]
+    val11 = map_2d[y1, x1, :]
+    return (val00 * (1 - wx) * (1 - wy) + val01 * wx * (1 - wy) +
+            val10 * (1 - wx) * wy + val11 * wx * wy)
