+def GetAdjacentCellByFace(cell, face, offset):
+    # Shift parent Morton code right by 3 bits per offset level [S1]
+    parent_morton = cell.morton >> (offset * 3)
+    # Add directional Morton offset for the face [G]
+    face_offsets = [1, -1, 4, -4, 16, -16]
+    return parent_morton + face_offsets[face] * offset
