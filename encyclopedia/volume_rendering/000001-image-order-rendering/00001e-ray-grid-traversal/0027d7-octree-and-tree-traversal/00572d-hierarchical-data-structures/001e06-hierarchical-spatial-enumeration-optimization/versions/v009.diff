+        else:
+            t1 = (min_coord[d] - origin[d]) / direction[d]
+            t2 = (max_coord[d] - origin[d]) / direction[d]
+            t_min = max(t_min, min(t1, t2))
+            t_max = min(t_max, max(t1, t2))
+    return (t_min, t_max)
