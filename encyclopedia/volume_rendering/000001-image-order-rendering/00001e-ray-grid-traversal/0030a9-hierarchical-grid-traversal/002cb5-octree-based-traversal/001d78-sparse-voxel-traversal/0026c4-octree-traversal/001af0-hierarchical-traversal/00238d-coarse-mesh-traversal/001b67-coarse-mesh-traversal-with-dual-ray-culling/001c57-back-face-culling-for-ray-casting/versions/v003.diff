+def raycast_fragment_shader(entry_point, exit_point_coord, back_face_texture, volume_texture, step_size, screen_size):
+    # Retrieve exit point from back-face texture
+    # Note: gl_FragCoord is in window coordinates, normalize by ScreenSize
+    exit_point = texture(back_face_texture, gl_FragCoord.st / screen_size).xyz
+    
+    # If entry and exit are the same, the ray missed the volume or hit an edge
+    if entry_point == exit_point:
+        discard
+    
+    dir = exit_point - entry_point
+    length_total = length(dir)
+    delta_dir = normalize(dir) * step_size
+    
+    voxel_coord = entry_point
+    color_acum = vec4(0.0)
+    alpha_acum = 0.0
+    length_acum = 0.0
+    
+    # Max iterations to prevent infinite loops
+    max_iterations = 1600
+    
+    for i in range(max_iterations):
+        intensity = texture(volume_texture, voxel_coord).x
+        
+        # Apply transfer function (simplified)
+        color_sample = vec4(intensity, intensity, intensity, intensity)
+        alpha_sample = intensity
+        
+        # Alpha blending
+        color_acum += color_sample * (1.0 - alpha_acum)
+        alpha_acum += alpha_sample * (1.0 - alpha_acum)
+        
+        voxel_coord += delta_dir
+        length_acum += length(delta_dir)
+        
+        # Termination conditions
+        if length_acum >= length_total:
+            break
+        if alpha_acum >= 1.0:
+            alpha_acum = 1.0
+            break
+    
+    return color_acum
