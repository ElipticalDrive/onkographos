+def ray_box_intersect(ray_origin: vec3<f32>, ray_dir: vec3<f32>, box_min: vec3<f32>, box_max: vec3<f32>, intersection_depth: float):
+    origin_to_box_max = (box_max - ray_origin) / ray_dir
