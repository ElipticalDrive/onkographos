+def mat_mul(A, B):
+    """Multiply two 4x4 matrices."""
+    C = [[0.0]*4 for _ in range(4)]
+    for i in range(4):
+        for j in range(4):
+            for k in range(4):
+                C[i][j] += A[i][k] * B[k][j]
+    return C
+
+def mat_inv(M):
+    """Compute inverse of a 4x4 matrix using Gauss-Jordan elimination."""
+    aug = [row[:] + [1.0 if i == j else 0.0 for j in range(4)] for i, row in enumerate(M)]
+    for i in range(4):
+        pivot = aug[i][i]
+        if abs(pivot) < 1e-9:
+            raise ValueError("Matrix is singular")
+        for j in range(8):
+            aug[i][j] /= pivot
+        for k in range(4):
+            if k != i:
+                factor = aug[k][i]
+                for j in range(8):
+                    aug[k][j] -= factor * aug[i][j]
+    return [row[4:] for row in aug]
 
