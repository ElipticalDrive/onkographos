+def cross(a: List[float], b: List[float]) -> List[float]:
+    return [
+        a[1]*b[2] - a[2]*b[1],
+        a[2]*b[0] - a[0]*b[2],
+        a[0]*b[1] - a[1]*b[0]
+    ]
+
+def normalize(v: List[float]) -> List[float]:
