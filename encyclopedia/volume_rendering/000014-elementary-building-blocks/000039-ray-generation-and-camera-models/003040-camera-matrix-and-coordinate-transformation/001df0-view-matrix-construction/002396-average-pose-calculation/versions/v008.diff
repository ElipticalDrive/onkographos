 import numpy as np
 
+def viewmatrix(z_axis, up, position):
+    """Constructs a 4x4 camera-to-world matrix from z-axis, up vector, and position [G]."""
+    x = np.cross(z_axis, up)
+    x = x / np.linalg.norm(x)
+    y = np.cross(x, z_axis)
+    rot = np.eye(4)
+    rot[:3, 0] = x
+    rot[:3, 1] = y
+    rot[:3, 2] = z_axis
+    trans = np.eye(4)
+    trans[:3, 3] = position
+    return trans @ rot
