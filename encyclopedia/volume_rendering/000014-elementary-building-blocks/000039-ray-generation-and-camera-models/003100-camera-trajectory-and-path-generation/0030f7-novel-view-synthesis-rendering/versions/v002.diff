+    # Alpha
+    alpha = 1.0 - torch.exp(-sigma_fine * deltas)
+    
+    # Transmittance
+    T = torch.cumprod(torch.exp(-sigma_fine * deltas), dim=1)
+    T = torch.cat([torch.ones_like(T[:, :1]), T], dim=1)
+    
+    # Weight
