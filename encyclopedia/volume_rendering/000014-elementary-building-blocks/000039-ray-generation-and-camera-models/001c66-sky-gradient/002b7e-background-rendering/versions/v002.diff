+    v100 = grid[x1][y0][z0][channel]
+    v010 = grid[x0][y1][z0][channel]
+    v110 = grid[x1][y1][z0][channel]
+    v001 = grid[x0][y0][z1][channel]
+    v101 = grid[x1][y0][z1][channel]
+    v011 = grid[x0][y1][z1][channel]
+    v111 = grid[x1][y1][z1][channel]
+    fx, fy, fz = frac
+    c00 = v000 * (1-fx) + v100 * fx
+    c01 = v010 * (1-fx) + v110 * fx
+    c10 = v001 * (1-fx) + v101 * fx
+    c11 = v011 * (1-fx) + v111 * fx
+    c0 = c00 * (1-fy) + c01 * fy
+    c1 = c10 * (1-fy) + c11 * fy
+    return c0 * (1-fz) + c1 * fz
