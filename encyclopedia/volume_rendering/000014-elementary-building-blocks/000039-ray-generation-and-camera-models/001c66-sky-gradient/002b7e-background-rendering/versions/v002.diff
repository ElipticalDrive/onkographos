+def intersect_sphere(origin, dir, r):
+    # Standard ray-sphere intersection returning positive t or -1
+    a = dot(dir, dir)
+    b = 2.0 * dot(origin, dir)
+    c = dot(origin, origin) - r * r
+    disc = b * b - 4 * a * c
+    if disc < 0: return -1.0
+    sqrt_disc = sqrt(disc)
+    t1 = (-b - sqrt_disc) / (2 * a)
+    t2 = (-b + sqrt_disc) / (2 * a)
+    t = t1 if t1 > 1e-6 else t2
+    return t if t > 0 else -1.0
+
+def unitvec2equirect(pos, reso):
+    # Convert 3D unit vector to 2D equirectangular coordinates in-place
+    pos[0] = atan2(pos[2], pos[0]) / (2.0 * 3.141592653589793)
+    pos[1] = asin(pos[1]) / 3.141592653589793 + 0.5
+    pos[0] *= reso * 2
+    pos[1] *= reso
