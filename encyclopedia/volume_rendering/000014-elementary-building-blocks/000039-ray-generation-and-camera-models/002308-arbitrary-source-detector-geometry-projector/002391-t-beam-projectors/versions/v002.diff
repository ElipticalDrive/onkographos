+def clip_ray_to_box(origin, direction, bounds):
+    t_min = -float('inf')
+    t_max = float('inf')
+    for i in range(3):
+        if direction[i] == 0:
+            if origin[i] < bounds[i][0] or origin[i] > bounds[i][1]:
