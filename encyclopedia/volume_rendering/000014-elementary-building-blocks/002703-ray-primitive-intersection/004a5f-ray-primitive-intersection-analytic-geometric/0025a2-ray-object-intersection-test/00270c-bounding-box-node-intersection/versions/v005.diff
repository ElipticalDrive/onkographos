+def _ray_triangle_intersect(ray, tri):
+    # Standard Möller–Trumbore ray-triangle intersection [G]
+    v1, v2, v3 = tri.p0, tri.p1, tri.p2
+    e1 = (v1[0]-v2[0], v1[1]-v2[1], v1[2]-v2[2])
+    e2 = (v1[0]-v3[0], v1[1]-v3[1], v1[2]-v3[2])
+    h = (ray.d[1]*e2[2]-ray.d[2]*e2[1], ray.d[2]*e2[0]-ray.d[0]*e2[2], ray.d[0]*e2[1]-ray.d[1]*e2[0])
+    a = e1[0]*h[0] + e1[1]*h[1] + e1[2]*h[2]
+    if -0.00001 < a < 0.00001:
+        return None
+    f = 1.0 / a
+    s = (ray.o[0]-v1[0], ray.o[1]-v1[1], ray.o[2]-v1[2])
+    u = f * (s[0]*h[0] + s[1]*h[1] + s[2]*h[2])
+    if u < 0.0 or u > 1.0:
+        return None
+    q = (s[0]*e1[2]-s[2]*e1[1], s[2]*e1[0]-s[0]*e1[2], s[0]*e1[1]-s[1]*e1[0])
+    v = f * (ray.d[0]*q[0] + ray.d[1]*q[1] + ray.d[2]*q[2])
+    if v < 0.0 or u + v > 1.0:
+        return None
+    t = f * (e1[0]*q[0] + e1[1]*q[1] + e1[2]*q[2])
+    if t > 0.00001:
+        return t
