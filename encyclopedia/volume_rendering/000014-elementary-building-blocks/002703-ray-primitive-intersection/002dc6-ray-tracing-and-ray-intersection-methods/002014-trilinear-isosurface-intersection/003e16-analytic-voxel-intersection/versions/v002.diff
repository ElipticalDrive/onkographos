+    t_near, t_far = ray_box_intersect(o, d, voxel_min, voxel_max)
+    if t_near > t_far or t_far < 0:
+        return None
+    if t_near == 0:
+        o_local = o - voxel_min
+        d_local = d * (voxel_max - voxel_min)
+    else:
+        o_local = o + d * t_near - voxel_min
+        d_local = d * (voxel_max - voxel_min)
+        t_far = t_far - t_near
