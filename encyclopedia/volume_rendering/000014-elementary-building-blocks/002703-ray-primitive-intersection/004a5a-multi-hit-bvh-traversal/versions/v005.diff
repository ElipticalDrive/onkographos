+def intersect_sphere(sphere, origin, direction):
+    oc = origin - sphere.center
+    b = oc.dot(direction)
+    c = oc.dot(oc) - sphere.radius * sphere.radius
+    disc = b * b - c
+    if disc < 0:
+        return None
+    sq = disc ** 0.5
+    t = -b - sq
+    return t if t > 0 else (-b + sq if -b + sq > 0 else None)
