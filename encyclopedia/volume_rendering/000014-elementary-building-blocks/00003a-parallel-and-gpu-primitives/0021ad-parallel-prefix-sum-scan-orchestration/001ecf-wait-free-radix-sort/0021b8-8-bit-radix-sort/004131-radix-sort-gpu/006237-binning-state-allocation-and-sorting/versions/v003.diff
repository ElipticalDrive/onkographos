+def radix_sort_pairs_32(keys_in, keys_out, values_in, values_out, num_items):
+    # Standard 32-bit radix sort for pairs [G]
+    pairs = list(zip(keys_in, values_in))
+    for shift in range(0, 32, 8):
+        buckets = [[] for _ in range(256)]
+        for k, v in pairs:
+            byte_val = (k >> shift) & 0xFF
+            buckets[byte_val].append((k, v))
