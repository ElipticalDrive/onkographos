-        if rays_t_old[n] >= 0:
-            # Atomic increment of alive_counter
-            idx = alive_counter + 1
-            alive_counter += 1
-            rays_alive[idx] = rays_alive_old[n]
-            rays_t[idx] = rays_t_old[n]
