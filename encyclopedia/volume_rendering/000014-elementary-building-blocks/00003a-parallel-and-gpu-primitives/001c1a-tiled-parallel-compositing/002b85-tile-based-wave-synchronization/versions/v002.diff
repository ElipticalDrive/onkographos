+import threading
+
+class Lock:
+    def __init__(self):
+        self._lock = threading.Lock()
+    def acquire(self):
+        self._lock.acquire()
+    def release(self):
+        self._lock.release()
+    def __enter__(self):
+        self.acquire()
+        return self
+    def __exit__(self, *args):
+        self.release()
+
+class Condition:
+    def __init__(self, lock):
+        self._cond = threading.Condition(lock._lock)
+    def wait(self):
+        self._cond.wait()
+    def notify_all(self):
+        self._cond.notify_all()
+
