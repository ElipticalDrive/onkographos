+    """
+    Encodes 3D coordinates into a Morton code.
+    Prioritizes y-axis over x and z.
+    """
+    code = 0
+    for b in range(num_bits):
+        code += (4 * ((y >> b) & 1) + 2 * ((x >> b) & 1) + ((z >> b) & 1)) * (2 ** (3 * b))
+    return code
