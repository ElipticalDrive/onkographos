+    """
+    Decodes a Morton code back to 3D coordinates.
+    """
+    x, y, z = 0, 0, 0
+    for b in range(num_bits):
+        shift = 3 * b
+        z |= ((code >> shift) & 1) << b
+        x |= ((code >> (shift + 1)) & 1) << b
+        y |= ((code >> (shift + 2)) & 1) << b
+    return x, y, z
