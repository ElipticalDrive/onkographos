+    class Morton:
+        def __init__(self, value): self.value = value
+        @staticmethod
+        def with_key(v): return Morton(v)
+        @staticmethod
+        def new(): return Morton(0)
+        def __gt__(self, other): return self.value > other.value
+        def parent(self): return Morton(self.value >> 3)
+        def center(self): return (self.value, self.value, self.value)
 
