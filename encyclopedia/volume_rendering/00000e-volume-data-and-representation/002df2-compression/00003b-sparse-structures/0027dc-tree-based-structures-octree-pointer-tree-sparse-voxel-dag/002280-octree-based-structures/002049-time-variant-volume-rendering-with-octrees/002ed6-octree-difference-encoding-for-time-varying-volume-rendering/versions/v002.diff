+def build_octree(data, min_block_size=8):
+    # [G] Standard recursive octree construction
+    def _build(block):
+        if np.all(block == block[0, 0, 0]):
+            return Node(is_leaf=True, value=int(block[0, 0, 0]))
+        if block.shape[0] <= min_block_size:
+            return Node(is_leaf=True, value=int(np.mean(block)))
+        mid = block.shape[0] // 2
+        children = []
+        for i in range(2):
+            for j in range(2):
+                for k in range(2):
+                    children.append(_build(block[i*mid:(i+1)*mid, j*mid:(j+1)*mid, k*mid:(k+1)*mid]))
+        return Node(is_leaf=False, children=children)
+    return _build(data)
