+def parse_png_manual(path: str) -> tuple[bytes, int, int]:
+    with open(path, 'rb') as f:
+        data = f.read()
+        assert data[12:16] == b'IHDR'
+        width = struct.unpack('<I', data[16:20])[0]
+        height = struct.unpack('<I', data[20:24])[0]
+        
+        compressed_data = b''
+        idx = 8
+        while idx < len(data):
+            chunk_len = struct.unpack('<I', data[idx:idx+4])[0]
+            chunk_type = data[idx+4:idx+8]
+            if chunk_type == b'IDAT':
+                compressed_data += data[idx+8:idx+8+chunk_len]
+            elif chunk_type == b'IEND':
+                break
+            idx += 4 + 4 + chunk_len + 4
+            
+        raw_data = zlib.decompress(compressed_data, -15)[2:-6]
+        return raw_data, width, height
+
