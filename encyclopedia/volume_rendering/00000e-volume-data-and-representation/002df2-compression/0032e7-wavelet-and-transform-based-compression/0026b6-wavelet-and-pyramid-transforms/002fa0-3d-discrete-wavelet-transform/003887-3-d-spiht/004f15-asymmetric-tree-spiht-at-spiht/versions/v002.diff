+def get_2x2_groups(band_data):
+    """Yields coordinates of all non-overlapping 2x2 groups in a 2D sub-band."""
+    height, width = band_data.shape
+    for y in range(0, height, 2):
+        for x in range(0, width, 2):
+            yield (y, x)
