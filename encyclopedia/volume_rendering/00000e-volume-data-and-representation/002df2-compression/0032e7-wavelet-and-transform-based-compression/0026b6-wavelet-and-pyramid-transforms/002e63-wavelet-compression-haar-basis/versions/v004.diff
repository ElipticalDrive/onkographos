+```python
+def haar_1d(x):
+    """Apply one level of 1D Haar transform to vector x."""
+    n = len(x)
+    if n <= 1: return x
+    avg = [(x[2*i] + x[2*i+1]) / 2.0 for i in range(n // 2)]
+    diff = [(x[2*i] - x[2*i+1]) / 2.0 for i in range(n // 2)]
+    return avg + diff
 
