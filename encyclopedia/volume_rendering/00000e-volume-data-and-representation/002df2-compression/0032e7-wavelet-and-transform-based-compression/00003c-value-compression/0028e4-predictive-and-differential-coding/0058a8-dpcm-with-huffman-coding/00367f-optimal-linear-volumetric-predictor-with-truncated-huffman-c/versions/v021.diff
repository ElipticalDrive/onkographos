+def solve_3x3(A, b): # [G]
+    # Standard Gaussian elimination for 3x3 system
+    n = 3
+    M = [A[i] + [b[i]] for i in range(n)]
+    for i in range(n):
+        for j in range(i+1, n):
+            if M[i][i] == 0: continue
+            factor = M[j][i] / M[i][i]
+            for k in range(i, n+1):
+                M[j][k] -= factor * M[i][k]
+    x = [0]*n
+    for i in range(n-1, -1, -1):
+        x[i] = M[i][n]
+        for j in range(i+1, n):
+            x[i] -= M[i][j] * x[j]
+        x[i] /= M[i][i]
+    return x
+
