+def build_huffman(symbols, counts):
+    import heapq
+    heap = [[c, [s, '']] for s, c in zip(symbols, counts)]
+    heapq.heapify(heap)
+    while len(heap) > 1:
+        lo = heapq.heappop(heap)
+        hi = heapq.heappop(heap)
+        for pair in lo[1:]: pair[1] = '0' + pair[1]
+        for pair in hi[1:]: pair[1] = '1' + pair[1]
+        heapq.heappush(heap, [lo[0] + hi[0]] + lo[1:] + hi[1:])
+    return {s: code for s, code in heapq.heappop(heap)[1:]}
