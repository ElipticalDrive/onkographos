+def solve_3x3(A, b):
+    # Gaussian elimination for 3x3 system
+    M = [A[i] + [b[i]] for i in range(3)]
+    for i in range(3):
+        pivot = M[i][i]
+        for j in range(i, 4): M[i][j] /= pivot
+        for k in range(3):
