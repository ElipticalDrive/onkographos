+def compress_rle(data):
+    """Standard RLE compression: returns list of (count, value) tuples."""
+    if not data:
+        return []
+    rle = []
+    current_val = data[0]
+    count = 1
+    for val in data[1:]:
+        if val == current_val:
+            count += 1
+        else:
+            rle.append((count, current_val))
+            current_val = val
+            count = 1
+    rle.append((count, current_val))
+    return rle
