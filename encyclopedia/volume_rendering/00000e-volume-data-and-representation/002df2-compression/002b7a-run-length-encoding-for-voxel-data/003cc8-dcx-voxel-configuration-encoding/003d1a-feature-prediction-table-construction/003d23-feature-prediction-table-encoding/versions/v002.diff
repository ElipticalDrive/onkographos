     *   Store the inferred value in the corresponding grid cell [S1].
 
+**Pseudocode:**
+```python
+def feature_prediction_encode(grid, p, FPTs):
+    X, Y, Z = grid.shape
+    residual = zeros_like(grid)
+    for level in range(p):
+        s = 2**(p - level)
+        r = s // 2
+        # 1. Store key voxels (cube corners)
+        for qx in range(0, X // s + 1):
+            for qy in range(0, Y // s + 1):
+                for qz in range(0, Z // s + 1):
+                    residual[qx*s, qy*s, qz*s] = grid[qx*s, qy*s, qz*s]
+        # 2. Step 1: Central voxels
+        for qx in range(0, X // s):
+            for qy in range(0, Y // s):
+                for qz in range(0, Z // s):
+                    cx, cy, cz = qx*s + r, qy*s + r, qz*s + r
+                    if not in_bounds(cx, cy, cz): continue
+                    ctx = pack_bits(residual[cx ± r, cy ± r, cz ± r])
+                    pred = FPTs[0][ctx]
+                    residual[cx, cy, cz] = grid[cx, cy, cz] ^ pred
+        # 3. Step 2: Face centers (X-axis orthogonal faces shown; Y/Z handled analogously)
+        for qx in range(0, X // s):
+            for qy in range(0, Y // s + 1):
+                for qz in range(0, Z // s):
+                    fx, fy, fz = qx*s + r, qy*s, qz*s + r
+                    if not in_bounds(fx, fy, fz): continue
+                    ctx = pack_bits(fx, fy ± r, fz ± r) + pack_bits(fx ± r, fy, fz)
+                    pred = FPTs[1][ctx]
+                    residual[fx, fy, fz] = grid[fx, fy, fz] ^ pred
+        # 4. Step 3: Edge centers (Z-axis parallel edges shown; X/Y handled analogously)
+        for qx in range(0, X // s + 1):
+            for qy in range(0, Y // s + 1):
+                for qz in range(0, Z // s):
+                    ex, ey, ez = qx*s + r, qy*s + r, qz*s
+                    if not in_bounds(ex, ey, ez): continue
+                    ctx = pack_bits(ex, ey, ez ± r) + pack_bits(ex ± r, ey ± r, ez)
+                    pred = FPTs[2][ctx]
+                    residual[ex, ey, ez] = grid[ex, ey, ez] ^ pred
+    return residual
+
+def in_bounds(x, y, z):
+    return 0 <= x < X and 0 <= y < Y and 0 <= z < Z
+
+def pack_bits(*coords):
+    # Concatenates occupancy bits from the given coordinate tuples into a single integer index
+    index = 0
+    for c in coords:
+        index = (index << 1) | residual[c]
+    return index
+```
+
 **Edge Cases and Pitfalls:**
 *   **Boundary Conditions:** For non-cubic grids or grids with dimensions not equal to $2^d$, prediction contexts may include non-existing voxels outside the grid. These out-of-bounds voxels are treated as having an occupancy value of 0 [S1].
