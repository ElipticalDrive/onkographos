+
+    # Step 5: Binary-Swap Compositing
+    def binary_swap_composite(images):
+        n = len(images)
+        stage = 1
+        while stage < n:
+            for i in range(n):
+                if i % (2 * stage) == 0:
+                    neighbor_idx = i + stage
+                    half_w = images[i][0].shape[1] // 2
