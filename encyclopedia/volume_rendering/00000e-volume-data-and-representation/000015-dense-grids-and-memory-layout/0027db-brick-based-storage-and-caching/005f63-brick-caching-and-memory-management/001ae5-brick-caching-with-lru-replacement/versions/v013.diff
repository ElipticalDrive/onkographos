+### Pseudocode
+```python
+class BrickCache:
+    def __init__(self, dims, brick_size, brick_num_ratio):
+        self.brick_dims = (
+            (dims[0] + brick_size[0] - 1) // brick_size[0],
+            (dims[1] + brick_size[1] - 1) // brick_size[1],
+            (dims[2] + brick_size[2] - 1) // brick_size[2]
+        )
+        self.N_bricks = self.brick_dims[0] * self.brick_dims[1] * self.brick_dims[2]
+        self.blk_nums = int(self.N_bricks * brick_num_ratio)
+        self.brick_vol = (brick_size[0] + 1) * (brick_size[1] + 1) * (brick_size[2] + 1)
+        self.data = bytearray(self.blk_nums * self.brick_vol)
+        self.entries = [{"valid": False, "blk_idx": -1} for _ in range(self.N_bricks)]
+        self.blocks = [{"used": False} for _ in range(self.blk_nums)]
+        self.cnt_buf = [0] * (self.N_bricks * 256) # Loaded from disk
+        self.clock_pos = 0
+        self.blk_used = 0
+        self.mutex = threading.Lock()
+        self.fin = None # File handle
+
+    def get_block(self, bx, by, bz, tf1d=None):
+        if bx >= self.brick_dims[0] or by >= self.brick_dims[1] or bz >= self.brick_dims[2]:
+            return None
+        if tf1d is not None:
+            cnt_base = (bx * self.brick_dims[1] + by) * self.brick_dims[2] + bz
+            idx = 0
+            while idx < 256:
+                if self.cnt_buf[cnt_base + idx] != 0 and tf1d.sampleSimple(idx).w != 0:
+                    break
+                idx += 1
+            if idx == 256:
+                return None
+        entry_idx = bx * self.brick_dims[1] * self.brick_dims[2] + by * self.brick_dims[2] + bz
+        entry = self.entries[entry_idx]
+        if entry["valid"]:
+            self.blocks[entry["blk_idx"]]["used"] = True
+            return self.data[entry["blk_idx"] * self.brick_vol : (entry["blk_idx"] + 1) * self.brick_vol]
+        with self.mutex:
+            if self.blk_used < self.blk_nums:
+                blk_idx = next(i for i in range(self.blk_nums) if not self.blocks[i]["used"])
+                self.blk_used += 1
+            else:
+                while self.blocks[self.clock_pos]["used"]:
+                    self.clock_pos = (self.clock_pos + 1) % self.blk_nums
+                old_blk_idx = self.clock_pos
+                self.blocks[old_blk_idx]["used"] = False
+                self.entries[entry_idx]["valid"] = False
+                blk_idx = old_blk_idx
+            # Load block from file into self.data at offset blk_idx * self.brick_vol
+            entry["valid"] = True
+            entry["blk_idx"] = blk_idx
+            self.blocks[blk_idx]["used"] = True
+            return self.data[blk_idx * self.brick_vol : (blk_idx + 1) * self.brick_vol]
+```
+
