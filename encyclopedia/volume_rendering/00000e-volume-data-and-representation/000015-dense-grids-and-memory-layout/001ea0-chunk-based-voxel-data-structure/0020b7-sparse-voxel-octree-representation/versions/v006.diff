-NODE ::= <INODE>|<LNODE>
-INODE ::= <CHNM>(p)<BIT><PTS>
-LNODE ::= <CHNM>(q)<BIT>
-CHNM ::= (8)<HT>
-PTS ::= (1)*(8)<PT>
