+        channel_desc = cuda_create_channel_desc_ushort() if is_16bit else cuda_create_channel_desc_uchar()
+        array = cuda_malloc_3d_array(channel_desc, extent)
+        copy_params = make_cuda_memcpy3d_params(buffer, array, extent)
