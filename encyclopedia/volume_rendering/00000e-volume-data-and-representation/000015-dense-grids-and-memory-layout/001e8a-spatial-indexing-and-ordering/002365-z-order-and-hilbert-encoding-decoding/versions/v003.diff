-    # Assume x, y, z are 32-bit integers
-    i = 0
-    for b in range(32):
-        i |= ((x & (1 << b)) << (2 * b))
-        i |= ((y & (1 << b)) << (2 * b + 1))
-        i |= ((z & (1 << b)) << (2 * b + 2))
-    return i
+def hilbert_encode_3d(x, y, z, bits_per_dim=5):
+    """
+    Encodes 3D coordinates into a Hilbert index.
+    Assumes x, y, z are non-negative integers < 2^bits_per_dim.
+    """
+    n = 1 << (bits_per_dim - 1)
+    rx, ry, rz = 0, 0, 0
+    r = x | (y << 1) | (z << 2)
+    
+    for s in range(bits_per_dim - 1):
+        d = n >> s
+        rx = 1 if (x & d) else 0
+        ry = 1 if (y & d) else 0
+        rz = 1 if (z & d) else 0
+        
+        # If the right bit of x is 1, invert the order of the sub-cube
+        if rx == 1:
+            # Swap x and y
+            x, y = y, x
+            # Invert y
+            y = d - 1 - y
+        # If the right bit of y is 1, invert x and z
+        if ry == 1:
+            # Swap x and z
+            x, z = z, x
+            # Invert z
+            z = d - 1 - z
+        # If the right bit of z is 1, invert y and z
+        if rz == 1:
+            # Swap y and z
+            y, z = z, y
+            # Invert z
+            z = d - 1 - z
+            
+    # Final interleaving
+    index = 0
+    for i in range(bits_per_dim):
+        index |= ((x >> i) & 1) << (3 * i)
+        index |= ((y >> i) & 1) << (3 * i + 1)
+        index |= ((z >> i) & 1) << (3 * i + 2)
+        
+    return index
 ```
-*Note: The above pseudocode is a simplified bit-interleaving logic. Efficient implementations use parallel bit manipulation instructions or lookup tables [S1, unofficial].*
 
-### Algorithm: Hilbert Curve Encoding
-Hilbert encoding maps coordinates by traversing a recursive space-filling curve. The mapping depends on the dimension and the orientation of the curve at each recursive step.
-
-1. Initialize $I = 0$.
-2. For each bit position $b$ from $B-1$ down to $0$:
-   - Determine the quadrant $q$ containing the point $(x_b, y_b, z_b)$ based on the current orientation.
-   - Update $I$ by adding the offset corresponding to quadrant $q$.
-   - Update the coordinates $(x, y, z)$ and the orientation matrix to reflect the recursive step into the selected quadrant.
-3. Return $I$.
-
