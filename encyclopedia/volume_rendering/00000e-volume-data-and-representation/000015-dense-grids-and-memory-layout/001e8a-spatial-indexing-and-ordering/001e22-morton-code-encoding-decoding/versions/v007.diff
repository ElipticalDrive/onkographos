+def make_magic(dimensions: int) -> list:
+    """
+    Generates magic bits array for fast Morton decoding.
+    """
+    d = dimensions
+    limit = 64 // d + 1
+    nth = [0] * 6
+    
+    for i in range(limit):
+        if i <= 32:
+            nth[0] |= 1 << (i * d)
+        if i <= 16:
+            nth[1] |= 3 << (i * (d << 1))
+        if i <= 8:
+            nth[2] |= 0xf << (i * (d << 2))
+        if i <= 4:
+            nth[3] |= 0xff << (i * (d << 3))
+        if i <= 2:
+            nth[4] |= 0xffff << (i * (d << 4))
+        if i <= 1:
+            nth[5] |= 0xffffff << (i * (d << 5))
+            
