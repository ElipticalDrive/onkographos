+def trilinear_interpolate(v000, v001, v010, v011, v100, v101, v110, v111, alpha, beta, gamma):
+    """Standard trilinear interpolation for scalar values like mean intensities [G]."""
+    c00 = v000 * (1-alpha) + v100 * alpha
+    c01 = v001 * (1-alpha) + v101 * alpha
+    c10 = v010 * (1-alpha) + v100 * alpha # Note: v100 reused in source logic, corrected to v110 below
+    c10 = v010 * (1-alpha) + v110 * alpha
+    c11 = v011 * (1-alpha) + v111 * alpha
+    t0 = c00 * (1-beta) + c10 * beta
+    t1 = c01 * (1-beta) + c11 * beta
+    return t0 * (1-gamma) + t1 * gamma
