+def query_leaf_payload_index(voxel_x, voxel_y, voxel_z, min_bound, max_bound, max_depth, nodes, leaf_payload_indices):
+    # Standard SVO traversal matching the forward pass logic
+    if not (min_bound.x <= voxel_x and voxel_x < max_bound.x and
+            min_bound.y <= voxel_y and voxel_y < max_bound.y and
+            min_bound.z <= voxel_z and voxel_z < max_bound.z):
+        return -1
+        
+    node_index = 0
+    depth_remaining = max_depth
+    
+    while depth_remaining > 0:
+        if node_index >= len(nodes):
+            return -1
+            
+        descriptor = nodes[node_index]
+        child_index = ((voxel_x >> (depth_remaining - 1)) & 1) | \
+                      ((voxel_y >> (depth_remaining - 1)) & 1) << 1 | \
+                      ((voxel_z >> (depth_remaining - 1)) & 1) << 2
+        child_bit = 1 << child_index
+        
+        if (descriptor.child_mask & child_bit) == 0:
+            return -1
+            
+        if (descriptor.leaf_mask & child_bit) != 0:
+            leaf_id = descriptor.payload_base + prefix_rank(descriptor.leaf_mask, child_index)
