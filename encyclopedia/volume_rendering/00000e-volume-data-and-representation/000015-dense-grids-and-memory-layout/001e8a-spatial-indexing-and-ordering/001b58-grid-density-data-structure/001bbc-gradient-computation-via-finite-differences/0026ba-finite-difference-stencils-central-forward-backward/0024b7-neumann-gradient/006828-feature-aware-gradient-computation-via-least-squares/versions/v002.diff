 *   The matrix $(Q^T Q)$ is constant for every local function if the same $k$ is chosen for $k$-ring neighbors of each voxel, allowing precomputation [S1, unofficial].
 
+**Pseudocode:**
+```python
+def compute_gradient_least_squares(grid, neighbors_func, degree=3):
+    """
+    grid: dict mapping (u,v,w) -> scalar value
+    neighbors_func: returns list of neighbor coordinates for a given voxel
+    degree: polynomial degree for basis functions
+    """
+    gradients = {}
+    for i in grid:
+        u_i, v_i, w_i = i
+        neighbor_coords = neighbors_func(i)
+        Q = []
+        values = []
+        # 1. Construct fitting matrix Q and value vector I^D
+        for j in neighbor_coords:
+            u_j, v_j, w_j = j
+            basis = []
+            for a in range(degree + 1):
+                for b in range(degree + 1):
+                    for c in range(degree + 1):
+                        if a + b + c <= degree:
+                            basis.append(u_j**a * v_j**b * w_j**c)
+            Q.append(basis)
+            values.append(grid[j])
+        Q = np.array(Q)
+        values = np.array(values)
+        # 2. Solve for coefficients C^T
+        QtQ = Q.T @ Q
+        C_T = np.linalg.solve(QtQ, Q.T @ values)
+        # 3. Compute derivative vectors P_u, P_v, P_w at voxel i
+        P_u, P_v, P_w = [], [], []
+        for a in range(degree + 1):
+            for b in range(degree + 1):
+                for c in range(degree + 1):
+                    if a + b + c <= degree:
+                        # Derivative w.r.t u: set u^m to 0 if m < 0
+                        P_u.append((a * u_i**(a-1) if a > 0 else 0) * v_i**b * w_i**c)
+                        P_v.append(b * u_i**a * (v_i**(b-1) if b > 0 else 0) * w_i**c)
+                        P_w.append(c * u_i**a * v_i**b * (w_i**(c-1) if c > 0 else 0))
+        P_u, P_v, P_w = np.array(P_u), np.array(P_v), np.array(P_w)
+        # 4. Gradient: (P_u C^T, P_v C^T, P_w C^T)
+        gradients[i] = (P_u @ C_T, P_v @ C_T, P_w @ C_T)
+    return gradients
+```
