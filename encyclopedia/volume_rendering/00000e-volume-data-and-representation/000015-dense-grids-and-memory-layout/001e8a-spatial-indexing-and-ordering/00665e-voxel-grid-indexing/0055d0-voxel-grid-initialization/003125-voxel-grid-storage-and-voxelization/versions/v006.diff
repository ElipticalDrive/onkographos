+    
+    # dim = ceil(bbox_extent / voxel_size) + 2
+    width = int(math.ceil(bbox_extent[0] / voxel_size)) + 2
+    height = int(math.ceil(bbox_extent[1] / voxel_size)) + 2
+    depth = int(math.ceil(bbox_extent[2] / voxel_size)) + 2
+    
