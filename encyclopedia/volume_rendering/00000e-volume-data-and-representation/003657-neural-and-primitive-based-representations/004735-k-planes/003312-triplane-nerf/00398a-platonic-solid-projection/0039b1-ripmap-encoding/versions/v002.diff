+- The level indices $l_x, l_y$ must be clamped to the valid range $[0, L-1]$ to avoid out-of-bounds access [G].
 - The anisotropic pooling direction is fixed: $y$-level increments use horizontal averaging ($2\times1$), and $x$-level increments use vertical averaging ($1\times2$) [S1]. This assumes the coordinate system aligns with the pooling axes.
+
+**Pseudocode:**
+```python
+def build_riipmap(F, L):
+    R = [[None] * L for _ in range(L)]
+    R[0][0] = F
+    for i in range(1, L):
+        R[i][0] = avg_pool_1x2(R[i-1][0])
+    for j in range(1, L):
+        for i in range(L):
+            R[i][j] = avg_pool_2x1(R[i][j-1])
+    return R
+
+def query_riipmap(R, px, py, lx, ly, L, H, W, C):
+    ix = max(0, min(L - 1, int(lx)))
+    iy = max(0, min(L - 1, int(ly)))
+    fx = lx - ix
+    fy = ly - iy
+    px = max(0, min(W - 1, px))
+    py = max(0, min(H - 1, py))
+    f00 = bilinear(R[ix][iy], px, py, H, W, C)
+    f10 = bilinear(R[ix+1][iy], px, py, H, W, C) if ix + 1 < L else f00
+    f01 = bilinear(R[ix][iy+1], px, py, H, W, C) if iy + 1 < L else f00
+    f11 = bilinear(R[ix+1][iy+1], px, py, H, W, C) if ix + 1 < L and iy + 1 < L else f00
+    return lerp(lerp(f00, f10, fx), lerp(f01, f11, fx), fy)
+```
 
