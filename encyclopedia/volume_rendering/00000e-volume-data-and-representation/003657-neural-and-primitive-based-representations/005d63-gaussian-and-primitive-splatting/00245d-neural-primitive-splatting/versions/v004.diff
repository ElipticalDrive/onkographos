+    sh += c[12] * (-0.546274 * x * (4 * z * z - 3))
+    sh += c[13] * (0.546274 * y * (x * x - y * y))
+    sh += c[14] * (-0.315392 * x * (x * x - 3 * y * y))
+    sh += c[15] * (0.126225 * x * (x * x - 3 * y * y))
+    return sh
