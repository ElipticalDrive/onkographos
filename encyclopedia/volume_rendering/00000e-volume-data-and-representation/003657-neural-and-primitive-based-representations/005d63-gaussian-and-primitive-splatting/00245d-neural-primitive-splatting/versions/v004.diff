 import numpy as np
 
+def quat_to_rot(q):
+    """Convert quaternion to 3x3 rotation matrix [G]."""
+    x, y, z, w = q
+    return np.array([
+        [1 - 2*(y**2 + z**2), 2*(x*y - z*w), 2*(x*z + y*w)],
+        [2*(x*y + z*w), 1 - 2*(x**2 + z**2), 2*(y*z - x*w)],
+        [2*(x*z - y*w), 2*(y*z + x*w), 1 - 2*(x**2 + y**2)]
+    ])
+
+def line_ellipsoid_intersection(primitive, ray_o, ray_d):
+    """Compute entry and exit distances t_in, t_out for ray intersecting ellipsoid [G]."""
+    R = quat_to_rot(primitive['q_B'])
+    s = primitive['s_B']
+    o_local = R.T @ (ray_o - primitive['x_B'])
+    d_local = R.T @ ray_d
+    inv_s = 1.0 / s
+    A = np.sum((d_local * inv_s)**2)
+    B = 2.0 * np.sum((o_local * d_local) * inv_s**2)
+    C = np.sum((o_local * inv_s)**2) - 1.0
+    disc = B**2 - 4*A*C
+    if disc < 0:
+        return np.inf, -np.inf
+    sqrt_disc = math.sqrt(disc)
+    t1 = (-B - sqrt_disc) / (2*A)
+    t2 = (-B + sqrt_disc) / (2*A)
+    return min(t1, t2), max(t1, t2)
+
+def evaluate_sh(coeffs, direction):
+    """Evaluate 4-band spherical harmonics for a direction [G]."""
+    x, y, z = direction
+    # Standard 4-band (degree 3) SH basis evaluation
+    sh = np.zeros(3)
+    # Coefficients layout: [c0, c1y, c1z, c1x, c2yy, c2yz, c2xz, c2xx, c3yyy, c3yyz, c3yzz, c3yxx, c3xzz, c3xzx, c3xxx, c3xyy]
+    c = coeffs.reshape(16, 3)
+    sh += c[0] * 0.282095
