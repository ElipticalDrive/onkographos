+    sh += c[2] * (0.488603 * z)
+    sh += c[3] * (-0.488603 * x)
+    sh += c[4] * (1.092548 * y * y)
+    sh += c[5] * (-1.092548 * y * z)
+    sh += c[6] * (1.092548 * x * z)
+    sh += c[7] * (-0.315392 * (3 * z * z - 1))
+    sh += c[8] * (-1.092548 * x * y * y)
