 import numpy as np
 
+class Linear:
+    def __init__(self, in_features, out_features):
+        self.weight = np.random.randn(in_features, out_features) * 0.02
+        self.bias = np.zeros(out_features)
+    def forward(self, x):
+        return x @ self.weight + self.bias
+
+class MLP:
+    def __init__(self, input_dim, hidden_dim, output_dim):
+        self.fc1 = Linear(input_dim, hidden_dim)
+        self.fc2 = Linear(hidden_dim, output_dim)
+    def forward(self, x):
+        x = np.maximum(0, x @ self.fc1.weight + self.fc1.bias)
+        return x @ self.fc2.weight + self.fc2.bias
+
+def adam_step(params, grads, lr, beta1, beta2, eps, m, v, t):
+    for p, g in zip(params, grads):
+        m[t] = beta1 * m[t] + (1 - beta1) * g
+        v[t] = beta2 * v[t] + (1 - beta2) * g**2
+        m_hat = m[t] / (1 - beta1**t)
+        v_hat = v[t] / (1 - beta2**t)
+        p -= lr * m_hat / (np.sqrt(v_hat) + eps)
