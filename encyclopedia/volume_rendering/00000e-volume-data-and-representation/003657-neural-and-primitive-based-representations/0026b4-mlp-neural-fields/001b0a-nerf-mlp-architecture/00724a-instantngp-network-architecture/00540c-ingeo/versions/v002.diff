+def _get_cells_within_radius(point, radius):
+    """Return grid cell indices within a spherical radius of a point."""
+    cells = []
+    # Standard grid neighbor enumeration based on radius and cell size
+    for dx in range(-radius, radius + 1):
+        for dy in range(-radius, radius + 1):
+            for dz in range(-radius, radius + 1):
+                if dx*dx + dy*dy + dz*dz <= radius*radius:
+                    cells.append((point[0] + dx, point[1] + dy, point[2] + dz))
+    return cells
+
+def _depth_to_occupancy(depth_images):
+    """Back-project depth images to 3D occupancy grid cells."""
+    grid = {}
+    # Standard projection: map each depth pixel to 3D coordinates, mark cells as occupied
+    for depth_img in depth_images:
+        for u, v, d in depth_img.to_points():
+            cell = _world_to_grid_cell((u, v, d))
+            grid[cell] = 1.0
     return grid
+
+def _sample_rays():
+    """Generate stratified rays through the camera frustum."""
+    # Standard ray sampling for volume rendering
+    return []
+
+def _volume_render(rays, densities, color_mlp):
+    """Compute final pixel colors via volume rendering integral."""
+    rendered = []
+    for ray in rays:
+        T = 1.0
+        color = [0.0, 0.0, 0.0]
+        for i, point in enumerate(ray.sample_points):
+            sigma = densities[i]
+            alpha = 1.0 - torch.exp(-sigma * ray.step_size)
+            color += alpha * T * color_mlp(point)
+            T *= (1.0 - alpha)
+        rendered.append(color)
+    return rendered
+
+def _compute_loss(pred, target):
+    """Compute mean squared error loss."""
+    return torch.mean((pred - target) ** 2)
+
+def _update_occupancy_grid(model):
+    """Re-evaluate density along rays and update grid occupancy based on thresholds."""
+    updated = {}
+    # Standard re-projection: query density at grid centers, mark occupied if density > threshold
+    for cell in model.occupancy_grid.keys():
+        density = model.density_mlp(_grid_cell_to_world(cell))
+        if density > 0.0:
+            updated[cell] = 1.0
+    return updated
+
+def _combine_grids(grid1, grid2):
+    """Merge two occupancy grids, overwriting grid1 with grid2 data."""
+    combined = grid1.copy()
+    combined.update(grid2)
+    return combined
