+import torch
+import numpy as np
+
+def gen_world2local(normal):
+    """Construct a rotation matrix aligning local Z with normal [G]."""
+    z = normal / (torch.norm(normal, dim=-1, keepdim=True) + 1e-8)
+    up = torch.tensor([0.0, 0.0, 1.0], device=normal.device).unsqueeze(0)
+    x = torch.cross(z, up)
+    x = x / (torch.norm(x, dim=-1, keepdim=True) + 1e-8)
+    y = torch.cross(z, x)
+    return torch.stack([x, y, z], dim=-2)  # [N, 3, 3]
+
+def dir2rusink(ldir, vdir):
+    """Compute Rusinkiewicz coordinates from local light and view directions [G]."""
+    sum_dir = vdir + ldir
+    norm_sum = torch.norm(sum_dir, dim=-1, keepdim=True) + 1e-8
+    return sum_dir / norm_sum  # [N*L, 3]
+
+def scatter_nd(indices, values, shape):
+    """Scatter values to indices in a zero tensor [G]."""
+    out = torch.zeros(shape, device=values.device, dtype=values.dtype)
+    out.scatter_(0, indices.unsqueeze(-1).expand(-1, values.shape[-1]), values)
+    return out
+
