+def compute_vmf_brdf(l, d, n, rho, alpha):
+    """
+    l: light direction
+    d: view direction
+    n: normal
+    rho: roughness
+    alpha: specular tint
+    """
+    lr = 2 * (-torch.dot(d, n)) * n + d
+    # G(l, lr, xs) = alpha * exp(rho * (l . lr - 1))
+    return alpha * torch.exp(rho * (torch.dot(l, lr) - 1))
