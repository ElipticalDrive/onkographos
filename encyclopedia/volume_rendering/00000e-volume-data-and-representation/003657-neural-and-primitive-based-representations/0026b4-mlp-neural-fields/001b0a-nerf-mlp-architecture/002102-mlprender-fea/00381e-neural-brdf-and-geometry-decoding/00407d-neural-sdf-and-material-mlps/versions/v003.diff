+    freq_bands = 2.0 ** torch.linspace(0, num_frequencies - 1, num_frequencies)
+    x_embed = x.unsqueeze(-1) * freq_bands.unsqueeze(0)
+    x_embed = torch.cat([torch.sin(x_embed), torch.cos(x_embed)], dim=-1)
