+        densities = self.coarse_mlp(torch.cat([enc_pts, fused_features], dim=-1)).squeeze(-1)
+        colors = self.fine_mlp(torch.cat([enc_dirs, self.pos_enc(points)], dim=-1)).squeeze(-1)
+        
+        t = torch.zeros(N_rays, N_samples + 1, device=points.device)
+        for i in range(N_rays):
