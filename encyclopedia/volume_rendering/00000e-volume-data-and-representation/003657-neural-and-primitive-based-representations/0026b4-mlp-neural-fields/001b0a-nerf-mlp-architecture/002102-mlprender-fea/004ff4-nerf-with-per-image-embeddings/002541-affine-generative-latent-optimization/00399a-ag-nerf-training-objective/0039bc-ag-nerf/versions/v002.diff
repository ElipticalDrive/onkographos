+    def project_and_interpolate(self, points_3d, K, P, source_img, feat_map, H, W):
+        points_hom = torch.cat([points_3d, torch.ones(points_3d.shape[0], 1)], dim=1)
+        cam_mat = K @ P
+        points_2d_hom = torch.matmul(points_hom, cam_mat.T)
+        points_2d = points_2d_hom[:, :2] / points_2d_hom[:, 2:3]
+        
+        grid_x = (points_2d[:, 0] / (W - 1)) * 2 - 1
+        grid_y = (points_2d[:, 1] / (H - 1)) * 2 - 1
+        grid = torch.stack([grid_x, grid_y], dim=-1).unsqueeze(0).unsqueeze(1)
+        
+        img_feat = F.grid_sample(source_img.unsqueeze(0), grid, align_corners=True).squeeze().T
+        feat_feat = F.grid_sample(feat_map.unsqueeze(0), grid, align_corners=True).squeeze().T
+        return torch.cat([img_feat, feat_feat], dim=-1)
