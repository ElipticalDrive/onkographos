 import torch.nn.functional as F
 
+class ConvBlock(nn.Module):
+    def __init__(self, in_channels, out_channels):
+        super().__init__()
+        self.conv1 = nn.Conv2d(in_channels, out_channels, kernel_size=3, padding=1)
+        self.bn1 = nn.BatchNorm2d(out_channels)
+        self.conv2 = nn.Conv2d(out_channels, out_channels, kernel_size=3, padding=1)
+        self.bn2 = nn.BatchNorm2d(out_channels)
+        self.relu = nn.ReLU(inplace=True)
+
+    def forward(self, x):
+        out = self.conv1(x)
+        out = self.bn1(out)
+        out = self.relu(out)
+        out = self.conv2(out)
+        out = self.bn2(out)
+        out = self.relu(out)
+        return out
+
+class SkyEncoderBranch(nn.Module):
+    def __init__(self, out_channels):
+        super().__init__()
+        # 5 downsampling conv-blocks with channels (64, 128, 256, 256, 256)
+        self.blocks = nn.ModuleList()
+        in_ch = 2048  # Output dimension from ResNet50 backbone
+        dims = [64, 128, 256, 256, 256]
+        for d in dims:
+            self.blocks.append(ConvBlock(in_ch, d))
+            in_ch = d
+        self.pool = nn.AdaptiveAvgPool2d(1)
+        self.fc = nn.Linear(in_ch, out_channels)
+
+    def forward(self, x):
+        for block in self.blocks:
+            x = block(x)
+        x = self.pool(x).view(x.size(0), -1)
+        return self.fc(x)
+
+class SkyDecoderUNet(nn.Module):
+    def __init__(self, in_channels, latent_dim, channels):
+        super().__init__()
+        # channels: [64, 128, 256, 256, 256, 256, 128, 64, 32, 16]
+        # 5 downsampling, 5 upsampling
+        self.down_blocks = nn.ModuleList()
+        self.up_blocks = nn.ModuleList()
+        
+        # Downsampling
+        current_ch = in_channels
+        for i in range(5):
+            self.down_blocks.append(ConvBlock(current_ch, channels[i]))
+            current_ch = channels[i]
+            
+        # Bottleneck latent fusion
+        self.latent_fusion = nn.Linear(latent_dim, channels[5])
+        
+        # Upsampling
+        for i in range(5, 10):
+            self.up_blocks.append(UpConvBlock(channels[i], channels[i-1]))
+            
+        self.final_conv = nn.Conv2d(channels[9], 3, kernel_size=1)
+
+    def forward(self, x, latent_code):
+        # Downsample
+        skips = []
+        for block in self.down_blocks:
+            x = block(x)
+            skips.append(x)
+            
+        # Latent fusion at bottleneck
+        b, c, h, w = x.shape
+        latent_expanded = self.latent_fusion(latent_code).view(b, -1, 1, 1).expand(b, -1, h, w)
+        x = torch.cat([x, latent_expanded], dim=1)
+        
+        # Upsample
+        for i, block in enumerate(self.up_blocks):
+            skip = skips[4-i]
+            x = block(x, skip)
+            
+        x = self.final_conv(x)
+        return x
+
+class UpConvBlock(nn.Module):
+    def __init__(self, in_channels, out_channels):
+        super().__init__()
+        self.up = nn.ConvTranspose2d(in_channels, out_channels, kernel_size=2, stride=2)
+        self.conv = ConvBlock(out_channels * 2, out_channels)
+
+    def forward(self, x, skip):
+        x = self.up(x)
+        x = torch.cat([x, skip], dim=1)
+        x = self.conv(x)
+        return x
+
