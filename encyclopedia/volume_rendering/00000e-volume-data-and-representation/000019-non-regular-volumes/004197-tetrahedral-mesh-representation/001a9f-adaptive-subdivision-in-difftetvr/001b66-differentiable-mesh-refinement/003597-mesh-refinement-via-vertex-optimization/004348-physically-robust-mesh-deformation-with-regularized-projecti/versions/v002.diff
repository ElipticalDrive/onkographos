+def optimize_mesh(V, h_theta, F_tri, T=60, k_init=0.1, k_decay=0.5, v0=0.0, lam_a=1.0, lam_b=1.0, lam_c=1.0):
+    # V: vertex positions array
+    # h_theta(V): neural network predicting closest points
+    # F_tri: surface triangles
+    for t in range(1, T + 1):
+        # Noise coefficient schedule: linear decay from k_init
+        k_t = max(0.0, k_init - (t - 1) * k_decay / 10)
+        # Random Gaussian noise n ~ N(0,1) for each vertex
+        n = generate_gaussian_noise(V.shape)
+        # Predicted closest points p^s = h_theta(V, v^s)
+        p = h_theta(V)
+        # Robust projection residual r^s = v^s - p^s + k_t * n
+        r = V - p + k_t * n
+        # Smooth regularization terms (source does not specify exact formulas for R_edge, R_lap, R_norm)
+        R_edge = compute_edge_penalty(V, F_tri)
+        R_lap = compute_laplacian_term(V, F_tri)
+        R_norm = compute_normal_consistency(V, F_tri)
+        R_smooth = lam_a * R_edge + lam_b * R_lap + lam_c * R_norm
+        # Orientation regularization term
+        R_orient = 0.0
+        for k in tetrahedra_indices:
+            # M_{c,k} is 4x4 homogeneous coordinate matrix
+            M = build_homogeneous_matrix(V, k)
+            det_M = determinant(M)
+            if det_M <= v0:
+                R_orient -= (det_M - v0)**2 * log(det_M)
+            else:
+                R_orient += det_M
+        # Total loss L(V)
+        L = sum(norm(r)) + R_smooth + R_orient
+        # Update V using gradient-based optimizer
+        grad_V = compute_gradient(L, V)
+        V = V - learning_rate * grad_V
+    return V
