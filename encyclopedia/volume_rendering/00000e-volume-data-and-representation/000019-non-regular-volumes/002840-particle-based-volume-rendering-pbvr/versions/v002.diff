 *   **Discretization Error:** Projected particles are discretized to sub-pixel positions. If projected particle images overlap before discretization, the sum of projected areas may differ from the continuous case, causing artifacts [S1, unofficial].
 
+**Pseudocode:**
+```python
+import math
+import random
+
+def ParticleGeneration(tetrahedra_stream, transfer_function, sub_pixel_level):
+    r = 1.0 / (2.0 * sub_pixel_level)
+    # Initialize sub-pixel buffers: sub_pixel_buffers[pixel_x][pixel_y][sub_x][sub_y] = (depth, color)
+    sub_pixel_buffers = {}
+
+    for tet in tetrahedra_stream:
+        # 1. Estimate Density
+        centroid_x = (tet.v0.x + tet.v1.x + tet.v2.x + tet.v3.x) / 4.0
+        centroid_y = (tet.v0.y + tet.v1.y + tet.v2.y + tet.v3.y) / 4.0
+        centroid_z = (tet.v0.z + tet.v1.z + tet.v2.z + tet.v3.z) / 4.0
+        scalar_val = tet.scalar_at(centroid_x, centroid_y, centroid_z)
+        alpha = transfer_function(scalar_val)
+        delta_t = 1.0 # Normalized ray segment length for streaming context
+        rho_g = -math.log(1.0 - alpha) / (math.pi * r * r * delta_t)
+
+        # 2. Determine Particle Count
+        cell_volume = tet.volume()
+        N = rho_g * cell_volume
+        if random.random() <= (N - math.floor(N)):
+            n = math.floor(N) + 1
+        else:
+            n = math.floor(N)
+
+        # 3. Generate Particles
+        for j in range(n):
+            b = [random.random() for _ in range(4)]
+            s = sum(b)
+            b = [bi / s for bi in b]
+
+            px = sum(b[k] * tet.v[k].x for k in range(4))
+            py = sum(b[k] * tet.v[k].y for k in range(4))
+            pz = sum(b[k] * tet.v[k].z for k in range(4))
+
+            nx = sum(b[k] * tet.n[k].x for k in range(4))
+            ny = sum(b[k] * tet.n[k].y for k in range(4))
+            nz = sum(b[k] * tet.n[k].z for k in range(4))
+
+            # 4. Project to Image Plane
+            proj_x = px
+            proj_y = py
+            proj_z = pz
+
+            # 5. Discretize to Sub-pixel
+            sub_x = int(math.floor(proj_x * sub_pixel_level))
+            sub_y = int(math.floor(proj_y * sub_pixel_level))
+
+            # 6. Render to O-buffer
+            if sub_x not in sub_pixel_buffers: sub_pixel_buffers[sub_x] = {}
+            if sub_y not in sub_pixel_buffers[sub_x]: sub_pixel_buffers[sub_x][sub_y] = {}
+            if sub_y not in sub_pixel_buffers[sub_x][sub_y]:
+                sub_pixel_buffers[sub_x][sub_y] = (float('inf'), 0.0)
+
+            current_depth, current_color = sub_pixel_buffers[sub_x][sub_y]
+            if proj_z < current_depth:
+                sub_pixel_buffers[sub_x][sub_y] = (proj_z, alpha)
+
+    # 7. Average Sub-pixels to Final Pixels
+    final_image = {}
+    for px in sub_pixel_buffers:
+        for py in sub_pixel_buffers[px]:
+            total_luminance = 0.0
+            count = 0
+            for sx in range(sub_pixel_level):
+                for sy in range(sub_pixel_level):
+                    if (sx, sy) in sub_pixel_buffers[px][py]:
+                        total_luminance += sub_pixel_buffers[px][py][(sx, sy)][1]
+                        count += 1
+            if count > 0:
+                final_image[(px, py)] = total_luminance / count
+    return final_image
+```
