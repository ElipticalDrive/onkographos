+```python
+def volume_net_forward(volume, encoder_weights):
+    # 5 convolutional layers followed by fully connected layer
+    x = volume
+    for w in encoder_weights[:5]:
+        x = relu(conv3d(x, w))
+    x = flatten(x)
+    fc_w = encoder_weights[5]
+    feature = linear(x, fc_w)
+    return feature
 
