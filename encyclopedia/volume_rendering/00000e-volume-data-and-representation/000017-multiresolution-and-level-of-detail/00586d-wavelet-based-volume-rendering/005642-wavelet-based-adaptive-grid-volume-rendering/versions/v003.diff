+def trilinear_interpolate(grid, pos):
+    # Standard trilinear interpolation on uniform grid [G]
+    ix, iy, iz = pos / grid.spacing
+    x0, y0, z0 = floor(ix), floor(iy), floor(iz)
+    x1, y1, z1 = x0 + 1, y0 + 1, z1 + 1
+    dx, dy, dz = ix - x0, iy - y0, iz - z0
+    v000 = grid.sample(x0, y0, z0)
+    v100 = grid.sample(x1, y0, z0)
+    v010 = grid.sample(x0, y1, z0)
+    v110 = grid.sample(x1, y1, z0)
+    v001 = grid.sample(x0, y0, z1)
+    v101 = grid.sample(x1, y0, z1)
+    v011 = grid.sample(x0, y1, z1)
+    v111 = grid.sample(x1, y1, z1)
+    return (v000*(1-dx)*(1-dy)*(1-dz) + v100*dx*(1-dy)*(1-dz) + v010*(1-dx)*dy*(1-dz) + v110*dx*dy*(1-dz) +
