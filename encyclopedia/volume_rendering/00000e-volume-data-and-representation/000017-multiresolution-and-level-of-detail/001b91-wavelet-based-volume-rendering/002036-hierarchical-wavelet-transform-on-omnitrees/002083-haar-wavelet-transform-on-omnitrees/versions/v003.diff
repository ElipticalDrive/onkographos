+    coefficients = {}
+    
+    def traverse(node, node_id):
+        if node.is_leaf:
+            return
+        
+        # Get splitting label
+        b = node.splitting_label
+        d = len(b)
+        
+        # For each dimension where the node is split
+        for j in range(d):
+            if b[j] == 1:
+                # Get left and right children along dimension j
