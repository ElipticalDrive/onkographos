+def random_sample_ray(image):
+    return (random.uniform(0, image.width), random.uniform(0, image.height))
+
+def render_scene(model, rays, planes=None):
+    features = [interpolate_planes(plane, ray) for plane in (planes or model.positional_planes) for ray in rays]
+    return model.decoder(features)
+
+def apply_sr_model(sr_net, plane):
+    return sr_net(plane)
+
+def downsample_image(image, factor):
+    return image.resize((image.width // factor, image.height // factor), resample=3)
+
+def compute_mse(pred, target):
+    return sum((p - t) ** 2 for p, t in zip(pred, target)) / len(pred)
+
+def interpolate_planes(plane, ray):
+    return plane[ray[0], ray[1]]
