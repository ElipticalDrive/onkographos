+def apply_box_blur(data, size, D, H, W):
+    """Applies a simple box averaging filter to smooth transition regions."""
+    result = [0.0] * len(data)
+    half = size // 2
+    for z in range(D):
+        for y in range(H):
+            for x in range(W):
+                idx = z * H * W + y * W + x
+                total = 0.0
+                count = 0
+                for dz in range(-half, half + 1):
+                    for dy in range(-half, half + 1):
+                        for dx in range(-half, half + 1):
+                            nz, ny, nx = z + dz, y + dy, x + dx
+                            if 0 <= nz < D and 0 <= ny < H and 0 <= nx < W:
+                                total += data[nz * H * W + ny * W + nx]
+                                count += 1
+                result[idx] = total / count
     return result
