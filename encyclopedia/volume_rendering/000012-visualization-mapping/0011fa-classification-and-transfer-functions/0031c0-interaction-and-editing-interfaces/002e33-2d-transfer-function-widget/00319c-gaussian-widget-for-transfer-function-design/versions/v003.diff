+def evaluate_gaussian_widget(x, mu, sigma):
+    # x, mu: 3D feature vectors (numpy arrays or lists)
+    # sigma: scalar spread parameter (variance)
+    diff = x - mu
+    # Isotropic covariance: Sigma_mat = sigma * I
+    # |Sigma| = sigma^3, Sigma_inv = 1/sigma
+    exponent = -0.5 * (diff @ diff) / sigma
+    normalization = (2 * 3.141592653589793) ** 1.5 * (sigma ** 1.5)
+    return (1.0 / normalization) * math.exp(exponent)
