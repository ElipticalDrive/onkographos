+class CubicSpline:
+    """Standard cubic spline evaluator [G]."""
+    def __init__(self, p0, p1, t0, t1):
+        self.p0, self.p1 = p0, p1
+        self.t0, self.t1 = t0, t1
+        # Coefficients for P(t) = a*t^3 + b*t^2 + c*t + d
+        self.a = 2*p0 - 2*p1 + t0 + t1
+        self.b = -3*p0 + 3*p1 - 2*t0 - t1
+        self.c = t0
+        self.d = p0
+    def evaluate(self, t):
+        t2, t3 = t*t, t*t*t
+        return self.a*t3 + self.b*t2 + self.c*t + self.d
