+# Helper: Standard linear curve sampling [G]
+def sample_curve(t, control_points):
+    # control_points is a list of (t_val, value) tuples sorted by t_val
+    if t <= control_points[0][0]: return control_points[0][1]
+    if t >= control_points[-1][0]: return control_points[-1][1]
+    for i in range(len(control_points) - 1):
+        t0, v0 = control_points[i]
+        t1, v1 = control_points[i+1]
+        if t0 <= t <= t1:
+            frac = (t - t0) / (t1 - t0)
+            return v0 + frac * (v1 - v0)
