+        # Update TF parameters
+        kappa -= learning_rate * grad_kappa
+        color -= learning_rate * grad_color
+        
+        # Clamp values to valid range
+        kappa = np.clip(kappa, 0, 1)
+        color = np.clip(color, 0, 1)
+        
+    return kappa, color
