+    for iteration in range(num_iterations):
+        total_loss = 0
+        grad_kappa = np.zeros(256)
+        grad_color = np.zeros((256, 3))
+        
+        for ref_img in reference_images:
+            # Render volume with current TF
+            rendered_img = render_volume(volume, kappa, color)
+            
+            # Compute MSE loss
+            loss = np.mean((rendered_img - ref_img) ** 2)
+            total_loss += loss
+            
+            # Compute gradients via backpropagation through renderer
+            # This requires a differentiable renderer
+            grad_rendered = 2 * (rendered_img - ref_img) / (rendered_img.size)
