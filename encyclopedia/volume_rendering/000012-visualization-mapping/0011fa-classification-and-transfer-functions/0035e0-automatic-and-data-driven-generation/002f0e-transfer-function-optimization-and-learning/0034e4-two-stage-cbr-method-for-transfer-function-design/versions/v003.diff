+def extract_cnn_features(images):
+    # Standard AlexNet FC7 feature extraction (4096 dims per image)
+    # Returns list of numpy arrays of shape (4096,)
+    return [alexnet_fc7(image) for image in images]
+
+def compute_dtw_distance(profile_q, profile_c):
+    Lq, Lc = len(profile_q), len(profile_c)
+    # Initialize distance matrix
+    D = [[float('inf')] * Lc for _ in range(Lq)]
+    D[0][0] = (profile_q[0] - profile_c[0])**2
+    # Fill first row and column
+    for i in range(1, Lq): D[i][0] = D[i-1][0] + (profile_q[i] - profile_c[0])**2
+    for j in range(1, Lc): D[0][j] = D[0][j-1] + (profile_q[0] - profile_c[j])**2
+    # Fill rest with continuity and monotonicity constraints
+    for i in range(1, Lq):
+        for j in range(1, Lc):
+            cost = (profile_q[i] - profile_c[j])**2
+            D[i][j] = cost + min(D[i-1][j-1], D[i-1][j], D[i][j-1])
+    # Calculate final distance: min sqrt(sum(p_k / K))
+    # Reconstruct path to get K and sum
+    path = []
+    i, j = Lq-1, Lc-1
+    while i > 0 or j > 0:
+        path.append(D[i][j])
+        if i == 0: j -= 1
+        elif j == 0: i -= 1
+        else:
+            prev = min(D[i-1][j-1], D[i-1][j], D[i][j-1])
+            if D[i-1][j-1] == prev: i -= 1; j -= 1
+            elif D[i-1][j] == prev: i -= 1
+            else: j -= 1
+    path.append(D[0][0])
+    K = len(path)
+    return (sum(path) / K)**0.5
+
+def optimize_visibility(initial_tf, volume, sois):
