+def compute_knn_bandwidths(feature_points, k):
+    """
+    Compute bandwidths d_{i,k} as distance to k-th nearest neighbor.
+    Args:
+        feature_points: List of feature space coordinates.
+        k: Number of nearest neighbors.
+    Returns:
+        bandwidths: List of bandwidths for each point.
+    """
+    n = len(feature_points)
+    bandwidths = []
+    for i in range(n):
+        dists = []
+        for j in range(n):
+            if i == j:
+                continue
+            diff = [feature_points[i][m] - feature_points[j][m] for m in range(len(feature_points[i]))]
+            dists.append(math.sqrt(sum(d*d for d in diff)))
+        dists.sort()
+        idx = min(k - 1, len(dists) - 1)
+        bandwidths.append(dists[idx])
+    return bandwidths
