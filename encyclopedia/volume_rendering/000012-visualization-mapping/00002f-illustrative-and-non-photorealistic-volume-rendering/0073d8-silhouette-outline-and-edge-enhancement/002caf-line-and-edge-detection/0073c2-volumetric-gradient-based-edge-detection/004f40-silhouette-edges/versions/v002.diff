+            opacity = transfer_function(rho)
+            sample_color = volume.sample_color(x)
+            color = blend(color, sample_color, opacity)
+            alpha = 1.0 - (1.0 - alpha) * (1.0 - opacity)
+        t += step_size
+    return color
