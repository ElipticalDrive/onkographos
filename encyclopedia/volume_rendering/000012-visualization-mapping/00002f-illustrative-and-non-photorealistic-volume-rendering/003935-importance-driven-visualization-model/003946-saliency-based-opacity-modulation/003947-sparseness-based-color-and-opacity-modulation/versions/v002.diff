+def rgb_to_hsv(rgb):
+    """Standard RGB to HSV conversion [G]."""
+    r, g, b = rgb
+    max_c = max(r, g, b)
+    min_c = min(r, g, b)
+    diff = max_c - min_c
+    if diff == 0:
+        h = 0.0
+    elif max_c == r:
+        h = 60.0 * (((g - b) / diff) % 6)
+    elif max_c == g:
+        h = 60.0 * (((b - r) / diff) + 2)
+    else:
+        h = 60.0 * (((r - g) / diff) + 4)
+    v = max_c
+    s = diff / max_c if max_c != 0 else 0.0
+    return h, s, v
+
+def hsv_to_rgb(h, s, v):
+    """Standard HSV to RGB conversion [G]."""
+    c = v * s
+    x = c * (1 - abs((h / 60.0) % 2 - 1))
+    m = v - c
+    if h < 60:
+        r, g, b = c, x, 0
+    elif h < 120:
+        r, g, b = x, c, 0
+    elif h < 180:
+        r, g, b = 0, c, x
+    elif h < 240:
+        r, g, b = 0, x, c
+    elif h < 300:
+        r, g, b = x, 0, c
+    else:
+        r, g, b = c, 0, x
+    return (r + m, g + m, b + m)
