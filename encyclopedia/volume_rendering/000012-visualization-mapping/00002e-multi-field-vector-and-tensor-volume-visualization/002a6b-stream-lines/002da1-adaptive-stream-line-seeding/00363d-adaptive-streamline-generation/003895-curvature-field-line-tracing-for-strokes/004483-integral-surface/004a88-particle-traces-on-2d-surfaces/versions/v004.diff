+def magnitude(v):
+    return math.sqrt(v[0]**2 + v[1]**2 + v[2]**2)
+
+def dot(v1, v2):
+    return v1[0]*v2[0] + v1[1]*v2[1] + v1[2]*v2[2]
+
+def normalize(v):
+    m = magnitude(v)
+    return (v[0]/m, v[1]/m, v[2]/m) if m > 0 else (0, 0, 0)
+
