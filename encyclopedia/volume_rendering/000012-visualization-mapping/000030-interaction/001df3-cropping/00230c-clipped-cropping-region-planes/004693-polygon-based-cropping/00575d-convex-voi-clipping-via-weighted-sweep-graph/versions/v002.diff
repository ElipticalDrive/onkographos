+def sort_edges_to_polygon(edges, vertices):
+    """Sort edges to form a convex polygon."""
+    if not edges:
+        return []
+    
+    # Build adjacency list
+    adj = {}
+    for e in edges:
+        v1, v2 = e
+        if v1 not in adj:
+            adj[v1] = []
+        if v2 not in adj:
+            adj[v2] = []
+        adj[v1].append(v2)
+        adj[v2].append(v1)
+    
+    # Start from an arbitrary edge
+    start_v = edges[0][0]
+    path = [start_v]
+    current_v = start_v
+    visited = {start_v}
+    
+    while len(path) < len(edges) + 1: # +1 to close the loop
+        neighbors = adj.get(current_v, [])
+        next_v = None
+        for n in neighbors:
+            if n not in visited:
+                next_v = n
