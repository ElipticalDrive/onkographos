+def heney_greenstein(cos_theta, g):
+    """Standard Henyey-Greenstein phase function [G]."""
+    denom = 1.0 + g**2 - 2.0 * g * cos_theta
+    return (1.0 - g**2) / (4.0 * math.pi * (denom ** 1.5))
+
+def blackbody_radiance(temperature_kelvin):
+    """Approximate blackbody radiance for a given temperature [G]."""
+    return 1.0 / (temperature_kelvin * 1e-6)
 
