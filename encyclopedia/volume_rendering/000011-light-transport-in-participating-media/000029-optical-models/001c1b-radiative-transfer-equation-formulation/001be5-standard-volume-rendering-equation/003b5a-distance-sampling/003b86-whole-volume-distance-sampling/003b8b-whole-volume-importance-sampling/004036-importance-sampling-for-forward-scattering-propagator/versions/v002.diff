+# Standard geometric and sampling helpers [G]
+def random_vector_in_plane_through(origin):
+    theta = random() * 2 * pi
+    return vec3(cos(theta), sin(theta), 0)
+
+def project_to_surface(origin, offset, surface):
+    ray = Ray(origin, offset)
+    hit = ray_intersect(ray, surface)
+    return hit.point if hit else None, hit is not None
+
+def compute_pdf_offset_projection(offset, surface):
+    return 1.0 / (2 * pi)  # Uniform in plane
+
+def sample_direction_from_short_length_weight(model):
+    # Marginalize short length weight of Eq. 10
+    return normalize(model.sample_short_length_marginal())
+
+def compute_pdf_ballistic_sampling(direction, model):
+    return model.short_length_pdf(direction)
+
+def sample_s_from_dipole_limits(model, x_i, x0):
+    # MIS of large and small ps limits
+    s_large = model.sample_large_ps_limit()
+    s_small = model.sample_small_ps_limit()
+    return s_large if random() < 0.5 else s_small
+
+def sample_direction_from_exponential_weight(model, x_i, x0, s):
+    # Sample based on exponential weight of G_f (Eq. 9)
+    return model.sample_exponential_weight(s)
+
+def bsdf_sample(omega_in, x):
+    return bsdf.sample_pdf(omega_in, x)
+
+def sample_light_direction(x, lights):
+    return lights[0].sample_direction(x)
+
+def bsdf_sample_adjoint(omega_out, x):
+    return bsdf.sample_adjoint(omega_out, x)
+
+def sample_s_specialized(model, x_i, x0, omega_e):
+    return model.specialized_path_length_sampler(omega_e)
+
+def is_direction_back_into_medium(omega, normal):
+    return dot(omega, normal) < 0
+
+def radiance_split_throughput(radiance, throughput):
+    return radiance / max(throughput, 1e-6)
