+def compute_transmittance(x_start, x_end, get_sigma):
+    """Standard transmittance calculation [G]."""
+    num_samples = 10
+    dt = dot(x_end - x_start, x_end - x_start) / num_samples
+    integral = 0.0
+    for i in range(num_samples):
