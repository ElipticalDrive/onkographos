+**Pseudocode:**
+```python
+import math
+
+class Texture3D:
+    """Simple 3D texture supporting trilinear interpolation."""
+    def __init__(self, width, height, depth):
+        self.width = width
+        self.height = height
+        self.depth = depth
+        # Initialize with zeros
+        self.data = [[[0.0 for _ in range(width)] for _ in range(height)] for _ in range(depth)]
+        
+    def set(self, z, y, x, value):
+        if 0 <= z < self.depth and 0 <= y < self.height and 0 <= x < self.width:
+            self.data[z][y][x] = value
+            
+    def sample(self, u, v, z):
+        # Clamp coordinates
+        u = max(0.0, min(1.0, u))
+        v = max(0.0, min(1.0, v))
+        z = max(0.0, min(float(self.depth - 1), z))
+        
+        # Trilinear interpolation
+        x0, x1 = int(u * self.width), min(int(u * self.width) + 1, self.width - 1)
+        y0, y1 = int(v * self.height), min(int(v * self.height) + 1, self.height - 1)
+        z0, z1 = int(z), min(int(z) + 1, self.depth - 1)
+        
+        dx, dy, dz = u * self.width - x0, v * self.height - y0, z - z0
+        
+        v000 = self.data[z0][y0][x0]
+        v100 = self.data[z0][y0][x1]
+        v010 = self.data[z0][y1][x0]
+        v110 = self.data[z0][y1][x1]
+        v001 = self.data[z1][y0][x0]
+        v101 = self.data[z1][y0][x1]
+        v011 = self.data[z1][y1][x0]
+        v111 = self.data[z1][y1][x1]
+        
+        def lerp(a, b, t): return a + t * (b - a)
+        
+        c00 = lerp(v000, v100, dx)
+        c01 = lerp(v010, v110, dx)
+        c10 = lerp(v001, v101, dx)
+        c11 = lerp(v011, v111, dx)
+        
+        d0 = lerp(c00, c01, dy)
+        d1 = lerp(c10, c11, dy)
+        
+        return lerp(d0, d1, dz)
+
+def generate_opacity_shadow_map(light_cam_matrix, shadow_volume_range, slice_count, density_func, extinction_coef, light_cam_size):
+    """
+    Generates a 3D texture storing transmittance layers.
+    shadow_volume_range: (z_min, z_max)
+    slice_count: Number of layers (L)
+    light_cam_size: (width, height) of the shadow map viewport
+    """
+    z_min, z_max = shadow_volume_range
+    step_size = (z_max - z_min) / slice_count
+    
+    # Initialize 3D texture of size (width, height, slice_count)
+    shadow_map = Texture3D(width=light_cam_size[0], height=light_cam_size[1], depth=slice_count)
+    
+    # March along the light ray (Z-axis in light space)
+    for i in range(slice_count):
+        # Position along the light ray
+        pos_z = z_min + i * step_size
+        # Assume density function takes world/light space coordinates.
+        # For a uniform grid march, we sample at (0, 0, pos_z) in light space.
+        pos = (0.0, 0.0, pos_z)
+        current_density = density_func(pos)
+        
+        # Accumulate optical depth and compute transmittance using Beer's Law
+        # Note: extinction_coef and step_size must share consistent units (e.g., both in meters or both in km)
+        # If density is per km and step_size is in meters, apply conversion: step_size_m = step_size * 1000.0
+        total_optical_depth = 0.0
+        for k in range(i + 1):
+            k_pos_z = z_min + k * step_size
+            k_pos = (0.0, 0.0, k_pos_z)
+            total_optical_depth += density_func(k_pos) * step_size
+        
+        transmittance = math.exp(-extinction_coef * total_optical_depth)
+        
+        # Store transmittance in the 3D texture at coordinate (u, v, i/L)
+        # Using center of pixel for sampling
+        u, v = 0.5 / light_cam_size[0], 0.5 / light_cam_size[1]
+        shadow_map.set(i, int(v * light_cam_size[1]), int(u * light_cam_size[0]), transmittance)
+        
+    return shadow_map
+
+def raymarch_with_shadow_map(view_ray_origin, view_ray_dir, step_count, step_size, 
+                             light_cam_matrix, shadow_map, shadow_volume_range,
+                             ambient_light, direct_light, scattering_coef, extinction_coef,
+                             phase_func, light_cam_size):
+    """
+    Renders the volume using precomputed shadow map.
+    """
+    z_min, z_max = shadow_volume_range
+    
+    transmittance = 1.0
+    illumination = (0.0, 0.0, 0.0)
+    
+    current_pos = list(view_ray_origin)
+    
+    for i in range(step_count):
+        # Advance sample position
+        current_pos[0] += view_ray_dir[0] * step_size
+        current_pos[1] += view_ray_dir[1] * step_size
+        current_pos[2] += view_ray_dir[2] * step_size
+        
+        # 1. Shadow Lookup
+        # Transform to light space (assuming light_cam_matrix is a 4x4 matrix)
+        # Homogeneous division handled conceptually; here we assume light_cam_matrix outputs normalized coordinates
+        light_pos = light_cam_matrix.transform(current_pos)
+        
+        # Normalize Z to [0, 1]
+        z = (-light_pos[2] - z_min) / (z_max - z_min)
+        z = max(0.0, min(1.0, z))
+        
+        # Normalize UV
+        uv = (light_pos[0] / light_cam_size[0] / 2.0 + 0.5, 
+              light_pos[1] / light_cam_size[1] / 2.0 + 0.5)
+        
+        # Sample transmittance from 3D texture
+        shadow_factor = shadow_map.sample(uv[0], uv[1], z)
+        
+        # 2. Volume Integration
+        current_density = density_func(current_pos)
+        
+        # Update volume transmittance (Beer's Law)
+        transmittance *= math.exp(-current_density * extinction_coef * step_size)
+        
+        # Compute In-Scattering
+        # L_in = Ambient + Direct * Phase * Shadow
+        phase = phase_func(view_ray_dir, (-view_ray_dir[0], -view_ray_dir[1], -view_ray_dir[2]))
+        in_scattering = (ambient_light[0] + direct_light[0] * phase * shadow_factor,
+                         ambient_light[1] + direct_light[1] * phase * shadow_factor,
+                         ambient_light[2] + direct_light[2] * phase * shadow_factor)
+        
+        # Compute Out-Scattering
+        out_scattering = (scattering_coef * current_density,
+                          scattering_coef * current_density,
+                          scattering_coef * current_density)
+        
+        # Accumulate Illumination
+        current_light = (in_scattering[0] * out_scattering[0],
+                         in_scattering[1] * out_scattering[1],
+                         in_scattering[2] * out_scattering[2])
+        illumination = (illumination[0] + transmittance * current_light[0] * step_size,
+                        illumination[1] + transmittance * current_light[1] * step_size,
+                        illumination[2] + transmittance * current_light[2] * step_size)
+        
+    return (illumination[0], illumination[1], illumination[2], transmittance)
+```
+
 **Edge Cases and Pitfalls:**
 *   **Banding:** Visible bands may occur due to a low number of layers in the opacity shadow map. Solution: Add a small random offset in each step of the ray marcher to create visual noise, which can be blurred if too noticeable [S2, unofficial].
 *   **Channel Storage:** Storing different layer values in different color channels (e.g., Layer 1 in Red, Layer 2 in Green) prevents correct bilinear/trilinear interpolation during sampling. Store all layers in a single channel or use separate passes [S2, unofficial].
 *   **Depth Range:** Incorrect $z_{min}$ causes incorrect shading [S2, unofficial].
+*   **Unit Consistency:** The extinction coefficient $\sigma_t$ and step size $\Delta x$ must share units. If $\sigma_t$ is given per kilometer but $\Delta x$ is in meters, apply a conversion factor (e.g., $\Delta x_{km} = \Delta x_m / 1000$) before computing Beer's Law [S2, unofficial].
 
