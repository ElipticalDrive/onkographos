+def binary_search_a_buffer(a_buffer, t, d):
+    if d < a_buffer[0].d or d > a_buffer[-1].d:
+        return []
+    min_layer, max_layer = 0, len(a_buffer) - 1
+    while min_layer <= max_layer:
+        mid = min_layer + (max_layer - min_layer) // 2
+        if a_buffer[mid].d < d:
+            min_layer = mid + 1
+        else:
+            max_layer = mid - 1
+    return [a_buffer[max_layer], a_buffer[min_layer]]
