+def bilinear_interpolate(grid, point):
+    """Bilinear interpolation on a 2D grid."""
+    x, y = point
+    x0, y0 = int(x), int(y)
+    x1, y1 = x0 + 1, y0 + 1
+    dx, dy = x - x0, y - y0
+    g00 = grid[y0, x0]
+    g01 = grid[y0, x1]
+    g10 = grid[y1, x0]
+    g11 = grid[y1, x1]
+    top = g00 * (1 - dx) + g01 * dx
+    bottom = g10 * (1 - dx) + g11 * dx
+    return top * (1 - dy) + bottom * dy
 
