+# Standard helper operations
+def sample_primary(camera, screen_pos, rng):
+    return Ray(camera.origin, camera.direction(screen_pos), float('inf'))
+
+def intersect(scene, ray):
+    t_min = float('inf')
+    hit = None
+    for surface in scene.surfaces:
+        t, data = surface.intersect(ray)
+        if 0 < t < t_min:
+            t_min = t
+            hit = data
+    return Intersection(t_min, hit)
+
