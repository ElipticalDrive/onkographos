+def cos_weighted_hemisphere(normal):
+    # Standard cosine-weighted hemisphere sampling
+    u1 = random.random()
+    u2 = random.random()
+    r = math.sqrt(u1)
+    theta = 2.0 * math.pi * u2
+    x = r * math.cos(theta)
+    y = r * math.sin(theta)
