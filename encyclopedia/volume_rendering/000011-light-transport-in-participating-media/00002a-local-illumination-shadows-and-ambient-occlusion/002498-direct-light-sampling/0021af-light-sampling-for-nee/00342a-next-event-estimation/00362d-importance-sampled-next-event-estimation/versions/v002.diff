+# Helper definitions (standard operations)
+def weighted_choice(items, weights, fixed_kappa=None):
+    # Standard categorical sampling based on weights
+    total = sum(weights)
+    r = random.uniform(0.0, total)
+    cumulative = 0.0
+    for i, w in enumerate(weights):
+        cumulative += w
+        if r <= cumulative:
+            return items[i]
+    return items[-1]
+
+def sample_sggx(lobe):
+    # Standard sampling from the SGGX microfacet distribution
+    return lobe.sample()
+
+def compute_sggx_pdf(direction, lobe):
+    # Standard PDF evaluation for SGGX
+    return lobe.pdf(direction)
+
+def get_tangent_plane(point):
+    # Plane passing through point with normal equal to surface normal
+    return Plane(point, point.normal)
+
+def intersect_plane_with_light(plane, light):
+    # Intersect plane with light geometry to get a segment or region
+    return plane.intersect(light.geometry)
+
+def sample_from_precomputed_distribution(normal, dist):
+    # Sample from the pre-computed 1D distribution conditioned on normal
+    return dist.sample(normal)
+
+def sample_from_segment(segment):
+    # Uniform sampling along the intersection segment
+    t = random.uniform(0.0, 1.0)
+    return segment.start + t * (segment.end - segment.start)
+
+def compute_pdf(direction, light, point):
+    # Standard geometric PDF computation
+    return light.pdf(direction, point)
