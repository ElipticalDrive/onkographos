     1.  Once all $K$ directions are processed, use the final ambient light intensity volume in the standard rendering pass [S2, unofficial].
 
+**Pseudocode:**
+```python
+def preprocess_volume(volume_data, block_size=16):
+    # Divide volume into blocks and encode LODs (8^3, 4^3, 2^3, 1^3)
+    packed_texture = pack_multiresolution(volume_data, block_size)
+    forward_map = create_forward_index(packed_texture)
+    reverse_map = create_reverse_index(packed_texture, min_lod=4)
+    ambient_texture = create_zero_texture_like(packed_texture)
+    return packed_texture, forward_map, reverse_map, ambient_texture
+
+def compute_ray_contribution(voxel_pos, direction, packed_texture, forward_map, reverse_map, tf, R_b, a, M, adaptive=False):
+    # Initialize front-to-back compositing
+    accumulated_opacity = 0.0
+    light_contribution = 0.0
+    step_size = 1.0 if not adaptive else get_adaptive_step(voxel_pos, packed_texture, reverse_map)
+    
+    for m in range(1, M + 1):
+        sample_pos = voxel_pos + direction * (a + m * step_size)
+        opacity = tf.lookup(sample_pos)
+        transmittance = math.exp(-accumulated_opacity)
+        light_contribution += transmittance * (1.0 / R_b) * opacity
+        accumulated_opacity += opacity
+        if accumulated_opacity >= 1.0:
+            break
+    return light_contribution / M
+
+def incremental_lao_pipeline(packed_texture, forward_map, reverse_map, ambient_texture, directions, weights, R_b, a, M):
+    k = 0
+    for direction, weight in zip(directions, weights):
+        k += 1
+        # Render quad to trigger per-fragment computation
+        for voxel in mapped_voxels_from_framebuffer():
+            I_k = compute_ray_contribution(voxel, direction, packed_texture, forward_map, reverse_map, tf, R_b, a, M)
+            # OpenGL blend operation implements: A_k = (1/k)*I_k + ((k-1)/k)*A_{k-1}
+            blend_factor = 1.0 / k
+            ambient_texture[voxel] = blend_factor * I_k + (1.0 - blend_factor) * ambient_texture[voxel]
+        # Interleave with rendering for user interaction
+        render_with_current_ambient(ambient_texture)
+    return ambient_texture
+```
+
 **Edge Cases and Pitfalls:**
