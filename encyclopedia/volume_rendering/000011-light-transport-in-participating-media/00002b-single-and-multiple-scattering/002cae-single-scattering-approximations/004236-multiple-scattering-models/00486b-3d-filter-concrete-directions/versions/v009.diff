+def compute_radiance_3d_filter(voxel_grid, viewing_direction, sunlight_direction, mean_density):
+    """
+    Computes radiance using the 3D-Filter method.
+    Assumes voxel_grid is a 3D array of density values.
+    """
+    # Step 1: Precompute the 3D-Filter (Contribution-Ratio Pattern)
+    # This is typically done offline or as a preprocessing step.
+    # The filter represents contribution ratios for 2nd and 3rd order scattering.
+    filter_3d = precompute_3d_filter(mean_density, viewing_direction, sunlight_direction)
+    
+    # Step 2: Compute Single Scattering Components
+    # Skylight: Single scattering by particles
+    L_single_sky = compute_single_scattering_sky(voxel_grid, viewing_direction)
+    
+    # Sunlight: Single scattering
+    L_single_sun = compute_single_scattering_sun(voxel_grid, viewing_direction, sunlight_direction)
+    
+    # Step 3: Compute Multiple Scattering (Orders 2 and 3)
+    L_multiple = zeros_like(voxel_grid)
+    
+    # Apply the 3D-filter to the whole space
+    for voxel in voxel_grid:
+        # Multiply form factors by energy at related points
+        # The filter contains precomputed weights for contributing voxels
+        # Stochastic selection of contributing voxels is handled within precompute_3d_filter
+        contribution = 0.0
+        for contributing_voxel, weight in filter_3d[voxel]:
+            # Energy at the related point (contributing_voxel)
+            # This involves integrating transmittance and emission/scattering from that voxel
+            energy = get_energy_at_voxel(contributing_voxel, sunlight_direction, mean_density)
+            contribution += weight * energy
+        
+        L_multiple[voxel] = contribution
+        
+    # Step 4: Accumulate Results
+    L_total = L_single_sky + L_single_sun + L_multiple
+    
+    return L_total
 
