+    v100 = LUT[ix1, iy, iz]
+    v010 = LUT[ix, iy1, iz]
+    v110 = LUT[ix1, iy1, iz]
+    v001 = LUT[ix, iy, iz1]
+    v101 = LUT[ix1, iy, iz1]
+    v011 = LUT[ix, iy1, iz1]
+    v111 = LUT[ix1, iy1, iz1]
