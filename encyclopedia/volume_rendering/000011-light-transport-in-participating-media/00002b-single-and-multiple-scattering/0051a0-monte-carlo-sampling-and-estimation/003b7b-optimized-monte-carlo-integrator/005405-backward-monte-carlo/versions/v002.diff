+def compute_transmittance_along_ray(origin, direction, voxel_grid, max_dist=1e6):
+    """Compute transmittance T = exp(-integral(beta dl)) along a ray to TOA."""
+    steps = 100
+    dl = max_dist / steps
+    tau = 0.0
+    for i in range(steps):
+        pos = (origin[0] + direction[0] * (i * dl),
+               origin[1] + direction[1] * (i * dl),
+               origin[2] + direction[2] * (i * dl))
+        if not voxel_grid.is_inside(pos):
+            break
+        sigma_a, beta_a = voxel_grid.get_extinction(pos)
+        tau += (sigma_a + beta_a) * dl
+    return math.exp(-tau)
+
+def solve_distance(ray_origin, ray_dir, target_tau, voxel_grid, max_dist=1e6):
+    """Bisection solver to find l such that integral_0^l (sigma_a n + beta_air) dl = target_tau."""
+    low, high = 0.0, max_dist
+    for _ in range(50):
+        mid = (low + high) / 2
+        pos = (ray_origin[0] + ray_dir[0] * mid,
+               ray_origin[1] + ray_dir[1] * mid,
+               ray_origin[2] + ray_dir[2] * mid)
+        if not voxel_grid.is_inside(pos):
+            high = mid
+            continue
+        sigma_a, beta_a = voxel_grid.get_extinction(pos)
+        tau = 0.0
+        steps = 10
+        dl = mid / steps
+        for j in range(steps):
+            p = (ray_origin[0] + ray_dir[0] * (j * dl),
+                 ray_origin[1] + ray_dir[1] * (j * dl),
+                 ray_origin[2] + ray_dir[2] * (j * dl))
+            if voxel_grid.is_inside(p):
+                s, b = voxel_grid.get_extinction(p)
+                tau += (s + b) * dl
+        if tau < target_tau:
+            low = mid
+        else:
+            high = mid
+    return (low + high) / 2
+
+def scatter_direction(current_dir, phi_scatter, azimuth):
+    """Rotate current_dir by phi_scatter around a random axis perpendicular to current_dir."""
+    def normalize(v):
+        l = math.sqrt(v[0]**2 + v[1]**2 + v[2]**2)
+        return (v[0]/l, v[1]/l, v[2]/l)
+    def cross(a, b):
+        return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])
+    def dot(a, b):
+        return a[0]*b[0] + a[1]*b[1] + a[2]*b[2]
+
+    ref = (0.0, 1.0, 0.0) if abs(dot(current_dir, ref)) < 0.9 else (1.0, 0.0, 0.0)
+    u = normalize(cross(current_dir, ref))
+    v = cross(current_dir, u)
+    sin_phi = math.sin(phi_scatter)
+    cos_phi = math.cos(phi_scatter)
+    cos_az = math.cos(azimuth)
+    sin_az = math.sin(azimuth)
+    new_x = cos_phi * current_dir[0] + sin_phi * (cos_az * u[0] + sin_az * v[0])
+    new_y = cos_phi * current_dir[1] + sin_phi * (cos_az * u[1] + sin_az * v[1])
+    new_z = cos_phi * current_dir[2] + sin_phi * (cos_az * u[2] + sin_az * v[2])
+    return (new_x, new_y, new_z)
 
