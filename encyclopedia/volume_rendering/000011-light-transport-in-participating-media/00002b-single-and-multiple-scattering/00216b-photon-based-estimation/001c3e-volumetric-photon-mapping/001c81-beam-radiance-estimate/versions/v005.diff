+def ray_intersects_bbox(ray_origin, ray_dir, bbox):
+    """Standard slab method for ray-AABB intersection."""
+    inv_dir = (1.0/ray_dir[0], 1.0/ray_dir[1], 1.0/ray_dir[2])
