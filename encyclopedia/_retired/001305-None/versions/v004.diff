+```python
+# Preprocessing phase
+def preprocess(volume):
+    normals = compute_normals(volume)
+    opacities = compute_opacities(volume)
+    octree = build_octree(volume)
+    return normals, opacities, octree
+
+# Hardware simulation: triple shift register holds (depth, color) for current, prev, next scanlines [S3]
+def init_shift_register(scanlines):
+    return [scanlines[0], scanlines[1], scanlines[2]]
+
+# Gradient computation from neighbor depths [G]
+def compute_gradient_horizontal(depth_left, depth_right):
+    return depth_right - depth_left
+
+def compute_gradient_bidirectional(depth_left, depth_right, depth_top, depth_bottom):
+    dx = depth_right - depth_left
+    dy = depth_bottom - depth_top
+    return (dx, dy)
+
+# Quantize gradient to predefined finite set [G]
+def quantize_gradient(gradient_vector):
