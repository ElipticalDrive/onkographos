+
+# Concatenate color and gradient index into congradient value [S2, book]
+def concatenate(color_rgb, gradient_index):
+    return (color_rgb[0] << 16) | (color_rgb[1] << 8) | color_rgb[2] | (gradient_index << 24)
+
+# Main pipeline: interleaved projection and shading [S2, book]
+def run_pipeline(shift_register, light_params, lut):
+    shaded_pixels = []
+    width = len(shift_register[1])
+    for i in range(width):
+        current = shift_register[1][i]
+        left = shift_register[1][i - 1] if i > 0 else current
+        right = shift_register[1][i + 1] if i < width - 1 else current
+        top = shift_register[0][i]
+        bottom = shift_register[2][i]
+
+        # Unidirectional or bidirectional approach [S2, book]
+        gradient = compute_gradient_horizontal(left[0], right[0])
+        # gradient = compute_gradient_bidirectional(left[0], right[0], top[0], bottom[0])
+
+        gradient_index = quantize_gradient(gradient)
+        congradient_value = concatenate(current[1], gradient_index)
+        shaded_color = lut[congradient_value]
+        shaded_pixels.append(shaded_color)
+    return shaded_pixels
