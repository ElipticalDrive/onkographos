a","https://digital.library.unt.edu/ark:/67531/metadc1411654/?q=plane marching volume rendering","https://digital.library.unt.edu/ark:/67531/metadc1411654/?q=octree subdivision volume rendering"],"cited_by":[{"path":"1304-recursive-subdivision.md","name":"Recursive Subdivision","k":4},{"path":"6931-3-root-2-subdivision.md","name":"3-root-2 Subdivision","k":1},{"path":"7753-2d-b-spline-wavelet-masks-quadtree.md","name":"2D B-spline Wavelet Masks (Quadtree)","k":1},{"path":"7390-trilinear-b-spline-wavelet-encoding.md","name":"Trilinear B-spline Wavelet Encoding","k":1},{"path":"7585-b-spline-wavelet-lifting-scheme.md","name":"B-spline Wavelet Lifting Scheme","k":1}]}